enable hexagonrpcd-adsp-sensorspd.service
disable hexagonrpcd-adsp-rootpd.service
disable hexagonrpcd-sdsp.service
enable iio-sensor-proxy.service
# UCM owns the amplifier routes and conservative levels.
disable alsa-restore.service
disable alsa-state.service
# Double tap to wake stays off while the proximity sensor is covered.
enable wake-gesture-proximity.service
