# Reference: <https://postmarketos.org/devicepkg>
maintainer="Bruno Gregorio <accounts@bruno.pw>"
pkgname=device-sony-pdx246
pkgdesc="Sony Xperia 10 VI"
pkgver=0.1
pkgrel=9
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# No mkinitfs here. That bare name is Alpine's mkinitfs, which provides
# cmd:mkinitfs and so conflicts with postmarketos-mkinitfs - the one
# postmarketos-base actually pulls in, via postmarketos-initramfs. Only
# archived device packages still list it, from before the rename.
#
# android-tools is what provides mkbootimg: boot-deploy's header v3/v4 path
# hardcodes 'require_package "mkbootimg" "android-tools"'.
#
# No kernel here. Which kernel to install is chosen in 'pmbootstrap init' and
# each choice is a subpackage below, because the two disagree about more than
# their version: the device tree to boot, the name the USB controller gets,
# what the initramfs has to load and how to ask for an early console. Every
# deviceinfo key and every file that differs carries a _downstream or
# _mainline suffix, which is the mechanism devicepkg-dev and pmbootstrap both
# key off:
# https://wiki.postmarketos.org/wiki/Device_specific_package#Multiple_kernels
depends="
	android-tools
	postmarketos-base
"
makedepends="devicepkg-dev"
install="$pkgname-openrc.post-install $pkgname-openrc.post-upgrade"
source="
	deviceinfo
	81-libssc-sony-pdx246.rules
	hexagonrpcd-adsp-fresh
	hexagonrpcd-adsp-sensorspd.conf
	kernel-cmdline.downstream.conf
	kernel-cmdline.mainline.conf
	lomiri-deviceinfo.yaml
	modules-initfs.downstream
	modules-initfs.mainline
"
subpackages="
	$pkgname-kernel-downstream:kernel_downstream
	$pkgname-kernel-mainline:kernel_mainline
	$pkgname-lomiri:lomiri
	$pkgname-openrc
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

kernel_downstream() {
	pkgdesc="Sony's 5.10 vendor kernel - boots, has UFS, display and modem drivers"
	depends="linux-sony-pdx246"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

# The firmware goes with mainline: it sits where our device tree's
# firmware-name properties and drm/msm's catalog point. firmware-sony-pdx246
# is built from files taken off the phone; see its APKBUILD. ath10k's
# firmware-5.bin for the WLAN comes from linux-firmware, and so do the
# Bluetooth chip's rampatch and NVM, crbtfw32.tlv and crnv32u.bin, which
# rounds 44 and 53 loaded; until pkgrel 7 nothing pulled them in.
#
# soc-qcom is what every mainline Qualcomm device in pmaports pulls in. Here
# it is for bootmac: the WCN3991's NVM carries the default Bluetooth address,
# so btqca leaves hci0 unconfigured until something sets one, and bluetoothd
# never sees a controller. bootmac sets one from a hash of the serial number,
# and an address for wlan0, which otherwise gets a random one each boot. Not
# soc-qcom-qbootctl: qbootctl marks the slot good in the UFS GPT, and this
# port does not write the UFS.
#
# hexagonrpcd serves the ADSP's sensors domain its files. Our fork in
# temp/hexagonrpcd, 0.4.0-r103, adds the sns_reg_version mapping this phone's
# domain asks for, hence the version. The domain also wants hexagonrpcd early,
# and hexagonrpcd-adsp-fresh, run from the service's start_pre, restarts the
# ADSP when it is not.
kernel_mainline() {
	pkgdesc="Our own 6.18 mainline kernel, see docs/06-mainline.md"
	depends="
		firmware-sony-pdx246-adreno
		firmware-sony-pdx246-adsp
		firmware-sony-pdx246-cdsp
		firmware-sony-pdx246-hexagonfs
		firmware-sony-pdx246-wlan
		hexagonrpcd>=0.4.0-r103
		linux-firmware-ath10k
		linux-firmware-qca
		linux-postmarketos-qcom-sm6450
		soc-qcom
		"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname

	install -Dm644 "$srcdir"/hexagonrpcd-adsp-sensorspd.conf \
		-t "$subpkgdir"/usr/share/hexagonrpcd/
	install -Dm755 "$srcdir"/hexagonrpcd-adsp-fresh \
		-t "$subpkgdir"/usr/libexec/$pkgname/
	install -Dm644 "$srcdir"/81-libssc-sony-pdx246.rules \
		-t "$subpkgdir"/usr/lib/udev/rules.d/
}

# Lomiri's scale. Lomiri, its UI toolkit and qtmir take it from GRID_UNIT_PX
# alone, pixels to the grid unit, 8 when unset: round 87's screenshot had a
# top panel 24 px tall. Our postmarketos-ui-lomiri sets it from this file
# through device-info, as Ubuntu Touch's lomiri-session does. pmOS's wiki
# rule, ppi * 0.05236, gives 23 for 453 ppi (Mir reports 61x141 mm), and
# Android runs this panel at density 450, a scale of 2.81.
#
# But qtmir hands Mir a scale of GRID_UNIT_PX / 8 and then finds the output
# to draw on by its size at that scale, truncated, where Mir rounds it; when
# the two differ the screen gets no output and Lomiri dies on its first
# frame (rounds 90 to 92, a null m_outputSurface in
# PlatformScreen::makeCurrent). On 1080x2520 that rules out 17, 19, 22, 23
# and 25, and 24 is a whole scale of 3. The key is deviceinfo_codename,
# which /etc/profile.d/deviceinfo-converter.sh exports as
# DEVICEINFO_DEVICE_NAME; Names is our device tree's model, for when that is
# not set.
lomiri() {
	pkgdesc="Sony Xperia 10 VI: Lomiri's device configuration"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-lomiri"
	depends=""

	install -Dm644 "$srcdir"/lomiri-deviceinfo.yaml \
		"$subpkgdir"/etc/lomiri-deviceinfo/devices/sony-pdx246.yaml
}

# Starts hexagonrpcd for the sensors at boot, as Fairphone 5 does. Only with
# the mainline kernel, which is the one with the files to serve.
#
# Also iio-sensor-proxy, the one thing that reads them: Qt's sensor plugins
# and GNOME both go through it, and libssc gives it the accelerometer,
# light, proximity and compass (round 84), all four by 31 s into a boot
# with no help once the ADSP's sensors are up (round 92). The GNOME, Plasma
# and Sxmo UI packages start it, postmarketos-ui-lomiri does not, so on
# Lomiri nothing would. That belongs upstream in the UI package; until then
# it is here.
openrc() {
	install_if="$pkgname-kernel-mainline=$pkgver-r$pkgrel openrc"
	depends="hexagonrpcd-openrc iio-sensor-proxy-openrc openrc"

	mkdir -p "$subpkgdir"
}

