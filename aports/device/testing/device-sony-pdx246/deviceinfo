# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Sony Xperia 10 VI"
deviceinfo_manufacturer="Sony"
deviceinfo_codename="sony-pdx246"

# Name the real USB controller rather than letting the initramfs pick. Without
# this, get_usb_udc() takes the first entry in /sys/class/udc, and this kernel
# also builds dummy_hcd, which registers dummy_udc.0 - a software host and
# gadget emulator with no connection to the USB-C port. On 2026-10-05 the
# gadget bound to it and enumerated beautifully: cdc_ncm, cdc_acm, ttyACM0,
# usb0 with an IP, "USB_STATE=CONFIGURED", all of it inside the phone and
# invisible from outside. Naming the controller means a gadget either lands on
# the hardware or fails loudly. From the stock boot: a600000.ssusb is the
# Qualcomm glue and a600000.dwc3 the core, and the core is what registers
# the UDC.
deviceinfo_usb_network_udc="a600000.dwc3"
deviceinfo_year="2024"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_keyboard="false"
deviceinfo_external_storage="true"
deviceinfo_screen_width="1080"
deviceinfo_screen_height="2520"

# The base SoC device tree. pdx246 runs Qualcomm's Parrot QRD reference tree:
# stock ships parrot.dtb in vendor_boot and applies the parrot-qrd overlay from
# the dtbo partition on top. We build and ship the same base here and leave the
# stock dtbo partition alone, so the bootloader applies the same overlay it
# always did. CONFIG_BUILD_ARM64_DT_OVERLAY=y (columbia.config) is what makes
# the base carry the __symbols__ node that overlay application needs.
deviceinfo_dtb="vendor/qcom/parrot"

# Bootloader related
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
# Boot image header v4: mkbootimg emits boot.img (kernel) plus vendor_boot.img
# (dtb + our initramfs + cmdline). Both have to be flashed.
deviceinfo_header_version="4"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_fastboot_partition_kernel="boot"
deviceinfo_flash_fastboot_partition_vendor_boot="vendor_boot"
deviceinfo_flash_fastboot_partition_rootfs="userdata"
# Generates and flashes a vbmeta with verification flags cleared. Needed
# because our boot images are unsigned; see docs/04-flashing.md for the
# rollback-index caveat.
deviceinfo_flash_fastboot_partition_vbmeta="vbmeta"

# UFS on this device reports 4096-byte logical blocks.
deviceinfo_rootfs_image_sector_size="4096"

# deviceinfo_kernel_cmdline is deliberately NOT set. boot-deploy's get_cmdline()
# uses it *instead of* the /usr/lib/kernel-cmdline.d/ drop-ins rather than as
# well as them, so setting it here would throw away kernel-cmdline.conf. The
# cmdline, and why each option is on it, lives there.

# Load addresses. boot-deploy's header v3/v4 branch passes none of the offset
# deviceinfo variables to mkbootimg, so mkbootimg's own defaults apply - and
# its default --base is 0x10000000, which is not this board's:
#
#   device/sony/columbia/PlatformConfig.mk
#     BOARD_KERNEL_BASE        := 0x00000000
#     BOARD_KERNEL_PAGESIZE    := 4096
#     BOARD_KERNEL_TAGS_OFFSET := 0x00000100
#     BOARD_RAMDISK_OFFSET     := 0x01000000
#     BOARD_BOOT_HEADER_VERSION := 4
#
# Sony sets no BOARD_KERNEL_OFFSET or BOARD_DTB_OFFSET, and the three offsets
# above are already mkbootimg's defaults, so --base alone brings all four
# addresses in the vendor_boot header into line with stock. Header v3+ moved
# them out of boot.img and into vendor_boot.img, where the bootloader is
# documented to read them from.
#
# bootimg_custom_args is the only hook for this: boot-deploy interpolates it
# unquoted into the v4 mkbootimg call.
deviceinfo_bootimg_custom_args="--base 0x00000000"
