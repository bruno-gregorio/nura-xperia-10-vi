# The ADSP's audio graph for the Sony Xperia 10 VI, built from our own m4 on
# top of the upstream AudioReach topology macros. The kernel asks for
# qcom/<card driver name>/<card model>-tplg.bin, so the file name follows the
# sound node's model property.
maintainer="Bruno Gregorio <accounts@bruno.pw>"
pkgname=firmware-sony-pdx246-audioreach-topology
pkgver=0_git20260930
_commit="b4c1510fe6686ab8053715a02c34bec875ca5c6c"
pkgrel=1
pkgdesc="AudioReach topology for Sony Xperia 10 VI"
url="https://github.com/linux-msm/audioreach-topology"
# these files are not specific to cpu architecture, but only make sense on aarch64 devices
arch="aarch64"
license="BSD-3-Clause"
makedepends_build="alsa-utils m4"
source="audioreach-topology-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	SM6450-Sony-Xperia-10-VI.m4
	"
options="!check !tracedeps pmb:cross-native2"
builddir="$srcdir/audioreach-topology-$_commit"

build() {
	m4 -I "$builddir" "$srcdir"/SM6450-Sony-Xperia-10-VI.m4 \
		> Sony-Xperia-10-VI.conf
	alsatplg -c Sony-Xperia-10-VI.conf -o Sony-Xperia-10-VI-tplg.bin
}

package() {
	install -Dm644 Sony-Xperia-10-VI-tplg.bin \
		-t "$pkgdir"/usr/lib/firmware/qcom/sm6450
}
sha512sums="
