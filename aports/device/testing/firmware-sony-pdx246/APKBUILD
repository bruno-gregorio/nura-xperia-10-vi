# Firmware for the Sony Xperia 10 VI, from the phone itself.
#
# Unlike most firmware-* aports this downloads nothing: there is no public
# copy of these files to point at, and they may not be redistributed. They
# come off the phone - stock's modem and vendor partitions, and for the
# sensors its persist partition and /sys/devices/soc0 - and
# scripts/stage-firmware.sh copies them next to this APKBUILD, where the
# aport's .gitignore keeps them out of git. Build this package only after
# running it.
#
# The paths are the ones our kernel asks for. The remote processors' and the
# zap shader's come from the board's firmware-name properties; the GPU's
# SQE and GMU microcode from drm/msm's catalog entry for the Adreno 710; the
# WLAN board data from ath10k's own naming. ath10k's firmware-5.bin and the
# Bluetooth firmware are linux-firmware's, so they are not here; the device
# package depends on linux-firmware-ath10k and linux-firmware-qca for them.
#
# board-2.bin is a plain file, so it takes precedence over the compressed
# board-2.bin.zst linux-firmware-ath10k installs at the same path: the
# firmware loader tries the uncompressed name first, and apk sees two
# different files. linux-firmware has no board data for this phone.
maintainer="Bruno Gregorio <accounts@bruno.pw>"
pkgname=firmware-sony-pdx246
pkgver=1
pkgrel=0
pkgdesc="Firmware for Sony Xperia 10 VI"
url="https://postmarketos.org"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
subpackages="
	$pkgname-adreno
	$pkgname-adsp
	$pkgname-cdsp
	$pkgname-hexagonfs
	$pkgname-wlan
	"
source="
	a710_sqe.fw
	a710_zap.mbn
	adsp.mbn
	board-2.bin
	cdsp.mbn
	gmu_gen70000.bin
	hexagonfs.tar
	wpss.mbn
	"

_fwdir="/usr/lib/firmware/qcom/sm6450/Sony/columbia"

package() {
	# The parent package is empty; the device package pulls the parts.
	mkdir -p "$pkgdir"
}

adreno() {
	pkgdesc="Sony Xperia 10 VI GPU firmware"

	install -Dm644 "$srcdir"/a710_sqe.fw "$srcdir"/gmu_gen70000.bin \
		-t "$subpkgdir"/usr/lib/firmware/qcom/
	install -Dm644 "$srcdir"/a710_zap.mbn -t "$subpkgdir/$_fwdir"/
}

adsp() {
	pkgdesc="Sony Xperia 10 VI ADSP firmware"

	install -Dm644 "$srcdir"/adsp.mbn -t "$subpkgdir/$_fwdir"/
}

cdsp() {
	pkgdesc="Sony Xperia 10 VI CDSP firmware"

	install -Dm644 "$srcdir"/cdsp.mbn -t "$subpkgdir/$_fwdir"/
}

hexagonfs() {
	pkgdesc="Sony Xperia 10 VI files hexagonrpcd serves the ADSP"

	# abuild unpacks the tar into $srcdir: sensors/ and socinfo/.
	mkdir -p "$subpkgdir"/usr/share/qcom/sm6450/Sony/columbia
	cp -R "$srcdir"/sensors "$srcdir"/socinfo \
		"$subpkgdir"/usr/share/qcom/sm6450/Sony/columbia/
	find "$subpkgdir"/usr/share/qcom -type d -exec chmod 0755 {} +
	find "$subpkgdir"/usr/share/qcom -type f -exec chmod 0644 {} +
}

wlan() {
	pkgdesc="Sony Xperia 10 VI WLAN firmware"

	install -Dm644 "$srcdir"/wpss.mbn -t "$subpkgdir/$_fwdir"/
	install -Dm644 "$srcdir"/board-2.bin \
		-t "$subpkgdir"/usr/lib/firmware/ath10k/WCN3990/hw1.0/
}
