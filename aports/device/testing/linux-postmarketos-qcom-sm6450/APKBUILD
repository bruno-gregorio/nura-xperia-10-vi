# Reference: <https://postmarketos.org/vendorkernel>
# Our own mainline kernel for the SM6450. docs/06-mainline.md is the long
# version: what each patch derives from and how it was checked.

maintainer="Bruno Gregorio <accounts@bruno.pw>"
_flavor="postmarketos-qcom-sm6450"
pkgname=linux-$_flavor
pkgver=6.18.55
pkgrel=51
pkgdesc="Mainline kernel for Qualcomm SM6450 (Snapdragon 6 Gen 1) devices"
arch="aarch64"
_carch="arm64"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	pmb:kconfigcheck-uefi
	"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	installkernel
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	python3
	rust
	rust-bindgen
	rust-src
	rustfmt
	zstd
"

_config="config-$_flavor.$arch"

# A stock kernel.org tarball plus our patches, rather than a fork on a git
# host: keeping the base a released tarball is what makes "based on 6.18.55"
# checkable by someone who has never seen this repository.
#
# The patches are three layers, each one diff that
# scripts/sync-kernel-patches.sh squashes out of a branch in out/linux.
# kernel/ in this repository has the same layers one commit per patch, with
# their reasoning; read those, not these.
#
# - backports.patch: upstream commits and postings this base predates, each
#   with its author and origin (kernel/backports/).
# - sm6450-mainline.patch: the SoC and board series for upstream
#   (kernel/patches/).
# - pdx246-bringup.patch: what does not go upstream as is: the bootloader's
#   ids, a USB PHY workaround, the panel's FLM setting, the QSEECOM TEE and
#   fingerprint drivers, and the Hi-846 modules' stock programs
#   (kernel/bringup/).
source="
	https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$pkgver.tar.xz
	$_config
	backports.patch
	sm6450-mainline.patch
	pdx246-bringup.patch
"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
	# Rust availability and compiler capability symbols depend on the native
	# build toolchain. Resolve them without an interactive configuration prompt.
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	# Two images, because two things might want to boot this kernel and they
	# disagree about the format:
	#
	# - Image, uncompressed, is what goes in the Android boot.img. That is
	#   the path this device actually boots today: aboot on pdx246 has never
	#   been shown to unpack a gzipped kernel, and the stock boot.img carries
	#   an uncompressed image, so this is the one that is known to work.
	#   boot-deploy picks it up as /boot/vmlinuz.
	# - vmlinuz.efi is the EFI zboot wrapper, for the day this boots through
	#   an EFI loader instead. Costs nothing to ship.
	install -Dm644 "$builddir/arch/$_carch/boot/Image" "$pkgdir/boot/vmlinuz"
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
		"$pkgdir/boot/linux.efi"

	# Alpine is usr-merged, so modules belong under /usr/lib/modules.
	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir/boot/" \
		INSTALL_MOD_PATH="$pkgdir/usr" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	# deviceinfo_dtb_mainline points here. Fail the build rather than ship a
	# boot image with no device tree in it, which is a silent black screen.
	test -f "$pkgdir/boot/dtbs/qcom/sm6450-sony-xperia-columbia-pdx246.dtb" \
		|| die "the pdx246 device tree was not installed"

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

