# Reference: <https://postmarketos.org/vendorkernel>
# Our own mainline kernel for the SM6450. docs/06-mainline.md is the long
# version: what each patch derives from and how it was checked.

maintainer="Bruno Gregorio <accounts@bruno.pw>"
_flavor="postmarketos-qcom-sm6450"
pkgname=linux-$_flavor
pkgver=6.18.55
pkgrel=36
pkgdesc="Mainline kernel for Qualcomm SM6450 (Snapdragon 6 Gen 1) devices"
arch="aarch64"
_carch="arm64"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	pmb:kconfigcheck-uefi
	"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	installkernel
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	python3
	zstd
"

_config="config-$_flavor.$arch"

# A stock kernel.org tarball plus our series, rather than a fork on a git
# host. There is no fork: the work only exists as patches here, and keeping
# the base a released tarball is what makes "based on 6.18.55" checkable by
# someone who has never seen this repository.
#
# sm6450-mainline.patch is the whole series squashed, written by
# scripts/sync-kernel-patches.sh out of the sm6450 branch in out/linux.
# kernel/patches/ in this repository has the same change one commit per
# patch; that is the copy to read, and the one that goes to the lists.
#
# bringup-milestones.patch is not part of that series and never will be. It
# is a debugging instrument for a board with no console: inert unless
# pmos.milestone is on the command line, and with it, it writes how far
# start_kernel and kernel_init got into panic_timeout, which the A/B retry
# counter turns into seconds on the host. docs/05-status.md has the decode.
# Drop it once the kernel reaches /init.
#
# backport-*.patch are upstream commits this base predates, carried
# unchanged apart from context: the Gunyah watchdog (07b9712339e3 and
# ca316e145c35, both in mainline since 2026). The OS runs as a Gunyah VM on
# this SoC and may not touch the MMIO watchdog, so this is the only watchdog
# it has. They are not ours and do not go into kernel/patches/.
#
# backport-0003 and backport-0004 are the panel, a Samsung SOFEF01-M driving
# an AMS605DK01: Marijn Suijten's binding, in mainline as 722f0707782b, and
# his driver as posted (v2, reviewed, not merged when this was written).
# sofef01-ams605dk01-vci-supply.patch is ours on top of that binding: it lets
# the AMS605DK01 have the vci supply the Xperia 10 VI's panel has. It belongs
# with his series, not ours, so it goes to him rather than to the lists on
# its own. bringup-sofef01-pdx246-flm.patch sends this phone's own FLM
# setting, 8f 27 27 where the driver has the Xperia 10 V's 8f 27 25, keyed on
# the machine compatible until it is known whether the difference matters.
#
# bringup-gunyah-wdt-start-at-boot.patch is ours, sits on top of them, and is
# another instrument that never goes upstream: with
# gunyah_wdt.start_at_boot=1 the watchdog starts at probe and the watchdog
# core feeds it until userspace takes over, so a kernel that hangs is reset by
# the hypervisor instead of waiting for someone to hold the buttons.
#
# bringup-gunyah-wdt-smccc-1-0.patch is ours too. qcom_scm registers the
# watchdog only once the hypervisor has answered the SMCCC vendor UID query
# with Gunyah's UUID, and makes that query with arm_smccc_1_1_invoke(), which
# below SMCCC v1.1 fails without calling anything. This firmware reports
# v1.0, so the watchdog was never registered. The patch asks again with a
# v1.0 call, and qcom_scm.force_gunyah_wdt=1 skips the question for the case
# where the hypervisor does not answer it either.
#
# backport-0005 to backport-0007 are the touchscreen, a FocalTech FT3519T:
# Yedaya Katsman's FT3518 binding and driver entry (9b352327add1 and
# 5383e76483dc) and Bhushan Shah's FT3519 binding, which falls back to the
# FT3518 (731c634ea95e). All three are in mainline since 2026, and edt-ft5x06
# needs nothing else for this chip.
#
# backport-0008 is Alexander Koskovich's fix for A7xx GPUs on SoCs without an
# LLCC, as posted (v7, reviewed, not merged when this was written), renamed
# back to 6.18's llc_mmio. Without it drm/msm leaves an error pointer where
# the cx_mem mapping should be, and the A710's first resume faults reading
# CX_MISC_TCM_RET_CNTL through it (round 69 in docs/05-status.md).
#
# backport-0009 is Mohammad Rafi Shaik's MI2S clock control for
# q6apm-lpass-dais, cc8495c1d45a in linux-next, with the one hunk that
# touched 6.18's q6i2s_ops redone by hand and the SENARY MI2S ports, which
# 6.18's bindings do not have yet, left out. The speaker amplifiers take their
# I2S bit clock from the SoC, and without it nothing turns that clock on.
# Our sc8280xp change uses its LPAIF_MI2S_BCLK.
#
# backport-0010 is Srinivas Kandagatla's port limit check, d49ee8faefec in
# linux-next, with USB_RX standing in for the SENARY MI2S ports 6.18 lacks.
# 6.18 sizes the q6apm DAI arrays at 127 entries, and QUINARY_MI2S_RX, the
# speaker port, is number 127.
source="
	https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$pkgver.tar.xz
	$_config
	sm6450-mainline.patch
	backport-0001-firmware-qcom-scm-Register-gunyah-watchdog-device.patch
	backport-0002-watchdog-Add-driver-for-Gunyah-Watchdog.patch
	bringup-milestones.patch
	bringup-gunyah-wdt-start-at-boot.patch
	bringup-gunyah-wdt-smccc-1-0.patch
	backport-0003-dt-bindings-display-panel-Describe-Samsung-SOFEF01-M-DDIC.patch
	backport-0004-drm-panel-Add-panel-driver-for-Samsung-SOFEF01-DDIC.patch
	sofef01-ams605dk01-vci-supply.patch
	bringup-sofef01-pdx246-flm.patch
	backport-0005-dt-bindings-input-edt-ft5x06-Add-FocalTech-FT3518.patch
	backport-0006-Input-edt-ft5x06-add-support-for-FocalTech-FT3518.patch
	backport-0007-dt-bindings-input-edt-ft5x06-Add-FocalTech-FT3519.patch
	bringup-dwc3-qcom-phy-reinit.patch
	backport-0008-drm-msm-adreno-set-cx_misc_mmio-regardless-of-LLCC.patch
	backport-0009-ASoC-qcom-q6apm-lpass-dais-Add-MI2S-clock-control.patch
	backport-0010-ASoC-qcom-common-validate-cpu-dai-id-during-parsing.patch
"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	# Two images, because two things might want to boot this kernel and they
	# disagree about the format:
	#
	# - Image, uncompressed, is what goes in the Android boot.img. That is
	#   the path this device actually boots today: aboot on pdx246 has never
	#   been shown to unpack a gzipped kernel, and the stock boot.img carries
	#   an uncompressed image, so this is the one that is known to work.
	#   boot-deploy picks it up as /boot/vmlinuz.
	# - vmlinuz.efi is the EFI zboot wrapper, for the day this boots through
	#   an EFI loader instead. Costs nothing to ship.
	install -Dm644 "$builddir/arch/$_carch/boot/Image" "$pkgdir/boot/vmlinuz"
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
		"$pkgdir/boot/linux.efi"

	# Alpine is usr-merged, so modules belong under /usr/lib/modules.
	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir/boot/" \
		INSTALL_MOD_PATH="$pkgdir/usr" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	# deviceinfo_dtb_mainline points here. Fail the build rather than ship a
	# boot image with no device tree in it, which is a silent black screen.
	test -f "$pkgdir/boot/dtbs/qcom/sm6450-sony-xperia-columbia-pdx246.dtb" \
		|| die "the pdx246 device tree was not installed"

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

