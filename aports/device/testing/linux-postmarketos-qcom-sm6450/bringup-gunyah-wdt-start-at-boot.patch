diff --git a/drivers/watchdog/gunyah_wdt.c b/drivers/watchdog/gunyah_wdt.c
index 49dfef4..31ff740 100644
--- a/drivers/watchdog/gunyah_wdt.c
+++ b/drivers/watchdog/gunyah_wdt.c
@@ -149,6 +149,23 @@ static int gunyah_wdt_restart(struct watchdog_device *wdd,
 	return 0;
 }
 
+/*
+ * Bring-up only, NOT FOR UPSTREAM.
+ *
+ * This phone has no console and nothing else that resets a kernel which has
+ * stopped: a hang sits there until someone holds the buttons, and the board
+ * is being brought up by a loop that runs unattended. With this set the
+ * watchdog starts at probe and is marked running, so the watchdog core
+ * keeps it fed from its own kthread until userspace opens it. A kernel that
+ * stops scheduling stops feeding it, and Gunyah resets the board.
+ * docs/05-status.md in the postmarketOS port for sony-pdx246 has the rest.
+ *
+ * Inert unless gunyah_wdt.start_at_boot=1 is on the command line.
+ */
+static bool start_at_boot;
+module_param(start_at_boot, bool, 0444);
+MODULE_PARM_DESC(start_at_boot, "Start at probe and let the watchdog core feed it until userspace opens it");
+
 static const struct watchdog_info gunyah_wdt_info = {
 	.identity = "Gunyah Watchdog",
 	.options = WDIOF_SETTIMEOUT
@@ -196,7 +213,15 @@ static int gunyah_wdt_probe(struct platform_device *pdev)
 	wdd->min_timeout = 1; /* seconds */
 	wdd->timeout = wdd->max_timeout;
 
-	gunyah_wdt_stop(wdd);
+	if (start_at_boot) {
+		ret = gunyah_wdt_start(wdd);
+		if (ret)
+			return dev_err_probe(dev, ret, "could not start at boot\n");
+		set_bit(WDOG_HW_RUNNING, &wdd->status);
+		dev_info(dev, "started at boot, timeout %us\n", wdd->timeout);
+	} else {
+		gunyah_wdt_stop(wdd);
+	}
 	platform_set_drvdata(pdev, wdd);
 	watchdog_set_restart_priority(wdd, 0);
 
