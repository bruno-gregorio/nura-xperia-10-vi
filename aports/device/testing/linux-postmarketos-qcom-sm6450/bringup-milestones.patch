+/*
+ * Bring-up instrument for a board with no usable console. NOT FOR UPSTREAM.
+ *
+ * docs/05-status.md in the postmarketOS port for sony-pdx246 has the full
+ * argument; the short version is that this phone has exactly one output
+ * channel. Its DRAM is scrubbed by the bootloader between boots, its UART is
+ * not broken out, and its panel is command mode so nothing pushes whatever a
+ * framebuffer console writes. What is left is the A/B retry counter: boot one
+ * slot, and how long the bootloader takes to give up and fall back to the
+ * other one is readable from the host. With panic=N the kernel chooses that
+ * duration, and seven attempts multiply it, so a number the kernel writes
+ * into panic_timeout arrives on the host as elapsed seconds.
+ *
+ * So panic_timeout is used here as a one-register output port. Each call
+ * below stores a different value, and whichever ran last before the panic is
+ * the furthest point the kernel reached. Nothing is printed and nothing is
+ * read back, which is the point: this works on a kernel that cannot print.
+ *
+ * Inert unless pmos.milestone is on the command line.
+ *
+ * pmos.milestone=N zooms in on the initcalls: from the Nth one on, each
+ * initcall stores 100 plus its distance from N, one second per initcall, for
+ * 64 of them, and 170 after that. The default 48 + seq/16 encoding finds the
+ * band; this finds the call, without a rebuild.
+ */
+static int pmos_milestone_on;
+static int pmos_initcall_seq;
+static int pmos_zoom_base = -1;
+
+static int __init pmos_milestone_setup(char *str)
+{
+	pmos_milestone_on = 1;
+	if (str && kstrtoint(str, 0, &pmos_zoom_base))
+		pmos_zoom_base = -1;
+	return 0;
+}
+early_param("pmos.milestone", pmos_milestone_setup);
+
+/*
+ * Deliberately not __init: the last two call sites run after free_initmem().
+ */
+static void pmos_milestone(int n)
+{
+	if (pmos_milestone_on)
+		panic_timeout = 2 * n;
+}
+
+/*
+ * Initcalls get their own range so a death inside do_initcalls() reads out as
+ * a position in the sequence rather than as "somewhere in do_basic_setup".
+ * The counter spans both do_pre_smp_initcalls() and do_basic_setup(), so the
+ * value is unique even though the two phases are far apart.
+ */
+static void pmos_milestone_initcall(void)
+{
+	int seq;
+
+	if (!pmos_milestone_on)
+		return;
+	seq = pmos_initcall_seq++;
+	if (pmos_zoom_base >= 0 && seq >= pmos_zoom_base)
+		panic_timeout = seq - pmos_zoom_base < 64 ?
+				100 + seq - pmos_zoom_base : 170;
+	else
+		panic_timeout = 48 + seq / 16;
+}
