Opt-in QSEE app diagnostic log using the published downstream RAM-buffer ABI.
Source: https://android.googlesource.com/kernel/msm/+/330705db41eb77d77476c5fccf3527f5db1d1525/drivers/firmware/qcom/tz_log.c

diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -5,6 +5,7 @@
  */
 
 #include <linux/arm-smccc.h>
+#include <linux/debugfs.h>
 #include <linux/bitfield.h>
 #include <linux/bits.h>
 #include <linux/cleanup.h>
@@ -1855,6 +1856,52 @@
 
 	return 0;
 }
+
+/* Opt-in diagnostic log, using the downstream QSEEOS register-log ABI.
+ * This is a kernel-owned RAM buffer, never a mapping of TZ/MMIO memory.
+ * SCM is built in and cannot be unbound; no unregister-log ABI exists, so
+ * a successfully registered buffer must remain allocated until reboot.
+ */
+static bool qseecom_log;
+module_param_named(qseecom_log, qseecom_log, bool, 0400);
+MODULE_PARM_DESC(qseecom_log, "Register a root-only QSEE app log until reboot");
+static struct debugfs_blob_wrapper qseecom_log_blob;
+
+static int __init qcom_scm_qseecom_log_init(void)
+{
+	struct qcom_scm_qseecom_resp res = {};
+	struct qcom_scm_desc desc = {};
+	void *buffer;
+	int ret;
+
+	if (!qseecom_log || !__scm)
+		return 0;
+	buffer = qcom_tzmem_alloc(__scm->mempool, SZ_32K, GFP_KERNEL);
+	if (!buffer)
+		return -ENOMEM;
+	memset(buffer, 0, SZ_32K);
+	desc.owner = QSEECOM_TZ_OWNER_QSEE_OS;
+	desc.svc = QSEECOM_TZ_SVC_APP_MGR;
+	desc.cmd = 6; /* REGISTER_LOG_BUF, downstream tz_log.c */
+	desc.arginfo = QCOM_SCM_ARGS(2, QCOM_SCM_RW, QCOM_SCM_VAL);
+	desc.args[0] = qcom_tzmem_to_phys(buffer);
+	desc.args[1] = SZ_32K;
+	mutex_lock(&qcom_scm_qseecom_call_lock);
+	ret = __qcom_scm_qseecom_call(&desc, &res);
+	mutex_unlock(&qcom_scm_qseecom_call_lock);
+	if (ret || res.result != QSEECOM_RESULT_SUCCESS) {
+		dev_warn(__scm->dev, "qseecom: log registration failed: %d/%lld\n",
+			 ret, res.result);
+		qcom_tzmem_free(buffer);
+		return ret ?: -EIO;
+	}
+	qseecom_log_blob.data = buffer;
+	qseecom_log_blob.size = SZ_32K;
+	debugfs_create_blob("qseecom-app-log", 0400, NULL, &qseecom_log_blob);
+	dev_info(__scm->dev, "qseecom: root-only app log registered\n");
+	return 0;
+}
+late_initcall(qcom_scm_qseecom_log_init);
 
 /* Registered listener services, protected by qcom_scm_qseecom_call_lock. */
 static LIST_HEAD(qcom_scm_qseecom_listeners);
