Reserve dynamic modem remote-filesystem buffers on pdx246.

--- a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
+++ b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
@@ -1196,3 +1196,20 @@
 };
 
 #include "pdx246-egisfp.dtsi"
+
+/* Stock allocates 0x280000 bytes dynamically for RMTFS client 1.
+ * Reserve a separate low-32-bit pool, with guard pages, for mainline's
+ * qcom_rmtfs_mem driver. No partition access is enabled by this node.
+ */
+&{/reserved-memory} {
+	rmtfs_mem: rmtfs {
+		compatible = "qcom,rmtfs-mem";
+		size = <0 0x282000>;
+		alignment = <0 0x1000>;
+		alloc-ranges = <0 0x80000000 0 0x80000000>;
+		no-map;
+		qcom,client-id = <1>;
+		qcom,vmid = <15>; /* QCOM_SCM_VMID_MSS_MSA */
+		qcom,use-guard-pages;
+	};
+};
