+ * video subdevice, then reset/power down and restore the normal 24 MHz.
+ */
+#define HI846_OTP_SIZE 5449
+static const struct {
+	u16 address, value;
+	u8 width, delay_ms, read;
+} hi846_otp_sequence[] = {
+	{ 0xa00, 0x0, 2, 0, 0 },
+	{ 0x2000, 0x0, 2, 10, 0 },
+	{ 0x2002, 0xff, 2, 0, 0 },
+	{ 0x2004, 0x0, 2, 0, 0 },
+	{ 0x2008, 0x3fff, 2, 0, 0 },
+	{ 0x23fe, 0xc056, 2, 0, 0 },
+	{ 0xa00, 0x0, 2, 0, 0 },
+	{ 0xe04, 0x12, 2, 0, 0 },
+	{ 0xf08, 0x2f04, 2, 0, 0 },
+	{ 0xf30, 0x1f, 2, 0, 0 },
+	{ 0xf36, 0x1f, 2, 10, 0 },
+	{ 0xf04, 0x3a00, 2, 0, 0 },
+	{ 0xf32, 0x25a, 2, 0, 0 },
+	{ 0xf38, 0x25a, 2, 0, 0 },
+	{ 0xf2a, 0x4124, 2, 0, 0 },
+	{ 0x6a, 0x100, 2, 0, 0 },
+	{ 0x4c, 0x100, 2, 0, 0 },
+	{ 0xa02, 0x1, 1, 0, 0 },
+	{ 0xa00, 0x0, 1, 10, 0 },
