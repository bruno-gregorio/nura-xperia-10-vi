new file mode 100644
index 000000000..e9190c45d
--- /dev/null
+++ b/rust/kernel/gpio.rs
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! GPIO consumer descriptors.
+//!
+//! C header: [`include/linux/gpio/consumer.h`](srctree/include/linux/gpio/consumer.h)
+
+use crate::{
+    bindings,
+    device::Device,
+    error::{from_err_ptr, to_result, Result},
+    prelude::*,
+};
+use core::ptr::NonNull;
+
+/// The direction a descriptor is requested with, and an output's initial value.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Flags {
+    /// An input.
+    In,
+    /// An output, initially inactive.
+    OutLow,
+    /// An output, initially active.
+    OutHigh,
+}
+
+impl Flags {
+    fn as_raw(self) -> bindings::gpiod_flags {
+        match self {
+            Self::In => bindings::gpiod_flags_GPIOD_IN,
+            Self::OutLow => bindings::gpiod_flags_GPIOD_OUT_LOW,
+            Self::OutHigh => bindings::gpiod_flags_GPIOD_OUT_HIGH,
+        }
+    }
+}
+
+/// An exclusively requested GPIO descriptor.
+///
+/// Values are logical: they follow the active polarity in the firmware
+/// description. The descriptor is not device-managed. It is released when
+/// dropped, so its owner decides how long the line stays requested.
+///
+/// # Invariants
+///
+/// `self.0` was acquired by `gpiod_get` and has not been released.
+pub struct Desc(NonNull<bindings::gpio_desc>);
+
+// SAFETY: A descriptor is not tied to the task that requested it.
+unsafe impl Send for Desc {}
+
+// SAFETY: Every method takes `&self`, and gpiolib serialises access to a line.
+unsafe impl Sync for Desc {}
+
+impl Desc {
+    /// Requests the GPIO of `dev` that firmware names `con_id`.
+    pub fn get(dev: &Device, con_id: &CStr, flags: Flags) -> Result<Self> {
+        // SAFETY: `dev` is a valid device and `con_id` is NUL-terminated.
+        let desc = from_err_ptr(unsafe {
+            bindings::gpiod_get(dev.as_raw(), con_id.as_char_ptr(), flags.as_raw())
+        })?;
+        // INVARIANT: `gpiod_get` succeeded; it reports failure only by error pointer.
+        NonNull::new(desc).map(Self).ok_or(ENOENT)
+    }
+
+    /// Reads the logical value. May sleep.
+    pub fn value_cansleep(&self) -> Result<bool> {
+        // SAFETY: By the type invariant, `self.0` is a requested descriptor.
+        let ret = unsafe { bindings::gpiod_get_value_cansleep(self.0.as_ptr()) };
+        to_result(ret)?;
+        Ok(ret != 0)
+    }
+
+    /// Sets the logical value of an output. May sleep.
+    pub fn set_value_cansleep(&self, value: bool) -> Result {
+        // SAFETY: By the type invariant, `self.0` is a requested descriptor.
+        to_result(unsafe { bindings::gpiod_set_value_cansleep(self.0.as_ptr(), value.into()) })
+    }
+}
+
+impl Drop for Desc {
+    fn drop(&mut self) {
+        // SAFETY: By the type invariant, `self.0` is requested; this releases it once.
+        unsafe { bindings::gpiod_put(self.0.as_ptr()) };
+    }
+}
