+static bool qcom_mdt_bins_are_split(const struct firmware *fw)
+{
+	const struct elf32_phdr *phdrs;
+	const struct elf32_hdr *ehdr;
+	uint64_t seg_start, seg_end;
+	int i;
+
+	ehdr = (struct elf32_hdr *)fw->data;
+	phdrs = (struct elf32_phdr *)(fw->data + ehdr->e_phoff);
+
+	for (i = 0; i < ehdr->e_phnum; i++) {
+		/*
+		 * The size of the MDT file is not padded to include any
+		 * zero-sized segments at the end. Ignore these, as they should
+		 * not affect the decision about image being split or not.
+		 */
+		if (!phdrs[i].p_filesz)
+			continue;
+
+		seg_start = phdrs[i].p_offset;
+		seg_end = phdrs[i].p_offset + phdrs[i].p_filesz;
+		if (seg_start > fw->size || seg_end > fw->size)
+			return true;
+	}
+
+	return false;
+}
+
+/* Contiguous QSEECom images may be ELF32 or ELF64. Keep this parser
+ * separate from the ELF32 remoteproc loader: the physical layout and
+ * validation contract of those existing users are unchanged.
+ */
+struct mdt_image_headers {
+	u64 phoff;
+	u16 count;
+	bool elf64;
+};
+
+static int mdt_image_headers(const struct firmware *fw,
+			     struct mdt_image_headers *h)
+{
+	u16 entry_size;
+	u64 end;
+
+	if (fw->size < EI_NIDENT || memcmp(fw->data, ELFMAG, SELFMAG) ||
+	    fw->data[EI_DATA] != ELFDATA2LSB || fw->data[EI_VERSION] != EV_CURRENT)
+		return -EINVAL;
+
+	h->elf64 = fw->data[EI_CLASS] == ELFCLASS64;
+	if (h->elf64) {
+		const struct elf64_hdr *eh = (const void *)fw->data;
+
+		if (fw->size < sizeof(*eh) || eh->e_ehsize != sizeof(*eh))
+			return -EINVAL;
+		h->phoff = eh->e_phoff;
+		h->count = eh->e_phnum;
+		entry_size = sizeof(struct elf64_phdr);
+		if (eh->e_phentsize != entry_size || h->phoff < sizeof(*eh))
+			return -EINVAL;
+	} else if (fw->data[EI_CLASS] == ELFCLASS32) {
+		const struct elf32_hdr *eh = (const void *)fw->data;
+
+		if (fw->size < sizeof(*eh) || eh->e_ehsize != sizeof(*eh))
+			return -EINVAL;
+		h->phoff = eh->e_phoff;
+		h->count = eh->e_phnum;
+		entry_size = sizeof(struct elf32_phdr);
+		if (eh->e_phentsize != entry_size || h->phoff < sizeof(*eh))
+			return -EINVAL;
+	} else {
+		return -EINVAL;
+	}
+
+	/* Split filenames have two decimal digits, b00 through b99. */
+	if (!h->count || h->count > 100 || h->phoff > fw->size)
+		return -EINVAL;
+	end = h->phoff + (u64)h->count * entry_size;
+	return end > fw->size ? -EINVAL : 0;
+}
+
+static void mdt_image_segment(const struct firmware *fw,
+			      const struct mdt_image_headers *h, unsigned int i,
+			      u64 *offset, u64 *size)
+{
+	if (h->elf64) {
+		const struct elf64_phdr *ph = (const void *)(fw->data + h->phoff);
+
+		*offset = ph[i].p_offset;
+		*size = ph[i].p_filesz;
+	} else {
+		const struct elf32_phdr *ph = (const void *)(fw->data + h->phoff);
+
+		*offset = ph[i].p_offset;
+		*size = ph[i].p_filesz;
+	}
+}
+
+static bool mdt_image_split(const struct firmware *fw,
+			    const struct mdt_image_headers *h)
+{
+	u64 offset, size;
+	unsigned int i;
+
+	for (i = 0; i < h->count; i++) {
+		mdt_image_segment(fw, h, i, &offset, &size);
+		if (size && (offset > fw->size || size > fw->size - offset))
+			return true;
+	}
+	return false;
+}
+
+/**
+ * qcom_mdt_get_image_size() - size of a contiguous QSEECom firmware image
+ * @fw: ELF32 or ELF64 metadata (or complete unsplit image)
+ *
+ * Split layout is metadata followed by every nonempty segment in program
+ * header order, including the header and hash segments a second time.
+ * Return: required bytes, or a negative error.
+ */
+ssize_t qcom_mdt_get_image_size(const struct firmware *fw)
+{
+	struct mdt_image_headers h;
+	u64 offset, size, total = fw->size;
+	unsigned int i;
+	int ret = mdt_image_headers(fw, &h);
+
+	if (ret)
+		return ret;
+	if (!mdt_image_split(fw, &h))
+		return fw->size > SSIZE_MAX ? -EFBIG : fw->size;
+	for (i = 0; i < h.count; i++) {
+		mdt_image_segment(fw, &h, i, &offset, &size);
+		if (size > SSIZE_MAX || total > SSIZE_MAX - size)
+			return -EFBIG;
+		total += size;
+	}
+	return total;
+}
+EXPORT_SYMBOL_GPL(qcom_mdt_get_image_size);
+
+/**
+ * qcom_mdt_read_image() - assemble an authenticated QSEECom image
+ * @dev: requesting device
+ * @fw: validated ELF32/ELF64 metadata
+ * @fw_name: metadata filename ending in .mdt
+ * @mem: destination
+ * @mem_size: destination capacity
+ *
+ * This only reads firmware. Authentication remains the secure loader's job.
+ * Return: assembled bytes, or a negative error.
+ */
+ssize_t qcom_mdt_read_image(struct device *dev, const struct firmware *fw,
+			  const char *fw_name, void *mem, size_t mem_size)
+{
+	struct mdt_image_headers h;
+	const struct firmware *segment;
+	char *name;
+	u64 offset, size;
+	size_t used, name_len;
+	unsigned int i;
+	ssize_t total = qcom_mdt_get_image_size(fw);
+	int ret;
+
+	if (total < 0)
+		return total;
+	if (mem_size < total)
+		return -ENOSPC;
+	ret = mdt_image_headers(fw, &h);
+	if (ret)
+		return ret;
+	memcpy(mem, fw->data, fw->size);
+	if (!mdt_image_split(fw, &h))
+		return fw->size;
+	name_len = strlen(fw_name);
+	if (name_len < 4 || strcmp(fw_name + name_len - 4, ".mdt"))
+		return -EINVAL;
+	name = kstrdup(fw_name, GFP_KERNEL);
+	if (!name)
+		return -ENOMEM;
+	used = fw->size;
+	for (i = 0; i < h.count; i++) {
+		mdt_image_segment(fw, &h, i, &offset, &size);
+		if (!size)
+			continue;
+		snprintf(name + name_len - 3, 4, "b%02u", i);
+		ret = request_firmware(&segment, name, dev);
+		if (ret)
+			goto out;
+		if (segment->size != size) {
+			release_firmware(segment);
+			ret = -EINVAL;
+			goto out;
+		}
+		memcpy(mem + used, segment->data, size);
+		used += size;
+		release_firmware(segment);
+	}
+	kfree(name);
+	return used;
+out:
+	kfree(name);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_mdt_read_image);
+
