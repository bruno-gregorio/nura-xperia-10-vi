diff --git a/Documentation/devicetree/bindings/interconnect/qcom,sm6450-rpmh.yaml b/Documentation/devicetree/bindings/interconnect/qcom,sm6450-rpmh.yaml
new file mode 100644
index 000000000..26fb5c1c8
--- /dev/null
+++ b/Documentation/devicetree/bindings/interconnect/qcom,sm6450-rpmh.yaml
@@ -0,0 +1,136 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interconnect/qcom,sm6450-rpmh.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm RPMh Network-On-Chip Interconnect on SM6450
+
+maintainers:
+  - Bruno Gregório <accounts@bruno.pw>
+
+description: |
+  RPMh interconnect providers support system bandwidth requirements through
+  RPMh hardware accelerators known as Bus Clock Manager (BCM). The provider is
+  able to communicate with the BCM through the Resource State Coordinator (RSC)
+  associated with each execution environment. Provider nodes must point to at
+  least one RPMh device child node pertaining to their RSC and each provider
+  can map to multiple RPMh resources.
+
+  See also: include/dt-bindings/interconnect/qcom,sm6450-rpmh.h
+
+properties:
+  compatible:
+    enum:
+      - qcom,sm6450-aggre1-noc
+      - qcom,sm6450-aggre2-noc
+      - qcom,sm6450-clk-virt
+      - qcom,sm6450-cnoc2
+      - qcom,sm6450-cnoc3
+      - qcom,sm6450-gem-noc
+      - qcom,sm6450-lpass-ag-noc
+      - qcom,sm6450-mc-virt
+      - qcom,sm6450-mmss-noc
+      - qcom,sm6450-nsp-noc
+      - qcom,sm6450-pcie-anoc
+      - qcom,sm6450-system-noc
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    minItems: 1
+    maxItems: 2
+
+required:
+  - compatible
+
+allOf:
+  - $ref: qcom,rpmh-common.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - qcom,sm6450-clk-virt
+              - qcom,sm6450-mc-virt
+    then:
+      properties:
+        reg: false
+    else:
+      required:
+        - reg
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - qcom,sm6450-aggre1-noc
+    then:
+      properties:
+        clocks:
+          items:
+            - description: aggre UFS PHY AXI clock
+            - description: aggre USB3 PRIM AXI clock
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - qcom,sm6450-aggre2-noc
+    then:
+      properties:
+        clocks:
+          items:
+            - description: RPMH CC IPA clock
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - qcom,sm6450-pcie-anoc
+    then:
+      properties:
+        clocks:
+          items:
+            - description: aggre-NOC PCIe AXI clock
+            - description: cfg-NOC PCIe a-NOC AHB clock
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - qcom,sm6450-aggre1-noc
+              - qcom,sm6450-aggre2-noc
+              - qcom,sm6450-pcie-anoc
+    then:
+      required:
+        - clocks
+    else:
+      properties:
+        clocks: false
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,sm6450-gcc.h>
+
+    interconnect-0 {
+        compatible = "qcom,sm6450-clk-virt";
+        #interconnect-cells = <2>;
+        qcom,bcm-voters = <&apps_bcm_voter>;
+    };
+
+    interconnect@16e0000 {
+        compatible = "qcom,sm6450-aggre1-noc";
+        reg = <0x016e0000 0x1c080>;
+        #interconnect-cells = <2>;
+        clocks = <&gcc GCC_AGGRE_UFS_PHY_AXI_CLK>,
+                 <&gcc GCC_AGGRE_USB3_PRIM_AXI_CLK>;
+        qcom,bcm-voters = <&apps_bcm_voter>;
+    };
