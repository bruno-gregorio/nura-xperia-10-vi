+#include "pm6150l.dtsi"
+#include "pmk8350.dtsi"
+
+/ {
+	model = "Sony Xperia 10 VI";
+	compatible = "sony,pdx246", "qcom,sm6450";
+	chassis-type = "handset";
+
+	aliases {
+		serial0 = &uart3;
+		serial1 = &uart11;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&vol_down_n>;
+
+		key-volume-down {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&pm6450_gpios 1 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * The charger and the Type-C port controller, a PM7250B, sit on an
+	 * SPMI bus the ADSP owns, so the port is reached through it. The
+	 * port is wired for USB 2.0 only.
+	 */
+	pmic-glink {
+		compatible = "qcom,sm6450-pmic-glink", "qcom,pmic-glink";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_1_dwc3_hs>;
+					};
+				};
+			};
+		};
+	};
+
+	/*
+	 * The panel's 1.8V logic supply is switched on by driving PM6150L
+	 * GPIO 9 low. With it the other way round the panel still takes
+	 * writes, but sends neither TE nor a read reply.
+	 */
+	panel_vddio_1p8: regulator-panel-vddio {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vddio_1p8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+
+		gpio = <&pm6150l_gpios 9 GPIO_ACTIVE_LOW>;
+		startup-delay-us = <233>;
+
+		pinctrl-0 = <&panel_vddio_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+
+	ts_avdd: regulator-ts-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "ts_avdd";
+		gpio = <&tlmm 103 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
