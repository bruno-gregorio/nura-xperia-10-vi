# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: gki_defconfig + vendor/parrot_GKI.config
#                         + vendor/sony/columbia.config + pmos.config

maintainer="Bruno Gregorio <accounts@bruno.pw>"
pkgname=linux-sony-pdx246
pkgver=5.10.269
pkgrel=0
pkgdesc="Sony Xperia 10 VI kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="sony-pdx246"
url="https://github.com/johanneszab/android_kernel_sony_sm6450"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"

makedepends="
	bash
	bc
	bison
	clang
	devicepkg-dev
	findutils
	flex
	kmod
	linux-headers
	lld
	llvm
	openssl-dev
	perl
	python3
	rsync
	xz
"

# Sony's 5.10 release for this device, as carried by the LineageOS pdx246 port:
# LineageOS's Sony sm8450 5.10 fork with pdx246's drivers and Sony's config on
# top. The device trees are Sony's separate copyleft release and are a second
# tarball because upstream keeps them in their own repository.
_gh="https://github.com/johanneszab"
_kernel_repo="android_kernel_sony_sm6450"
_kernel_commit="03a594e6c40a35ee47791286e9e9eed91480add2"
_dt_repo="android_kernel_sony_sm6450-devicetrees"
_dt_commit="958dce5aaab6c58df7573843e85398b477d8dc62"

source="
	$pkgname-$_kernel_commit.tar.gz::$_gh/$_kernel_repo/archive/$_kernel_commit.tar.gz
	$pkgname-dt-$_dt_commit.tar.gz::$_gh/$_dt_repo/archive/$_dt_commit.tar.gz
	pmos.config
"
builddir="$srcdir/$_kernel_repo-$_kernel_commit"

prepare() {
	default_prepare

	# arch/arm64/boot/dts/vendor is a symlink to a sibling checkout that only
	# exists inside an Android repo tree, so it dangles here. Replace it with
	# Sony's device tree release. arch/arm64/boot/dts/Makefile keys off
	# vendor/Makefile: once it exists, only the vendor tree is built, which is
	# what we want - the stock qcom/ directory has no parrot support.
	rm -f "$builddir/arch/$_carch/boot/dts/vendor"
	mv "$srcdir/$_dt_repo-$_dt_commit" "$builddir/arch/$_carch/boot/dts/vendor"

	# With CONFIG_BUILD_ARM64_DT_OVERLAY=y the vendor device tree Makefile
	# fills in dtbo-y only, and scripts/Makefile.dtbo builds parrot.dtb purely
	# as a dependency of the overlays that name it in -base. That is the DTB we
	# boot (the bootloader applies the stock parrot-qrd overlay to it), but
	# scripts/Makefile.dtbinst installs $(dtb-y), which is empty here. Name it
	# so that dtbs_install actually puts it in the package. These lines land
	# after the Makefile's own "always-y := $(dtb-y)", hence the second one.
	cat >> "$builddir/arch/$_carch/boot/dts/vendor/qcom/Makefile" <<-EOF

		# postmarketOS: install the base DTB we boot from.
		dtb-\$(CONFIG_ARCH_PARROT) += parrot.dtb
		always-\$(CONFIG_ARCH_PARROT) += parrot.dtb
	EOF

	# Qualcomm wraps $(CC) in scripts/basic/cc-wrapper, which reads the
	# compiler's stderr and fails the build on any warning not in a
	# three-entry allowlist. That only holds with the exact Clang Google
	# pinned for android12-5.10 (r416183b, Clang 12); with Alpine's Clang the
	# first new warning kills the build, and the error it prints does not say
	# why. Drop the wrapper.
	grep -q '^CC := scripts/basic/cc-wrapper ' "$builddir/Makefile" \
		|| die "cc-wrapper hook moved, re-check the top-level Makefile"
	sed -i 's|^CC := scripts/basic/cc-wrapper ||' "$builddir/Makefile"

	# Same reason: drop -Werror wherever the tree hardcodes it. The whole
	# token has to go - a bare 's/-Werror//' would leave "-Werror=implicit-int"
	# as the nonsense argument "=implicit-int".
	local i
	for i in $(find "$builddir" -type f \( -name Makefile -o -name Kbuild \)); do
		sed -i -E -e 's/-Werror-/-W/g' -e 's/-Werror(=[A-Za-z0-9_,=-]+)?//g' "$i"
	done

	make ARCH="$_carch" LLVM=1 gki_defconfig
	./scripts/kconfig/merge_config.sh -m -O . .config \
		"arch/$_carch/configs/vendor/parrot_GKI.config" \
		"arch/$_carch/configs/vendor/sony/columbia.config" \
		"$srcdir/pmos.config"
	make ARCH="$_carch" LLVM=1 olddefconfig
}

# Google pinned Clang 12 for this tree; Alpine ships Clang 20+. A decade of new
# diagnostics sits in between and several of them default to errors. None are
# actionable for a port, so downgrade the lot to warnings.
# -Wno-unknown-warning-option has to come first: scripts/Makefile.clang appends
# -Werror=unknown-warning-option, which would turn every name below that this
# particular Clang has never heard of into a hard error.
_kcflags="-Wno-error
	-Wno-unknown-warning-option
	-Wno-error=unknown-warning-option
	-Wno-error=array-bounds
	-Wno-error=array-parameter
	-Wno-error=bitwise-instead-of-logical
	-Wno-error=cast-function-type-mismatch
	-Wno-error=deprecated-non-prototype
	-Wno-error=enum-constexpr-conversion
	-Wno-error=format
	-Wno-error=gnu-variable-sized-type-not-at-end
	-Wno-error=implicit-function-declaration
	-Wno-error=implicit-int
	-Wno-error=incompatible-function-pointer-types
	-Wno-error=incompatible-pointer-types
	-Wno-error=int-conversion
	-Wno-error=misleading-indentation
	-Wno-error=pointer-bool-conversion
	-Wno-error=return-type
	-Wno-error=single-bit-bitfield-constant-conversion
	-Wno-error=sometimes-uninitialized
	-Wno-error=strict-prototypes
	-Wno-error=unterminated-string-initialization
	-Wno-error=unused-but-set-variable
	-Wno-error=unused-command-line-argument
	-Wno-error=void-pointer-to-enum-cast"

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KCFLAGS="$(echo $_kcflags)" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" \
		Image dtbs modules
}

package() {
	install -Dm644 "$builddir/arch/$_carch/boot/Image" "$pkgdir/boot/vmlinuz"

	# Alpine is usr-merged, so modules belong under /usr/lib/modules.
	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		KCFLAGS="$(echo $_kcflags)" \
		INSTALL_PATH="$pkgdir/boot/" \
		INSTALL_MOD_PATH="$pkgdir/usr" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	# deviceinfo_dtb points here; fail the build rather than ship a boot.img
	# with no device tree in it.
	test -f "$pkgdir/boot/dtbs/vendor/qcom/parrot.dtb" \
		|| die "parrot.dtb was not installed, check the vendor dts Makefile"

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

