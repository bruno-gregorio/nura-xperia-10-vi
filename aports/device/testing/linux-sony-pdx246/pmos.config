# postmarketOS requirements on top of
#   gki_defconfig + vendor/parrot_GKI.config + vendor/sony/columbia.config
# (the three fragments the LineageOS pdx246 port builds with).
#
# Everything here is either required by "pmbootstrap kconfig check" or needed
# because we boot a Linux userspace instead of Android.

# --- toolchain -------------------------------------------------------------
# gki_defconfig turns on full LTO, CFI and the shadow call stack. They cost a
# lot of build time and RAM and they are not needed for bring-up; the whole
# kernel including every out-of-tree module is built here in one go, so there
# is no ABI to keep compatible with a prebuilt.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set

# gki_defconfig builds full DWARF4. That is the single biggest cost in both
# build time and module size here, and kallsyms is enough to read a backtrace.
# Turn it back on the day something actually needs DWARF.
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_BTF is not set

# --- modules ---------------------------------------------------------------
# The vendor modules are built from this same tree and shipped unsigned in the
# initramfs and /lib/modules; GKI's module signing would only get in the way.
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_MODULE_COMPRESS=n
# Android ships modules named exactly as modules.load lists them.
CONFIG_MODVERSIONS=n
CONFIG_TRIM_UNUSED_KSYMS=n

# --- console / framebuffer -------------------------------------------------
# gki_defconfig has no VT and no fbdev at all: Android draws through
# SurfaceFlinger. A Linux userspace needs a console and an fbdev to fall back
# on, and pmbootstrap's kconfig check requires all of these.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_HW_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
# The stock cmdline asks for a virtual framebuffer (video=vfb:...). It would
# claim /dev/fb0 ahead of the real display and pmOS refuses it outright.
# CONFIG_FB_VIRTUAL is not set

# --- pmOS "category:default" ----------------------------------------------
# CONFIG_ANDROID_PARANOID_NETWORK is not set
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_CGROUPS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_XTS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DM_CRYPT=y
CONFIG_INPUT_EVDEV=y
CONFIG_NLS_ASCII=y
CONFIG_SYN_COOKIES=y
CONFIG_SYSVIPC=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_UEVENT_HELPER=y
CONFIG_USER_NS=y
CONFIG_VFAT_FS=y
CONFIG_RD_ZSTD=y
CONFIG_DECOMPRESS_ZSTD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y

# --- rootfs ----------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_DM_VERITY=n
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y

# --- early debugging -------------------------------------------------------
# Without a display driver the first boots are blind; keep every log path open
# so that a console ramoops dump or a serial cable can be read back.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y

# The debug UART has to be builtin, not a module. earlycon is wired up by
# OF_EARLYCON_DECLARE, which only exists in vmlinux, and a console that first
# appears when modules load is no use for the part of boot we cannot see.
# parrot.dtb has the port at 0x98c000 (compatible "qcom,msm-geni-console",
# status "ok") and already asks for it in chosen/bootargs as console=ttyMSM0.
# SERIAL_MSM_GENI depends on MSM_GENI_SE, so that has to come along; leaving it
# at =m is what silently demoted all three to modules last time round. Both
# names are dropped from modules-initfs to match.
CONFIG_MSM_GENI_SE=y
CONFIG_SERIAL_MSM_GENI=y
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# ramoops needs nothing flashed and no cable: parrot.dtb reserves
# ramoops_region@ffd00000 (768K, 256K of it console, 256K pmsg) with a
# compatible of "ramoops", so PSTORE_RAM binds to it on its own and the
# previous boot's console log is readable from /sys/fs/pstore after a reboot.
# This is the primary way to see why a blind boot died.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y
