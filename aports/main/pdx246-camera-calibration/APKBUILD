# Camera tuning for the Xperia 10 VI's modules, calibrated per unit.
#
# libcamera keys its tuning files by sensor, but these are Sony's tuning for
# the modules in this phone: the IMX582 main camera and the two Hi-846s. So
# they go in /etc/libcamera/ipa/simple, which libcamera searches before its
# own files in /usr/share, and libcamera's generic hi846.yaml stays as it is
# for other phones with that sensor.
#
# Each Hi-846 module also stores its own lens shading in OTP, which the
# kernel driver publishes as NVMEM. pdx246-camera-calibrate scales the module
# tuning to it at boot and writes the result to /run, where the two Hi-846
# links point; a sensor it cannot calibrate gets the module tuning as is.
# hi846*.json hold the golden sample's shading and the green weights, from
# Sony's stock tuning; scripts/camera-low-light.py imports both them and the
# tuning files from it.
maintainer="Bruno Gregorio <accounts@bruno.pw>"
pkgname=pdx246-camera-calibration
pkgver=1
pkgrel=4
pkgdesc="Xperia 10 VI camera tuning, calibrated per unit from the Hi-846 OTP"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
depends="python3 py3-yaml"
options="!check"
source="
	pdx246-camera-calibrate
	hi846_otp.py
	hi846.yaml
	hi846.json
	hi846-front.yaml
	hi846-front.json
	imx582.yaml
	pdx246-camera-calibration.service
	90-pdx246-camera-calibration.preset
	"

package() {
	local data=/usr/share/$pkgname
	local tuning=/etc/libcamera/ipa/simple

	install -Dm755 "$srcdir"/pdx246-camera-calibrate -t "$pkgdir"/usr/bin/
	install -Dm644 "$srcdir"/hi846_otp.py -t "$pkgdir"/usr/lib/$pkgname/
	install -Dm644 "$srcdir"/hi846.yaml "$srcdir"/hi846.json \
		"$srcdir"/hi846-front.yaml "$srcdir"/hi846-front.json \
		-t "$pkgdir"$data/
	install -Dm644 "$srcdir"/imx582.yaml -t "$pkgdir"$tuning/
	for name in hi846 hi846-front; do
		ln -s /run/$pkgname/simple/$name.yaml "$pkgdir"$tuning/$name.yaml
	done

	install -Dm644 "$srcdir"/pdx246-camera-calibration.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/90-pdx246-camera-calibration.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
}
