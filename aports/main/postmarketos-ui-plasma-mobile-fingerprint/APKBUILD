# Bring-up target for the Xperia's future fprintd-compatible Egis backend.
maintainer="Bruno Gregório <accounts@bruno.pw>"
pkgname=postmarketos-ui-plasma-mobile-fingerprint
pkgver=0.1
pkgrel=0
pkgdesc="Plasma Mobile fingerprint enrollment and screen-lock integration"
url="https://invent.kde.org/plasma/plasma-mobile"
arch="noarch"
license="MIT"
depends="postmarketos-ui-plasma-mobile plasma-workspace fprintd fprintd-pam"
# systemd-edge's kscreenlocker currently ships Fedora's PAM includes
# fingerprint-auth/postlogin and SELinux modules, absent in this rootfs.
# Own just its fingerprint stack with Alpine's base-account/base-session.
replaces="kscreenlocker"
source="kde-fingerprint fingerprint-settings.desktop"
options="!check"

package() {
	install -Dm644 "$srcdir"/kde-fingerprint "$pkgdir"/etc/pam.d/kde-fingerprint
	install -Dm644 "$srcdir"/fingerprint-settings.desktop \
		"$pkgdir"/usr/share/applications/fingerprint-settings.desktop
}
