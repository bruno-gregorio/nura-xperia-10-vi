 include/qsee_supplicant.h |  3 ++
 src/services.c            |  1 +
 src/time.c                | 80 +++++++++++++++++++++++++++++++++++++++
 tests/test_protocol.c     | 15 ++++++++
 5 files changed, 100 insertions(+), 1 deletion(-)
 create mode 100644 src/time.c

