# Maintainer: Bruno Gregório <accounts@bruno.pw>
#
# Qualcomm's client library for the mainline qcomtee driver, and its test
# client, for the Xperia 10 VI's fingerprint work. The patch adds -o to the
# test client, which opens services by UID and releases them at once, to
# find out what this phone's QTEE lets a Linux client reach.
pkgname=quic-teec
pkgver=1.0.2
pkgrel=0
pkgdesc="Qualcomm TEE client library (libqcomtee)"
url="https://github.com/quic/quic-teec"
arch="aarch64"
license="BSD-3-Clause"
makedepends="cmake samurai libcbor-dev linux-headers"
subpackages="$pkgname-dev $pkgname-tests"
source="$pkgname-$pkgver.tar.gz::https://github.com/quic/quic-teec/archive/refs/tags/v$pkgver.tar.gz
	0001-tests-Open-and-release-services-by-UID.patch
	"
# The tests need the phone's QTEE.
options="!check"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_SKIP_RPATH=ON \
		-DBUILD_SHARED_LIBS=ON \
		-DBUILD_UNITTEST=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm755 build/tests/qcomteetest "$pkgdir"/usr/bin/qcomteetest
}

tests() {
	pkgdesc="$pkgdesc (test client)"

	amove usr/bin/qcomteetest
}
sha512sums="
