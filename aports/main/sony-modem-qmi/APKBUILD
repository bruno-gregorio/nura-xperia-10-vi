# Maintainer: Bruno Gregório <accounts@bruno.pw>
#
# Sony's modem firmware wants three QMI services of Android. It reads units
# of the trim area (TA) partition over 0xe3 and 0xe4, which Sony's
# /vendor/bin/ta_qmi_service serves, and its SIM manager logs to 0xe6,
# /vendor/bin/mlog_qmi_service's. Without the first two the modem's data side
# never starts (no DMS); without the third the UIM service never registers,
# so no SIM is read. This is our own implementation of all three, written
# from the stock binaries' and the modem's IDL tables and tad's partition
# format; docs/05-status.md has how they were read.
#
# It opens the partition read-only and keeps whatever the modem writes in
# memory, as upstream's rmtfs.service (-r) does for the modem's own storage.
pkgname=sony-modem-qmi
pkgver=0.1
pkgrel=0
pkgdesc="QMI services Sony's modem expects of the AP: trim area and logging"
url="https://github.com/bruno-gregorio/nura-xperia-10-vi"
arch="all"
license="BSD-3-Clause"
makedepends="linux-headers qrtr-dev"
subpackages="$pkgname-openrc $pkgname-systemd:systemd"
source="
	qmi_sony.c
	qmi_sony.h
	sony-modem-qmi.c
	sony-modem-qmi.initd
	sony-modem-qmi.service
	ta.c
	ta.h
	ta_raw.c
	ta_raw.h
	"
builddir="$srcdir"
options="!check"

build() {
	${CC:-cc} $CFLAGS -Wall -Wextra -Wno-unused-parameter \
		-o sony-modem-qmi \
		sony-modem-qmi.c qmi_sony.c ta.c ta_raw.c \
		$LDFLAGS -lqrtr
}

package() {
	install -Dm755 sony-modem-qmi -t "$pkgdir"/usr/bin/
	install -Dm755 sony-modem-qmi.initd "$pkgdir"/etc/init.d/sony-modem-qmi
	install -Dm644 sony-modem-qmi.service \
		-t "$pkgdir"/usr/lib/systemd/system/
}

systemd() {
	pkgdesc="$pkgdesc (systemd service)"
	depends="systemd"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	amove usr/lib/systemd/system
}

