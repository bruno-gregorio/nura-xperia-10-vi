+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Bruno Gregório
+ *
+ * Contrast detection autofocus
+ */
+
+#pragma once
+
+#include <optional>
+#include <stdint.h>
+#include <utility>
+#include <vector>
+
+#include <libcamera/control_ids.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Phase {
+		Coarse,
+		Fine,
+	};
+
+	void startScan(double brightness);
+	void stopScan(controls::AfStateEnum state);
+	void scan(double sharpness);
+	void finishScan();
+	void watch(double sharpness, double brightness);
+	void moveLens(int32_t position);
+	int32_t lensFromDioptres(float dioptres) const;
+	float dioptresFromLens(int32_t position) const;
+
+	/* Tuning */
+	controls::AfModeEnum defaultMode_ = controls::AfModeManual;
+	std::optional<int32_t> infinityTuned_;
+	std::optional<int32_t> macroTuned_;
+	float macroDioptres_ = 10.0f;
+	float defaultDioptres_ = 0.5f;
+	unsigned int coarseSteps_ = 10;
+	double minContrast_ = 0.1;
+	double rescanChange_ = 0.3;
+
+	/* Session */
+	bool hasLens_ = false;
+	int32_t lensMin_ = 0;
+	int32_t lensMax_ = 0;
+	int32_t infinity_ = 0;
+	int32_t macro_ = 0;
+	int32_t position_ = 0;
+
+	controls::AfModeEnum mode_ = controls::AfModeManual;
+	controls::AfStateEnum state_ = controls::AfStateIdle;
+	bool paused_ = false;
+	bool pauseDeferred_ = false;
+	bool scanRequested_ = false;
+	double lastBrightness_ = 0.0;
+	int32_t lastExposure_ = 0;
+	double lastGain_ = 0.0;
+	unsigned int lightSteady_ = 0;
+	double scanBrightness_ = 0.0;
+
+	bool scanning_ = false;
+	Phase phase_ = Phase::Coarse;
+	int32_t step_ = 0;
+	std::vector<int32_t> plan_;
+	std::size_t next_ = 0;
+	std::vector<std::pair<int32_t, double>> samples_;
+
+	bool watching_ = false;
+	double focusedSharpness_ = 0.0;
+	double focusedBrightness_ = 0.0;
+	double lastSharpness_ = 0.0;
+	unsigned int changed_ = 0;
+	unsigned int steady_ = 0;
+	bool sceneChanged_ = false;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
