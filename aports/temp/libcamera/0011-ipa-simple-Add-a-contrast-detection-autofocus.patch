@@ -0,0 +1,483 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Bruno Gregório
+ *
+ * Contrast detection autofocus
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <errno.h>
+#include <string>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace ipa::soft::algorithms {
+
+/*
+ * The statistics measure how sharp the middle of the frame is. A scan steps
+ * the lens from infinity towards macro, stopping once the sharpness has
+ * clearly fallen past a peak, then steps more finely around the best coarse
+ * position and settles on the best fine one, refined by a parabola through it
+ * and its neighbours.
+ *
+ * Statistics come every SwStatsCpu::kStatPerNumFrames frames and the lens
+ * moves as soon as the IPA asks, so each set of statistics is of a frame taken
+ * where the previous set left the lens.
+ *
+ * Noise adds to the sharpness, and grows with the gain, so a scan waits for the
+ * AGC to stop changing the exposure and gain, which it does once it has
+ * settled or reached its limits, and for the brightness to hold still. It
+ * starts again if the brightness moves away during it. A scene too dark to
+ * show anything is not scanned at all.
+ *
+ * In continuous mode the algorithm keeps the sharpness and brightness it
+ * focused at, and scans again once either has changed for a while and the
+ * scene has then steadied.
+ */
+
+/* Fine steps per coarse step. */
+static constexpr int32_t kFineDivisions = 4;
+
+/* A scan ends this many coarse samples past a peak they have fallen from. */
+static constexpr unsigned int kSamplesPastPeak = 2;
+static constexpr double kPeakDrop = 0.25;
+
+/* Statistics a change must last for, and the scene must then hold still for. */
+static constexpr unsigned int kChangedSamples = 3;
+static constexpr unsigned int kSteadySamples = 2;
+static constexpr double kSteadyChange = 0.1;
+
+/* How still the brightness must hold to scan, and how far it may then move. */
+static constexpr double kSteadyLight = 0.05;
+static constexpr double kScanLightDrift = 0.2;
+
+/* Below this mean over the black level, out of 255, there is nothing to see. */
+static constexpr double kMinBrightness = 8.0;
+
+static double relativeChange(double value, double reference)
+{
+	return std::abs(value - reference) / std::max(reference, 1e-6);
+}
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	std::string mode = tuningData["mode"].get<std::string>("manual");
+	if (mode == "manual") {
+		defaultMode_ = controls::AfModeManual;
+	} else if (mode == "auto") {
+		defaultMode_ = controls::AfModeAuto;
+	} else if (mode == "continuous") {
+		defaultMode_ = controls::AfModeContinuous;
+	} else {
+		LOG(IPASoftAf, Error) << "Unknown mode '" << mode << "'";
+		return -EINVAL;
+	}
+
+	infinityTuned_ = tuningData["infinity"].get<int32_t>();
+	macroTuned_ = tuningData["macro"].get<int32_t>();
+	macroDioptres_ = tuningData["macroDioptres"].get<float>(10.0f);
+	defaultDioptres_ = tuningData["defaultPosition"].get<float>(0.5f);
+	coarseSteps_ = tuningData["coarseSteps"].get<unsigned int>(10);
+	minContrast_ = tuningData["minContrast"].get<double>(0.1);
+	rescanChange_ = tuningData["rescanChange"].get<double>(0.3);
+
+	if (macroDioptres_ <= 0.0f || coarseSteps_ < 2) {
+		LOG(IPASoftAf, Error) << "Invalid tuning";
+		return -EINVAL;
+	}
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues,
+			    ControlValue(static_cast<int32_t>(defaultMode_)));
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(controls::AfTriggerValues);
+	context.ctrlMap[&controls::AfPause] =
+		ControlInfo(controls::AfPauseValues);
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(0.0f, macroDioptres_, defaultDioptres_);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	const ControlInfoMap &lensControls = configInfo.lensControls;
+	const auto it = lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+
+	mode_ = defaultMode_;
+	paused_ = false;
+	pauseDeferred_ = false;
+	scanning_ = false;
+	watching_ = false;
+	sceneChanged_ = false;
+	scanRequested_ = mode_ == controls::AfModeContinuous;
+	state_ = scanRequested_ ? controls::AfStateScanning : controls::AfStateIdle;
+	lastBrightness_ = 0.0;
+	lastExposure_ = 0;
+	lastGain_ = 0.0;
+	lightSteady_ = 0;
+
+	hasLens_ = it != lensControls.end();
+	if (!hasLens_) {
+		LOG(IPASoftAf, Info) << "No lens, autofocus disabled";
+		return 0;
+	}
+
+	lensMin_ = it->second.min().get<int32_t>();
+	lensMax_ = it->second.max().get<int32_t>();
+	infinity_ = std::clamp(infinityTuned_.value_or(lensMin_), lensMin_, lensMax_);
+	macro_ = std::clamp(macroTuned_.value_or(lensMax_), lensMin_, lensMax_);
+	if (infinity_ == macro_) {
+		LOG(IPASoftAf, Error)
+			<< "Infinity and macro are the same position, autofocus disabled";
+		hasLens_ = false;
+		return 0;
+	}
+
+	moveLens(lensFromDioptres(defaultDioptres_));
+	context.activeState.lens.position = position_;
+
+	LOG(IPASoftAf, Info)
+		<< "Lens " << lensMin_ << "-" << lensMax_
+		<< ", infinity at " << infinity_ << ", macro at " << macro_;
+
+	return 0;
+}
+
+void Af::queueRequest([[maybe_unused]] IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!hasLens_)
+		return;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = static_cast<controls::AfModeEnum>(*mode);
+		paused_ = false;
+		pauseDeferred_ = false;
+		scanning_ = false;
+		watching_ = false;
+		scanRequested_ = mode_ == controls::AfModeContinuous;
+		state_ = scanRequested_ ? controls::AfStateScanning
+					: controls::AfStateIdle;
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart) {
+			scanRequested_ = true;
+			state_ = controls::AfStateScanning;
+		} else if (*trigger == controls::AfTriggerCancel &&
+			   state_ == controls::AfStateScanning) {
+			scanRequested_ = false;
+			stopScan(controls::AfStateIdle);
+		}
+	}
+
+	const auto &pause = controls.get(controls::AfPause);
+	if (pause && mode_ == controls::AfModeContinuous) {
+		switch (*pause) {
+		case controls::AfPauseImmediate:
+			/* Pick an interrupted scan up again on resuming. */
+			if (scanning_) {
+				scanning_ = false;
+				scanRequested_ = true;
+			}
+			paused_ = true;
+			pauseDeferred_ = false;
+			break;
+		case controls::AfPauseDeferred:
+			if (scanning_ || scanRequested_)
+				pauseDeferred_ = true;
+			else
+				paused_ = true;
+			break;
+		case controls::AfPauseResume:
+			paused_ = false;
+			pauseDeferred_ = false;
+			break;
+		}
+	}
+
+	const auto &lensPosition = controls.get(controls::LensPosition);
+	if (lensPosition && mode_ == controls::AfModeManual)
+		moveLens(lensFromDioptres(*lensPosition));
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!hasLens_)
+		return;
+
+	if (stats->valid && stats->focusCount) {
+		double mean = static_cast<double>(stats->focusSum) / stats->focusCount;
+		double brightness = mean - context.activeState.blc.level;
+		double sharpness = 0.0;
+
+		/* Scale by brightness, so that the exposure does not matter. */
+		if (brightness >= kMinBrightness)
+			sharpness = static_cast<double>(stats->focus) /
+				    stats->focusCount / (brightness * brightness);
+
+		LOG(IPASoftAf, Debug)
+			<< "Lens at " << position_ << ", sharpness " << sharpness
+			<< ", brightness " << brightness;
+
+		const auto &agc = context.activeState.agc;
+		bool exposureHeld = agc.exposure == lastExposure_ &&
+				    agc.again == lastGain_;
+		lastExposure_ = agc.exposure;
+		lastGain_ = agc.again;
+
+		if (exposureHeld &&
+		    relativeChange(brightness, lastBrightness_) < kSteadyLight)
+			lightSteady_++;
+		else
+			lightSteady_ = 0;
+		lastBrightness_ = brightness;
+
+		if (mode_ != controls::AfModeManual && !paused_) {
+			if (scanning_ &&
+			    relativeChange(brightness, scanBrightness_) > kScanLightDrift) {
+				LOG(IPASoftAf, Debug) << "Light changed while scanning";
+				scanning_ = false;
+				scanRequested_ = true;
+			}
+
+			if (scanning_) {
+				scan(sharpness);
+			} else if (scanRequested_) {
+				if (lightSteady_ >= kSteadySamples) {
+					scanRequested_ = false;
+					startScan(brightness);
+				}
+			} else if (mode_ == controls::AfModeContinuous) {
+				watch(sharpness, brightness);
+			}
+		}
+	}
+
+	context.activeState.lens.position = position_;
+
+	metadata.set(controls::AfState, static_cast<int32_t>(state_));
+	metadata.set(controls::LensPosition, dioptresFromLens(position_));
+	if (mode_ == controls::AfModeContinuous) {
+		int32_t pauseState = controls::AfPauseStateRunning;
+		if (paused_)
+			pauseState = controls::AfPauseStatePaused;
+		else if (pauseDeferred_)
+			pauseState = controls::AfPauseStatePausing;
+		metadata.set(controls::AfPauseState, pauseState);
+	}
+}
+
+void Af::startScan(double brightness)
+{
+	const int32_t steps = static_cast<int32_t>(coarseSteps_);
+
+	if (brightness < kMinBrightness) {
+		LOG(IPASoftAf, Debug) << "Too dark to scan";
+		moveLens(lensFromDioptres(defaultDioptres_));
+		stopScan(controls::AfStateFailed);
+		return;
+	}
+
+	scanBrightness_ = brightness;
+
+	scanning_ = true;
+	watching_ = false;
+	phase_ = Phase::Coarse;
+	state_ = controls::AfStateScanning;
+	step_ = (macro_ - infinity_) / steps;
+	samples_.clear();
+	plan_.clear();
+	for (int32_t i = 0; i <= steps; i++)
+		plan_.push_back(infinity_ + (macro_ - infinity_) * i / steps);
+	next_ = 0;
+
+	LOG(IPASoftAf, Debug) << "Scanning";
+	moveLens(plan_[next_++]);
+}
+
+void Af::stopScan(controls::AfStateEnum state)
+{
+	scanning_ = false;
+	watching_ = false;
+	state_ = state;
+
+	if (pauseDeferred_) {
+		paused_ = true;
+		pauseDeferred_ = false;
+	}
+}
+
+void Af::scan(double sharpness)
+{
+	auto bySharpness = [](const std::pair<int32_t, double> &a,
+			      const std::pair<int32_t, double> &b) {
+		return a.second < b.second;
+	};
+
+	samples_.emplace_back(position_, sharpness);
+
+	if (phase_ == Phase::Fine) {
+		if (next_ < plan_.size())
+			moveLens(plan_[next_++]);
+		else
+			finishScan();
+		return;
+	}
+
+	auto best = std::max_element(samples_.begin(), samples_.end(), bySharpness);
+	std::size_t past = samples_.end() - 1 - best;
+	bool fallen = past >= kSamplesPastPeak &&
+		      sharpness < best->second * (1.0 - kPeakDrop);
+	if (!fallen && next_ < plan_.size()) {
+		moveLens(plan_[next_++]);
+		return;
+	}
+
+	auto worst = std::min_element(samples_.begin(), samples_.end(), bySharpness);
+	if (best->second <= 0.0 ||
+	    best->second < worst->second * (1.0 + minContrast_)) {
+		LOG(IPASoftAf, Debug)
+			<< "No peak: sharpness " << worst->second
+			<< " to " << best->second;
+		moveLens(lensFromDioptres(defaultDioptres_));
+		stopScan(controls::AfStateFailed);
+		return;
+	}
+
+	/* Step finely across the coarse steps either side of the peak. */
+	const int32_t centre = best->first;
+	const int32_t low = std::min(infinity_, macro_);
+	const int32_t high = std::max(infinity_, macro_);
+	int32_t fine = step_ / kFineDivisions;
+	if (!fine)
+		fine = step_ < 0 ? -1 : 1;
+
+	phase_ = Phase::Fine;
+	samples_.clear();
+	plan_.clear();
+	for (int32_t k = 1 - kFineDivisions; k < kFineDivisions; k++) {
+		int32_t position = std::clamp(centre + k * fine, low, high);
+		if (plan_.empty() || plan_.back() != position)
+			plan_.push_back(position);
+	}
+	next_ = 0;
+
+	LOG(IPASoftAf, Debug) << "Coarse peak at " << centre;
+	moveLens(plan_[next_++]);
+}
+
+void Af::finishScan()
+{
+	auto best = std::max_element(samples_.begin(), samples_.end(),
+				     [](const std::pair<int32_t, double> &a,
+					const std::pair<int32_t, double> &b) {
+					     return a.second < b.second;
+				     });
+	std::size_t i = best - samples_.begin();
+	double target = best->first;
+
+	/* Fit a parabola through the best fine sample and its neighbours. */
+	if (i > 0 && i + 1 < samples_.size()) {
+		double l = samples_[i - 1].second;
+		double c = best->second;
+		double r = samples_[i + 1].second;
+		double curve = l - 2.0 * c + r;
+
+		if (curve < 0.0)
+			target += 0.5 * (l - r) / curve *
+				  (samples_[i + 1].first - samples_[i - 1].first) / 2.0;
+	}
+
+	moveLens(static_cast<int32_t>(std::lround(target)));
+	stopScan(controls::AfStateFocused);
+
+	LOG(IPASoftAf, Debug)
+		<< "Focused at " << position_ << ", sharpness " << best->second;
+}
+
+void Af::watch(double sharpness, double brightness)
+{
+	if (!watching_) {
+		watching_ = true;
+		sceneChanged_ = false;
+		changed_ = 0;
+		focusedSharpness_ = sharpness;
+		focusedBrightness_ = brightness;
+		lastSharpness_ = sharpness;
+		return;
+	}
+
+	if (!sceneChanged_) {
+		if (relativeChange(sharpness, focusedSharpness_) > rescanChange_ ||
+		    relativeChange(brightness, focusedBrightness_) > rescanChange_)
+			changed_++;
+		else
+			changed_ = 0;
+
+		if (changed_ >= kChangedSamples) {
+			LOG(IPASoftAf, Debug) << "Scene changed";
+			sceneChanged_ = true;
+			steady_ = 0;
+		}
+	} else {
+		if (relativeChange(sharpness, lastSharpness_) < kSteadyChange)
+			steady_++;
+		else
+			steady_ = 0;
+
+		/* Leave it to process() to wait for steady light too. */
+		if (steady_ >= kSteadySamples) {
+			watching_ = false;
+			scanRequested_ = true;
+			state_ = controls::AfStateScanning;
+		}
+	}
+
+	lastSharpness_ = sharpness;
+}
+
+void Af::moveLens(int32_t position)
+{
+	position_ = std::clamp(position, lensMin_, lensMax_);
+}
+
+int32_t Af::lensFromDioptres(float dioptres) const
+{
+	double position = infinity_ + (macro_ - infinity_) * dioptres / macroDioptres_;
+
+	return std::clamp(static_cast<int32_t>(std::lround(position)),
+			  lensMin_, lensMax_);
+}
+
+float Af::dioptresFromLens(int32_t position) const
+{
+	return std::max(0.0f, macroDioptres_ * (position - infinity_) /
+				      static_cast<float>(macro_ - infinity_));
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
