From a1e335c27148075570ac34c4c05aaae7adebe71e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 15:57:10 -0300
Subject: [PATCH] ipa: simple: Compute the line duration at configure time
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The soft IPA takes the line length and pixel rate from the sensor
information the software ISP reads when it is created, before any mode
is set, so the line duration and the ExposureTime it reports are those
of the sensor's default mode. On a Sony IMX582 whose default mode has
lines of 9.9 us, a 2000x1132 mode with lines of 6.6 us at 117 fps
reported exposures of 12 ms.

Pass the sensor information in the IPA configuration, read once the
pipeline handler has set the sensor format, and compute the line
duration from it, as the rkisp1 IPA does.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 include/libcamera/ipa/soft.mojom         | 1 +
 src/ipa/simple/soft_simple.cpp           | 2 ++
 src/libcamera/pipeline/simple/simple.cpp | 3 +++
 3 files changed, 6 insertions(+)

diff --git a/include/libcamera/ipa/soft.mojom b/include/libcamera/ipa/soft.mojom
index a6e3ed5..b8ffc6f 100644
--- a/include/libcamera/ipa/soft.mojom
+++ b/include/libcamera/ipa/soft.mojom
@@ -9,6 +9,7 @@ module ipa.soft;
 import "include/libcamera/ipa/core.mojom";
 
 struct IPAConfigInfo {
+	libcamera.IPACameraSensorInfo sensorInfo;
 	libcamera.ControlInfoMap sensorControls;
 	libcamera.ControlInfoMap lensControls;
 };
diff --git a/src/ipa/simple/soft_simple.cpp b/src/ipa/simple/soft_simple.cpp
index aacdaab..8147787 100644
--- a/src/ipa/simple/soft_simple.cpp
+++ b/src/ipa/simple/soft_simple.cpp
@@ -214,6 +214,8 @@ int IPASoftSimple::configure(const IPAConfigInfo &configInfo)
 	context_.activeState = {};
 	context_.frameContexts.clear();
 
+	/* The line length and pixel rate are those of the configured mode. */
+	context_.sensorInfo = configInfo.sensorInfo;
 	context_.configuration.agc.lineDuration =
 		context_.sensorInfo.minLineLength * 1.0s / context_.sensorInfo.pixelRate;
 	context_.configuration.agc.exposureMin = exposureInfo.min().get<int32_t>();
diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index df6cd57..0157ece 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -1616,6 +1616,9 @@ int SimplePipelineHandler::configure(Camera *camera, CameraConfiguration *c)
 		return data->converter_->configure(inputCfg, outputCfgs);
 	} else {
 		ipa::soft::IPAConfigInfo configInfo;
+		ret = data->sensor_->sensorInfo(&configInfo.sensorInfo);
+		if (ret)
+			return ret;
 		configInfo.sensorControls = data->sensor_->controls();
 		if (CameraLens *focusLens = data->sensor_->focusLens())
 			configInfo.lensControls = focusLens->controls();
-- 
