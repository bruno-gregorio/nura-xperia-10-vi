diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
index a13a755..89ee4bc 100644
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -11,6 +11,8 @@
 #include <cmath>
 #include <stdint.h>
 
+#include <linux/v4l2-controls.h>
+
 #include <libcamera/base/log.h>
 
 #include "control_ids.h"
@@ -65,10 +67,108 @@ Agc::Agc()
 {
 }
 
+/*
+ * Two optional tuning parameters let the AGC go past the sensor's default
+ * frame length and its analogue gain in low light: exposureTimeMax, the
+ * longest exposure in microseconds, for which frames are lengthened, and
+ * digitalGainMax, the highest gain the software ISP applies on top.
+ */
+int Agc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	std::optional<double> exposureTimeMax =
+		tuningData["exposureTimeMax"].get<double>();
+	if (exposureTimeMax) {
+		if (*exposureTimeMax <= 0.0) {
+			LOG(IPASoftExposure, Error) << "Invalid exposureTimeMax";
+			return -EINVAL;
+		}
+		exposureTimeMax_ = std::chrono::duration<double, std::micro>(*exposureTimeMax);
+	}
+
+	digitalGainMax_ = tuningData["digitalGainMax"].get<double>(1.0);
+	if (digitalGainMax_ < 1.0) {
+		LOG(IPASoftExposure, Error) << "Invalid digitalGainMax";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+int Agc::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	const auto &limits = context.configuration.agc;
+
+	context.activeState.agc.digitalGain = 1.0;
+	exposureMaxLong_ = limits.exposureMax;
+	longFrames_ = false;
+
+	const auto it = configInfo.sensorControls.find(V4L2_CID_VBLANK);
+	if (exposureTimeMax_ && it != configInfo.sensorControls.end()) {
+		const int32_t height = context.sensorInfo.outputSize.height;
+
+		/*
+		 * Setting the format put the frame length and the exposure
+		 * limit at their defaults, so the margin the sensor keeps
+		 * between the two follows from them.
+		 */
+		vblankDefault_ = it->second.def().get<int32_t>();
+		vblankMax_ = it->second.max().get<int32_t>();
+		exposureMargin_ = height + vblankDefault_ - limits.exposureMax;
+
+		const int32_t lines =
+			static_cast<int32_t>(*exposureTimeMax_ / limits.lineDuration);
+		const int32_t longest = height + vblankMax_ - exposureMargin_;
+		if (exposureMargin_ >= 0 && lines > limits.exposureMax &&
+		    longest > limits.exposureMax) {
+			exposureMaxLong_ = std::min(lines, longest);
+			longFrames_ = true;
+		}
+	}
+
+	LOG(IPASoftExposure, Info)
+		<< "Exposure up to " << exposureMaxLong_ << " lines ("
+		<< utils::Duration(limits.lineDuration * exposureMaxLong_).get<std::milli>()
+		<< " ms), digital gain up to " << digitalGainMax_;
+
+	return 0;
+}
+
+void Agc::prepare(IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext,
+		  DebayerParams *params)
+{
+	/*
+	 * The software ISP applies the gains after it subtracts the black
+	 * level, so digital gain there leaves black where it was.
+	 */
+	frameContext.digitalGain = context.activeState.agc.digitalGain;
+	params->gains *= static_cast<float>(frameContext.digitalGain);
+}
+
+/*
+ * Lengthen the frame to fit the exposure, never below the mode's default
+ * frame length.
+ */
+void Agc::setFrameLength(IPAContext &context, IPAFrameContext &frameContext)
+{
+	if (!longFrames_) {
+		frameContext.sensor.vblank.reset();
+		return;
+	}
+
+	const int32_t height = context.sensorInfo.outputSize.height;
+	frameContext.sensor.vblank =
+		std::clamp(frameContext.sensor.exposure + exposureMargin_ - height,
+			   vblankDefault_, vblankMax_);
+}
+
 void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, double exposureMSV)
 {
+	const auto &limits = context.configuration.agc;
 	int32_t &exposure = frameContext.sensor.exposure;
 	double &again = frameContext.sensor.gain;
+	double &dgain = context.activeState.agc.digitalGain;
 
 	double error = kExposureOptimal - exposureMSV;
 
@@ -85,23 +185,39 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, dou
 	float factor = 1.0f + step;
 
 	if (factor > 1.0f) {
-		/* Scene too dark: increase exposure first, then gain. */
-		if (exposure < context.configuration.agc.exposureMax) {
+		/*
+		 * Scene too dark: increase exposure within the default frame
+		 * length first, then analogue gain, then lengthen the frames
+		 * for more exposure, and add digital gain last.
+		 */
+		if (exposure < limits.exposureMax) {
 			int32_t next = static_cast<int32_t>(exposure * factor);
-			exposure = std::max(next, exposure + 1);
-		} else {
+			exposure = std::min(std::max(next, exposure + 1),
+					    limits.exposureMax);
+		} else if (again < limits.againMax) {
 			double next = again * factor;
-			if (next - again < context.configuration.agc.againMinStep)
-				again += context.configuration.agc.againMinStep;
+			if (next - again < limits.againMinStep)
+				again += limits.againMinStep;
 			else
 				again = next;
+		} else if (exposure < exposureMaxLong_) {
+			int32_t next = static_cast<int32_t>(exposure * factor);
+			exposure = std::max(next, exposure + 1);
+		} else {
+			dgain *= factor;
 		}
 	} else {
-		/* Scene too bright: decrease gain first, then exposure. */
-		if (again > context.configuration.agc.again10) {
+		/* Scene too bright: undo the same steps in reverse order. */
+		if (dgain > 1.0) {
+			dgain *= factor;
+		} else if (exposure > limits.exposureMax) {
+			int32_t next = static_cast<int32_t>(exposure * factor);
+			exposure = std::max(std::min(next, exposure - 1),
+					    limits.exposureMax);
+		} else if (again > limits.again10) {
 			double next = again * factor;
-			if (again - next < context.configuration.agc.againMinStep)
-				again -= context.configuration.agc.againMinStep;
+			if (again - next < limits.againMinStep)
+				again -= limits.againMinStep;
 			else
 				again = next;
 		} else {
@@ -110,10 +226,9 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, dou
 		}
 	}
 
-	exposure = std::clamp(exposure, context.configuration.agc.exposureMin,
-			      context.configuration.agc.exposureMax);
-	again = std::clamp(again, context.configuration.agc.againMin,
-			   context.configuration.agc.againMax);
+	exposure = std::clamp(exposure, limits.exposureMin, exposureMaxLong_);
+	again = std::clamp(again, limits.againMin, limits.againMax);
+	dgain = std::clamp(dgain, 1.0, digitalGainMax_);
 
 	context.activeState.agc.exposure = exposure;
 	context.activeState.agc.again = again;
@@ -121,7 +236,8 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, dou
 	LOG(IPASoftExposure, Debug)
 		<< "exposureMSV " << exposureMSV
 		<< " error " << error << " factor " << factor
-		<< " exp " << exposure << " again " << again;
+		<< " exp " << exposure << " again " << again
+		<< " dgain " << dgain;
 }
 
 void Agc::process(IPAContext &context,
@@ -134,6 +250,14 @@ void Agc::process(IPAContext &context,
 		context.configuration.agc.lineDuration * frameContext.sensor.exposure;
 	metadata.set(controls::ExposureTime, exposureTime.get<std::micro>());
 	metadata.set(controls::AnalogueGain, frameContext.sensor.gain);
+	if (frameContext.digitalGain > 0.0)
+		metadata.set(controls::DigitalGain, frameContext.digitalGain);
+	if (frameContext.sensor.vblank) {
+		utils::Duration frameDuration = context.configuration.agc.lineDuration *
+			static_cast<int32_t>(context.sensorInfo.outputSize.height +
+					     *frameContext.sensor.vblank);
+		metadata.set(controls::FrameDuration, frameDuration.get<std::micro>());
+	}
 
 	if (!context.activeState.agc.valid) {
 		/*
@@ -152,6 +276,7 @@ void Agc::process(IPAContext &context,
 		 */
 		frameContext.sensor.exposure = context.activeState.agc.exposure;
 		frameContext.sensor.gain = context.activeState.agc.again;
+		setFrameLength(context, frameContext);
 		return;
 	}
 
@@ -174,11 +299,20 @@ void Agc::process(IPAContext &context,
 	if (yHistValsPerBin == 0) {
 		LOG(IPASoftExposure, Debug)
 			<< "Not adjusting exposure due to insufficient histogram data";
+		setFrameLength(context, frameContext);
 		return;
 	}
 
+	/*
+	 * The statistics are those of the raw frame. Stretch the histogram
+	 * above the black level by the digital gain to see the frame the
+	 * software ISP outputs.
+	 */
+	const double dgain = context.activeState.agc.digitalGain;
 	for (unsigned int i = 0; i < histogramSize; i++) {
-		unsigned int idx = (i - (i / yHistValsPerBinMod)) / yHistValsPerBin;
+		unsigned int j = std::min(static_cast<unsigned int>(i * dgain),
+					  histogramSize - 1);
+		unsigned int idx = (j - (j / yHistValsPerBinMod)) / yHistValsPerBin;
 		exposureBins[idx] += histogram[blackLevelHistIdx + i];
 	}
 
@@ -190,6 +324,7 @@ void Agc::process(IPAContext &context,
 
 	float exposureMSV = (denom == 0 ? 0 : static_cast<float>(num) / denom);
 	updateExposure(context, frameContext, exposureMSV);
+	setFrameLength(context, frameContext);
 }
 
 REGISTER_IPA_ALGORITHM(Agc, "Agc")
