From 4e328da82782342802b0f1b215b9a90d8a42c38a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 19:02:56 -0300
Subject: [PATCH 16/16] software_isp: Look for a front camera tuning file
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The tuning file is named after the sensor model, but a phone can use one
model in different modules: the Sony Xperia 10 VI has an SK Hynix Hi-846
behind its ultra-wide lens and another behind its front lens, which the
vendor tunes apart. For a front camera, look for '<sensor>-front.yaml'
first and fall back to '<sensor>.yaml'.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 src/libcamera/software_isp/software_isp.cpp | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/libcamera/software_isp/software_isp.cpp b/src/libcamera/software_isp/software_isp.cpp
index 7d7b04f..58c3dc8 100644
--- a/src/libcamera/software_isp/software_isp.cpp
+++ b/src/libcamera/software_isp/software_isp.cpp
@@ -21,6 +21,7 @@
 
 #include <libcamera/controls.h>
 #include <libcamera/formats.h>
+#include <libcamera/property_ids.h>
 #include <libcamera/stream.h>
 
 #include "libcamera/internal/bayer_format.h"
@@ -158,9 +159,18 @@ SoftwareIsp::SoftwareIsp(PipelineHandler *pipe, const CameraSensor *sensor,
 	/*
 	 * The API tuning file is made from the sensor name. If the tuning file
 	 * isn't found, fall back to the 'uncalibrated' file.
+	 *
+	 * A phone may use the same sensor model in different modules front
+	 * and back. A front camera looks for '<sensor>-front' first.
 	 */
-	std::string ipaTuningFile =
-		ipa_->configurationFile(sensor->model() + ".yaml", "uncalibrated.yaml");
+	std::string ipaTuningFile;
+	const auto location = sensor->properties().get(properties::Location);
+	if (location == properties::CameraLocationFront)
+		ipaTuningFile = ipa_->configurationFile(sensor->model() + "-front.yaml",
+							sensor->model() + ".yaml");
+	if (ipaTuningFile.empty())
+		ipaTuningFile = ipa_->configurationFile(sensor->model() + ".yaml",
+							"uncalibrated.yaml");
 
 	IPACameraSensorInfo sensorInfo{};
 	int ret = sensor->sensorInfo(&sensorInfo);
-- 
