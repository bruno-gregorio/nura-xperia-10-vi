diff --git a/src/ipa/simple/algorithms/awb.cpp b/src/ipa/simple/algorithms/awb.cpp
index 92ed0bb..732f345 100644
--- a/src/ipa/simple/algorithms/awb.cpp
+++ b/src/ipa/simple/algorithms/awb.cpp
@@ -7,6 +7,9 @@
 
 #include "awb.h"
 
+#include <algorithm>
+#include <cmath>
+#include <limits>
 #include <numeric>
 #include <stdint.h>
 
@@ -23,11 +26,53 @@ LOG_DEFINE_CATEGORY(IPASoftAwb)
 
 namespace ipa::soft::algorithms {
 
+int Awb::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	if (!tuningData.contains("illuminants"))
+		return 0;
+	for (const auto &entry : tuningData["illuminants"].asList()) {
+		auto ct = entry["ct"].get<double>();
+		auto rg = entry["rg"].get<double>();
+		auto bg = entry["bg"].get<double>();
+		if (!ct || !rg || !bg || !std::isfinite(*ct) ||
+		    !std::isfinite(*rg) || !std::isfinite(*bg) ||
+		    *ct < 1000 || *ct > 25000 || *rg <= 0 || *bg <= 0)
+			return -EINVAL;
+		illuminants_.push_back({ *ct, std::log(*rg), std::log(*bg) });
+	}
+	std::sort(illuminants_.begin(), illuminants_.end());
+	return illuminants_.size() >= 2 ? 0 : -EINVAL;
+}
+
+unsigned int Awb::calibratedTemperature(double rg, double bg) const
+{
+	const double r = std::log(rg), b = std::log(bg);
+	double best = std::numeric_limits<double>::infinity();
+	double ct = 5000;
+	/* Project raw-channel ratios onto this sensor's illuminant locus. */
+	for (size_t i = 1; i < illuminants_.size(); ++i) {
+		const auto &a = illuminants_[i - 1];
+		const auto &z = illuminants_[i];
+		double dr = z[1] - a[1], db = z[2] - a[2];
+		double norm = dr * dr + db * db;
+		double t = norm > 0 ? std::clamp(((r - a[1]) * dr + (b - a[2]) * db) / norm, 0.0, 1.0) : 0.0;
+		double er = r - a[1] - t * dr, eb = b - a[2] - t * db;
+		double distance = er * er + eb * eb;
+		if (distance < best) {
+			best = distance;
+			/* Interpolate in reciprocal colour temperature. */
+			ct = 1.0 / ((1.0 - t) / a[0] + t / z[0]);
+		}
+	}
+	return std::lround(ct);
+}
+
 int Awb::configure(IPAContext &context,
 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
 	auto &gains = context.activeState.awb.gains;
 	gains = { { 1.0, 1.0, 1.0 } };
+	context.activeState.awb.temperatureK = 5000;
 
 	return 0;
 }
@@ -86,6 +131,8 @@ void Awb::process(IPAContext &context,
 
 	RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
 	context.activeState.awb.temperatureK = estimateCCT(rgbGains);
+	if (!illuminants_.empty())
+		context.activeState.awb.temperatureK = calibratedTemperature(rgbGains.r(), rgbGains.b());
 	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
 
 	LOG(IPASoftAwb, Debug)
