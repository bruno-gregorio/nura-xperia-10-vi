+	GLuint lensShadingTexture_ = 0;
+	GLint lensShadingUniform_;
+	GLint lensShadingCropUniform_;
+	GLint lensShadingEnabledUniform_;
 
 	Size nativeOutputSize_;
 	Rectangle window_;
