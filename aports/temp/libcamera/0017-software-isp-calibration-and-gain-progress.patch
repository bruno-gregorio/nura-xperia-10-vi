diff --git a/src/ipa/simple/algorithms/lsc.cpp b/src/ipa/simple/algorithms/lsc.cpp
new file mode 100644
index 0000000..89534a2
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.cpp
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Lens shading calibration in active-array coordinates. */
+#include "lsc.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera::ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftLsc)
+
+int Lsc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	int ret = tables_.readYaml(tuningData["tables"], "ct", "gains");
+	if (ret)
+		return ret;
+	for (const auto &[ct, table] : tables_.data()) {
+		for (float gain : table.data()) {
+			if (!std::isfinite(gain) || gain < 0.5f || gain > 8.0f)
+				return -EINVAL;
+		}
+	}
+	LOG(IPASoftLsc, Info) << "Loaded " << tables_.data().size()
+			    << " lens shading tables (17x13 RGB)";
+	return 0;
+}
+
+void Lsc::prepare(IPAContext &context, [[maybe_unused]] uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext, DebayerParams *params)
+{
+	const auto &info = context.sensorInfo;
+	if (!info.activeAreaSize.width || !info.activeAreaSize.height ||
+	    !info.analogCrop.width || !info.analogCrop.height)
+		return;
+
+	const auto &table = tables_.getInterpolated(context.activeState.awb.temperatureK);
+	std::copy(table.data().begin(), table.data().end(), params->lensShading.begin());
+	params->lensShadingCrop = {
+		float(info.analogCrop.x) / info.activeAreaSize.width,
+		float(info.analogCrop.y) / info.activeAreaSize.height,
+		float(info.analogCrop.width) / info.activeAreaSize.width,
+		float(info.analogCrop.height) / info.activeAreaSize.height,
+	};
+	params->lensShadingEnabled = true;
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "LensShading")
+
+} /* namespace libcamera::ipa::soft::algorithms */
diff --git a/src/ipa/simple/algorithms/lsc.h b/src/ipa/simple/algorithms/lsc.h
new file mode 100644
index 0000000..4e8be35
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <libipa/interpolator.h>
+#include "algorithm.h"
+
+namespace libcamera::ipa::soft::algorithms {
+
+class Lsc : public Algorithm
+{
+public:
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void prepare(IPAContext &context, uint32_t frame,
+		     IPAFrameContext &frameContext, DebayerParams *params) override;
+
+private:
+	Interpolator<Matrix<float, 13, 17 * 3>> tables_;
+};
+
+} /* namespace libcamera::ipa::soft::algorithms */
