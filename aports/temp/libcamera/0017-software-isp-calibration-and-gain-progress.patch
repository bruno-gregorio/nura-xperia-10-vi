 ])
diff --git a/src/ipa/simple/soft_simple.cpp b/src/ipa/simple/soft_simple.cpp
index e69fdc6..fa9065a 100644
--- a/src/ipa/simple/soft_simple.cpp
+++ b/src/ipa/simple/soft_simple.cpp
@@ -303,6 +303,7 @@ void IPASoftSimple::computeParams(const uint32_t frame)
 {
 	context_.activeState.combinedMatrix = Matrix<float, 3, 3>::identity();
 	params_->gains = RGB<float>({ 1.0f, 1.0f, 1.0f });
+	params_->lensShadingEnabled = false;
 
 	IPAFrameContext &frameContext = context_.frameContexts.get(frame);
 	for (const auto &algo : algorithms())
@@ -342,8 +343,22 @@ void IPASoftSimple::processStats(const uint32_t frame,
 
 	auto &againNew = frameContext.sensor.gain;
 	ctrls.set(V4L2_CID_EXPOSURE, frameContext.sensor.exposure);
-	ctrls.set(V4L2_CID_ANALOGUE_GAIN,
-		  static_cast<int32_t>(camHelper_ ? camHelper_->gainCode(againNew) : againNew));
+	int32_t gainCode = camHelper_ ? camHelper_->gainCode(againNew) : againNew;
+	const double gainOld = camHelper_ ? camHelper_->gain(again) : again;
+	/*
+	 * A fixed minimum gain increment does not cover reciprocal gain
+	 * encodings: near the IMX582's limit a single code spans several x.
+	 * Ensure a requested change survives quantization, or AGC can remain
+	 * stuck below the limit and never use longer exposures/digital gain.
+	 */
+	if (againNew > gainOld && gainCode <= again)
+		gainCode = again + 1;
+	else if (againNew < gainOld && gainCode >= again)
+		gainCode = again - 1;
+	const auto &gainInfo = sensorInfoMap_.at(V4L2_CID_ANALOGUE_GAIN);
+	gainCode = std::clamp(gainCode, gainInfo.min().get<int32_t>(),
+			      gainInfo.max().get<int32_t>());
+	ctrls.set(V4L2_CID_ANALOGUE_GAIN, gainCode);
 	if (frameContext.sensor.vblank)
 		ctrls.set(V4L2_CID_VBLANK, *frameContext.sensor.vblank);
 
diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index d20d9d6..2383f28 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -71,6 +71,24 @@ uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
 
+uniform sampler2D lens_shading;
+uniform vec4 lens_shading_crop;
+uniform bool lens_shading_enabled;
+
+vec3 shading_gain(vec2 position)
+{
+	vec2 grid = clamp(lens_shading_crop.xy + position * lens_shading_crop.zw,
+			  vec2(0.0), vec2(1.0)) * vec2(16.0, 12.0);
+	vec2 base = floor(grid);
+	vec2 weight = fract(grid);
+	vec2 uv = (base + 0.5) / vec2(17.0, 13.0);
+	vec2 step = 1.0 / vec2(17.0, 13.0);
+	return mix(mix(texture2D(lens_shading, uv).rgb,
+		       texture2D(lens_shading, uv + vec2(step.x, 0.0)).rgb, weight.x),
+		   mix(texture2D(lens_shading, uv + vec2(0.0, step.y)).rgb,
+		       texture2D(lens_shading, uv + step).rgb, weight.x), weight.y);
+}
+
 #if defined (QUAD_BAYER)
 vec2 quad_cell(vec2 pixel)
 {
@@ -276,6 +294,8 @@ void main(void)
 	 * reworked into a single multiplication.
 	 */
 	rgb = (rgb - blacklevel) / (1.0 - blacklevel);
+	if (lens_shading_enabled)
+		rgb *= shading_gain(center_pixel / max(tex_size - vec2(1.0), vec2(1.0)));
 
 	/* Apply AWB gains, and saturate each channel at sensor range */
 	rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index aaa42b5..17a594b 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -11,6 +11,7 @@
 
 #include <algorithm>
 #include <assert.h>
+#include <cstring>
 #include <memory>
 #include <stdlib.h>
 #include <string>
@@ -124,6 +125,9 @@ int DebayerEGL::getShaderVariableLocations(void)
 	blackLevelUniformDataIn_ = glGetUniformLocation(programId_, "blacklevel");
 	gammaUniformDataIn_ = glGetUniformLocation(programId_, "gamma");
 	contrastExpUniformDataIn_ = glGetUniformLocation(programId_, "contrastExp");
+	lensShadingUniform_ = glGetUniformLocation(programId_, "lens_shading");
+	lensShadingCropUniform_ = glGetUniformLocation(programId_, "lens_shading_crop");
+	lensShadingEnabledUniform_ = glGetUniformLocation(programId_, "lens_shading_enabled");
 
 	textureUniformStep_ = glGetUniformLocation(programId_, "tex_step");
 	textureUniformSize_ = glGetUniformLocation(programId_, "tex_size");
@@ -519,6 +523,21 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	LOG(Debayer, Debug) << " blackLevelUniformDataIn_ " << blackLevelUniformDataIn_ << " data " << params.blackLevel;
 
 	glUniform3f(awbUniformDataIn_, params.gains[0], params.gains[1], params.gains[2]);
+	glUniform1i(lensShadingEnabledUniform_, params.lensShadingEnabled && lensShadingTexture_);
+	if (params.lensShadingEnabled && lensShadingTexture_) {
+		std::array<float, 17 * 13 * 4> rgba;
+		for (unsigned int i = 0; i < 17 * 13; ++i) {
+			for (unsigned int c = 0; c < 3; ++c)
+				rgba[i * 4 + c] = params.lensShading[i * 3 + c];
+			rgba[i * 4 + 3] = 1.0f;
+		}
+		glActiveTexture(GL_TEXTURE2);
+		glBindTexture(GL_TEXTURE_2D, lensShadingTexture_);
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, 17, 13, 0, GL_RGBA, GL_FLOAT, rgba.data());
+		glUniform1i(lensShadingUniform_, 2);
+		glUniform4fv(lensShadingCropUniform_, 1, params.lensShadingCrop.data());
+		glActiveTexture(GL_TEXTURE0);
+	}
 	LOG(Debayer, Debug) << " awbUniformDataIn_ " << awbUniformDataIn_ << " data " << params.gains;
 
 	/*
@@ -722,11 +741,31 @@ int DebayerEGL::start()
 	if (initBayerShaders(inputPixelFormat_, outputPixelFormat_))
 		return -EINVAL;
 
+	const char *extensions = reinterpret_cast<const char *>(glGetString(GL_EXTENSIONS));
+	if (lensShadingUniform_ >= 0 && extensions &&
+	    std::strstr(extensions, "GL_OES_texture_float") && maxTextureImageUnits >= 3) {
+		glGenTextures(1, &lensShadingTexture_);
+		glActiveTexture(GL_TEXTURE2);
+		glBindTexture(GL_TEXTURE_2D, lensShadingTexture_);
+		/* Manual bilinear sampling needs no float-linear extension. */
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+		glActiveTexture(GL_TEXTURE0);
+	} else {
+		LOG(Debayer, Info) << "Lens shading unavailable for this EGL format/context";
+	}
+
 	return 0;
 }
 
 void DebayerEGL::stop()
 {
+	if (lensShadingTexture_) {
+		glDeleteTextures(1, &lensShadingTexture_);
+		lensShadingTexture_ = 0;
+	}
 	eglImageOutCache_.clear();
 	eglImageInCache_.clear();
 
