+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Check the actual CPU statistics path, including its shared-memory output. */
+#include <array>
+#include <iostream>
+#include <numeric>
+#include <sys/mman.h>
+#include <vector>
+
+#include <libcamera/camera_manager.h>
+#include <libcamera/formats.h>
+#include <libcamera/stream.h>
+#include "libcamera/internal/software_isp/swstats_cpu.h"
+#include "test.h"
+
+using namespace libcamera;
+
+class PackedBayerStatsTest : public Test
+{
+protected:
+	int run() override
+	{
+		CameraManager manager;
+		const std::array<std::array<PixelFormat, 4>, 2> formats = {{
+			{ formats::SRGGB10_CSI2P, formats::SGRBG10_CSI2P,
+					formats::SGBRG10_CSI2P, formats::SBGGR10_CSI2P },
+			{ formats::SRGGB12_CSI2P, formats::SGRBG12_CSI2P,
+					formats::SGBRG12_CSI2P, formats::SBGGR12_CSI2P },
+		}};
+		for (unsigned int depth = 0; depth < 2; depth++) {
+			unsigned int lowBits = depth ? 4 : 2;
+			unsigned int lanes = depth ? 2 : 4;
+			unsigned int divisor = 1 << lowBits;
+			for (unsigned int phase = 0; phase < 4; phase++) {
+				for (bool clipped : { false, true }) {
+					StreamConfiguration cfg;
+					cfg.pixelFormat = formats[depth][phase];
+					cfg.size = { 64, 16 };
+					cfg.stride = 64 * (lanes + 1) / lanes + 8;
+					SwStatsCpu stats(manager);
+					if (!stats.isValid() || stats.configure(cfg))
+						return TestFail;
+					stats.setWindow(Rectangle(cfg.size));
+					std::vector<uint8_t> bytes(cfg.stride * cfg.size.height, 0xa5);
+					const std::array<unsigned int, 3> rgb = {
+						16 * divisor + 3, 20 * divisor + 3, 24 * divisor + 3
+					};
+					for (unsigned int y = 0; y < cfg.size.height; y++) {
+						for (unsigned int x = 0; x < cfg.size.width; x += lanes) {
+							unsigned int low = 0;
+							for (unsigned int lane = 0; lane < lanes; lane++) {
+								unsigned int px = (x + lane + (phase & 1)) % 2;
+								unsigned int py = (y + (phase >> 1)) % 2;
+								unsigned int channel = px == py ? (px ? 2 : 0) : 1;
+								unsigned int value = clipped ? (256 * divisor - 1) : rgb[channel];
+								bytes[y * cfg.stride + x / lanes * (lanes + 1) + lane] = value >> lowBits;
+								low |= (value & (divisor - 1)) << (lane * lowBits);
+							}
+							bytes[y * cfg.stride + x / lanes * (lanes + 1) + lanes] = low;
+						}
+					}
+					stats.startFrame(0);
+					for (unsigned int y = 0; y < cfg.size.height; y += 2) {
+						const uint8_t *rows[] = { bytes.data() + y * cfg.stride,
+																															bytes.data() + y * cfg.stride,
+																															bytes.data() + (y + 1) * cfg.stride };
+						stats.processLine0(0, y, rows);
+					}
+					stats.finishFrame(0, 0);
+					auto *result = static_cast<const SwIspStats *>(mmap(nullptr, sizeof(SwIspStats),
+							PROT_READ, MAP_SHARED, stats.getStatsFD().get(), 0));
+					if (result == MAP_FAILED)
+						return TestFail;
+					unsigned int count = 64;
+					bool okay = result->valid && result->awbCount == (clipped ? 0 : count) &&
+							std::accumulate(result->yHistogram.begin(), result->yHistogram.end(), 0u) == count;
+					for (unsigned int c = 0; c < 3; c++) {
+						unsigned int value = clipped ? (256 * divisor - 1) : rgb[c];
+						okay &= result->sum_[c] == count * value / divisor;
+						okay &= result->awbSum[c] == (clipped ? 0 : count * value / divisor);
+					}
+					munmap(const_cast<SwIspStats *>(result), sizeof(SwIspStats));
+					if (!okay) {
+						std::cerr << "Packed stats mismatch: depth=" << (lowBits + 8)
+																<< " phase=" << phase << " clipped=" << clipped << std::endl;
+						return TestFail;
+					}
+				}
+			}
+		}
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(PackedBayerStatsTest)
