Integrate the Bayer footprint before GPU preview downsampling.

diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -94,6 +94,7 @@
 }
 
 uniform float bayer_denoise;
+uniform vec2 pixel_footprint;
 
 /* Opt-in 5x5 spatial/range filter in linear sensor space. This is our
  * software filter, not a reproduction of Qualcomm's ABF hardware.
@@ -101,6 +102,8 @@
 vec3 denoise_bayer(vec2 pixel, vec3 reference)
 {
     vec3 sum = vec3(0.0), weights = vec3(0.0);
+    bool downsample = max(pixel_footprint.x, pixel_footprint.y) > 1.5;
+    vec2 radius = max(vec2(1.5), min(pixel_footprint, vec2(4.0)) * 0.5 + 1.0);
     for (int y = -2; y <= 2; y++) {
         for (int x = -2; x <= 2; x++) {
             vec2 pos = pixel + vec2(float(x), float(y));
@@ -109,9 +112,16 @@
                 (phase.y < 1.0 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0)) :
                 (phase.y < 1.0 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0));
             float value = raw_fetch(pos);
-            float difference = (value - dot(reference, channel)) / bayer_denoise;
+            float difference = (value - dot(reference, channel)) / max(bayer_denoise, 0.000001);
             float spatial = 1.0 / (1.0 + float(x*x + y*y) * 0.25);
             float weight = spatial / (1.0 + difference * difference);
+            if (downsample) {
+                /* Integrate the source footprint before decimation. Range
+                 * rejection would preserve noise and reintroduce aliasing.
+                 * Normalize each Bayer channel independently below. */
+                vec2 area = max(vec2(0.0), vec2(1.0) - abs(vec2(float(x), float(y))) / radius);
+                weight = area.x * area.y;
+            }
             sum += channel * (weight * value);
             weights += channel * weight;
         }
@@ -152,7 +162,7 @@
         (phase.y < 1.0 ? vec3(horizontal, c, vertical) :
                          vec3(diagonal, (horizontal + vertical) * 0.5, c));
 #if !defined(QUAD_BAYER)
-    if (bayer_denoise > 0.0)
+    if (bayer_denoise > 0.0 || max(pixel_footprint.x, pixel_footprint.y) > 1.5)
         rgb = denoise_bayer(center_pixel, rgb);
 #endif
 
