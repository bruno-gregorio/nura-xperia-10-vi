+int DebayerEGL::initChromaFilter()
+{
+	static constexpr unsigned char vertex[] =
+		"attribute vec2 vertexIn; varying vec2 textureOut;"
+		"void main() { gl_Position=vec4(vertexIn,0.0,1.0);"
+		"textureOut=(vertexIn+1.0)*0.5; }";
+	std::vector<std::string> env = { "#version 100\n" };
+	GLuint vs = 0, fs = 0;
+	if (egl_.compileVertexShader(vs, Span(vertex, sizeof(vertex) - 1), env))
+		return -EINVAL;
+	utils::scope_exit vertexGuard([&] { glDeleteShader(vs); });
+	if (egl_.compileFragmentShader(fs, chroma_denoise_frag, env))
+		return -EINVAL;
+	utils::scope_exit fragmentGuard([&] { glDeleteShader(fs); });
+	if (egl_.linkProgram(chromaProgram_, fs, vs))
+		return -EINVAL;
+	chromaImage_ = std::make_unique<eGLImage>(GL_RGBA, outputSize_.width,
+		outputSize_.height, outputSize_.width * 4, GL_TEXTURE3, 3);
+	egl_.createTexture2D(*chromaImage_, nullptr);
+	return egl_.attachTextureToFBO(*chromaImage_);
+}
+
+void DebayerEGL::filterChroma(eGLImage &output)
+{
+	static const GLfloat vertices[4][2] = {
+		{-1, -1}, {-1, 1}, {1, 1}, {1, -1}
+	};
+	egl_.attachTextureToFBO(output);
+	egl_.useProgram(chromaProgram_);
+	egl_.activateBindTexture(*chromaImage_);
+	glUniform1i(glGetUniformLocation(chromaProgram_, "image"), 3);
+	glUniform2f(glGetUniformLocation(chromaProgram_, "pixel_step"),
+		1.0f / outputSize_.width, 1.0f / outputSize_.height);
+	GLint position = glGetAttribLocation(chromaProgram_, "vertexIn");
+	glEnableVertexAttribArray(position);
+	glVertexAttribPointer(position, 2, GL_FLOAT, GL_FALSE, 0, vertices);
+	glViewport(0, 0, outputSize_.width, outputSize_.height);
+	glDrawArrays(GL_TRIANGLE_FAN, 0, DEBAYER_OPENGL_COORDS);
+}
