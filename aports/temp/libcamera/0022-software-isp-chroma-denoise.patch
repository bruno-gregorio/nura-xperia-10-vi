diff --git a/src/libcamera/shaders/chroma_denoise.frag b/src/libcamera/shaders/chroma_denoise.frag
--- /dev/null
+++ b/src/libcamera/shaders/chroma_denoise.frag
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Spatial chroma filtering after downsampling. Luminance guides the filter
+ * across edges; retain most original luminance for texture and sharpness.
+ * This is our software filter, not Qualcomm's hardware noise algorithm.
+ */
+precision highp float;
+varying vec2 textureOut;
+uniform sampler2D image;
+uniform vec2 pixel_step;
+void main()
+{
+    vec3 centre = texture2D(image, textureOut).rgb;
+    /* Symmetric R/B coefficients work for both output byte orders. */
+    const vec3 luma = vec3(0.25, 0.5, 0.25);
+    float y0 = dot(centre, luma);
+    vec3 total = vec3(0.0);
+    float norm = 0.0;
+    for (int y = -2; y <= 2; y++) {
+        for (int x = -2; x <= 2; x++) {
+            vec3 c = texture2D(image, textureOut + vec2(float(x), float(y)) * pixel_step).rgb;
+            float difference = (dot(c, luma) - y0) / 0.10;
+            float spatial = (3.0 - abs(float(x))) * (3.0 - abs(float(y)));
+            float weight = spatial / (1.0 + difference * difference);
+            total += weight * c;
+            norm += weight;
+        }
+    }
+    vec3 smooth = total / norm;
+    float ys = dot(smooth, luma);
+    gl_FragColor = vec4(clamp(smooth + vec3(0.7 * (y0 - ys)), 0.0, 1.0), 1.0);
+}
