@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <errno.h>
+#include <vector>
+
+#include <libipa/interpolator.h>
+
+namespace libcamera::ipa::soft::algorithms {
+
+/* Exposure index used by the module's stock tuning: 3% sensitivity steps.
+ * This uses applied exposure, not the proprietary scene-metering estimator.
+ * referenceTime is the first exposure-table knee, in microseconds.
+ */
+inline double exposureIndex(double time, double gain, double referenceTime)
+{
+	return std::max(0.0, std::log10(std::max(time * gain / referenceTime, 1.0)) *
+			77.89852905273438);
+}
+
+/* Preserve constant tuning inside each trigger band, interpolate in gaps. */
+template<typename T>
+class LuxTables
+{
+public:
+	int read(const ValueNode &yaml, const char *tables, const char *value,
+		 double minimum = -8.0)
+	{
+		bands_.clear();
+		if (yaml.isEmpty())
+			return 0;
+		if (!yaml.isList())
+			return -EINVAL;
+		for (const auto &node : yaml.asList()) {
+			auto start = node["start"].template get<double>();
+			auto end = node["end"].template get<double>();
+			if (!start || !end || !std::isfinite(*start) || !std::isfinite(*end) ||
+			    *start < 0 || *end < *start ||
+			    (!bands_.empty() && *start <= bands_.back().end))
+				return -EINVAL;
+			Band band{ *start, *end, {} };
+			if (band.tables.readYaml(node[tables], "ct", value))
+				return -EINVAL;
+			for (const auto &[ct, matrix] : band.tables.data())
+				for (auto v : matrix.data())
+					if (!std::isfinite(v) || v < minimum || v > 8)
+						return -EINVAL;
+			bands_.push_back(std::move(band));
+		}
+		return 0;
+	}
+
+	bool empty() const { return bands_.empty(); }
+
+	T get(double lux, unsigned int ct)
+	{
+		for (size_t i = 0; i < bands_.size(); ++i) {
+			auto &a = bands_[i];
+			if (lux <= a.end || i + 1 == bands_.size())
+				return a.tables.getInterpolated(ct);
+			auto &b = bands_[i + 1];
+			if (lux < b.start) {
+				double t = (lux - a.end) / (b.start - a.end);
+				return a.tables.getInterpolated(ct) * (1 - t) +
+				       b.tables.getInterpolated(ct) * t;
+			}
+		}
+		return {};
+	}
+
+private:
+	struct Band {
+		double start, end;
+		Interpolator<T> tables;
+	};
+	std::vector<Band> bands_;
+};
+
+} /* namespace libcamera::ipa::soft::algorithms */
