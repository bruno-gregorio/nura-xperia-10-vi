# Forked from Alpine for temporary downstream patches
# Forked again from pmaports' temp/libcamera 0.7.2-r4 (9fec495) for the
# Xperia 10 VI's cameras: the Sony IMX582's sensor properties and helper
# (0007), a helper for the Hynix Hi-846 (0008), a contrast detection
# autofocus for the soft IPA (0009 to 0011), the soft IPA's line duration
# taken from the configured mode (0012), longer frames and digital gain
# in low light (0013, 0014), a focus scan past the calibrated range
# (0015), a tuning file of its own for a front camera (0016), and tuning
# files for the IMX582 and both Hi-846 modules with Sony's colour
# matrices. Drop this fork once libcamera has all of them. pkgrel is
# pmaports' plus 100, plus one per change here.
maintainer="Robert Mader <robert.mader@collabora.com>"
pkgname=libcamera
_pkgver=0.7.2
pkgver=9999$_pkgver
pkgrel=110
pkgdesc="Linux camera framework"
url="https://libcamera.org/"
arch="all"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
# upstream calls 'date' with a non-POSIX option so we pull in coreutils
makedepends="
	coreutils
	doxygen
	eudev-dev
	glib-dev
	gnutls-dev
	graphviz
	gst-plugins-base-dev
	gtest-dev
	libevent-dev
	libpisp-dev
	libunwind-dev
	libyuv-dev
	linux-headers
	meson
	py3-jinja2
	py3-ply
	py3-pybind11-dev
	py3-sphinx
	py3-sphinxcontrib-doxylink
	py3-yaml
	python3-dev
	qt6-qtbase-dev
	qt6-qttools-dev
	yaml-dev
	"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	qcam
	$pkgname-gstreamer
	$pkgname-v4l2
	$pkgname-tools
	py3-$pkgname-pyc:pyc
	py3-$pkgname:py3
	"
_tuning_files="
	hi846.yaml
	hi846-front.yaml
	imx355.yaml
	imx363.yaml
	imx371.yaml
	imx376.yaml
	imx519.yaml
	imx582.yaml
	imx800.yaml
	imx858.yaml
	s5k3l6xx.yaml
	s5kjn1.yaml
	"
source="https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$_pkgver/libcamera-v$_pkgver.tar.gz
	0001-software_isp-debayer_egl-Re-add-log-for-failing-DMAB.patch
	0002-libcamera-camera_sensor-Add-Sony-IMX355-sensor-prope.patch
	0003-libcamera-software_isp-debayer_egl-Use-untransposed-.patch
	0004-debayer-Further-demote-Unsupported-input-format-log.patch
	0005-ipa-simple-Derive-AGC-minimum-gain-step-from-sensor-.patch
	0006-libcamera-Add-quad-Bayer-CFA-layout-support.patch
	0007-libcamera-camera_sensor-Add-Sony-IMX582-sensor-prope.patch
	0008-ipa-libipa-camera_sensor_helper-Add-Hynix-Hi-846-hel.patch
	0009-software_isp-Pass-lens-controls-between-the-pipeline.patch
	0010-libcamera-software_isp-Measure-focus-in-the-statisti.patch
	0011-ipa-simple-Add-a-contrast-detection-autofocus.patch
	0012-ipa-simple-Compute-the-line-duration-at-configure-ti.patch
	0013-pipeline-simple-Let-the-IPA-set-VBLANK.patch
	0014-ipa-simple-agc-Lengthen-frames-and-add-digital-gain-.patch
	0015-ipa-simple-af-Scan-past-the-calibrated-focus-range.patch
	0016-software_isp-Look-for-a-front-camera-tuning-file.patch
	qcam.desktop
	$_tuning_files
	"
builddir="$srcdir/$pkgname-v$_pkgver"
# gstreamer tests fail
# manual strip because ipa .sign files depend on the file contents- have to re-sign after strip
options="!strip !check"

case "$CARCH" in
arm*|aarch64)
	subpackages="$subpackages $pkgname-raspberrypi"
	;;
esac

case "$CARCH" in
ppc64le|s390x|riscv64|loongarch64)
	# doesn't install any ipa
	;;
*)
	depends="$pkgname-ipa=$pkgver-r$pkgrel"
	subpackages="$subpackages $pkgname-ipa"
	;;
esac

build() {
	abuild-meson \
		-Dpipelines=auto,virtual \
		-Dv4l2=true \
		-Dwerror=false \
		-Ddocumentation=disabled \
		. output
	meson compile -C output
}

check() {
	meson test -C output --print-errorlogs
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 -t "$pkgdir"/usr/share/applications "$srcdir"/qcam.desktop

	# manual strip first..
	scanelf --recursive \
		--nobanner \
		--etype "ET_DYN,ET_EXEC" \
		--format "%F" \
		"$pkgdir" \
		| while read -r file; do
			strip "$file"
	done
}

ipa() {
	depends=""
	amove usr/lib/libcamera
	amove usr/share/libcamera/ipa

	for _tuning_file in $_tuning_files; do
		install -Dm644 -t "$subpkgdir"/usr/share/libcamera/ipa/simple \
			"$srcdir"/"$_tuning_file"
	done

	# then sign ipa's
	local ipa
	for ipa in "$subpkgdir"/usr/lib/libcamera/ipa/ipa*.so; do
		msg "signing $ipa"
		"$builddir"/src/ipa/ipa-sign.sh \
			"$(find "$builddir"/output -type f -iname "*ipa-priv-key.pem")" \
			"$ipa" \
			"$ipa".sign
	done
}

qcam() {
	depends=""
	amove usr/bin/qcam

	amove usr/share/applications/qcam.desktop
}

gstreamer() {
	depends=""
	amove usr/lib/gstreamer-1.0
}

v4l2() {
	depends=""
	amove usr/libexec/libcamera/v4l2-compat.so
}

raspberrypi() {
	depends=""
	amove usr/share/libcamera/ipa/rpi
	amove usr/libexec/libcamera/raspberrypi_ipa_proxy
	amove usr/share/libcamera/pipeline/rpi/vc4
}

tools() {
	depends=""
	amove usr/bin/cam
	amove usr/bin/lc-compliance
}

py3() {
	pkgdesc="$pkgname (python bindings)"
	depends="python3"

	amove usr/lib/python*
}


