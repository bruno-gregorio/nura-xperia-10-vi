--- /dev/null
+++ b/libfprint/drivers/egisqsee/egisqsee-bix.c
@@ -0,0 +1,677 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#define FP_COMPONENT "egisqsee"
+
+#include "drivers_api.h"
+#include "egisqsee-bix.h"
+
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+
+/*
+ * The request is libets' 64-bit QSEECom message: u32 0xE0 at 0, the data
+ * buffer's capacity at 24, and the BIX message inline from 0x68, whose
+ * command id lands at 108, payload length at 120 and payload at 124.
+ * TrustZone patches the data buffer's address in at 8. The response holds
+ * the BIX status at 16 and the output length at 36.
+ */
+#define REQUEST_SIZE 0x880
+#define RESPONSE_SIZE 0x840
+#define DATA_SIZE 4096
+#define PAYLOAD_OFFSET 124
+#define PAYLOAD_MAX (REQUEST_SIZE - PAYLOAD_OFFSET)
+
+#define CMD_CALLBACK_REPLY 0x5000u
+#define CMD_PENDING 0x5001u
+#define CMD_TOKEN 0x6000u
+#define CMD_HELLO 0xfffu
+#define CMD_SENSOR_INIT 0x8001u
+#define CMD_SET_GROUP 0x8003u
+#define CMD_SPI_POWER 0x8004u
+#define CMD_SET_PROP 0xfffffffeu
+#define CMD_GET_PROP 0xffffffffu
+
+#define PROP_SPI_POWER 0x20070103u
+#define PROP_GROUP_PATH 0x20040101u
+#define PROP_GROUP_ID 0x2004010au
+#define PROP_IDENTITY 0x40040105u
+#define PROP_TOKEN 0x21040105u
+
+#define IDENTITY_SIZE 0x10d
+#define IDENTITY_HEADER 13
+
+/* Callback codes the TA asks the client to serve, and the reply results. */
+#define CALLBACK_TEST 1u
+#define CALLBACK_USER_NAME 2u
+#define CALLBACK_PLATFORM_NAME 3u
+#define CALLBACK_HARDWARE_RESET 8u
+#define CALLBACK_RESULT_OK 0u
+#define CALLBACK_RESULT_UNHANDLED 2u
+#define CALLBACK_RESULT_BAD_HANDLE 0x12u
+#define CALLBACK_ROUNDS_MAX 64
+
+/* Keymaster's get-secure-key command, for the fingerprint authenticator. */
+#define KEYMASTER_GET_KEY 0x205u
+#define KEYMASTER_FINGERPRINT 2u
+#define KEYMASTER_REQUEST 64
+#define KEYMASTER_RESPONSE 1088
+
+struct writer {
+  guint8 *buffer;
+  gsize size, length;
+  gboolean overflow;
+};
+
+static void
+put (struct writer *w, const void *data, gsize size)
+{
+  if (w->overflow || size > w->size - w->length)
+    {
+      w->overflow = TRUE;
+      return;
+    }
+  if (data)
+    memcpy (w->buffer + w->length, data, size);
+  else
+    memset (w->buffer + w->length, 0, size);
+  w->length += size;
+}
+
+static void
+put_u32 (struct writer *w, guint32 value)
+{
+  value = GUINT32_TO_LE (value);
+  put (w, &value, sizeof (value));
+}
+
+static void
+set_u32 (guint8 *buffer, gsize offset, guint32 value)
+{
+  value = GUINT32_TO_LE (value);
+  memcpy (buffer + offset, &value, sizeof (value));
+}
+
+guint32
+egisqsee_bix_u32 (const guint8 *buffer, gsize offset)
+{
+  guint32 value;
+
+  memcpy (&value, buffer + offset, sizeof (value));
+  return GUINT32_FROM_LE (value);
+}
+
+static GError *
+proto_error (const char *format, ...) G_GNUC_PRINTF (1, 2);
+
+static GError *
+proto_error (const char *format, ...)
+{
+  g_autofree char *message = NULL;
+  va_list args;
+
+  va_start (args, format);
+  message = g_strdup_vprintf (format, args);
+  va_end (args);
+  return fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO, "%s", message);
+}
+
+static GError *
+transport_error (const char *operation)
+{
+  return fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL, "%s: %s",
+                                   operation, g_strerror (errno));
+}
+
+/* A property list: {u32 count, u32 bytes, {u32 id, u32 size, value}...},
+ * optionally after a u32 event, as the agent's gen_bix_event_data. */
+static gboolean
+serialize (EgisqseeBix *bix, struct writer *w, gboolean with_event,
+           guint32 event, const struct egisqsee_record *records,
+           gsize count, GError **error)
+{
+  static const guint8 no_token[EGISQSEE_AUTH_TOKEN_SIZE];
+  gsize header, i;
+
+  if (with_event)
+    put_u32 (w, event);
+  header = w->length;
+  put_u32 (w, count);
+  put_u32 (w, 0);
+  for (i = 0; i < count; i++)
+    {
+      const guint8 *value = records[i].value;
+      guint32 size = records[i].size;
+
+      if (size == EGISQSEE_RECORD_PATH)
+        {
+          value = (const guint8 *) bix->path;
+          size = strlen (bix->path) + 1;
+        }
+      else if (size == EGISQSEE_RECORD_AUTH_TOKEN)
+        {
+          /* Android's hw_auth_token, which only the keystore uses. */
+          value = no_token;
+          size = sizeof (no_token);
+        }
+      put_u32 (w, records[i].id);
+      put_u32 (w, size);
+      put (w, value, size);
+    }
+  if (w->overflow)
+    {
+      g_propagate_error (error, proto_error ("BIX payload too large"));
+      return FALSE;
+    }
+  set_u32 (w->buffer, header + 4, w->length - header - 8);
+  return TRUE;
+}
+
+static gboolean
+transact (EgisqseeBix *bix, guint32 command, const guint8 *payload,
+          gsize length, guint32 *status, GError **error)
+{
+  guint32 output;
+
+  if (length > PAYLOAD_MAX)
+    {
+      g_propagate_error (error, proto_error ("BIX payload too large"));
+      return FALSE;
+    }
+  memset (bix->request, 0, sizeof (bix->request));
+  memset (bix->response, 0, sizeof (bix->response));
+  memset (bix->data, 0, sizeof (bix->data));
+  set_u32 (bix->request, 0, 0xe0);
+  set_u32 (bix->request, 24, DATA_SIZE);
+  set_u32 (bix->request, 108, command);
+  set_u32 (bix->request, 120, length);
+  if (length)
+    memcpy (bix->request + PAYLOAD_OFFSET, payload, length);
+  if (egisqsee_tee_send (&bix->tee, bix->request, REQUEST_SIZE,
+                         bix->response, RESPONSE_SIZE,
+                         bix->data, DATA_SIZE))
+    {
+      g_propagate_error (error, transport_error ("QSEECom invoke"));
+      return FALSE;
+    }
+  *status = egisqsee_bix_u32 (bix->response, 16);
+  output = egisqsee_bix_u32 (bix->response, 36);
+  fp_dbg ("BIX 0x%x: status %u, output %u", command, *status, output);
+  if (output > DATA_SIZE)
+    {
+      g_propagate_error (error, proto_error ("BIX 0x%x output length %u",
+                                             command, output));
+      return FALSE;
+    }
+  return TRUE;
+}
+
+static guint32
+hardware_reset (EgisqseeBix *bix, guint32 mode)
+{
+  /* As the vendor agent: mode 1 power-cycles the sensor, mode 2 pulses
+   * its reset line. */
+  fp_dbg ("TA asks for a hardware reset, mode %u", mode);
+  if (mode == 1)
+    {
+      if (egisqsee_hw_power (bix->hw, FALSE))
+        return 1;
+      g_usleep (G_USEC_PER_SEC);
+      if (egisqsee_hw_power (bix->hw, TRUE))
+        return 1;
+      g_usleep (50000);
+    }
+  if (mode == 1 || mode == 2)
+    {
+      if (egisqsee_hw_reset (bix->hw))
+        return 1;
+      g_usleep (20000);
+    }
+  return 0;
+}
+
+/* The TA answered status 10: its request is a property, id 1, in the
+ * output. Serve it and send the reply, which yields the next status. */
+static gboolean
+answer_callback (EgisqseeBix *bix, guint32 *status, GError **error)
+{
+  guint8 reply[PAYLOAD_MAX];
+  guint8 *output = reply + 16;
+  guint32 length = egisqsee_bix_u32 (bix->response, 36);
+  guint32 token, code, input_length, capacity, result, output_length;
+  const guint8 *input;
+
+  if (length >= 16 && egisqsee_bix_u32 (bix->data, 4))
+    {
+      /* The request did not fit in the output; fetch it. */
+      if (!transact (bix, CMD_PENDING, NULL, 0, status, error))
+        return FALSE;
+      length = egisqsee_bix_u32 (bix->response, 36);
+    }
+  if (length < 0x28 || egisqsee_bix_u32 (bix->data, 0x10) != 1)
+    {
+      g_propagate_error (error, proto_error ("Malformed TA callback request"));
+      return FALSE;
+    }
+  token = egisqsee_bix_u32 (bix->data, 0x18);
+  code = egisqsee_bix_u32 (bix->data, 0x1c);
+  input_length = egisqsee_bix_u32 (bix->data, 0x20);
+  capacity = egisqsee_bix_u32 (bix->data, 0x24);
+  input = bix->data + 0x28;
+  if (input_length > length - 0x28)
+    {
+      g_propagate_error (error, proto_error ("Malformed TA callback request"));
+      return FALSE;
+    }
+  fp_dbg ("TA callback 0x%x, input %u, output capacity %u", code,
+          input_length, capacity);
+
+  output_length = MIN (capacity, sizeof (reply) - 16);
+  memset (output, 0, output_length);
+  result = CALLBACK_RESULT_UNHANDLED;
+  switch (code)
+    {
+    case CALLBACK_TEST:
+      {
+        guint32 n = input_length >= 4 ? egisqsee_bix_u32 (input, 0) : 0;
+        guint32 sum = 0, i;
+
+        if (n > input_length - 4 || n + 8 > output_length)
+          break;
+        for (i = 0; i < n; i++)
+          {
+            output[8 + i] = ~input[4 + i];
+            sum += output[8 + i];
+          }
+        set_u32 (output, 0, sum);
+        set_u32 (output, 4, n);
+        output_length = n + 8;
+        result = CALLBACK_RESULT_OK;
+        break;
+      }
+
+    case CALLBACK_PLATFORM_NAME:
+      /* The TA's behaviour is tuned per platform; it knows "Android". */
+      if (output_length < 12)
+        break;
+      set_u32 (output, 0, 8);
+      memcpy (output + 4, "Android", 8);
+      output_length = 12;
+      result = CALLBACK_RESULT_OK;
+      break;
+
+    case CALLBACK_HARDWARE_RESET:
+      if (input_length < 4 || output_length < 4)
+        break;
+      set_u32 (output, 0, hardware_reset (bix, egisqsee_bix_u32 (input, 0)));
+      output_length = 4;
+      result = CALLBACK_RESULT_OK;
+      break;
+
+    default:
+      /* Group 2 is the REE datastore, which this TA build does not use;
+       * the agent has no handle registered for it either. */
+      if (code >> 16 == 2)
+        result = CALLBACK_RESULT_BAD_HANDLE;
+      break;
+    }
+
+  set_u32 (reply, 0, token);
+  set_u32 (reply, 4, result);
+  set_u32 (reply, 8, input_length);
+  set_u32 (reply, 12, output_length);
+  return transact (bix, CMD_CALLBACK_REPLY, reply, 16 + output_length,
+                   status, error);
+}
+
+/* A command, with the TA's callbacks served. */
+static gboolean
+command (EgisqseeBix *bix, guint32 cmd, const guint8 *payload,
+         gsize length, guint32 *status, GError **error)
+{
+  guint rounds;
+
+  if (!transact (bix, cmd, payload, length, status, error))
+    return FALSE;
+  for (rounds = 0; *status == EGISQSEE_BIX_CALLBACK; rounds++)
+    {
+      if (rounds == CALLBACK_ROUNDS_MAX)
+        {
+          g_propagate_error (error, proto_error ("BIX 0x%x: callbacks without end", cmd));
+          return FALSE;
+        }
+      if (!answer_callback (bix, status, error))
+        return FALSE;
+    }
+  return TRUE;
+}
+
+static gboolean
+command_ok (EgisqseeBix *bix, guint32 cmd, const guint8 *payload,
+            gsize length, GError **error)
+{
+  guint32 status;
+
+  if (!command (bix, cmd, payload, length, &status, error))
+    return FALSE;
+  if (status != EGISQSEE_BIX_OK)
+    {
+      g_propagate_error (error, proto_error ("BIX 0x%x failed with status %u",
+                                             cmd, status));
+      return FALSE;
+    }
+  return TRUE;
+}
+
+static gboolean
+records_ok (EgisqseeBix *bix, guint32 cmd,
+            const struct egisqsee_record *records, gsize count,
+            GError **error)
+{
+  guint8 payload[PAYLOAD_MAX];
+  struct writer w = { payload, sizeof (payload) };
+
+  return serialize (bix, &w, FALSE, 0, records, count, error) &&
+         command_ok (bix, cmd, payload, w.length, error);
+}
+
+gboolean
+egisqsee_bix_open (EgisqseeBix *bix, struct egisqsee_hw *hw, GError **error)
+{
+  memset (bix, 0, sizeof (*bix));
+  bix->hw = hw;
+  g_strlcpy (bix->path, "PATH:/sdcard", sizeof (bix->path));
+  /* Attach to the TA qsee-app-loader holds; loading it a second time
+   * fails in TrustZone. */
+  if (egisqsee_tee_open (&bix->tee, "egisap64"))
+    {
+      g_propagate_error (error, transport_error ("Attaching to egisap64"));
+      return FALSE;
+    }
+  return TRUE;
+}
+
+void
+egisqsee_bix_close (EgisqseeBix *bix)
+{
+  egisqsee_tee_close (&bix->tee);
+  explicit_bzero (bix->request, sizeof (bix->request));
+  explicit_bzero (bix->response, sizeof (bix->response));
+  explicit_bzero (bix->data, sizeof (bix->data));
+}
+
+gboolean
+egisqsee_bix_spi_power (EgisqseeBix *bix, gboolean on, GError **error)
+{
+  const guint8 value[4] = { on ? 1 : 0 };
+  const struct egisqsee_record record = { PROP_SPI_POWER, 4, value };
+
+  return records_ok (bix, CMD_SPI_POWER, &record, 1, error);
+}
+
+/* The authenticator key context: Keymaster wraps it for the fingerprint
+ * TA, which takes it before sensor initialisation. Never logged or kept. */
+static gboolean
+token_context (EgisqseeBix *bix, GError **error)
+{
+  struct egisqsee_tee keymaster;
+  guint8 request[KEYMASTER_REQUEST] = { 0 };
+  guint8 response[KEYMASTER_RESPONSE] = { 0 };
+  guint8 payload[PAYLOAD_MAX];
+  guint32 status, offset, length;
+  gboolean ok = FALSE;
+
+  if (egisqsee_tee_open (&keymaster, "keymaster64") &&
+      egisqsee_tee_open (&keymaster, "keymaster"))
+    {
+      g_propagate_error (error, transport_error ("Attaching to Keymaster"));
+      return FALSE;
+    }
+  set_u32 (request, 0, KEYMASTER_GET_KEY);
+  set_u32 (request, 4, KEYMASTER_FINGERPRINT);
+  if (egisqsee_tee_send (&keymaster, request, sizeof (request),
+                         response, sizeof (response), NULL, 0))
+    {
+      g_propagate_error (error, transport_error ("Keymaster invoke"));
+      goto out;
+    }
+  status = egisqsee_bix_u32 (response, 0);
+  offset = egisqsee_bix_u32 (response, 4);
+  length = egisqsee_bix_u32 (response, 8);
+  if (status || offset != 12 || !length || length > 256)
+    {
+      g_propagate_error (error, proto_error ("Keymaster key context: status %u, length %u",
+                                             status, length));
+      goto out;
+    }
+  set_u32 (payload, 0, 1);
+  set_u32 (payload, 4, 8 + length);
+  set_u32 (payload, 8, PROP_TOKEN);
+  set_u32 (payload, 12, length);
+  memcpy (payload + 16, response + offset, length);
+  ok = command_ok (bix, CMD_TOKEN, payload, 16 + length, error);
+  explicit_bzero (payload, sizeof (payload));
+
+out:
+  explicit_bzero (response, sizeof (response));
+  egisqsee_tee_close (&keymaster);
+  return ok;
+}
+
+gboolean
+egisqsee_bix_init_sensor (EgisqseeBix *bix, GError **error)
+{
+  /* ree_init_sensor's records: secure capture backend 2 for sensor family
+   * 7, then capture timing. */
+  static const guint8 backend[8] = { 2, 0, 0, 0, 7, 0, 0, 0 };
+  const struct egisqsee_record sensor[] = {
+    { 0x46040101, 8, backend },
+    { 0x62040101, 4, (const guint8[]) { 48, 0, 0, 0 } },
+    { 0x62040118, 4, (const guint8[]) { 0x20, 0x03, 0, 0 } },
+    { 0x62040119, 4, (const guint8[]) { 0xf4, 0x01, 0, 0 } },
+    { 0x62040106, 4, (const guint8[]) { 50, 0, 0, 0 } },
+    { 0x23000101, 4, (const guint8[]) { 1, 0, 0, 0 } },
+  };
+  guint8 echo[REQUEST_SIZE] = { 0 };
+  guint32 status;
+
+  /* The TA's own echo: 7 comes back times ten. */
+  set_u32 (echo, 0, 1);
+  set_u32 (echo, 8, 7);
+  if (egisqsee_tee_send (&bix->tee, echo, sizeof (echo), bix->response,
+                         RESPONSE_SIZE, NULL, 0))
+    {
+      g_propagate_error (error, transport_error ("egisap64 echo"));
+      return FALSE;
+    }
+  if (egisqsee_bix_u32 (bix->response, 0) != 70)
+    {
+      g_propagate_error (error, proto_error ("egisap64 echo returned %u",
+                                             egisqsee_bix_u32 (bix->response, 0)));
+      return FALSE;
+    }
+
+  if (!egisqsee_bix_spi_power (bix, TRUE, error))
+    return FALSE;
+  if (egisqsee_hw_reset (bix->hw))
+    {
+      g_propagate_error (error, transport_error ("Resetting the sensor"));
+      return FALSE;
+    }
+  /* The post-load hello. It answers 1 on a TA that has been initialised
+   * before, which is not an error. */
+  if (!command (bix, CMD_HELLO, NULL, 0, &status, error))
+    return FALSE;
+  if (!token_context (bix, error))
+    return FALSE;
+  return records_ok (bix, CMD_SENSOR_INIT, sensor, G_N_ELEMENTS (sensor),
+                     error);
+}
+
+gboolean
+egisqsee_bix_set_path (EgisqseeBix *bix, const char *path, GError **error)
+{
+  if (g_snprintf (bix->path, sizeof (bix->path), "PATH:%s", path) >=
+      (int) sizeof (bix->path))
+    {
+      g_propagate_error (error, proto_error ("Template path too long"));
+      return FALSE;
+    }
+  return TRUE;
+}
+
+gboolean
+egisqsee_bix_set_active_group (EgisqseeBix *bix, guint32 gid, GError **error)
+{
+  guint8 padded[256] = { 0 };
+  guint8 id[4];
+  struct egisqsee_record records[] = {
+    { PROP_GROUP_PATH, sizeof (padded), padded },
+    { PROP_GROUP_ID, sizeof (id), id },
+  };
+
+  memcpy (padded, bix->path, strlen (bix->path));
+  set_u32 (id, 0, gid);
+  return records_ok (bix, CMD_SET_GROUP, records, G_N_ELEMENTS (records),
+                     error);
+}
+
+gboolean
+egisqsee_bix_get_prop (EgisqseeBix *bix, guint32 id, void *value,
+                       gsize size, GError **error)
+{
+  guint8 payload[4];
+  guint32 length;
+
+  set_u32 (payload, 0, id);
+  if (!command_ok (bix, CMD_GET_PROP, payload, sizeof (payload), error))
+    return FALSE;
+  length = egisqsee_bix_u32 (bix->response, 36);
+  fp_dbg ("Property 0x%08x: %u bytes", id, length);
+  memset (value, 0, size);
+  memcpy (value, bix->data, MIN (size, length));
+  return TRUE;
+}
+
+gboolean
+egisqsee_bix_set_prop (EgisqseeBix *bix, guint32 id, const void *value,
+                       gsize size, GError **error)
+{
+  guint8 payload[PAYLOAD_MAX];
+
+  if (size > sizeof (payload) - 4)
+    {
+      g_propagate_error (error, proto_error ("Property too large"));
+      return FALSE;
+    }
+  set_u32 (payload, 0, id);
+  memcpy (payload + 4, value, size);
+  return command_ok (bix, CMD_SET_PROP, payload, 4 + size, error);
+}
+
+gboolean
+egisqsee_bix_start (EgisqseeBix *bix, guint32 cmd,
+                    const struct egisqsee_record *records, gsize count,
+                    GError **error)
+{
+  return records_ok (bix, cmd, records, count, error);
+}
+
+gboolean
+egisqsee_bix_capture (EgisqseeBix *bix, guint32 cmd, guint32 event,
+                      const struct egisqsee_record *records, gsize count,
+                      guint8 result[EGISQSEE_RESULT_SIZE], GError **error)
+{
+  guint8 payload[PAYLOAD_MAX];
+  struct writer w = { payload, sizeof (payload) };
+  guint32 status, length, drained;
+
+  /* Only the store event carries properties. */
+  if (!serialize (bix, &w, TRUE, event, records, count, error) ||
+      !command (bix, cmd, payload, w.length, &status, error))
+    return FALSE;
+  if (status != EGISQSEE_BIX_OK && status != EGISQSEE_BIX_MORE_DATA)
+    {
+      g_propagate_error (error, proto_error ("BIX 0x%x event 0x%x failed with status %u",
+                                             cmd, event, status));
+      return FALSE;
+    }
+
+  /* The output is a property list; the result is the first value. */
+  memset (result, 0, EGISQSEE_RESULT_SIZE);
+  if (egisqsee_bix_u32 (bix->response, 36) >= 0x18)
+    {
+      length = MIN (egisqsee_bix_u32 (bix->data, 0x14), DATA_SIZE - 0x18);
+      memcpy (result, bix->data + 0x18, MIN (length, EGISQSEE_RESULT_SIZE));
+    }
+
+  /* The rest, the Android auth token and scores, is of no use here; the
+   * TA keeps it pending until it is fetched. */
+  for (drained = 0; status == EGISQSEE_BIX_MORE_DATA && drained < 8; drained++)
+    if (!transact (bix, CMD_PENDING, NULL, 0, &status, error))
+      return FALSE;
+
+  fp_dbg ("BIX 0x%x event 0x%x: status %u image %u capture %u process %u match %u update %u slot %u",
+          cmd, event, egisqsee_bix_u32 (result, EGISQSEE_RESULT_STATUS),
+          egisqsee_bix_u32 (result, EGISQSEE_RESULT_IMAGE),
+          egisqsee_bix_u32 (result, EGISQSEE_RESULT_CAPTURE),
+          egisqsee_bix_u32 (result, EGISQSEE_RESULT_PROCESS),
+          egisqsee_bix_u32 (result, EGISQSEE_RESULT_MATCH),
+          egisqsee_bix_u32 (result, EGISQSEE_RESULT_UPDATE),
+          result[EGISQSEE_RESULT_MATCH_SLOT]);
+  return TRUE;
+}
+
+gboolean
+egisqsee_bix_end (EgisqseeBix *bix, guint32 cmd, GError **error)
+{
+  guint8 payload[8] = { 0 };
+  guint32 status;
+
+  if (!command (bix, cmd, payload, sizeof (payload), &status, error))
+    return FALSE;
+  if (status != EGISQSEE_BIX_OK)
+    fp_dbg ("Workflow end 0x%x: status %u", cmd, status);
+  return TRUE;
+}
+
+gsize
+egisqsee_bix_identity (guint8 *record, gsize size, guint8 slot,
+                       const char *name)
+{
+  gsize length = strnlen (name, IDENTITY_SIZE - IDENTITY_HEADER - 1) + 1;
+
+  g_assert (size >= IDENTITY_SIZE);
+  memset (record, 0, IDENTITY_SIZE);
+  set_u32 (record, 0, IDENTITY_HEADER + length);
+  set_u32 (record, 4, 1);
+  record[8] = slot;
+  set_u32 (record, 9, length);
+  memcpy (record + IDENTITY_HEADER, name, length - 1);
+  return IDENTITY_SIZE;
+}
+
+gboolean
+egisqsee_bix_remove (EgisqseeBix *bix, guint8 slot, const char *name,
+                     GError **error)
+{
+  /* bix_remove's workflow: identity management, mode 1. */
+  const struct egisqsee_record manage[] = {
+    { 0x21040104, 8, (const guint8[]) { 0, 0, 0, 0, 0, 0, 0, 0 } },
+    { 0x42040101, 8, (const guint8[]) { 1, 0, 0, 0, 0, 0, 0, 0 } },
+    { 0x42048102, 8, (const guint8[]) { 3, 0, 0, 0, 1, 0, 0, 0 } },
+    { 0xa0040101, EGISQSEE_RECORD_PATH, NULL },
+    { 0xa1040102, 4, (const guint8[]) { 1, 0, 0, 0 } },
+    { 0x20040102, 4, (const guint8[]) { 0, 0, 0, 0 } },
+    { 0x00000000, 0, NULL },
+  };
+  guint8 identity[IDENTITY_SIZE];
+  struct egisqsee_record record = { PROP_IDENTITY, IDENTITY_SIZE, identity };
+  gboolean ok;
+
+  egisqsee_bix_identity (identity, sizeof (identity), slot, name);
+  if (!records_ok (bix, EGISQSEE_CMD_VERIFY_START, manage,
+                   G_N_ELEMENTS (manage), error))
+    return FALSE;
+  ok = records_ok (bix, EGISQSEE_CMD_IDENTITY, &record, 1, error);
+  return egisqsee_bix_end (bix, EGISQSEE_CMD_VERIFY_END, ok ? error : NULL) && ok;
+}
diff --git a/libfprint/drivers/egisqsee/egisqsee-bix.h b/libfprint/drivers/egisqsee/egisqsee-bix.h
new file mode 100644
index 0000000..65534cd
--- /dev/null
+++ b/libfprint/drivers/egisqsee/egisqsee-bix.h
@@ -0,0 +1,148 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <gio/gio.h>
+
+#include "egisqsee-hw.h"
+#include "egisqsee-tee.h"
+
+/*
+ * BIX, the message protocol of Egis' trusted application egisap64. A
+ * message is a command id and a payload, inline in a 0x880-byte request;
+ * the reply is a status in the response and an output in the data buffer.
+ * While the TA works it may ask the client for help (status 10): a sensor
+ * reset, a platform name. Templates never leave the TA; it stores them,
+ * encrypted, through the GP file listener qsee-supplicant serves.
+ */
+
+#define EGISQSEE_BIX_OK 0u
+#define EGISQSEE_BIX_FAIL 1u
+#define EGISQSEE_BIX_BAD_PARAM 3u
+#define EGISQSEE_BIX_CALLBACK 10u
+#define EGISQSEE_BIX_MORE_DATA 14u
+
+/* Workflow start and end commands, and the capture command of each. */
+#define EGISQSEE_CMD_ENROLL_START 0x10u
+#define EGISQSEE_CMD_ENROLL_CAPTURE 0x11u
+#define EGISQSEE_CMD_ENROLL_END 0x1fu
+#define EGISQSEE_CMD_VERIFY_START 0x20u
+#define EGISQSEE_CMD_VERIFY_CAPTURE 0x21u
+#define EGISQSEE_CMD_VERIFY_END 0x2fu
+#define EGISQSEE_CMD_IDENTITY 0x3003u
+
+/* Events of the capture commands. */
+#define EGISQSEE_EVENT_CAPTURE 1u
+#define EGISQSEE_EVENT_FINGER_OFF 2u
+#define EGISQSEE_EVENT_PROCESS 3u
+#define EGISQSEE_EVENT_STORE 6u
+#define EGISQSEE_EVENT_LEARN 0xfeu
+
+/* The capture result, the value of a capture command's first output
+ * property. Offsets and values from the vendor agent's reads of it. */
+#define EGISQSEE_RESULT_SIZE 0x160
+#define EGISQSEE_RESULT_STATUS 0x00     /* 0x56: retry */
+#define EGISQSEE_RESULT_IMAGE 0x04      /* EGISQSEE_IMAGE_* */
+#define EGISQSEE_RESULT_CAPTURE 0x30    /* FTC: 4 done */
+#define EGISQSEE_RESULT_PROCESS 0x38    /* FTX: enrollment progress */
+#define EGISQSEE_RESULT_MATCH 0x3c      /* FTM: 1 no match, 2 matched */
+#define EGISQSEE_RESULT_UPDATE 0x40     /* FTU: 2 template updated */
+#define EGISQSEE_RESULT_MATCH_SLOT 0x4c /* u8, index into the fid table */
+
+#define EGISQSEE_IMAGE_EMPTY 1u
+#define EGISQSEE_IMAGE_FUZZY_EMPTY 2u
+#define EGISQSEE_IMAGE_NON_FINGER 3u
+#define EGISQSEE_IMAGE_WATER 4u
+#define EGISQSEE_IMAGE_SLIDE 5u
+#define EGISQSEE_IMAGE_NORMAL 0x10u
+#define EGISQSEE_IMAGE_WET 0x11u
+#define EGISQSEE_IMAGE_DRY 0x12u
+#define EGISQSEE_IMAGE_TOO_PARTIAL 0x15u
+#define EGISQSEE_IMAGE_PARTIAL 0x16u
+
+#define EGISQSEE_CAPTURE_DONE 4u
+
+#define EGISQSEE_PROCESS_NONE 0u
+#define EGISQSEE_PROCESS_NOT_COMPLETE 1u
+#define EGISQSEE_PROCESS_DUPLICATE 2u
+#define EGISQSEE_PROCESS_QC_FAIL 3u
+#define EGISQSEE_PROCESS_REDUNDANT 4u
+#define EGISQSEE_PROCESS_DONE 5u
+
+#define EGISQSEE_MATCH_NO 1u
+#define EGISQSEE_MATCH_YES 2u
+
+/* Properties, as the u32 the agent puts on the wire. */
+#define EGISQSEE_PROP_REGISTRATION 0x01022005u /* struct below */
+#define EGISQSEE_PROP_NEW_FID 0x01022006u      /* u32 */
+#define EGISQSEE_PROP_VBT 0x011a6204u          /* u8, sensor health */
+#define EGISQSEE_PROP_TRIGGER 0x010b4204u      /* u32, 1: wait for IRQ */
+#define EGISQSEE_PROP_OPERATION 0x01012006u    /* u64 */
+#define EGISQSEE_PROP_ENROLL_TRIGGER 0x01084004u /* u32, 3 */
+#define EGISQSEE_PROP_ENROLL_PERCENT 0x01074004u /* u8, 0..100 */
+
+#define EGISQSEE_VBT_BAD 0xd6u
+
+/* The registration property: the active group's fid table and identity. */
+#define EGISQSEE_REGISTRATION_SIZE 0x138
+#define EGISQSEE_SLOTS 10
+#define EGISQSEE_REGISTRATION_NAME 0x36
+
+/* A capture or workflow record whose value the driver supplies. */
+#define EGISQSEE_RECORD_PATH 0xfffffff0u
+#define EGISQSEE_RECORD_AUTH_TOKEN 0xfffffff1u
+#define EGISQSEE_AUTH_TOKEN_SIZE 72
+
+struct egisqsee_record {
+  guint32 id;
+  guint32 size;
+  const guint8 *value;
+};
+
+typedef struct {
+  struct egisqsee_tee tee;
+  struct egisqsee_hw *hw;
+  char path[256];
+  guint8 request[0x880];
+  guint8 response[0x840];
+  guint8 data[4096];
+} EgisqseeBix;
+
+gboolean egisqsee_bix_open (EgisqseeBix *bix, struct egisqsee_hw *hw,
+                            GError **error);
+void egisqsee_bix_close (EgisqseeBix *bix);
+
+gboolean egisqsee_bix_init_sensor (EgisqseeBix *bix, GError **error);
+gboolean egisqsee_bix_spi_power (EgisqseeBix *bix, gboolean on,
+                                 GError **error);
+gboolean egisqsee_bix_set_path (EgisqseeBix *bix, const char *path,
+                                GError **error);
+/* Only inside a workflow; see select_group. */
+gboolean egisqsee_bix_set_active_group (EgisqseeBix *bix, guint32 gid,
+                                        GError **error);
+
+gboolean egisqsee_bix_get_prop (EgisqseeBix *bix, guint32 id, void *value,
+                                gsize size, GError **error);
+gboolean egisqsee_bix_set_prop (EgisqseeBix *bix, guint32 id,
+                                const void *value, gsize size,
+                                GError **error);
+
+gboolean egisqsee_bix_start (EgisqseeBix *bix, guint32 command,
+                             const struct egisqsee_record *records,
+                             gsize count, GError **error);
+gboolean egisqsee_bix_capture (EgisqseeBix *bix, guint32 command,
+                               guint32 event,
+                               const struct egisqsee_record *records,
+                               gsize count,
+                               guint8 result[EGISQSEE_RESULT_SIZE],
+                               GError **error);
+/* Ends a workflow; the TA's status is not an error, it may have none. */
+gboolean egisqsee_bix_end (EgisqseeBix *bix, guint32 command,
+                           GError **error);
+
+/* An identity record: the group's name and a slot of its fid table. */
+gsize egisqsee_bix_identity (guint8 *record, gsize size, guint8 slot,
+                             const char *name);
+gboolean egisqsee_bix_remove (EgisqseeBix *bix, guint8 slot,
+                              const char *name, GError **error);
+
+guint32 egisqsee_bix_u32 (const guint8 *buffer, gsize offset);
diff --git a/libfprint/drivers/egisqsee/egisqsee-hw.c b/libfprint/drivers/egisqsee/egisqsee-hw.c
new file mode 100644
index 0000000..01994f9
--- /dev/null
+++ b/libfprint/drivers/egisqsee/egisqsee-hw.c
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "egisqsee-hw.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdint.h>
+#include <sys/eventfd.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+/* drivers/misc/egisfp/egisfp.h in the kernel this phone runs. */
+#define EGISFP_POWER _IOW ('E', 0x81, uint32_t)
+#define EGISFP_RESET _IO ('E', 0x82)
+#define EGISFP_EVENTFD _IOW ('E', 0x83, int32_t)
+#define EGISFP_IRQ_ARM _IOW ('E', 0x84, uint32_t)
+
+int
+egisqsee_hw_open (struct egisqsee_hw *hw, const char *path)
+{
+  int32_t event_fd;
+
+  hw->fd = open (path, O_RDWR | O_CLOEXEC);
+  hw->event_fd = -1;
+  if (hw->fd < 0)
+    return -1;
+  hw->event_fd = eventfd (0, EFD_CLOEXEC | EFD_NONBLOCK);
+  event_fd = hw->event_fd;
+  if (hw->event_fd < 0 || ioctl (hw->fd, EGISFP_EVENTFD, &event_fd))
+    {
+      egisqsee_hw_close (hw);
+      return -1;
+    }
+  return 0;
+}
+
+void
+egisqsee_hw_close (struct egisqsee_hw *hw)
+{
+  /* Closing the device powers the sensor off and drops the eventfd. */
+  if (hw->fd >= 0)
+    close (hw->fd);
+  if (hw->event_fd >= 0)
+    close (hw->event_fd);
+  hw->fd = hw->event_fd = -1;
+}
+
+int
+egisqsee_hw_power (struct egisqsee_hw *hw, gboolean on)
+{
+  uint32_t value = on ? 1 : 0;
+
+  return ioctl (hw->fd, EGISFP_POWER, &value);
+}
+
+int
+egisqsee_hw_reset (struct egisqsee_hw *hw)
+{
+  return ioctl (hw->fd, EGISFP_RESET);
+}
+
+int
+egisqsee_hw_arm (struct egisqsee_hw *hw, guint32 mode)
+{
+  uint64_t stale;
+  uint32_t value = mode;
+
+  /* A notification from an earlier arm must not satisfy this one. */
+  while (read (hw->event_fd, &stale, sizeof (stale)) == sizeof (stale))
+    ;
+  return ioctl (hw->fd, EGISFP_IRQ_ARM, &value);
+}
+
+int
+egisqsee_hw_wait (struct egisqsee_hw *hw, int timeout_ms,
+                  GCancellable *cancellable)
+{
+  struct pollfd fds[2] = {
+    { .fd = hw->event_fd, .events = POLLIN },
+    { .fd = -1, .events = POLLIN },
+  };
+  uint64_t count;
+  int result;
+
+  if (cancellable)
+    fds[1].fd = g_cancellable_get_fd (cancellable);
+  do
+    result = poll (fds, fds[1].fd >= 0 ? 2 : 1, timeout_ms);
+  while (result < 0 && errno == EINTR);
+  if (cancellable)
+    g_cancellable_release_fd (cancellable);
+  if (result <= 0)
+    return result;
+  if (g_cancellable_is_cancelled (cancellable))
+    {
+      errno = ECANCELED;
+      return -1;
+    }
+  if (read (hw->event_fd, &count, sizeof (count)) != sizeof (count))
+    return errno == EAGAIN ? 0 : -1;
+  return 1;
+}
