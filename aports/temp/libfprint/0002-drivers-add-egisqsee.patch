+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <gio/gio.h>
+
+/*
+ * The sensor's power, reset and interrupt line, through the kernel's egisfp
+ * driver. Its SPI bus belongs to TrustZone, so this is all Linux controls.
+ */
+struct egisqsee_hw {
+  int fd;
+  int event_fd;
+};
+
+#define EGISQSEE_IRQ_RISING 1u
+#define EGISQSEE_IRQ_FALLING 2u
+#define EGISQSEE_IRQ_HIGH 4u
+#define EGISQSEE_IRQ_LOW 8u
+
+int egisqsee_hw_open (struct egisqsee_hw *hw, const char *path);
+void egisqsee_hw_close (struct egisqsee_hw *hw);
+int egisqsee_hw_power (struct egisqsee_hw *hw, gboolean on);
+int egisqsee_hw_reset (struct egisqsee_hw *hw);
+int egisqsee_hw_arm (struct egisqsee_hw *hw, guint32 mode);
+/* 1 on an interrupt, 0 on timeout, -1 with errno set, ECANCELED included. */
+int egisqsee_hw_wait (struct egisqsee_hw *hw, int timeout_ms,
+                      GCancellable *cancellable);
