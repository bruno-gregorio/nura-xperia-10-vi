+++ b/libfprint/drivers/egisqsee/egisqsee-tee.c
@@ -0,0 +1,176 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "egisqsee-tee.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/tee.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#define TEE_IMPL_ID_QSEECOM 5u
+#define MEMORY_SIZE (EGISQSEE_TEE_DATA + EGISQSEE_TEE_DATA_MAX)
+
+static int
+open_client_device (void)
+{
+  struct tee_ioctl_version_data version;
+  char path[32];
+  int i, fd;
+
+  for (i = 0; i < 16; i++)
+    {
+      snprintf (path, sizeof (path), "/dev/tee%d", i);
+      fd = open (path, O_RDWR | O_CLOEXEC);
+      if (fd < 0)
+        continue;
+      if (!ioctl (fd, TEE_IOC_VERSION, &version) &&
+          version.impl_id == TEE_IMPL_ID_QSEECOM)
+        return fd;
+      close (fd);
+    }
+  errno = ENODEV;
+  return -1;
+}
+
+void
+egisqsee_tee_close (struct egisqsee_tee *tee)
+{
+  int saved = errno;
+
+  if (tee->session_open)
+    {
+      struct tee_ioctl_close_session_arg arg = { .session = tee->session };
+      ioctl (tee->fd, TEE_IOC_CLOSE_SESSION, &arg);
+    }
+  if (tee->memory)
+    {
+      /* Requests carry the Keymaster token context; leave none behind. */
+      explicit_bzero (tee->memory, tee->memory_size);
+      munmap (tee->memory, tee->memory_size);
+    }
+  if (tee->shm_fd >= 0)
+    close (tee->shm_fd);
+  if (tee->fd >= 0)
+    close (tee->fd);
+  *tee = (struct egisqsee_tee) { .fd = -1, .shm_fd = -1 };
+  errno = saved;
+}
+
+int
+egisqsee_tee_open (struct egisqsee_tee *tee, const char *application)
+{
+  struct tee_ioctl_shm_alloc_data allocation = { .size = MEMORY_SIZE };
+  guint64 storage[(sizeof (struct tee_ioctl_open_session_arg) +
+                   sizeof (struct tee_ioctl_param) + 7) / 8] = { 0 };
+  struct tee_ioctl_open_session_arg *arg = (void *) storage;
+  struct tee_ioctl_buf_data buffer;
+  void *memory;
+
+  *tee = (struct egisqsee_tee) { .fd = -1, .shm_fd = -1 };
+  if (strlen (application) >= EGISQSEE_TEE_RSP)
+    {
+      errno = ENAMETOOLONG;
+      return -1;
+    }
+  tee->fd = open_client_device ();
+  if (tee->fd < 0)
+    return -1;
+  tee->shm_fd = ioctl (tee->fd, TEE_IOC_SHM_ALLOC, &allocation);
+  if (tee->shm_fd < 0)
+    goto fail;
+  tee->shm_id = allocation.id;
+  memory = mmap (NULL, MEMORY_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED,
+                 tee->shm_fd, 0);
+  if (memory == MAP_FAILED)
+    goto fail;
+  tee->memory = memory;
+  tee->memory_size = MEMORY_SIZE;
+  memset (tee->memory, 0, MEMORY_SIZE);
+  memcpy (tee->memory, application, strlen (application) + 1);
+
+  arg->num_params = 1;
+  arg->params[0].attr = TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_INPUT;
+  arg->params[0].b = strlen (application) + 1;
+  arg->params[0].c = tee->shm_id;
+  buffer.buf_ptr = (uintptr_t) storage;
+  buffer.buf_len = sizeof (storage);
+  if (ioctl (tee->fd, TEE_IOC_OPEN_SESSION, &buffer))
+    goto fail;
+  if (arg->ret)
+    {
+      errno = EIO;
+      goto fail;
+    }
+  tee->session = arg->session;
+  tee->session_open = TRUE;
+  return 0;
+
+fail:
+  egisqsee_tee_close (tee);
+  return -1;
+}
+
+int
+egisqsee_tee_send (struct egisqsee_tee *tee,
+                   const guint8 *request, gsize request_size,
+                   guint8 *response, gsize response_size,
+                   guint8 *data, gsize data_size)
+{
+  guint64 storage[(sizeof (struct tee_ioctl_invoke_arg) +
+                   4 * sizeof (struct tee_ioctl_param) + 7) / 8] = { 0 };
+  struct tee_ioctl_invoke_arg *arg = (void *) storage;
+  struct tee_ioctl_buf_data buffer;
+
+  if (!tee->session_open || request_size > EGISQSEE_TEE_RSP ||
+      response_size > EGISQSEE_TEE_DATA - EGISQSEE_TEE_RSP ||
+      data_size > EGISQSEE_TEE_DATA_MAX || (!data && data_size))
+    {
+      errno = EINVAL;
+      return -1;
+    }
+  memset (tee->memory, 0, tee->memory_size);
+  memcpy (tee->memory, request, request_size);
+  if (data)
+    memcpy (tee->memory + EGISQSEE_TEE_DATA, data, data_size);
+
+  arg->session = tee->session;
+  arg->num_params = data ? 4 : 2;
+  arg->params[0].attr = TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_INPUT;
+  arg->params[0].b = request_size;
+  arg->params[0].c = tee->shm_id;
+  arg->params[1].attr = TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_OUTPUT;
+  arg->params[1].a = EGISQSEE_TEE_RSP;
+  arg->params[1].b = response_size;
+  arg->params[1].c = tee->shm_id;
+  if (data)
+    {
+      /* A patch: the value is where in the request to write the next
+       * buffer's address, and how wide. Egis' 0xE0 message carries its
+       * payload pointer at offset 8, 64 bits. */
+      arg->params[2].attr = TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_INPUT;
+      arg->params[2].a = 8;
+      arg->params[2].b = 8;
+      arg->params[3].attr = TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_INOUT;
+      arg->params[3].a = EGISQSEE_TEE_DATA;
+      arg->params[3].b = data_size;
+      arg->params[3].c = tee->shm_id;
+    }
+  /* The kernel wants the length of exactly num_params parameters. */
+  buffer.buf_ptr = (uintptr_t) storage;
+  buffer.buf_len = sizeof (*arg) + arg->num_params * sizeof (arg->params[0]);
+  if (ioctl (tee->fd, TEE_IOC_INVOKE, &buffer))
+    return -1;
+  if (arg->ret || arg->params[1].b != response_size ||
+      (data && arg->params[3].b != data_size))
+    {
+      errno = EIO;
+      return -1;
+    }
+  memcpy (response, tee->memory + EGISQSEE_TEE_RSP, response_size);
+  if (data)
+    memcpy (data, tee->memory + EGISQSEE_TEE_DATA, data_size);
+  return 0;
+}
diff --git a/libfprint/drivers/egisqsee/egisqsee-tee.h b/libfprint/drivers/egisqsee/egisqsee-tee.h
new file mode 100644
index 0000000..5d0a383
--- /dev/null
+++ b/libfprint/drivers/egisqsee/egisqsee-tee.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <glib.h>
+
+/*
+ * A session with a QSEECom trusted application through the Linux TEE
+ * subsystem's QSEECom driver: /dev/teeN, implementation ID 5. The session
+ * attaches to a TA something else keeps loaded (qsee-app-loader); it never
+ * loads one. A command is a request and a response buffer and, for Egis'
+ * messages, a data buffer whose address TrustZone patches into the request.
+ *
+ * One shared-memory block holds all three: request at 0, response at
+ * EGISQSEE_TEE_RSP, data at EGISQSEE_TEE_DATA.
+ */
+#define EGISQSEE_TEE_RSP 4096
+#define EGISQSEE_TEE_DATA 8192
+#define EGISQSEE_TEE_DATA_MAX 4096
+
+struct egisqsee_tee {
+  int fd;
+  int shm_fd;
+  gint32 shm_id;
+  guint32 session;
+  gboolean session_open;
+  guint8 *memory;
+  gsize memory_size;
+};
+
+int egisqsee_tee_open (struct egisqsee_tee *tee, const char *application);
+void egisqsee_tee_close (struct egisqsee_tee *tee);
+/* @data may be NULL for a command without one; it is updated in place. */
+int egisqsee_tee_send (struct egisqsee_tee *tee,
+                       const guint8 *request, gsize request_size,
+                       guint8 *response, gsize response_size,
+                       guint8 *data, gsize data_size);
diff --git a/libfprint/drivers/egisqsee/egisqsee.c b/libfprint/drivers/egisqsee/egisqsee.c
new file mode 100644
index 0000000..299d3d2
--- /dev/null
+++ b/libfprint/drivers/egisqsee/egisqsee.c
@@ -0,0 +1,866 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Egis fingerprint sensors behind Qualcomm TrustZone, such as the EC617 in
+ * the Sony Xperia 10 VI. TrustZone owns the sensor's SPI bus; Egis' trusted
+ * application egisap64 captures, matches and stores templates, encrypted,
+ * through the GP file listener of qsee-supplicant, whose loader keeps the TA
+ * loaded. Linux holds the sensor's power, reset and finger interrupt, through
+ * the kernel's egisfp driver. Matching happens on the TA's own templates, so
+ * prints here only name a template: its group and finger id.
+ *
+ * The flows follow the vendor's Android agent, which these were recovered
+ * from for interoperability; the TA expects them.
+ */
+#define FP_COMPONENT "egisqsee"
+
+#include "drivers_api.h"
+#include "egisqsee-bix.h"
+#include "egisqsee-hw.h"
+#include "egisqsee-records.h"
+
+#include <errno.h>
+#include <string.h>
+
+/* The TA's template storage. One group holds every Linux user's fingers;
+ * fprintd keeps track of whose they are. The path is Android's, which the
+ * TA was built for; qsee-supplicant keeps it under its state directory. */
+#define GROUP_ID 0u
+#define GROUP_PATH "/data/vendor_de/0/fpdata"
+#define IDENTITY_NAME "User-0"
+
+/* The TA finishes an enrollment by itself once it has enough coverage, at
+ * most after its configured 20 touches. */
+#define ENROLL_STAGES 20
+
+/* The finger interrupt fires on its rising edge. */
+#define FINGER_IRQ EGISQSEE_IRQ_RISING
+/* Finger waits also capture again when the interrupt stays quiet. The
+ * agent relies on the interrupt alone; until it is proven for every flow
+ * here, a missed one costs a second, not the whole operation. */
+#define FINGER_ON_POLL_MS 1000
+#define FINGER_OFF_POLL_MS 250
+
+/* The agent's enrollment trigger, impl[312], 3 unless configured. With 0
+ * the sensor never raised its interrupt for a touch. */
+#define ENROLL_TRIGGER 3
+
+struct _FpiDeviceEgisqsee {
+  FpDevice parent;
+  struct egisqsee_hw hw;
+  EgisqseeBix *bix;
+};
+
+G_DECLARE_FINAL_TYPE (FpiDeviceEgisqsee, fpi_device_egisqsee, FPI,
+                      DEVICE_EGISQSEE, FpDevice)
+G_DEFINE_TYPE (FpiDeviceEgisqsee, fpi_device_egisqsee, FP_TYPE_DEVICE)
+
+static const FpIdEntry id_table[] = {
+  { .udev_types = FPI_DEVICE_UDEV_SUBTYPE_MISC, .misc_name = "egisfp0" },
+  { .udev_types = 0 }
+};
+
+enum operation {
+  OP_OPEN, OP_CLOSE, OP_LIST, OP_DELETE, OP_CLEAR, OP_ENROLL, OP_MATCH,
+};
+
+struct work {
+  enum operation operation;
+  guint32 fid;
+};
+
+struct match {
+  gboolean matched;
+  guint32 fid;
+  GError *retry;
+};
+
+struct progress {
+  FpiDeviceEgisqsee *self;
+  FpFingerStatusFlags finger;
+  gint stage;   /* an enrollment stage passed, or -1 */
+  GError *retry;
+};
+
+/* Main-thread reports from the worker. */
+static gboolean
+progress_in_main (gpointer data)
+{
+  struct progress *p = data;
+  FpDevice *device = FP_DEVICE (p->self);
+
+  fpi_device_report_finger_status (device, p->finger);
+  if ((p->stage >= 0 || p->retry) &&
+      fpi_device_get_current_action (device) == FPI_DEVICE_ACTION_ENROLL)
+    fpi_device_enroll_progress (device, MAX (p->stage, 0), NULL,
+                                g_steal_pointer (&p->retry));
+  g_clear_error (&p->retry);
+  g_object_unref (p->self);
+  g_free (p);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+report (FpiDeviceEgisqsee *self, FpFingerStatusFlags finger, gint stage,
+        GError *retry)
+{
+  struct progress *p = g_new0 (struct progress, 1);
+
+  p->self = g_object_ref (self);
+  p->finger = finger;
+  p->stage = stage;
+  p->retry = retry;
+  g_main_context_invoke (NULL, progress_in_main, p);
+}
+
+static GError *
+hw_error (const char *operation)
+{
+  if (errno == ECANCELED)
+    return g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED,
+                                "Operation cancelled");
+  return fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL, "%s: %s",
+                                   operation, g_strerror (errno));
+}
+
+/* Waits for a finger to come or go, with the SPI bus released meanwhile, as
+ * the vendor agent does; with a timeout, returns when it runs out too. */
+static gboolean
+wait_finger (FpiDeviceEgisqsee *self, int timeout_ms,
+             GCancellable *cancellable, GError **error)
+{
+  gboolean seen = FALSE;
+  int rc;
+
+  if (!egisqsee_bix_spi_power (self->bix, FALSE, error))
+    return FALSE;
+  if (egisqsee_hw_arm (&self->hw, FINGER_IRQ))
+    {
+      g_propagate_error (error, hw_error ("Arming the finger interrupt"));
+    }
+  else
+    {
+      rc = egisqsee_hw_wait (&self->hw, timeout_ms, cancellable);
+      if (rc > 0 || (rc == 0 && timeout_ms >= 0))
+        seen = TRUE;
+      else
+        g_propagate_error (error, hw_error ("Waiting for the finger"));
+      fp_dbg ("Finger wait: %s", rc > 0 ? "interrupt" : rc == 0 ? "timed out" : "failed");
+      egisqsee_hw_arm (&self->hw, 0);
+    }
+  /* The bus goes back on even after a cancel: the workflow end needs it. */
+  if (!egisqsee_bix_spi_power (self->bix, TRUE, seen ? error : NULL))
+    return FALSE;
+  return seen;
+}
+
+static gboolean
+get_registration (FpiDeviceEgisqsee *self,
+                  guint8 registration[EGISQSEE_REGISTRATION_SIZE],
+                  GError **error)
+{
+  return egisqsee_bix_get_prop (self->bix, EGISQSEE_PROP_REGISTRATION,
+                                registration, EGISQSEE_REGISTRATION_SIZE,
+                                error);
+}
+
+static guint32
+slot_fid (const guint8 *registration, guint slot)
+{
+  return egisqsee_bix_u32 (registration, 4 * slot);
+}
+
+static gboolean
+check_sensor (FpiDeviceEgisqsee *self, GError **error)
+{
+  guint8 vbt;
+
+  if (!egisqsee_bix_get_prop (self->bix, EGISQSEE_PROP_VBT, &vbt, 1, error))
+    return FALSE;
+  fp_dbg ("Sensor vbt 0x%02x", vbt);
+  if (vbt >= EGISQSEE_VBT_BAD)
+    {
+      g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                   "Sensor reports a fault (vbt 0x%02x)", vbt);
+      return FALSE;
+    }
+  return TRUE;
+}
+
+/* Captures until the TA has a usable image, waiting for the finger between
+ * tries. */
+static gboolean
+capture_finger (FpiDeviceEgisqsee *self, guint32 command,
+                guint8 result[EGISQSEE_RESULT_SIZE],
+                GCancellable *cancellable, GError **error)
+{
+  for (;;)
+    {
+      if (g_cancellable_set_error_if_cancelled (cancellable, error))
+        return FALSE;
+      if (!egisqsee_bix_capture (self->bix, command, EGISQSEE_EVENT_CAPTURE,
+                                 NULL, 0, result, error))
+        return FALSE;
+      if (egisqsee_bix_u32 (result, EGISQSEE_RESULT_CAPTURE) ==
+          EGISQSEE_CAPTURE_DONE)
+        {
+          report (self, FP_FINGER_STATUS_PRESENT, -1, NULL);
+          return TRUE;
+        }
+      report (self, FP_FINGER_STATUS_NEEDED, -1, NULL);
+      if (!wait_finger (self, FINGER_ON_POLL_MS, cancellable, error))
+        return FALSE;
+    }
+}
+
+/* Waits for the finger to lift, so that the next touch is a new one. */
+static gboolean
+await_finger_off (FpiDeviceEgisqsee *self, guint32 command,
+                  GCancellable *cancellable, GError **error)
+{
+  guint8 result[EGISQSEE_RESULT_SIZE];
+
+  for (;;)
+    {
+      if (!egisqsee_bix_capture (self->bix, command, EGISQSEE_EVENT_FINGER_OFF,
+                                 NULL, 0, result, error))
+        return FALSE;
+      if (egisqsee_bix_u32 (result, EGISQSEE_RESULT_IMAGE) ==
+          EGISQSEE_IMAGE_EMPTY)
+        {
+          report (self, FP_FINGER_STATUS_NONE, -1, NULL);
+          return TRUE;
+        }
+      /* Whether lifting the finger raises the interrupt is not known;
+       * look again now and then either way. */
+      if (!wait_finger (self, FINGER_OFF_POLL_MS, cancellable, error))
+        return FALSE;
+    }
+}
+
+static GError *
+enroll_retry (guint32 process)
+{
+  switch (process)
+    {
+    case EGISQSEE_PROCESS_REDUNDANT:
+      return fpi_device_retry_new_msg (FP_DEVICE_RETRY_REMOVE_FINGER,
+                                       "This part of the finger was already scanned");
+    case EGISQSEE_PROCESS_DUPLICATE:
+      return fpi_device_retry_new_msg (FP_DEVICE_RETRY_REMOVE_FINGER,
+                                       "This finger looks already enrolled");
+    default:
+      return fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL);
+    }
+}
+
+static gboolean
+enroll (FpiDeviceEgisqsee *self, GCancellable *cancellable, guint32 *fid,
+        GError **error)
+{
+  guint8 registration[EGISQSEE_REGISTRATION_SIZE];
+  guint8 result[EGISQSEE_RESULT_SIZE];
+  guint8 identity[0x10d], store_flag[4] = { 0 };
+  const struct egisqsee_record store[] = {
+    { 0x40040105, sizeof (identity), identity },
+    { 0x20050101, sizeof (store_flag), store_flag },
+  };
+  const guint32 trigger = ENROLL_TRIGGER;
+  gboolean started = FALSE, ok = FALSE;
+  gint touches = 0;
+  guint slot;
+
+  if (!get_registration (self, registration, error))
+    return FALSE;
+  for (slot = 0; slot < EGISQSEE_SLOTS && slot_fid (registration, slot); slot++)
+    ;
+  if (slot == EGISQSEE_SLOTS)
+    {
+      g_propagate_error (error, fpi_device_error_new (FP_DEVICE_ERROR_DATA_FULL));
+      return FALSE;
+    }
+
+  if (!egisqsee_bix_start (self->bix, EGISQSEE_CMD_ENROLL_START,
+                           egisqsee_enroll_start,
+                           G_N_ELEMENTS (egisqsee_enroll_start), error))
+    return FALSE;
+  started = TRUE;
+  if (!check_sensor (self, error) ||
+      !egisqsee_bix_set_prop (self->bix, EGISQSEE_PROP_ENROLL_TRIGGER,
+                              &trigger, sizeof (trigger), error) ||
+      !egisqsee_bix_get_prop (self->bix, EGISQSEE_PROP_NEW_FID, fid,
+                              sizeof (*fid), error))
+    goto out;
+  *fid = GUINT32_FROM_LE (*fid);
+  fp_dbg ("Enrolling finger id %u", *fid);
+
+  for (;;)
+    {
+      guint32 process;
+
+      if (!capture_finger (self, EGISQSEE_CMD_ENROLL_CAPTURE, result,
+                           cancellable, error) ||
+          !egisqsee_bix_capture (self->bix, EGISQSEE_CMD_ENROLL_CAPTURE,
+                                 EGISQSEE_EVENT_PROCESS, NULL, 0, result,
+                                 error))
+        goto out;
+      process = egisqsee_bix_u32 (result, EGISQSEE_RESULT_PROCESS);
+      if (process == EGISQSEE_PROCESS_DONE)
+        break;
+      if (process == EGISQSEE_PROCESS_NOT_COMPLETE)
+        {
+          guint8 percent;
+
+          /* The TA's own coverage, which the agent polls too. Its sample
+           * target is not known yet; 19 good touches were not enough. */
+          if (egisqsee_bix_get_prop (self->bix, EGISQSEE_PROP_ENROLL_PERCENT,
+                                     &percent, sizeof (percent), NULL))
+            {
+              fp_dbg ("Enrollment at %u%% after %d touches", percent, touches + 1);
+              if (percent >= 100)
+                break;
+            }
+          report (self, FP_FINGER_STATUS_PRESENT, MIN (++touches, ENROLL_STAGES - 1), NULL);
+        }
+      else
+        report (self, FP_FINGER_STATUS_PRESENT, touches, enroll_retry (process));
+      if (!await_finger_off (self, EGISQSEE_CMD_ENROLL_CAPTURE, cancellable,
+                             error))
+        goto out;
+    }
+
+  /* The TA picks the slot; the identity names the group. */
+  egisqsee_bix_identity (identity, sizeof (identity), 0, IDENTITY_NAME);
+  if (!egisqsee_bix_capture (self->bix, EGISQSEE_CMD_ENROLL_CAPTURE,
+                             EGISQSEE_EVENT_STORE, store, G_N_ELEMENTS (store),
+                             result, error))
+    goto out;
+  if (egisqsee_bix_u32 (result, EGISQSEE_RESULT_STATUS))
+    {
+      g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                   "Storing the template failed with status %u",
+                   egisqsee_bix_u32 (result, EGISQSEE_RESULT_STATUS));
+      goto out;
+    }
+  ok = TRUE;
+
+out:
+  if (started)
+    egisqsee_bix_end (self->bix, EGISQSEE_CMD_ENROLL_END, ok ? error : NULL);
+  report (self, FP_FINGER_STATUS_NONE, -1, NULL);
+  return ok && !(error && *error);
+}
+
+static gboolean
+match (FpiDeviceEgisqsee *self, GCancellable *cancellable,
+       struct match *outcome, GError **error)
+{
+  guint8 registration[EGISQSEE_REGISTRATION_SIZE];
+  guint8 result[EGISQSEE_RESULT_SIZE];
+  const guint32 trigger = 1;
+  const guint64 operation = 0;
+  gboolean started = FALSE, ok = FALSE;
+  guint32 decision;
+  guint slot;
+
+  if (!get_registration (self, registration, error))
+    return FALSE;
+  /* With nothing enrolled there is nothing to match against, and fprintd
+   * identifies before every enrollment, the first one included. */
+  for (slot = 0; slot < EGISQSEE_SLOTS && !slot_fid (registration, slot); slot++)
+    ;
+  if (slot == EGISQSEE_SLOTS)
+    return TRUE;
+  if (!egisqsee_bix_start (self->bix, EGISQSEE_CMD_VERIFY_START,
+                           egisqsee_verify_start,
+                           G_N_ELEMENTS (egisqsee_verify_start), error))
+    return FALSE;
+  started = TRUE;
+  /* Trigger 1: the TA expects the client to wait for the interrupt
+   * between captures, rather than poll. */
+  if (!check_sensor (self, error) ||
+      !egisqsee_bix_set_prop (self->bix, EGISQSEE_PROP_TRIGGER, &trigger,
+                              sizeof (trigger), error) ||
+      !egisqsee_bix_set_prop (self->bix, EGISQSEE_PROP_OPERATION, &operation,
+                              sizeof (operation), error) ||
+      !capture_finger (self, EGISQSEE_CMD_VERIFY_CAPTURE, result, cancellable,
+                       error) ||
+      !egisqsee_bix_capture (self->bix, EGISQSEE_CMD_VERIFY_CAPTURE,
+                             EGISQSEE_EVENT_PROCESS, NULL, 0, result, error))
+    goto out;
+
+  decision = egisqsee_bix_u32 (result, EGISQSEE_RESULT_MATCH);
+  slot = result[EGISQSEE_RESULT_MATCH_SLOT];
+  if (decision == EGISQSEE_MATCH_YES)
+    {
+      if (slot >= EGISQSEE_SLOTS || !slot_fid (registration, slot))
+        {
+          g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                       "Match in an empty slot %u", slot);
+          goto out;
+        }
+      outcome->matched = TRUE;
+      outcome->fid = slot_fid (registration, slot);
+      /* Let the TA refine the template from this touch, as on Android. */
+      {
+        g_autoptr(GError) learn_error = NULL;
+        if (!egisqsee_bix_capture (self->bix, EGISQSEE_CMD_VERIFY_CAPTURE,
+                                   EGISQSEE_EVENT_LEARN, NULL, 0, result,
+                                   &learn_error))
+          fp_warn ("Template update failed: %s", learn_error->message);
+      }
+    }
+  else
+    {
+      if (decision != EGISQSEE_MATCH_NO)
+        outcome->retry = fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL);
+      /* As on Android: the next attempt is a new touch, not the same one
+       * scanned again. */
+      if (!await_finger_off (self, EGISQSEE_CMD_VERIFY_CAPTURE, cancellable,
+                             error))
+        goto out;
+    }
+  ok = TRUE;
+
+out:
+  if (started)
+    egisqsee_bix_end (self->bix, EGISQSEE_CMD_VERIFY_END, ok ? error : NULL);
+  report (self, FP_FINGER_STATUS_NONE, -1, NULL);
+  return ok && !(error && *error);
+}
+
+static gboolean
+remove_fid (FpiDeviceEgisqsee *self, guint32 fid, GError **error)
+{
+  guint8 registration[EGISQSEE_REGISTRATION_SIZE];
+  char name[EGISQSEE_REGISTRATION_SIZE - EGISQSEE_REGISTRATION_NAME + 1] = { 0 };
+  guint slot;
+
+  if (!get_registration (self, registration, error))
+    return FALSE;
+  memcpy (name, registration + EGISQSEE_REGISTRATION_NAME,
+          EGISQSEE_REGISTRATION_SIZE - EGISQSEE_REGISTRATION_NAME);
+  for (slot = 0; slot < EGISQSEE_SLOTS; slot++)
+    {
+      if (!slot_fid (registration, slot) ||
+          (fid && slot_fid (registration, slot) != fid))
+        continue;
+      if (!egisqsee_bix_remove (self->bix, slot, name, error))
+        return FALSE;
+      if (fid)
+        return TRUE;
+    }
+  if (fid)
+    {
+      g_propagate_error (error, fpi_device_error_new (FP_DEVICE_ERROR_DATA_NOT_FOUND));
+      return FALSE;
+    }
+  return TRUE;
+}
+
+static void
+close_hardware (FpiDeviceEgisqsee *self)
+{
+  if (self->bix)
+    {
+      egisqsee_bix_spi_power (self->bix, FALSE, NULL);
+      egisqsee_bix_close (self->bix);
+      g_clear_pointer (&self->bix, g_free);
+    }
+  if (self->hw.fd >= 0)
+    egisqsee_hw_power (&self->hw, FALSE);
+  egisqsee_hw_close (&self->hw);
+}
+
+/* The TA refuses the group (status 4) outside a workflow. bix_set_active_group
+ * arms a verification and checks the sensor first, as here. */
+static gboolean
+select_group (FpiDeviceEgisqsee *self, GError **error)
+{
+  gboolean ok;
+
+  if (!egisqsee_bix_set_path (self->bix, GROUP_PATH, error) ||
+      !egisqsee_bix_start (self->bix, EGISQSEE_CMD_VERIFY_START,
+                           egisqsee_verify_start,
+                           G_N_ELEMENTS (egisqsee_verify_start), error))
+    return FALSE;
+  ok = check_sensor (self, error) &&
+       egisqsee_bix_set_active_group (self->bix, GROUP_ID, error);
+  return egisqsee_bix_end (self->bix, EGISQSEE_CMD_VERIFY_END,
+                           ok ? error : NULL) && ok;
+}
+
+static gboolean
+open_hardware (FpiDeviceEgisqsee *self, GError **error)
+{
+  const char *node = fpi_device_get_udev_data (FP_DEVICE (self),
+                                               FPI_DEVICE_UDEV_SUBTYPE_MISC);
+
+  if (egisqsee_hw_open (&self->hw, node) ||
+      egisqsee_hw_power (&self->hw, TRUE) ||
+      egisqsee_hw_reset (&self->hw))
+    {
+      g_propagate_error (error, hw_error ("Powering the sensor"));
+      return FALSE;
+    }
+  self->bix = g_new0 (EgisqseeBix, 1);
+  return egisqsee_bix_open (self->bix, &self->hw, error) &&
+         egisqsee_bix_init_sensor (self->bix, error) &&
+         select_group (self, error);
+}
+
+static GPtrArray *
+list_fids (FpiDeviceEgisqsee *self, GError **error)
+{
+  guint8 registration[EGISQSEE_REGISTRATION_SIZE];
+  GPtrArray *fids;
+  guint slot;
+
+  if (!get_registration (self, registration, error))
+    return NULL;
+  fids = g_ptr_array_new ();
+  for (slot = 0; slot < EGISQSEE_SLOTS; slot++)
+    if (slot_fid (registration, slot))
+      g_ptr_array_add (fids, GUINT_TO_POINTER (slot_fid (registration, slot)));
+  return fids;
+}
+
+static void
+worker (GTask *task, gpointer object, gpointer data, GCancellable *cancellable)
+{
+  FpiDeviceEgisqsee *self = object;
+  struct work *work = data;
+  g_autoptr(GError) error = NULL;
+
+  switch (work->operation)
+    {
+    case OP_OPEN:
+      if (open_hardware (self, &error))
+        {
+          g_task_return_boolean (task, TRUE);
+          return;
+        }
+      close_hardware (self);
+      break;
+
+    case OP_CLOSE:
+      close_hardware (self);
+      g_task_return_boolean (task, TRUE);
+      return;
+
+    case OP_LIST:
+      {
+        GPtrArray *fids = list_fids (self, &error);
+        if (!fids)
+          break;
+        g_task_return_pointer (task, fids, (GDestroyNotify) g_ptr_array_unref);
+        return;
+      }
+
+    case OP_DELETE:
+    case OP_CLEAR:
+      if (!remove_fid (self, work->fid, &error))
+        break;
+      g_task_return_boolean (task, TRUE);
+      return;
+
+    case OP_ENROLL:
+      {
+        guint32 fid = 0;
+        if (!enroll (self, cancellable, &fid, &error))
+          break;
+        g_task_return_pointer (task, GUINT_TO_POINTER (fid), NULL);
+        return;
+      }
+
+    case OP_MATCH:
+      {
+        struct match *outcome = g_new0 (struct match, 1);
+        if (!match (self, cancellable, outcome, &error))
+          {
+            g_free (outcome);
+            break;
+          }
+        g_task_return_pointer (task, outcome, g_free);
+        return;
+      }
+    }
+  g_task_return_error (task, g_steal_pointer (&error));
+}
+
+static void
+start (FpDevice *device, enum operation operation, guint32 fid,
+       GAsyncReadyCallback done)
+{
+  g_autoptr(GTask) task = NULL;
+  struct work *work = g_new0 (struct work, 1);
+
+  task = g_task_new (device, operation == OP_OPEN || operation == OP_CLOSE ?
+                     NULL : fpi_device_get_cancellable (device), done, NULL);
+  work->operation = operation;
+  work->fid = fid;
+  g_task_set_task_data (task, work, g_free);
+  g_task_run_in_thread (task, worker);
+}
+
+static FpPrint *
+print_new (FpDevice *device, FpPrint *print, guint32 fid)
+{
+  if (!print)
+    print = fp_print_new (device);
+  fpi_print_set_type (print, FPI_PRINT_RAW);
+  fpi_print_set_device_stored (print, TRUE);
+  g_object_set (print, "fpi-data", g_variant_new ("(uu)", GROUP_ID, fid),
+                NULL);
+  return print;
+}
+
+static gboolean
+print_fid (FpPrint *print, guint32 *fid)
+{
+  g_autoptr(GVariant) data = NULL;
+  guint32 gid;
+
+  g_object_get (print, "fpi-data", &data, NULL);
+  if (!data || !g_variant_is_of_type (data, G_VARIANT_TYPE ("(uu)")))
+    return FALSE;
+  g_variant_get (data, "(uu)", &gid, fid);
+  return gid == GROUP_ID && *fid;
+}
+
+static void
+open_done (GObject *object, GAsyncResult *result, gpointer data)
+{
+  GError *error = NULL;
+
+  g_task_propagate_boolean (G_TASK (result), &error);
+  fpi_device_open_complete (FP_DEVICE (object), error);
+}
+
+static void
+close_done (GObject *object, GAsyncResult *result, gpointer data)
+{
+  GError *error = NULL;
+
+  g_task_propagate_boolean (G_TASK (result), &error);
+  fpi_device_close_complete (FP_DEVICE (object), error);
+}
+
+static void
+delete_done (GObject *object, GAsyncResult *result, gpointer data)
+{
+  GError *error = NULL;
+
+  g_task_propagate_boolean (G_TASK (result), &error);
+  fpi_device_delete_complete (FP_DEVICE (object), error);
+}
+
+static void
+clear_done (GObject *object, GAsyncResult *result, gpointer data)
+{
+  GError *error = NULL;
+
+  g_task_propagate_boolean (G_TASK (result), &error);
+  fpi_device_clear_storage_complete (FP_DEVICE (object), error);
+}
+
+static void
+list_done (GObject *object, GAsyncResult *result, gpointer data)
+{
+  FpDevice *device = FP_DEVICE (object);
+  GError *error = NULL;
+  g_autoptr(GPtrArray) fids = g_task_propagate_pointer (G_TASK (result), &error);
+  GPtrArray *prints;
+  guint i;
+
+  if (!fids)
+    {
+      fpi_device_list_complete (device, NULL, error);
+      return;
+    }
+  prints = g_ptr_array_new_with_free_func (g_object_unref);
+  for (i = 0; i < fids->len; i++)
+    g_ptr_array_add (prints, g_object_ref_sink (
+                       print_new (device, NULL, GPOINTER_TO_UINT (g_ptr_array_index (fids, i)))));
+  fpi_device_list_complete (device, prints, NULL);
+}
+
+static void
+enroll_done (GObject *object, GAsyncResult *result, gpointer data)
+{
+  FpDevice *device = FP_DEVICE (object);
+  GError *error = NULL;
+  guint32 fid = GPOINTER_TO_UINT (g_task_propagate_pointer (G_TASK (result), &error));
+  FpPrint *print = NULL;
+
+  if (error)
+    {
+      fpi_device_enroll_complete (device, NULL, error);
+      return;
+    }
+  fpi_device_get_enroll_data (device, &print);
+  fpi_device_enroll_progress (device, ENROLL_STAGES, NULL, NULL);
+  fpi_device_enroll_complete (device, g_object_ref (print_new (device, print, fid)),
+                              NULL);
+}
+
+static void
+match_done (GObject *object, GAsyncResult *result, gpointer data)
+{
+  FpDevice *device = FP_DEVICE (object);
+  GError *error = NULL;
+  g_autofree struct match *outcome = g_task_propagate_pointer (G_TASK (result), &error);
+  gboolean verifying = fpi_device_get_current_action (device) == FPI_DEVICE_ACTION_VERIFY;
+  FpPrint *found = NULL;
+  g_autoptr(FpPrint) scan = NULL;
+
+  if (!outcome)
+    {
+      if (verifying)
+        fpi_device_verify_complete (device, error);
+      else
+        fpi_device_identify_complete (device, error);
+      return;
+    }
+
+  if (outcome->matched)
+    {
+      g_autoptr(GPtrArray) gallery = NULL;
+      FpPrint *print = NULL;
+      guint32 fid;
+      guint i;
+
+      scan = g_object_ref_sink (print_new (device, NULL, outcome->fid));
+      if (verifying)
+        {
+          fpi_device_get_verify_data (device, &print);
+          gallery = g_ptr_array_new ();
+          g_ptr_array_add (gallery, print);
+        }
+      else
+        {
+          fpi_device_get_identify_data (device, &gallery);
+          g_ptr_array_ref (gallery);
+        }
+      for (i = 0; i < gallery->len && !found; i++)
+        if (print_fid (g_ptr_array_index (gallery, i), &fid) && fid == outcome->fid)
+          found = g_ptr_array_index (gallery, i);
+    }
+
+  if (verifying)
+    {
+      if (outcome->retry)
+        fpi_device_verify_report (device, FPI_MATCH_ERROR, NULL,
+                                  g_steal_pointer (&outcome->retry));
+      else
+        fpi_device_verify_report (device, found ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL,
+                                  g_steal_pointer (&scan), NULL);
+      fpi_device_verify_complete (device, NULL);
+    }
+  else
+    {
+      if (outcome->retry)
+        fpi_device_identify_report (device, NULL, NULL,
+                                    g_steal_pointer (&outcome->retry));
+      else
+        fpi_device_identify_report (device, found, g_steal_pointer (&scan), NULL);
+      fpi_device_identify_complete (device, NULL);
+    }
+}
+
+static void
+dev_probe (FpDevice *device)
+{
+  fpi_device_probe_complete (device, "egisap64", NULL, NULL);
+}
+
+static void
+dev_open (FpDevice *device)
+{
+  start (device, OP_OPEN, 0, open_done);
+}
+
+static void
+dev_close (FpDevice *device)
+{
+  start (device, OP_CLOSE, 0, close_done);
+}
+
+static void
+dev_list (FpDevice *device)
+{
+  start (device, OP_LIST, 0, list_done);
+}
+
+static void
+dev_delete (FpDevice *device)
+{
+  FpPrint *print = NULL;
+  guint32 fid;
+
+  fpi_device_get_delete_data (device, &print);
+  if (!print_fid (print, &fid))
+    {
+      fpi_device_delete_complete (device,
+                                  fpi_device_error_new (FP_DEVICE_ERROR_DATA_INVALID));
+      return;
+    }
+  start (device, OP_DELETE, fid, delete_done);
+}
+
+static void
+dev_clear_storage (FpDevice *device)
+{
+  start (device, OP_CLEAR, 0, clear_done);
+}
+
+static void
+dev_enroll (FpDevice *device)
+{
+  start (device, OP_ENROLL, 0, enroll_done);
+}
+
+static void
+dev_match (FpDevice *device)
+{
+  start (device, OP_MATCH, 0, match_done);
+}
+
+static void
+dev_cancel (FpDevice *device)
+{
+  /* The worker watches the action's cancellable, also while it waits for
+   * the finger, and ends the TA workflow before it returns. */
+}
+
+static void
+fpi_device_egisqsee_init (FpiDeviceEgisqsee *self)
+{
+  self->hw.fd = self->hw.event_fd = -1;
+}
+
+static void
+fpi_device_egisqsee_class_init (FpiDeviceEgisqseeClass *klass)
+{
+  FpDeviceClass *dev_class = FP_DEVICE_CLASS (klass);
+
+  dev_class->id = FP_COMPONENT;
+  dev_class->full_name = "Egis fingerprint sensor (Qualcomm TrustZone)";
+  dev_class->type = FP_DEVICE_TYPE_UDEV;
+  dev_class->id_table = id_table;
+  dev_class->scan_type = FP_SCAN_TYPE_PRESS;
+  dev_class->nr_enroll_stages = ENROLL_STAGES;
+  dev_class->temp_hot_seconds = -1;
+
+  dev_class->probe = dev_probe;
+  dev_class->open = dev_open;
+  dev_class->close = dev_close;
+  dev_class->list = dev_list;
+  dev_class->delete = dev_delete;
+  dev_class->clear_storage = dev_clear_storage;
+  dev_class->enroll = dev_enroll;
+  dev_class->verify = dev_match;
+  dev_class->identify = dev_match;
+  dev_class->cancel = dev_cancel;
+
+  fpi_device_class_auto_initialize_features (dev_class);
+}
