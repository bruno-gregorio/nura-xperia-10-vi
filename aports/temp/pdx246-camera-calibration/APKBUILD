maintainer="Bruno Gregorio <accounts@bruno.pw>"
pkgname=pdx246-camera-calibration
pkgver=1
pkgrel=3
pkgdesc="Apply checksum-validated Hi846 OTP to Xperia 10 VI camera tuning"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
depends="python3 py3-yaml libcamera-ipa"
options="!check"
source="hi846_otp.py pdx246-camera-calibrate hi846.json hi846-front.json
 pdx246-camera-calibration.service 90-pdx246-camera-calibration.preset"
package() {
 install -Dm755 "$srcdir"/pdx246-camera-calibrate "$pkgdir"/usr/bin/pdx246-camera-calibrate
 install -Dm644 "$srcdir"/hi846_otp.py "$pkgdir"/usr/lib/pdx246-camera-calibration/hi846_otp.py
 install -Dm644 "$srcdir"/hi846.json "$srcdir"/hi846-front.json -t "$pkgdir"/usr/share/pdx246-camera-calibration/
 install -Dm644 "$srcdir"/pdx246-camera-calibration.service -t "$pkgdir"/usr/lib/systemd/system/
 install -Dm644 "$srcdir"/90-pdx246-camera-calibration.preset -t "$pkgdir"/usr/lib/systemd/system-preset/
 mkdir -p "$pkgdir"/etc/libcamera/ipa/simple
 for name in hi846 hi846-front; do
  ln -s /run/pdx246-camera-calibration/simple/$name.yaml "$pkgdir"/etc/libcamera/ipa/simple/$name.yaml
 done
}
