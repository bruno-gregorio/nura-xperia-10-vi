#!/usr/bin/python3
"""Apply validated per-unit OTP to the module tuning, without copying identity."""
import argparse
import json
import math
from pathlib import Path
import sys
import time
import yaml
sys.path.insert(0, '/usr/lib/pdx246-camera-calibration')
from hi846_otp import decode

class TuningDumper(yaml.SafeDumper):
    def ignore_aliases(self, data):
        return True

def calibrate(base, otp, reference):
    lsc = next(a['LensShading'] for a in base['algorithms'] if 'LensShading' in a)
    raw = otp['lsc']['response']
    golden = reference['golden']
    assert len(raw) == len(golden) == 884
    ratio = [g / r for g, r in zip(golden, raw)]
    if not all(math.isfinite(r) and 0.5 <= r <= 2 for r in ratio):
        raise ValueError('OTP differs excessively from module reference')
    # Stock RunInterpolation 0x1091664: golden / EEPROM, all four channels;
    # InterpolateAndCalibrate 0x1090dd4 multiplies this by the module gains.
    tables = [(t, reference['green_fraction'][str(t['ct'])]) for t in lsc['tables']]
    bands = lsc.get('luxBands', [])
    weights_by_band = reference.get('lux_green_fraction', [])
    if len(bands) != len(weights_by_band):
        raise ValueError('Low-light calibration bands do not match tuning')
    for band, weights in zip(bands, weights_by_band):
        tables.extend((t, weights[str(t['ct'])]) for t in band['tables'])
    for table, weights in tables:
        # Endpoint tables may share a list after loading aliased input YAML.
        # Never apply one endpoint's calibration a second time to another.
        table['gains'] = list(table['gains'])
        if len(table['gains']) != 663 or len(weights) != 221:
            raise ValueError('Unexpected LSC grid size')
        for i in range(221):
            factors = [ratio[i], weights[i] * ratio[221+i] +
                       (1-weights[i]) * ratio[442+i], ratio[663+i]]
            for c in range(3):
                table['gains'][i*3+c] *= factors[c]
        if not all(math.isfinite(g) and 0.5 <= g <= 8 for g in table['gains']):
            raise ValueError('Calibrated LSC gain outside ISP range')
    return base

def main():
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('--nvmem',type=Path,default=Path('/sys/bus/nvmem/devices'))
    p.add_argument('--tuning',type=Path,default=Path('/usr/share/libcamera/ipa/simple'))
    p.add_argument('--reference',type=Path,default=Path('/usr/share/pdx246-camera-calibration'))
    p.add_argument('--output',type=Path,default=Path('/run/pdx246-camera-calibration/simple'))
    a=p.parse_args()
    a.output.mkdir(parents=True,exist_ok=True)
    # Sensor probe can defer until the camera regulators/CCI become ready.
    # udev-trigger being started does not mean NVMEM has been published.
    deadline=time.monotonic()+45
    while not all(list(a.nvmem.glob('hi846-'+s+'-otp*/nvmem')) for s in ['front','back']):
        if time.monotonic()>=deadline:break
        time.sleep(.5)
    for sensor,name in [('front','hi846-front'),('back','hi846')]:
        files=list(a.nvmem.glob('hi846-'+sensor+'-otp*/nvmem'))
        target=a.output/(name+'.yaml')
        try:
            if len(files)!=1:raise ValueError('Exactly one OTP cache required')
            otp=decode(files[0].read_bytes())
            base=yaml.safe_load((a.tuning/(name+'.yaml')).read_text())
            ref=json.loads((a.reference/(name+'.json')).read_text())
            result=calibrate(base,otp,ref)
            tmp=target.with_suffix('.tmp')
            tmp.write_text('# Generated from checksum-validated sensor OTP; no module identity.\n'+yaml.dump(result,Dumper=TuningDumper,sort_keys=False))
            tmp.chmod(0o644);tmp.replace(target)
            print(sensor+': per-unit lens shading applied to all light levels; WB checksum validated (WB not adjusted)')
        except (ValueError,KeyError,StopIteration,OSError) as e:
            target.unlink(missing_ok=True)
            print(sensor+': using module tuning; '+str(e),file=sys.stderr)
            return 1
    return 0
if __name__=='__main__':raise SystemExit(main())
