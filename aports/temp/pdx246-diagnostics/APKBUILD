maintainer="Bruno Gregorio <accounts@bruno.pw>"
pkgname=pdx246-diagnostics
pkgver=1
pkgrel=0
pkgdesc="Repeatable GPU checks for the Xperia 10 VI"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
depends="foot glmark2"
options="!check"
source="pdx246-gpu-check pdx246-gpu-check.desktop"

package() {
	install -Dm755 "$srcdir"/pdx246-gpu-check "$pkgdir"/usr/bin/pdx246-gpu-check
	install -Dm644 "$srcdir"/pdx246-gpu-check.desktop \
		"$pkgdir"/usr/share/applications/pdx246-gpu-check.desktop
}

