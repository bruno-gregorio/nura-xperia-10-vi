#!/bin/sh
# Run in the logged-in Wayland session, without sudo.
set -eu
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    echo 'Run GPU Test from the application launcher in your Wayland session.' >&2
    exit 1
fi
lock=${XDG_RUNTIME_DIR:?}/pdx246-gpu-test.lock
if ! mkdir "$lock" 2>/dev/null; then
    echo 'Another GPU test is running.' >&2
    exit 1
fi
trap 'rmdir "$lock"' EXIT
trap 'exit 130' HUP INT TERM
base=${XDG_STATE_HOME:-$HOME/.local/state}/pdx246-gpu-test
dir=$base/$(date +%Y%m%d-%H%M%S)-$$
mkdir -p "$dir"
chmod 700 "$base" "$dir"
echo 'GPU Test: two short runs, about 40 seconds total.'
echo 'The first displays animation; the second measures offscreen rendering.'
echo 'Close the test window to cancel. Results remain in:'
echo "$dir"
{
    uname -r
    for cmd in qdbus6 qdbus; do
        if command -v "$cmd" >/dev/null; then
            timeout 5 "$cmd" org.kde.KWin /KWin supportInformation || true
            break
        fi
    done
} > "$dir/session.txt" 2>&1
sample() {
    for d in /sys/class/devfreq/*; do
        [ -r "$d/name" ] || continue
        case "$(cat "$d/name")" in
            *gpu*)
                for f in name governor cur_freq min_freq max_freq available_frequencies; do
                    [ ! -r "$d/$f" ] || { printf '%s: ' "$f"; cat "$d/$f"; }
                done ;;
        esac
    done
    for d in /sys/class/thermal/thermal_zone*; do
        [ ! -r "$d/temp" ] || printf '%s %s\n' "$(cat "$d/type")" "$(cat "$d/temp")"
    done
}
sample > "$dir/before.txt"
result=0
for mode in displayed offscreen; do
    set -- --size 720x1280 --benchmark 'build:use-vbo=true:duration=5' \
        --benchmark 'texture:texture-filter=linear:duration=5' \
        --benchmark 'shading:shading=phong:duration=5'
    [ "$mode" != offscreen ] || set -- "$@" --off-screen --frame-end=finish
    echo "Starting $mode rendering..."
    if timeout -k 5 45 glmark2-es2-wayland "$@" > "$dir/$mode.txt" 2>&1; then
        cat "$dir/$mode.txt"
    else
        result=$?
        cat "$dir/$mode.txt"
        echo "Run failed or was cancelled (exit $result)."
        break
    fi
done
sample > "$dir/after.txt"
echo
if grep -Eiq 'GL_RENDERER:.*(llvmpipe|softpipe|swrast)' "$dir/displayed.txt"; then
    echo 'Software rendering detected. This is not GPU acceleration.'
    result=1
elif grep -Eiq 'GL_RENDERER:.*(FD710|Adreno)' "$dir/displayed.txt"; then
    echo 'Adreno hardware renderer detected.'
else
    echo 'Renderer was not recognized; inspect GL_RENDERER above.'
fi
echo 'Displayed FPS can be limited by the screen refresh rate.'
echo 'Offscreen FPS does not measure UI responsiveness or touch latency.'
echo "Saved results: $dir"
exit "$result"
