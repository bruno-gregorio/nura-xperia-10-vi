+namespace {
+class CpuReadSync {
+public:
+    explicit CpuReadSync(const libcamera::FrameBuffer &buffer)
+    {
+        for (const auto &plane : buffer.planes()) {
+            int fd = plane.fd.get();
+            if (fds.count(fd)) continue;
+            if (!sync(fd, DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ)) return;
+            fds.insert(fd);
+        }
+        valid = true;
+    }
+    ~CpuReadSync()
+    {
+        for (int fd : fds) sync(fd, DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
+    }
+    bool valid = false;
+private:
+    static bool sync(int fd, uint64_t flags)
+    {
+        dma_buf_sync arg{flags};
+        int ret;
+        do { ret = ioctl(fd, DMA_BUF_IOCTL_SYNC, &arg); } while (ret < 0 && errno == EINTR);
+        if (ret < 0) qWarning() << "DMA buffer CPU read sync failed" << errno;
+        return ret == 0;
+    }
+    std::set<int> fds;
+};
+} // namespace
