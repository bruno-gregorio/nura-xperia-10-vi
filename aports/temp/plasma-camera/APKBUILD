20b61aee44e4e22ebb1154d4d98a9721e785228411e9d9064b0133a1f87018cf3a56a0640c4f7d1c67a8e23d0d100e5e6d0129008c96654158466dd5d59216b4  0001-responsive-preview.patch
6437326a14c1c85ba84bfe6967822be909c4625e4aa9fcf213efef802f32fb086e18c161722afc964f4ade046f5d4ef3ffabb9856167a3fe923f32c43d0f3a6d  pipeline-test.cpp
"
