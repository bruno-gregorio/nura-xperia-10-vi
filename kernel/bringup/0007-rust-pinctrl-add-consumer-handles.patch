+// SPDX-License-Identifier: GPL-2.0
+
+//! Pin control consumer handles.
+//!
+//! C header: [`include/linux/pinctrl/consumer.h`](srctree/include/linux/pinctrl/consumer.h)
+
+use crate::{
+    bindings,
+    device::Device,
+    error::{from_err_ptr, to_result, Result},
+    prelude::*,
+};
+use core::ptr::NonNull;
+
+/// A counted reference to the pin control handle of a device.
+///
+/// The reference is not device-managed; it is dropped with this value.
+///
+/// # Invariants
+///
+/// `self.0` was acquired by `pinctrl_get` and has not been released.
+pub struct Pinctrl(NonNull<bindings::pinctrl>);
+
+// SAFETY: A handle is not tied to the task that acquired it. It is not `Sync`:
+// selecting states of one handle concurrently is not serialised.
+unsafe impl Send for Pinctrl {}
+
+impl Pinctrl {
+    /// Takes a reference to the pin control handle of `dev`.
+    pub fn get(dev: &Device) -> Result<Self> {
+        // SAFETY: `dev` is a valid device.
+        let p = from_err_ptr(unsafe { bindings::pinctrl_get(dev.as_raw()) })?;
+        // INVARIANT: `pinctrl_get` succeeded; it reports failure only by error pointer.
+        NonNull::new(p).map(Self).ok_or(ENODEV)
+    }
+
+    /// Looks up the state that firmware names `name`.
+    pub fn lookup_state(&self, name: &CStr) -> Result<State<'_>> {
+        // SAFETY: By the type invariant, `self.0` is valid; `name` is NUL-terminated.
+        let state = from_err_ptr(unsafe {
+            bindings::pinctrl_lookup_state(self.0.as_ptr(), name.as_char_ptr())
+        })?;
+        // INVARIANT: the state belongs to `self`, which the borrow keeps alive.
+        Ok(State {
+            pinctrl: self,
+            state: NonNull::new(state).ok_or(ENODEV)?,
+        })
+    }
+}
+
+impl Drop for Pinctrl {
+    fn drop(&mut self) {
+        // SAFETY: By the type invariant, this releases the reference once.
+        unsafe { bindings::pinctrl_put(self.0.as_ptr()) };
+    }
+}
+
+/// A state of a [`Pinctrl`] handle.
+///
+/// # Invariants
+///
+/// `state` belongs to `pinctrl`.
+pub struct State<'a> {
+    pinctrl: &'a Pinctrl,
+    state: NonNull<bindings::pinctrl_state>,
+}
+
+impl State<'_> {
+    /// Applies the mux and configuration of this state to its pins.
+    pub fn select(&self) -> Result {
+        // SAFETY: By the type invariants, the handle is valid and owns the state.
+        to_result(unsafe {
+            bindings::pinctrl_select_state(self.pinctrl.0.as_ptr(), self.state.as_ptr())
+        })
+    }
+}
