+/* These programs were recovered from this phone's CamX sensor modules.
+ * Keep the sensor microcode in the private firmware package, with the exact
+ * ordered writes (including repeats), rather than substituting generic code.
+ */
+static int hi846_load_program(struct device *dev, const char *module,
+                             const char *suffix, struct hi846_reg_list *list)
+{
+	const struct firmware *fw;
+	struct hi846_reg *regs;
+	char name[96];
+	u32 count, i;
+	int ret;
+
+	snprintf(name, sizeof(name), "hynix/pdx246/hi846-%s-%s.bin", module, suffix);
+	ret = request_firmware(&fw, name, dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing sensor program %s\n", name);
+	ret = -EINVAL;
+	if (fw->size < 12 || memcmp(fw->data, "HI846R1", 8))
+		goto out;
+	count = get_unaligned_le32(fw->data + 8);
+	if (!count || count > 2048 || fw->size != 12 + count * 4)
+		goto out;
+	regs = devm_kcalloc(dev, count, sizeof(*regs), GFP_KERNEL);
+	if (!regs) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	for (i = 0; i < count; i++) {
+		regs[i].address = get_unaligned_le16(fw->data + 12 + i * 4);
+		regs[i].val = get_unaligned_le16(fw->data + 14 + i * 4);
+		if (regs[i].address > 0x3fff)
+			goto out;
+	}
+	list->regs = regs;
+	list->num_of_regs = count;
+	ret = 0;
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+static int hi846_module_config(struct hi846 *hi846, struct device *dev)
+{
+	struct hi846_mode *modes;
+	bool front;
+	char suffix[32];
+	unsigned int i, j;
+	int ret;
+
+	hi846->modes = supported_modes;
+	hi846->num_modes = ARRAY_SIZE(supported_modes);
+	hi846->format_code = HI846_MEDIA_BUS_FORMAT;
+	hi846->module = device_get_match_data(dev);
+	if (!hi846->module)
+		return 0;
+	if (clk_get_rate(hi846->clock) != 24000000)
+		return dev_err_probe(dev, -EINVAL, "stock programs require 24 MHz\n");
+	front = !strcmp(hi846->module, "front");
+	modes = devm_kcalloc(dev, 2, sizeof(*modes), GFP_KERNEL);
+	if (!modes)
+		return -ENOMEM;
+	modes[0] = (struct hi846_mode) {
+		.width = 3264, .height = 2448, .llp = 3800,
+		.fps = 30, .frame_len = 2526, .mipi_clk_div_4lane = 2,
+		.crop = { .width = 3264, .height = 2448 },
+	};
+	modes[1] = front ? (struct hi846_mode) {
+		.width = 1280, .height = 720, .llp = 3800,
+		.fps = 90, .frame_len = 842, .mipi_clk_div_4lane = 4,
+		.crop = { .left = 352, .top = 504, .width = 2560, .height = 1440 },
+	} : (struct hi846_mode) {
+		.width = 2304, .height = 1728, .llp = 3800,
+		.fps = 30, .frame_len = 2526, .mipi_clk_div_4lane = 2,
+		.crop = { .left = 480, .top = 360, .width = 2304, .height = 1728 },
+	};
+	ret = hi846_load_program(dev, hi846->module, "init", &hi846->module_init);
+	if (ret)
+		return ret;
+	for (i = 0; i < 2; i++) {
+		struct hi846_reg_list *list = &modes[i].reg_list_4lane;
+
+		snprintf(suffix, sizeof(suffix), "%ux%u", modes[i].width, modes[i].height);
+		ret = hi846_load_program(dev, hi846->module, suffix, list);
+		if (ret)
+			return ret;
+		for (j = 0; j < list->num_of_regs; j++)
+			if (list->regs[j].address == HI846_REG_PLL_CFG_MIPI1_H)
+				modes[i].mipi_pll = list->regs[j].val;
+		if (!modes[i].mipi_pll)
+			return -EINVAL;
+	}
+	hi846->modes = modes;
+	/* The smaller back mode is a centre crop, not binning. Advertising
+	 * it as a preview mode makes the simple pipeline silently lose the
+	 * ultra-wide field of view. Use the full array for normal capture.
+	 */
+	hi846->num_modes = front ? 2 : 1;
+	hi846->format_code = front ? MEDIA_BUS_FMT_SGRBG10_1X10 : HI846_MEDIA_BUS_FORMAT;
+	dev_info(dev, "using stock pdx246 %s sensor programs\n", hi846->module);
+	return 0;
+}
+
+/* Stock CamX OTP memory map: read-only mode, 19.2 MHz MCLK.
+ * No programming command is provided. Cache once before publishing the
+ * video subdevice, then reset/power down and restore the normal 24 MHz.
+ */
+#define HI846_OTP_SIZE 5449
+static const struct {
+	u16 address, value;
+	u8 width, delay_ms, read;
+} hi846_otp_sequence[] = {
+	{ 0xa00, 0x0, 2, 0, 0 },
+	{ 0x2000, 0x0, 2, 10, 0 },
+	{ 0x2002, 0xff, 2, 0, 0 },
+	{ 0x2004, 0x0, 2, 0, 0 },
+	{ 0x2008, 0x3fff, 2, 0, 0 },
+	{ 0x23fe, 0xc056, 2, 0, 0 },
+	{ 0xa00, 0x0, 2, 0, 0 },
+	{ 0xe04, 0x12, 2, 0, 0 },
+	{ 0xf08, 0x2f04, 2, 0, 0 },
+	{ 0xf30, 0x1f, 2, 0, 0 },
+	{ 0xf36, 0x1f, 2, 10, 0 },
+	{ 0xf04, 0x3a00, 2, 0, 0 },
+	{ 0xf32, 0x25a, 2, 0, 0 },
+	{ 0xf38, 0x25a, 2, 0, 0 },
+	{ 0xf2a, 0x4124, 2, 0, 0 },
+	{ 0x6a, 0x100, 2, 0, 0 },
+	{ 0x4c, 0x100, 2, 0, 0 },
+	{ 0xa02, 0x1, 1, 0, 0 },
+	{ 0xa00, 0x0, 1, 10, 0 },
+	{ 0xf02, 0x0, 1, 0, 0 },
+	{ 0x71a, 0x1, 1, 0, 0 },
+	{ 0x71b, 0x9, 1, 0, 0 },
+	{ 0xd04, 0x0, 1, 0, 0 },
+	{ 0xd00, 0x7, 1, 0, 0 },
+	{ 0x3e, 0x10, 1, 0, 0 },
+	{ 0xa00, 0x1, 1, 0, 0 },
+	{ 0x70a, 0x2, 1, 0, 0 },
+	{ 0x70b, 0x1, 1, 0, 0 },
+	{ 0x702, 0x1, 1, 0, 0 },
+	{ 0x708, 0x1549, 1, 1, 1 },
+	{ 0xa00, 0x0, 1, 10, 0 },
+	{ 0x3e, 0x0, 1, 0, 0 },
+	{ 0xa00, 0x1, 1, 0, 0 },
+};
+
+static int hi846_otp_nvmem_read(void *priv, unsigned int off, void *val, size_t bytes)
+{
+	if (off > HI846_OTP_SIZE || bytes > HI846_OTP_SIZE - off)
+		return -EINVAL;
+	memcpy(val, (u8 *)priv + off, bytes);
+	return 0;
+}
+
+/* Called while powered off; always leaves it powered off at 24 MHz. */
+static int hi846_cache_otp(struct hi846 *hi846)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&hi846->sd);
+	struct device *dev = &client->dev;
+	struct nvmem_config config = {
+		.dev = dev,
+		.id = NVMEM_DEVID_AUTO,
+		.owner = THIS_MODULE,
+		.read_only = true,
+		.root_only = true,
+		.size = HI846_OTP_SIZE,
+		.word_size = 1,
+		.stride = 1,
+		.reg_read = hi846_otp_nvmem_read,
+	};
+	struct nvmem_device *nvmem;
+	u8 *data;
+	unsigned int i, j;
+	int ret, restore;
+
+	data = devm_kmalloc(dev, HI846_OTP_SIZE, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	ret = clk_set_rate(hi846->clock, 19200000);
+	if (ret)
+		goto restore_clock;
+	if (clk_get_rate(hi846->clock) != 19200000) {
+		ret = -EINVAL;
+		goto restore_clock;
+	}
+	ret = hi846_power_on(hi846);
+	if (ret)
+		goto restore_clock;
+	for (i = 0; i < ARRAY_SIZE(hi846_otp_sequence) && !ret; i++) {
+		if (hi846_otp_sequence[i].read) {
+			for (j = 0; j < HI846_OTP_SIZE && !ret; j++)
+				ret = hi846_read_reg(hi846, 0x0708, &data[j]);
+		} else if (hi846_otp_sequence[i].width == 2) {
+			hi846_write_reg_16(hi846, hi846_otp_sequence[i].address,
+					   hi846_otp_sequence[i].value, &ret);
+		} else {
+			ret = hi846_write_reg(hi846, hi846_otp_sequence[i].address,
+					      hi846_otp_sequence[i].value);
+		}
+		if (hi846_otp_sequence[i].delay_ms)
+			msleep(hi846_otp_sequence[i].delay_ms);
+	}
+	/* Reset and remove power even when an OTP read failed. */
+	restore = hi846_power_off(hi846);
+	if (!ret)
+		ret = restore;
+restore_clock:
+	restore = clk_set_rate(hi846->clock, 24000000);
+	if (restore || clk_get_rate(hi846->clock) != 24000000)
+		return restore ? restore : -EINVAL;
+	if (ret)
+		return ret;
+	config.name = devm_kasprintf(dev, GFP_KERNEL, "hi846-%s-otp", hi846->module);
+	if (!config.name)
+		return -ENOMEM;
+	config.priv = data;
+	nvmem = devm_nvmem_register(dev, &config);
+	if (IS_ERR(nvmem))
+		return PTR_ERR(nvmem);
+	dev_info(dev, "cached %s OTP calibration (%u bytes) read-only\n",
+		 hi846->module, HI846_OTP_SIZE);
+	return 0;
+}
