+/* The two modules use opposite rail order in their stock power tables. */
+static int hi846_module_power(struct hi846 *hi846, bool on)
+{
+	bool front = !strcmp(hi846->module, "front");
+	unsigned int order[3] = { front ? 0 : 2, 1, front ? 2 : 0 };
+	int i, ret, first = 0;
+
+	gpiod_set_value_cansleep(hi846->rst_gpio, 1);
+	usleep_range(1000, 1500);
+	if (!on) {
+		clk_disable_unprepare(hi846->clock);
+		usleep_range(1000, 1500);
+		for (i = 2; i >= 0; i--) {
+			ret = regulator_disable(hi846->supplies[order[i]].consumer);
+			if (ret && !first)
+				first = ret;
+		}
+		return first;
+	}
+	for (i = 0; i < 3; i++) {
+		ret = regulator_enable(hi846->supplies[order[i]].consumer);
+		if (ret)
+			goto disable;
+		usleep_range(1000, 1500);
+	}
+	ret = clk_prepare_enable(hi846->clock);
+	if (ret)
+		goto disable;
+	usleep_range(4000, 5000);
+	gpiod_set_value_cansleep(hi846->rst_gpio, 0);
+	usleep_range(6000, 7000);
+	return 0;
+disable:
+	while (--i >= 0)
+		regulator_disable(hi846->supplies[order[i]].consumer);
+	return ret;
+}
