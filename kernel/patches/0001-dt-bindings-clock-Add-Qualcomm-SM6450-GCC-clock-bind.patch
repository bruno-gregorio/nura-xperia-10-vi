From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Tue, 6 Oct 2026 08:39:16 -0300
Subject: [PATCH] dt-bindings: clock: Add Qualcomm SM6450 GCC clock bindings
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add device tree bindings for the global clock controller on SM6450
based devices.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../bindings/clock/qcom,sm6450-gcc.yaml       |  57 ++++++
 include/dt-bindings/clock/qcom,sm6450-gcc.h   | 185 ++++++++++++++++++
 2 files changed, 242 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/qcom,sm6450-gcc.yaml
 create mode 100644 include/dt-bindings/clock/qcom,sm6450-gcc.h

diff --git a/Documentation/devicetree/bindings/clock/qcom,sm6450-gcc.yaml b/Documentation/devicetree/bindings/clock/qcom,sm6450-gcc.yaml
new file mode 100644
index 000000000..0e4949c62
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/qcom,sm6450-gcc.yaml
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/qcom,sm6450-gcc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm Global Clock & Reset Controller on SM6450
+
+maintainers:
+  - Bruno Gregório <accounts@bruno.pw>
+
+description: |
+  Qualcomm global clock control module provides the clocks, resets and power
+  domains on SM6450
+
+  See also: include/dt-bindings/clock/qcom,sm6450-gcc.h
+
+properties:
+  compatible:
+    const: qcom,sm6450-gcc
+
+  clocks:
+    items:
+      - description: Board XO source
+      - description: Sleep clock source
+      - description: PCIe 0 pipe clock source
+      - description: UFS Phy Rx symbol 0 clock source
+      - description: UFS Phy Rx symbol 1 clock source
+      - description: UFS Phy Tx symbol 0 clock source
+      - description: USB3 Phy wrapper pipe clock source
+
+required:
+  - compatible
+  - clocks
+  - '#power-domain-cells'
+
+allOf:
+  - $ref: qcom,gcc.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,rpmh.h>
+    clock-controller@100000 {
+      compatible = "qcom,sm6450-gcc";
+      reg = <0x00100000 0x001f4200>;
+      clocks = <&rpmhcc RPMH_CXO_CLK>, <&sleep_clk>,
+               <&pcie_0_phy>, <&ufs_mem_phy 0>,
+               <&ufs_mem_phy 1>, <&ufs_mem_phy 2>,
+               <&usb_1_qmpphy>;
+      #clock-cells = <1>;
+      #reset-cells = <1>;
+      #power-domain-cells = <1>;
+    };
+
+...
diff --git a/include/dt-bindings/clock/qcom,sm6450-gcc.h b/include/dt-bindings/clock/qcom,sm6450-gcc.h
new file mode 100644
index 000000000..ad3001f3c
