From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 10:23:43 -0300
Subject: [PATCH] dt-bindings: clock: qcom: Add SM6450 display clock controller
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add device tree bindings for the display clock controller on SM6450
based devices.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../bindings/clock/qcom,sm6450-dispcc.yaml    | 74 +++++++++++++++
 .../dt-bindings/clock/qcom,sm6450-dispcc.h    | 95 +++++++++++++++++++
 2 files changed, 169 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/qcom,sm6450-dispcc.yaml
 create mode 100644 include/dt-bindings/clock/qcom,sm6450-dispcc.h

diff --git a/Documentation/devicetree/bindings/clock/qcom,sm6450-dispcc.yaml b/Documentation/devicetree/bindings/clock/qcom,sm6450-dispcc.yaml
new file mode 100644
index 000000000..3b3aafc03
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/qcom,sm6450-dispcc.yaml
@@ -0,0 +1,74 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/qcom,sm6450-dispcc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm Display Clock & Reset Controller on SM6450
+
+maintainers:
+  - Bruno Gregório <accounts@bruno.pw>
+
+description: |
+  Qualcomm display clock control module provides the clocks, resets and power
+  domains on SM6450
+
+  See also: include/dt-bindings/clock/qcom,sm6450-dispcc.h
+
+properties:
+  compatible:
+    const: qcom,sm6450-dispcc
+
+  clocks:
+    items:
+      - description: Board XO source
+      - description: Board active XO source
+      - description: Display AHB clock source from GCC
+      - description: Sleep clock source
+      - description: Byte clock from DSI PHY0
+      - description: Pixel clock from DSI PHY0
+      - description: Link clock from DP PHY0
+      - description: VCO DIV clock from DP PHY0
+      - description: Link clock from DP PHY1
+      - description: VCO DIV clock from DP PHY1
+      - description: Link clock from DP PHY2
+      - description: VCO DIV clock from DP PHY2
+      - description: Link clock from DP PHY3
+      - description: VCO DIV clock from DP PHY3
+
+required:
+  - compatible
+  - clocks
+  - '#power-domain-cells'
+
+allOf:
+  - $ref: qcom,gcc.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,rpmh.h>
+    #include <dt-bindings/clock/qcom,sm6450-gcc.h>
+    clock-controller@af00000 {
+      compatible = "qcom,sm6450-dispcc";
+      reg = <0x0af00000 0x20000>;
+      clocks = <&rpmhcc RPMH_CXO_CLK>,
+               <&rpmhcc RPMH_CXO_CLK_A>,
+               <&gcc GCC_DISP_AHB_CLK>,
+               <&sleep_clk>,
+               <&dsi0_phy 0>,
+               <&dsi0_phy 1>,
+               <&dp0_phy 0>,
+               <&dp0_phy 1>,
+               <&dp1_phy 0>,
+               <&dp1_phy 1>,
+               <&dp2_phy 0>,
+               <&dp2_phy 1>,
+               <&dp3_phy 0>,
+               <&dp3_phy 1>;
+      #clock-cells = <1>;
+      #reset-cells = <1>;
+      #power-domain-cells = <1>;
+    };
+...
diff --git a/include/dt-bindings/clock/qcom,sm6450-dispcc.h b/include/dt-bindings/clock/qcom,sm6450-dispcc.h
new file mode 100644
index 000000000..71072b4ac
--- /dev/null
+++ b/include/dt-bindings/clock/qcom,sm6450-dispcc.h
@@ -0,0 +1,95 @@
