From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Tue, 6 Oct 2026 14:32:15 -0300
Subject: [PATCH] dt-bindings: spmi: Add SM6450 SPMI PMIC arbiter
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SM6450 has a PMIC arbiter v7 with two buses, laid out exactly like the
one on SAR2130P. The driver reads the hardware version out of the
PMIC_ARB_VERSION register rather than from the compatible, so no driver
change goes with this.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../devicetree/bindings/spmi/qcom,x1e80100-spmi-pmic-arb.yaml | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/spmi/qcom,x1e80100-spmi-pmic-arb.yaml b/Documentation/devicetree/bindings/spmi/qcom,x1e80100-spmi-pmic-arb.yaml
index 7c3cc20a8..8f0c0a66d 100644
--- a/Documentation/devicetree/bindings/spmi/qcom,x1e80100-spmi-pmic-arb.yaml
+++ b/Documentation/devicetree/bindings/spmi/qcom,x1e80100-spmi-pmic-arb.yaml
@@ -21,7 +21,9 @@ properties:
   compatible:
     oneOf:
       - items:
-          - const: qcom,sar2130p-spmi-pmic-arb
+          - enum:
+              - qcom,sar2130p-spmi-pmic-arb
+              - qcom,sm6450-spmi-pmic-arb
           - const: qcom,x1e80100-spmi-pmic-arb
       - const: qcom,x1e80100-spmi-pmic-arb
 
