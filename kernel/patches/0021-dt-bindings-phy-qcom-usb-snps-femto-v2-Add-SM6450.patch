From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Tue, 6 Oct 2026 15:01:51 -0300
Subject: [PATCH] dt-bindings: phy: qcom,usb-snps-femto-v2: Add SM6450
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SM6450's high-speed USB PHY is a Femto v2 of the same generation as the one
on SM6375 and SM8450, so it takes the 7nm fallback and its parameter
override tables.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../devicetree/bindings/phy/qcom,usb-snps-femto-v2.yaml          | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Documentation/devicetree/bindings/phy/qcom,usb-snps-femto-v2.yaml b/Documentation/devicetree/bindings/phy/qcom,usb-snps-femto-v2.yaml
index 661759b25..2fadbc96a 100644
--- a/Documentation/devicetree/bindings/phy/qcom,usb-snps-femto-v2.yaml
+++ b/Documentation/devicetree/bindings/phy/qcom,usb-snps-femto-v2.yaml
@@ -29,6 +29,7 @@ properties:
               - qcom,sdx55-usb-hs-phy
               - qcom,sdx65-usb-hs-phy
               - qcom,sm6375-usb-hs-phy
+              - qcom,sm6450-usb-hs-phy
               - qcom,sm8150-usb-hs-phy
               - qcom,sm8250-usb-hs-phy
               - qcom,sm8350-usb-hs-phy
