From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Tue, 6 Oct 2026 14:32:44 -0300
Subject: [PATCH] arm64: dts: qcom: Add PM6450 PMIC device tree
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add the device tree for PM6450, the companion PMIC paired with SM6450.
It describes the temperature alarm, its thermal zone and the nine GPIOs.

The regulators are not described here: they are RPMh-managed, so they are
children of the board's &apps_rsc rather than of the PMIC.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 arch/arm64/boot/dts/qcom/pm6450.dtsi | 63 ++++++++++++++++++++++++++++
 1 file changed, 63 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/pm6450.dtsi

diff --git a/arch/arm64/boot/dts/qcom/pm6450.dtsi b/arch/arm64/boot/dts/qcom/pm6450.dtsi
new file mode 100644
index 000000000..2e4253896
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/pm6450.dtsi
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2026, Bruno Gregório <accounts@bruno.pw>
+ */
+
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/spmi/spmi.h>
+
+&spmi_bus {
+	pm6450: pmic@1 {
+		compatible = "qcom,pm6450", "qcom,spmi-pmic";
+		reg = <0x1 SPMI_USID>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		pm6450_temp_alarm: temp-alarm@a00 {
+			compatible = "qcom,spmi-temp-alarm";
+			reg = <0xa00>;
+			interrupts = <0x1 0xa 0x0 IRQ_TYPE_EDGE_BOTH>;
+			#thermal-sensor-cells = <0>;
+		};
+
+		pm6450_gpios: gpio@8800 {
+			compatible = "qcom,pm6450-gpio", "qcom,spmi-gpio";
+			reg = <0x8800>;
+			gpio-controller;
+			gpio-ranges = <&pm6450_gpios 0 0 9>;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+	};
+};
+
+/ {
+	thermal-zones {
+		pm6450-thermal {
+			polling-delay-passive = <100>;
+
+			thermal-sensors = <&pm6450_temp_alarm>;
+
+			trips {
+				trip0 {
+					temperature = <95000>;
+					hysteresis = <0>;
+					type = "passive";
+				};
+
+				trip1 {
+					temperature = <115000>;
+					hysteresis = <0>;
+					type = "hot";
+				};
+
+				trip2 {
+					temperature = <145000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+	};
+};
