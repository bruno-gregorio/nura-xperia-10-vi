+
+&pm6450_gpios {
+	vol_down_n: vol-down-n-state {
+		pins = "gpio1";
+		function = "normal";
+		power-source = <0>;
+		bias-pull-up;
+		input-enable;
+	};
+};
+
+&pon_pwrkey {
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEUP>;
+
+	status = "okay";
+};
+
+&qupv3_id_0 {
+	status = "okay";
+};
+
+&sdc2_off_state {
+	sd-cd-pins {
+		pins = "gpio107";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+};
+
+&sdc2_on_state {
+	sd-cd-pins {
+		pins = "gpio107";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+};
+
+&sdhc_2 {
+	cd-gpios = <&tlmm 107 GPIO_ACTIVE_HIGH>;
+	vmmc-supply = <&pm6150l_l9>;
+	vqmmc-supply = <&pm6150l_l6>;
+
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&sdc2_on_state>;
+	pinctrl-1 = <&sdc2_off_state>;
+
+	status = "okay";
+};
+
+&uart3 {
+	status = "okay";
+};
+
+&usb_1 {
+	status = "okay";
+};
+
+&usb_1_dwc3 {
+	dr_mode = "otg";
+	usb-role-switch;
+};
+
+/*
+ * The stock tree tunes this PHY with a raw register write,
+ * qcom,param-override-seq, into HS_PHY_OVERRIDE_X0 through X3. Every field
+ * it sets inverts cleanly through the tables in phy-qcom-snps-femto-v2.c,
+ * so these are the same four registers expressed the way mainline expects.
+ * The fields it leaves at their nominal value are left out.
+ */
+&usb_1_hsphy {
+	vdda-pll-supply = <&pm6450_l5>;
+	vdda18-supply = <&pm6450_l23>;
+	vdda33-supply = <&pm6450_l25>;
+
+	qcom,hs-disconnect-bp = <630>;
+	qcom,squelch-detector-bp = <(-530)>;
+	qcom,hs-amplitude-bp = <650>;
+	qcom,pre-emphasis-duration-bp = <20000>;
+	qcom,pre-emphasis-amplitude-bp = <30000>;
+	qcom,hs-output-impedance-micro-ohms = <2600000>;
+
+	status = "okay";
+};
