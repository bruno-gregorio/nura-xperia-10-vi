From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 12:04:18 -0300
Subject: [PATCH] dt-bindings: remoteproc: qcom,sc7180-pas: Add SM6450 WPSS
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The wireless subsystem on SM6450 is SC7280's: the same power domains,
interrupts, PAS id, crash reason and SSCTL instance in the downstream
driver. Document it with the SC7280 WPSS as fallback.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../bindings/remoteproc/qcom,sc7180-pas.yaml  | 25 +++++++++++--------
 1 file changed, 15 insertions(+), 10 deletions(-)

diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml
index 66b455d0a..6ab66abd0 100644
--- a/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml
@@ -15,13 +15,17 @@ description:
 
 properties:
   compatible:
-    enum:
-      - qcom,sc7180-adsp-pas
-      - qcom,sc7180-mpss-pas
-      - qcom,sc7280-adsp-pas
-      - qcom,sc7280-cdsp-pas
-      - qcom,sc7280-mpss-pas
-      - qcom,sc7280-wpss-pas
+    oneOf:
+      - enum:
+          - qcom,sc7180-adsp-pas
+          - qcom,sc7180-mpss-pas
+          - qcom,sc7280-adsp-pas
+          - qcom,sc7280-cdsp-pas
+          - qcom,sc7280-mpss-pas
+          - qcom,sc7280-wpss-pas
+      - items:
+          - const: qcom,sm6450-wpss-pas
+          - const: qcom,sc7280-wpss-pas
 
   reg:
     maxItems: 1
@@ -127,9 +131,10 @@ allOf:
   - if:
       properties:
         compatible:
-          enum:
-            - qcom,sc7280-cdsp-pas
-            - qcom,sc7280-wpss-pas
+          contains:
+            enum:
+              - qcom,sc7280-cdsp-pas
+              - qcom,sc7280-wpss-pas
     then:
       properties:
         power-domains:
