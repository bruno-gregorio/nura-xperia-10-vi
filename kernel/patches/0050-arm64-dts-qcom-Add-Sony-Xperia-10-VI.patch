+/*
+ * The stock tree tunes this PHY with a raw register write,
+ * qcom,param-override-seq, into HS_PHY_OVERRIDE_X0 through X3. Every field
+ * it sets inverts cleanly through the tables in phy-qcom-snps-femto-v2.c,
+ * so these are the same four registers expressed the way mainline expects.
+ * The fields it leaves at their nominal value are left out.
+ */
+&usb_1_hsphy {
