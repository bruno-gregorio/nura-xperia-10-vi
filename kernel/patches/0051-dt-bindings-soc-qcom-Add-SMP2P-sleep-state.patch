From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Sun, 11 Oct 2026 20:35:22 -0300
Subject: [PATCH] dt-bindings: soc: qcom: Add SMP2P sleep state
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The sensor firmware on the ADSP of some Qualcomm SoCs reads an outbound
SMP2P entry named "sleepstate" from the application processor, one bit
of which says whether the application processor is awake. Describe the
node that points at that entry and bit, and allow the entry among the
SMP2P subnodes.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../soc/qcom/qcom,smp2p-sleepstate.yaml       | 41 +++++++++++++++++++
 .../bindings/soc/qcom/qcom,smp2p.yaml         |  2 +-
 2 files changed, 42 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/soc/qcom/qcom,smp2p-sleepstate.yaml

diff --git a/Documentation/devicetree/bindings/soc/qcom/qcom,smp2p-sleepstate.yaml b/Documentation/devicetree/bindings/soc/qcom/qcom,smp2p-sleepstate.yaml
new file mode 100644
index 000000000..9871ead29
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/qcom/qcom,smp2p-sleepstate.yaml
@@ -0,0 +1,41 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/qcom/qcom,smp2p-sleepstate.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SMP2P sleep state
+
+maintainers:
+  - Bruno Gregório <accounts@bruno.pw>
+
+description:
+  The sensor firmware on the ADSP of some Qualcomm SoCs reads an outbound
+  SMP2P entry named "sleepstate" from the application processor, one bit of
+  which says whether the application processor is awake. The firmware holds
+  back data while the bit is clear. This node points at that entry and bit.
+
+properties:
+  compatible:
+    const: qcom,smp2p-sleepstate
+
+  qcom,smem-states:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    description: State bit used by the AP to tell the remote it is awake
+    items:
+      - items:
+          - description: The outbound SMP2P entry
+          - description: The bit that says the application processor is awake
+
+required:
+  - compatible
+  - qcom,smem-states
+
+additionalProperties: false
+
+examples:
+  - |
+    sleepstate {
+        compatible = "qcom,smp2p-sleepstate";
+        qcom,smem-states = <&smp2p_adsp_sleepstate_out 12>;
+    };
diff --git a/Documentation/devicetree/bindings/soc/qcom/qcom,smp2p.yaml b/Documentation/devicetree/bindings/soc/qcom/qcom,smp2p.yaml
index 1ba1d419e..eb983237e 100644
--- a/Documentation/devicetree/bindings/soc/qcom/qcom,smp2p.yaml
+++ b/Documentation/devicetree/bindings/soc/qcom/qcom,smp2p.yaml
@@ -60,7 +60,7 @@ properties:
       Two identifiers of the inbound and outbound smem items used for this edge.
 
 patternProperties:
-  "^master-kernel|slave-kernel|ipa-ap-to-modem|ipa-modem-to-ap|wlan-ap-to-wpss|wlan-wpss-to-ap$":
+  "^master-kernel|slave-kernel|ipa-ap-to-modem|ipa-modem-to-ap|sleepstate-out|wlan-ap-to-wpss|wlan-wpss-to-ap$":
     type: object
     description:
       Each SMP2P pair contain a set of inbound and outbound entries, these are
