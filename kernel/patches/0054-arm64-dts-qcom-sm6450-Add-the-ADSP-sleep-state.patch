From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Sun, 11 Oct 2026 20:35:23 -0300
Subject: [PATCH] arm64: dts: qcom: sm6450: Add the ADSP sleep state
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The sensor firmware on the ADSP reads the application processor's awake
bit from an SMP2P entry named "sleepstate". Add the entry to the ADSP
edge and the node that drives its bit 12, as Qualcomm's downstream tree
does.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 arch/arm64/boot/dts/qcom/sm6450.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6450.dtsi b/arch/arm64/boot/dts/qcom/sm6450.dtsi
index 2a9e0cfb5..14758e3d7 100644
--- a/arch/arm64/boot/dts/qcom/sm6450.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6450.dtsi
@@ -606,6 +606,11 @@ smp2p_adsp_in: slave-kernel {
 			interrupt-controller;
 			#interrupt-cells = <2>;
 		};
+
+		smp2p_adsp_sleepstate_out: sleepstate-out {
+			qcom,entry-name = "sleepstate";
+			#qcom,smem-state-cells = <1>;
+		};
 	};
 
 	smp2p-cdsp {
@@ -702,6 +707,11 @@ wlan_smp2p_in: wlan-wpss-to-ap {
 		};
 	};
 
+	smp2p-sleepstate {
+		compatible = "qcom,smp2p-sleepstate";
+		qcom,smem-states = <&smp2p_adsp_sleepstate_out 12>;
+	};
+
 	soc: soc@0 {
 		#address-cells = <2>;
 		#size-cells = <2>;
