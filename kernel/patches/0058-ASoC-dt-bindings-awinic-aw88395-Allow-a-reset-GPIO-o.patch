From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 07:39:55 -0300
Subject: [PATCH] ASoC: dt-bindings: awinic,aw88395: Allow a reset GPIO on the
 AW88261
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The AW88261 has an active-low reset pin like the other amplifiers in
this binding, and a board that wires it to a GPIO has to release it
before the chip answers on I2C. Stop forbidding reset-gpios for it.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 Documentation/devicetree/bindings/sound/awinic,aw88395.yaml | 1 -
 1 file changed, 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/sound/awinic,aw88395.yaml b/Documentation/devicetree/bindings/sound/awinic,aw88395.yaml
index bb92d6ca3..7d64b38e4 100644
--- a/Documentation/devicetree/bindings/sound/awinic,aw88395.yaml
+++ b/Documentation/devicetree/bindings/sound/awinic,aw88395.yaml
@@ -61,7 +61,6 @@ allOf:
             enum:
               - awinic,aw88081
               - awinic,aw88083
-              - awinic,aw88261
     then:
       properties:
         reset-gpios: false
