From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 07:39:55 -0300
Subject: [PATCH] ASoC: codecs: aw88261: Add an OF match table
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The driver matches only through its I2C ID table. An amplifier described
in the device tree still binds, but its uevent carries only the of:
modalias, so the module is never loaded on its own. Add an OF match
table.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 sound/soc/codecs/aw88261.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/sound/soc/codecs/aw88261.c b/sound/soc/codecs/aw88261.c
index c0d629927..555ffd2b3 100644
--- a/sound/soc/codecs/aw88261.c
+++ b/sound/soc/codecs/aw88261.c
@@ -1274,9 +1274,16 @@ static const struct i2c_device_id aw88261_i2c_id[] = {
 };
 MODULE_DEVICE_TABLE(i2c, aw88261_i2c_id);
 
+static const struct of_device_id aw88261_of_match[] = {
+	{ .compatible = "awinic,aw88261" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw88261_of_match);
+
 static struct i2c_driver aw88261_i2c_driver = {
 	.driver = {
 		.name = AW88261_I2C_NAME,
+		.of_match_table = aw88261_of_match,
 	},
 	.probe = aw88261_i2c_probe,
 	.id_table = aw88261_i2c_id,
