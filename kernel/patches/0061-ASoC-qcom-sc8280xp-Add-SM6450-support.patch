From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 07:39:56 -0300
Subject: [PATCH] ASoC: qcom: sc8280xp: Add SM6450 support
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

On SM6450 boards the speakers can be amplifiers on an LPASS I2S port,
as the Awinic amplifier on the Sony Xperia 10 VI is. It takes its bit
clock from the SoC, and the machine driver does not turn that clock on.

Turn the match data into a structure, so that a board can ask for the
bit clock, set through the CPU DAI's set_sysclk() to rate times channels
times sample width. Add SM6450 with it.

LPAIF_MI2S_BCLK comes from the MI2S clock control in q6apm-lpass-dais,
commit cc8495c1d45a in linux-next.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 sound/soc/qcom/sc8280xp.c | 103 +++++++++++++++++++++++++++++++++-----
 1 file changed, 91 insertions(+), 12 deletions(-)

diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index ed8b04c60..147ffa423 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -12,10 +12,23 @@
 #include <sound/jack.h>
 #include <linux/input-event-codes.h>
 #include "qdsp6/q6afe.h"
+#include "qdsp6/q6prm.h"
 #include "common.h"
 #include "sdw.h"
 
+/**
+ * struct sc8280xp_snd_match_data - per-board data
+ * @driver_name: card driver name, which picks the topology and UCM files
+ * @mi2s_bclk_enable: turn on the MI2S bit clock, for codecs that do not
+ *	provide one
+ */
+struct sc8280xp_snd_match_data {
+	const char *driver_name;
+	bool mi2s_bclk_enable;
+};
+
 struct sc8280xp_snd_data {
+	const struct sc8280xp_snd_match_data *match_data;
 	bool stream_prepared[AFE_PORT_MAX];
 	struct snd_soc_card *card;
 	struct sdw_stream_runtime *sruntime[AFE_PORT_MAX];
@@ -114,6 +127,25 @@ static int sc8280xp_snd_hw_params(struct snd_pcm_substream *substream,
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(rtd->card);
+	unsigned int bclk;
+	int ret;
+
+	switch (cpu_dai->id) {
+	case PRIMARY_MI2S_RX...QUATERNARY_MI2S_TX:
+	case QUINARY_MI2S_RX...QUINARY_MI2S_TX:
+		if (!pdata->match_data->mi2s_bclk_enable)
+			break;
+
+		bclk = params_rate(params) * params_channels(params) *
+		       params_physical_width(params);
+		ret = snd_soc_dai_set_sysclk(cpu_dai, LPAIF_MI2S_BCLK, bclk,
+					     SND_SOC_CLOCK_OUT);
+		if (ret)
+			return ret;
+		break;
+	default:
+		break;
+	}
 
 	return qcom_snd_sdw_hw_params(substream, params, &pdata->sruntime[cpu_dai->id]);
 }
@@ -178,6 +210,7 @@ static int sc8280xp_platform_probe(struct platform_device *pdev)
 	if (!data)
 		return -ENOMEM;
 
+	data->match_data = of_device_get_match_data(dev);
 	card->dev = dev;
 	dev_set_drvdata(dev, card);
 	snd_soc_card_set_drvdata(card, data);
@@ -185,23 +218,69 @@ static int sc8280xp_platform_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
-	card->driver_name = of_device_get_match_data(dev);
+	card->driver_name = data->match_data->driver_name;
 	sc8280xp_add_be_ops(card);
 	return devm_snd_soc_register_card(dev, card);
 }
 
+static const struct sc8280xp_snd_match_data qcm6490_data = {
+	.driver_name = "qcm6490",
+};
+
+static const struct sc8280xp_snd_match_data qcs615_data = {
+	.driver_name = "qcs615",
+};
+
+static const struct sc8280xp_snd_match_data qcs6490_data = {
+	.driver_name = "qcs6490",
+};
+
+static const struct sc8280xp_snd_match_data qcs8300_data = {
+	.driver_name = "qcs8300",
+};
+
+static const struct sc8280xp_snd_match_data sa8775p_data = {
+	.driver_name = "sa8775p",
+};
+
+static const struct sc8280xp_snd_match_data sc8280xp_data = {
+	.driver_name = "sc8280xp",
+};
+
+static const struct sc8280xp_snd_match_data sm6450_data = {
+	.driver_name = "sm6450",
+	.mi2s_bclk_enable = true,
+};
+
+static const struct sc8280xp_snd_match_data sm8450_data = {
+	.driver_name = "sm8450",
+};
+
+static const struct sc8280xp_snd_match_data sm8550_data = {
+	.driver_name = "sm8550",
+};
+
+static const struct sc8280xp_snd_match_data sm8650_data = {
+	.driver_name = "sm8650",
+};
+
+static const struct sc8280xp_snd_match_data sm8750_data = {
+	.driver_name = "sm8750",
+};
+
 static const struct of_device_id snd_sc8280xp_dt_match[] = {
-	{.compatible = "qcom,qcm6490-idp-sndcard", "qcm6490"},
-	{.compatible = "qcom,qcs615-sndcard", "qcs615"},
-	{.compatible = "qcom,qcs6490-rb3gen2-sndcard", "qcs6490"},
-	{.compatible = "qcom,qcs8275-sndcard", "qcs8300"},
-	{.compatible = "qcom,qcs9075-sndcard", "sa8775p"},
-	{.compatible = "qcom,qcs9100-sndcard", "sa8775p"},
-	{.compatible = "qcom,sc8280xp-sndcard", "sc8280xp"},
-	{.compatible = "qcom,sm8450-sndcard", "sm8450"},
-	{.compatible = "qcom,sm8550-sndcard", "sm8550"},
-	{.compatible = "qcom,sm8650-sndcard", "sm8650"},
-	{.compatible = "qcom,sm8750-sndcard", "sm8750"},
+	{.compatible = "qcom,qcm6490-idp-sndcard", .data = &qcm6490_data},
+	{.compatible = "qcom,qcs615-sndcard", .data = &qcs615_data},
+	{.compatible = "qcom,qcs6490-rb3gen2-sndcard", .data = &qcs6490_data},
+	{.compatible = "qcom,qcs8275-sndcard", .data = &qcs8300_data},
+	{.compatible = "qcom,qcs9075-sndcard", .data = &sa8775p_data},
+	{.compatible = "qcom,qcs9100-sndcard", .data = &sa8775p_data},
+	{.compatible = "qcom,sc8280xp-sndcard", .data = &sc8280xp_data},
+	{.compatible = "qcom,sm6450-sndcard", .data = &sm6450_data},
+	{.compatible = "qcom,sm8450-sndcard", .data = &sm8450_data},
+	{.compatible = "qcom,sm8550-sndcard", .data = &sm8550_data},
+	{.compatible = "qcom,sm8650-sndcard", .data = &sm8650_data},
+	{.compatible = "qcom,sm8750-sndcard", .data = &sm8750_data},
 	{}
 };
 
