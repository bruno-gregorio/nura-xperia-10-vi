From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 08:21:52 -0300
Subject: [PATCH] ASoC: codecs: Add the Awinic AW88263 amplifier driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The AW88263 reports chip ID 0x2032. It shares only its first six
registers with the AW88261: the volume and the hardware mute sit in
SYSCTRL2, the I2S format in I2SCTRL, the feedback enable in I2SCFG1 and
the PLL's divider select in PLLCTRL1, all at addresses or bits the
AW88261 driver does not use. Give it a driver of its own. The register
layout and the power sequence come from Awinic's GPL aw882xx driver, the
ACF profile parsing from the shared aw88395 library.

The driver follows the cleaned-up AW88261 driver in linux-next. It has
no fades and starts the amplifier synchronously from DAPM. It programs
the I2S rate, width and frame size from hw_params, so the format no
longer comes from the profile. The volume control steps in 1/4 dB, and
its top is the level the profile asks for, so a tuned profile cannot be
exceeded from userspace.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 sound/soc/codecs/Kconfig   |  13 +
 sound/soc/codecs/Makefile  |   2 +
 sound/soc/codecs/aw88263.c | 936 +++++++++++++++++++++++++++++++++++++
 sound/soc/codecs/aw88263.h | 136 ++++++
 4 files changed, 1087 insertions(+)
 create mode 100644 sound/soc/codecs/aw88263.c
 create mode 100644 sound/soc/codecs/aw88263.h

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 91ac99bc3..e8c825ac5 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -60,6 +60,7 @@ config SND_SOC_ALL_CODECS
 	imply SND_SOC_AW88081
 	imply SND_SOC_AW88166
 	imply SND_SOC_AW88261
+	imply SND_SOC_AW88263
 	imply SND_SOC_AW88399
 	imply SND_SOC_BT_SCO
 	imply SND_SOC_BD28623
@@ -714,6 +715,18 @@ config SND_SOC_AW88261
 	  boost converter can be adjusted smartly according to
 	  the input amplitude.
 
+config SND_SOC_AW88263
+	tristate "Soc Audio for awinic aw88263"
+	depends on I2C
+	select REGMAP_I2C
+	select GPIOLIB
+	select SND_SOC_AW88395_LIB
+	help
+	  This option enables support for aw88263 Smart PA.
+	  The awinic AW88263 is an I2S/TDM input, high efficiency
+	  digital Smart K audio amplifier with an integrated boost
+	  converter and current and voltage sensing.
+
 config SND_SOC_AW88081
 	tristate "Soc Audio for awinic aw88081/aw88083"
 	depends on I2C
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
index da4077463..9f03aeac5 100644
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -55,6 +55,7 @@ snd-soc-aw88395-y := aw88395/aw88395.o \
 			aw88395/aw88395_device.o
 snd-soc-aw88166-y := aw88166.o
 snd-soc-aw88261-y := aw88261.o
+snd-soc-aw88263-y := aw88263.o
 snd-soc-aw88399-y := aw88399.o
 snd-soc-bd28623-y := bd28623.o
 snd-soc-bt-sco-y := bt-sco.o
@@ -487,6 +488,7 @@ obj-$(CONFIG_SND_SOC_AW88395_LIB) += snd-soc-aw88395-lib.o
 obj-$(CONFIG_SND_SOC_AW88395)	+=snd-soc-aw88395.o
 obj-$(CONFIG_SND_SOC_AW88166)	+=snd-soc-aw88166.o
 obj-$(CONFIG_SND_SOC_AW88261)	+=snd-soc-aw88261.o
+obj-$(CONFIG_SND_SOC_AW88263)	+=snd-soc-aw88263.o
 obj-$(CONFIG_SND_SOC_AW88399)	+= snd-soc-aw88399.o
 obj-$(CONFIG_SND_SOC_BD28623)	+= snd-soc-bd28623.o
 obj-$(CONFIG_SND_SOC_BT_SCO)	+= snd-soc-bt-sco.o
diff --git a/sound/soc/codecs/aw88263.c b/sound/soc/codecs/aw88263.c
new file mode 100644
index 000000000..acd01e9b3
--- /dev/null
+++ b/sound/soc/codecs/aw88263.c
@@ -0,0 +1,936 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// aw88263.c  --  AW88263 ALSA SoC Audio driver
+//
+// Based on aw88261.c, Copyright (c) 2023 awinic Technology CO., LTD.
+// The power sequencing follows Awinic's aw882xx driver.
+//
+
+#include <linux/bitfield.h>
+#include <linux/cleanup.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+#include "aw88263.h"
+#include "aw88395/aw88395_data_type.h"
+#include "aw88395/aw88395_device.h"
+
+static const struct regmap_config aw88263_regmap_config = {
+	.val_bits = 16,
+	.reg_bits = 8,
+	.max_register = AW88263_REG_MAX,
+	.reg_format_endian = REGMAP_ENDIAN_LITTLE,
+	.val_format_endian = REGMAP_ENDIAN_BIG,
+};
+
+static unsigned int aw88263_vol_to_reg(unsigned int vol)
+{
+	return FIELD_PREP(AW88263_VOL, ((vol / AW88263_VOL_6DB_STEP) << 6) |
+				       (vol % AW88263_VOL_6DB_STEP));
+}
+
+static unsigned int aw88263_reg_to_vol(unsigned int reg)
+{
+	unsigned int field = FIELD_GET(AW88263_VOL, reg);
+
+	return (field >> 6) * AW88263_VOL_6DB_STEP + (field & 0x3f);
+}
+
+static void aw88263_dev_set_volume(struct aw_device *aw_dev, unsigned int vol)
+{
+	vol = min(vol, (unsigned int)AW88263_MUTE_VOL);
+
+	regmap_update_bits(aw_dev->regmap, AW88263_SYSCTRL2_REG, AW88263_VOL,
+			   aw88263_vol_to_reg(vol));
+}
+
+/* The profile's own level, less what the mixer control takes off */
+static unsigned int aw88263_ctl_to_vol(struct aw_device *aw_dev)
+{
+	struct aw_volume_desc *desc = &aw_dev->volume_desc;
+
+	return desc->init_volume + (AW88263_CTL_MAX_VOL - desc->ctl_volume) * 2;
+}
+
+static void aw88263_dev_pwd(struct aw_device *aw_dev, bool pwd)
+{
+	regmap_update_bits(aw_dev->regmap, AW88263_SYSCTRL_REG, AW88263_PWDN,
+			   pwd ? AW88263_PWDN : 0);
+}
+
+static void aw88263_dev_amppd(struct aw_device *aw_dev, bool amppd)
+{
+	regmap_update_bits(aw_dev->regmap, AW88263_SYSCTRL_REG, AW88263_AMPPD,
+			   amppd ? AW88263_AMPPD : 0);
+}
+
+static void aw88263_dev_i2s_tx_enable(struct aw_device *aw_dev, bool enable)
+{
+	regmap_update_bits(aw_dev->regmap, AW88263_I2SCFG1_REG, AW88263_I2STXEN,
+			   enable ? AW88263_I2STXEN : 0);
+}
+
+static void aw88263_dev_mute(struct aw_device *aw_dev, bool mute)
+{
+	if (mute) {
+		aw88263_dev_set_volume(aw_dev, AW88263_MUTE_VOL);
+		regmap_update_bits(aw_dev->regmap, AW88263_SYSCTRL2_REG,
+				   AW88263_HMUTE, AW88263_HMUTE);
+	} else {
+		regmap_update_bits(aw_dev->regmap, AW88263_SYSCTRL2_REG,
+				   AW88263_HMUTE, 0);
+		aw88263_dev_set_volume(aw_dev, aw88263_ctl_to_vol(aw_dev));
+	}
+}
+
+static void aw88263_dev_clear_int_status(struct aw_device *aw_dev)
+{
+	unsigned int int_status;
+
+	/* the status clears on read; read it twice to be sure it did */
+	regmap_read(aw_dev->regmap, AW88263_SYSINT_REG, &int_status);
+	regmap_read(aw_dev->regmap, AW88263_SYSINT_REG, &int_status);
+}
+
+static int aw88263_dev_wait_sysst(struct aw_device *aw_dev, unsigned int check)
+{
+	unsigned int reg_val;
+	int ret, i;
+
+	for (i = 0; i < AW88263_DEV_SYSST_CHECK_MAX; i++) {
+		ret = regmap_read(aw_dev->regmap, AW88263_SYSST_REG, &reg_val);
+		if (ret)
+			return ret;
+
+		if ((reg_val & check) == check)
+			return 0;
+
+		usleep_range(2000, 2010);
+	}
+
+	dev_dbg(aw_dev->dev, "SYSST 0x%04x, waiting for 0x%04x\n", reg_val, check);
+
+	return -ETIMEDOUT;
+}
+
+/*
+ * The PLL locks to the I2S clocks either straight from its oscillator or
+ * through a divider. Try the first, and if it does not lock, kick the PLL
+ * through the divider and back as Awinic's driver does.
+ */
+static int aw88263_dev_check_syspll(struct aw_device *aw_dev)
+{
+	unsigned int reg_val;
+	int ret;
+
+	ret = aw88263_dev_wait_sysst(aw_dev, AW88263_IIS_CHECK);
+	if (!ret)
+		return 0;
+
+	ret = regmap_read(aw_dev->regmap, AW88263_PLLCTRL1_REG, &reg_val);
+	if (ret)
+		return ret;
+
+	if (!(reg_val & AW88263_CCO_MUX))
+		return -ETIMEDOUT;
+
+	regmap_update_bits(aw_dev->regmap, AW88263_PLLCTRL1_REG,
+			   AW88263_CCO_MUX, 0);
+	ret = aw88263_dev_wait_sysst(aw_dev, AW88263_IIS_CHECK);
+
+	regmap_update_bits(aw_dev->regmap, AW88263_PLLCTRL1_REG,
+			   AW88263_CCO_MUX, AW88263_CCO_MUX);
+	if (ret)
+		return ret;
+
+	usleep_range(2000, 2010);
+
+	return aw88263_dev_wait_sysst(aw_dev, AW88263_IIS_CHECK);
+}
+
+static int aw88263_dev_get_ef(struct aw_device *aw_dev, unsigned int reg, s16 *val)
+{
+	unsigned int reg_val;
+	u16 ef;
+	int ret;
+
+	ret = regmap_read(aw_dev->regmap, reg, &reg_val);
+	if (ret)
+		return ret;
+
+	ef = FIELD_GET(AW88263_EF_GESLP, reg_val);
+	if (ef & AW88263_EF_GESLP_SIGN)
+		ef |= ~AW88263_EF_GESLP;
+
+	*val = (s16)ef;
+
+	return 0;
+}
+
+/* Trim the voltage sense against the current sense, from their eFuse slopes */
+static int aw88263_dev_set_vcalb(struct aw_device *aw_dev)
+{
+	s16 icalk_val, vcalk_val;
+	int icalk, vcalk;
+	int ret;
+
+	ret = aw88263_dev_get_ef(aw_dev, AW88263_EFRM1_REG, &icalk_val);
+	if (ret)
+		return ret;
+
+	ret = aw88263_dev_get_ef(aw_dev, AW88263_EFRH_REG, &vcalk_val);
+	if (ret)
+		return ret;
+
+	icalk = AW88263_CABL_BASE_VALUE + icalk_val;
+	vcalk = AW88263_CABL_BASE_VALUE + vcalk_val;
+	if (!vcalk)
+		return -EINVAL;
+
+	return regmap_write(aw_dev->regmap, AW88263_VTMCTRL3_REG,
+			    AW88263_VCAL_FACTOR * icalk / vcalk);
+}
+
+static int aw88263_dev_reg_update(struct aw88263 *aw88263,
+				  unsigned char *data, unsigned int len)
+{
+	struct aw_device *aw_dev = aw88263->aw_pa;
+	unsigned int read_val;
+	int data_len, i, ret;
+	s16 *reg_data;
+	u16 reg_val;
+	u8 reg_addr;
+
+	if (!len || !data) {
+		dev_err(aw_dev->dev, "reg data is null or len is 0\n");
+		return -EINVAL;
+	}
+
+	reg_data = (s16 *)data;
+	data_len = len >> 1;
+
+	if (data_len & 0x1) {
+		dev_err(aw_dev->dev, "data len:%d unsupported\n", data_len);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < data_len; i += 2) {
+		reg_addr = reg_data[i];
+		reg_val = reg_data[i + 1];
+
+		switch (reg_addr) {
+		case AW88263_SYSCTRL_REG:
+			/* the profile may leave the amplifier off */
+			aw88263->amppd_st = reg_val & AW88263_AMPPD;
+
+			/* keep the chip powered down and its amplifier off */
+			ret = regmap_read(aw_dev->regmap, reg_addr, &read_val);
+			if (ret)
+				return ret;
+
+			reg_val &= ~(AW88263_PWDN | AW88263_AMPPD);
+			reg_val |= read_val & (AW88263_PWDN | AW88263_AMPPD);
+			break;
+		case AW88263_SYSCTRL2_REG:
+			/* the profile's level is the top of the mixer control */
+			aw_dev->volume_desc.init_volume = aw88263_reg_to_vol(reg_val);
+
+			/* keep the chip muted */
+			ret = regmap_read(aw_dev->regmap, reg_addr, &read_val);
+			if (ret)
+				return ret;
+
+			reg_val &= ~AW88263_HMUTE;
+			reg_val |= read_val & AW88263_HMUTE;
+			break;
+		case AW88263_I2SCFG1_REG:
+			/* no feedback until the amplifier is up */
+			reg_val &= ~AW88263_I2STXEN;
+			break;
+		case AW88263_VTMCTRL3_REG:
+			/* calibrated per chip below */
+			continue;
+		default:
+			break;
+		}
+
+		ret = regmap_write(aw_dev->regmap, reg_addr, reg_val);
+		if (ret)
+			return ret;
+	}
+
+	ret = aw88263_dev_set_vcalb(aw_dev);
+	if (ret)
+		return ret;
+
+	aw88263_dev_set_volume(aw_dev, AW88263_MUTE_VOL);
+
+	return 0;
+}
+
+static int aw88263_dev_get_prof_name(struct aw_device *aw_dev, int index, char **prof_name)
+{
+	struct aw_prof_info *prof_info = &aw_dev->prof_info;
+	struct aw_prof_desc *prof_desc;
+
+	if (index >= aw_dev->prof_info.count || index < 0)
+		return -EINVAL;
+
+	prof_desc = &aw_dev->prof_info.prof_desc[index];
+
+	*prof_name = prof_info->prof_name_list[prof_desc->id];
+
+	return 0;
+}
+
+static int aw88263_dev_fw_update(struct aw88263 *aw88263)
+{
+	struct aw_device *aw_dev = aw88263->aw_pa;
+	struct aw_sec_data_desc *sec_desc;
+	int ret;
+
+	if (aw_dev->prof_index >= aw_dev->prof_info.count)
+		return -EINVAL;
+
+	sec_desc = aw_dev->prof_info.prof_desc[aw_dev->prof_index].sec_desc;
+	ret = aw88263_dev_reg_update(aw88263, sec_desc[AW88395_DATA_TYPE_REG].data,
+				     sec_desc[AW88395_DATA_TYPE_REG].len);
+	if (ret) {
+		dev_err(aw_dev->dev, "update reg failed\n");
+		return ret;
+	}
+
+	aw_dev->prof_cur = aw_dev->prof_index;
+
+	return 0;
+}
+
+static int aw88263_dev_start(struct aw88263 *aw88263)
+{
+	struct aw_device *aw_dev = aw88263->aw_pa;
+	unsigned int reg_val;
+	int ret;
+
+	if (aw_dev->status == AW88263_DEV_PW_ON)
+		return 0;
+
+	if (aw_dev->prof_cur != aw_dev->prof_index) {
+		ret = aw88263_dev_fw_update(aw88263);
+		if (ret)
+			return ret;
+	}
+
+	/* the stream's format, over whatever the profile set */
+	ret = regmap_update_bits(aw_dev->regmap, AW88263_I2SCTRL_REG,
+				 AW88263_I2SSR | AW88263_I2SBCK |
+				 AW88263_I2SFS | AW88263_I2SMD,
+				 aw88263->i2sctrl);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(aw_dev->regmap, AW88263_SYSCTRL_REG,
+				 AW88263_BCKINV | AW88263_WSINV,
+				 aw88263->sysctrl_inv);
+	if (ret)
+		return ret;
+
+	aw88263_dev_pwd(aw_dev, false);
+	usleep_range(2000, 2010);
+
+	ret = aw88263_dev_check_syspll(aw_dev);
+	if (ret) {
+		dev_dbg(aw_dev->dev, "PLL did not lock\n");
+		goto pll_check_fail;
+	}
+
+	aw88263_dev_amppd(aw_dev, false);
+	usleep_range(1000, 1050);
+
+	ret = aw88263_dev_wait_sysst(aw_dev, AW88263_SYSST_CHECK);
+	if (ret) {
+		dev_dbg(aw_dev->dev, "amplifier did not come up\n");
+		goto sysst_check_fail;
+	}
+
+	aw88263_dev_i2s_tx_enable(aw_dev, true);
+
+	if (aw88263->amppd_st)
+		aw88263_dev_amppd(aw_dev, true);
+
+	aw88263_dev_mute(aw_dev, false);
+
+	aw88263_dev_clear_int_status(aw_dev);
+	aw_dev->status = AW88263_DEV_PW_ON;
+
+	if (!regmap_read(aw_dev->regmap, AW88263_SYSST_REG, &reg_val))
+		dev_dbg(aw_dev->dev, "started, SYSST 0x%04x\n", reg_val);
+
+	return 0;
+
+sysst_check_fail:
+	aw88263_dev_i2s_tx_enable(aw_dev, false);
+	aw88263_dev_clear_int_status(aw_dev);
+	aw88263_dev_amppd(aw_dev, true);
+pll_check_fail:
+	aw88263_dev_pwd(aw_dev, true);
+	aw_dev->status = AW88263_DEV_PW_OFF;
+
+	return ret;
+}
+
+static void aw88263_dev_stop(struct aw_device *aw_dev)
+{
+	if (aw_dev->status == AW88263_DEV_PW_OFF)
+		return;
+
+	aw_dev->status = AW88263_DEV_PW_OFF;
+
+	aw88263_dev_clear_int_status(aw_dev);
+	aw88263_dev_mute(aw_dev, true);
+	aw88263_dev_i2s_tx_enable(aw_dev, false);
+	usleep_range(1000, 1100);
+	aw88263_dev_amppd(aw_dev, true);
+	aw88263_dev_pwd(aw_dev, true);
+}
+
+static void aw88263_start(struct aw88263 *aw88263)
+{
+	struct aw_device *aw_dev = aw88263->aw_pa;
+	int ret, i;
+
+	if (aw_dev->fw_status != AW88263_DEV_FW_OK)
+		return;
+
+	for (i = 0; i < AW88263_START_RETRIES; i++) {
+		ret = aw88263_dev_start(aw88263);
+		if (!ret)
+			return;
+	}
+
+	dev_err(aw_dev->dev, "start failed: %d\n", ret);
+}
+
+static int aw88263_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct aw88263 *aw88263 = snd_soc_component_get_drvdata(dai->component);
+	unsigned int md;
+
+	switch (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_CBC_CFC:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		md = AW88263_I2SMD_PHILIPS;
+		break;
+	case SND_SOC_DAIFMT_LEFT_J:
+		md = AW88263_I2SMD_MSB_JUSTIFIED;
+		break;
+	case SND_SOC_DAIFMT_RIGHT_J:
+		md = AW88263_I2SMD_LSB_JUSTIFIED;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		aw88263->sysctrl_inv = 0;
+		break;
+	case SND_SOC_DAIFMT_IB_NF:
+		aw88263->sysctrl_inv = AW88263_BCKINV;
+		break;
+	case SND_SOC_DAIFMT_NB_IF:
+		aw88263->sysctrl_inv = AW88263_WSINV;
+		break;
+	case SND_SOC_DAIFMT_IB_IF:
+		aw88263->sysctrl_inv = AW88263_BCKINV | AW88263_WSINV;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	aw88263->i2sctrl &= ~AW88263_I2SMD;
+	aw88263->i2sctrl |= FIELD_PREP(AW88263_I2SMD, md);
+
+	return 0;
+}
+
+static int aw88263_hw_params(struct snd_pcm_substream *substream,
+			     struct snd_pcm_hw_params *params,
+			     struct snd_soc_dai *dai)
+{
+	struct aw88263 *aw88263 = snd_soc_component_get_drvdata(dai->component);
+	unsigned int sr, fs, bck;
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		return 0;
+
+	switch (params_rate(params)) {
+	case 8000:
+		sr = AW88263_I2SSR_8_KHZ;
+		break;
+	case 11025:
+		sr = AW88263_I2SSR_11_KHZ;
+		break;
+	case 12000:
+		sr = AW88263_I2SSR_12_KHZ;
+		break;
+	case 16000:
+		sr = AW88263_I2SSR_16_KHZ;
+		break;
+	case 22050:
+		sr = AW88263_I2SSR_22_KHZ;
+		break;
+	case 24000:
+		sr = AW88263_I2SSR_24_KHZ;
+		break;
+	case 32000:
+		sr = AW88263_I2SSR_32_KHZ;
+		break;
+	case 44100:
+		sr = AW88263_I2SSR_44_KHZ;
+		break;
+	case 48000:
+		sr = AW88263_I2SSR_48_KHZ;
+		break;
+	case 96000:
+		sr = AW88263_I2SSR_96_KHZ;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (params_width(params)) {
+	case 16:
+		fs = AW88263_I2SFS_16_BITS;
+		break;
+	case 20:
+		fs = AW88263_I2SFS_20_BITS;
+		break;
+	case 24:
+		fs = AW88263_I2SFS_24_BITS;
+		break;
+	case 32:
+		fs = AW88263_I2SFS_32_BITS;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (params_physical_width(params)) {
+	case 16:
+		bck = AW88263_I2SBCK_32FS;
+		break;
+	case 24:
+		bck = AW88263_I2SBCK_48FS;
+		break;
+	case 32:
+		bck = AW88263_I2SBCK_64FS;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	aw88263->i2sctrl &= AW88263_I2SMD;
+	aw88263->i2sctrl |= FIELD_PREP(AW88263_I2SSR, sr) |
+			    FIELD_PREP(AW88263_I2SFS, fs) |
+			    FIELD_PREP(AW88263_I2SBCK, bck);
+
+	return 0;
+}
+
+static const struct snd_soc_dai_ops aw88263_dai_ops = {
+	.set_fmt = aw88263_set_fmt,
+	.hw_params = aw88263_hw_params,
+};
+
+static struct snd_soc_dai_driver aw88263_dai[] = {
+	{
+		.name = "aw88263-aif",
+		.id = 1,
+		.playback = {
+			.stream_name = "Speaker_Playback",
+			.channels_min = 1,
+			.channels_max = 2,
+			.rates = AW88263_RATES,
+			.formats = AW88263_FORMATS,
+		},
+		.capture = {
+			.stream_name = "Speaker_Capture",
+			.channels_min = 1,
+			.channels_max = 2,
+			.rates = AW88263_RATES,
+			.formats = AW88263_FORMATS,
+		},
+		.ops = &aw88263_dai_ops,
+	},
+};
+
+static int aw88263_profile_info(struct snd_kcontrol *kcontrol,
+				struct snd_ctl_elem_info *uinfo)
+{
+	struct snd_soc_component *codec = snd_soc_kcontrol_component(kcontrol);
+	struct aw88263 *aw88263 = snd_soc_component_get_drvdata(codec);
+	char *prof_name;
+	int count;
+
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_ENUMERATED;
+	uinfo->count = 1;
+
+	count = aw88263->aw_pa->prof_info.count;
+	if (count <= 0) {
+		uinfo->value.enumerated.items = 0;
+		return 0;
+	}
+
+	uinfo->value.enumerated.items = count;
+
+	if (uinfo->value.enumerated.item >= count)
+		uinfo->value.enumerated.item = count - 1;
+
+	if (aw88263_dev_get_prof_name(aw88263->aw_pa, uinfo->value.enumerated.item,
+				      &prof_name))
+		strscpy(uinfo->value.enumerated.name, "null");
+	else
+		strscpy(uinfo->value.enumerated.name, prof_name);
+
+	return 0;
+}
+
+static int aw88263_profile_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *codec = snd_soc_kcontrol_component(kcontrol);
+	struct aw88263 *aw88263 = snd_soc_component_get_drvdata(codec);
+
+	ucontrol->value.enumerated.item[0] = aw88263->aw_pa->prof_index;
+
+	return 0;
+}
+
+static int aw88263_profile_set(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *codec = snd_soc_kcontrol_component(kcontrol);
+	struct aw88263 *aw88263 = snd_soc_component_get_drvdata(codec);
+	struct aw_device *aw_dev = aw88263->aw_pa;
+	unsigned int index = ucontrol->value.enumerated.item[0];
+
+	guard(mutex)(&aw88263->lock);
+
+	if (index >= aw_dev->prof_info.count)
+		return -EINVAL;
+
+	if (index == aw_dev->prof_index)
+		return 0;
+
+	aw_dev->prof_index = index;
+
+	/* a running amplifier switches over now, a stopped one when it starts */
+	if (aw_dev->status == AW88263_DEV_PW_ON) {
+		aw88263_dev_stop(aw_dev);
+		aw88263_start(aw88263);
+	}
+
+	return 1;
+}
+
+static int aw88263_volume_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *codec = snd_soc_kcontrol_component(kcontrol);
+	struct aw88263 *aw88263 = snd_soc_component_get_drvdata(codec);
+
+	ucontrol->value.integer.value[0] = aw88263->aw_pa->volume_desc.ctl_volume;
+
+	return 0;
+}
+
+static int aw88263_volume_set(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *codec = snd_soc_kcontrol_component(kcontrol);
+	struct aw88263 *aw88263 = snd_soc_component_get_drvdata(codec);
+	struct aw_device *aw_dev = aw88263->aw_pa;
+	long value = ucontrol->value.integer.value[0];
+
+	if (value < 0 || value > AW88263_CTL_MAX_VOL)
+		return -EINVAL;
+
+	guard(mutex)(&aw88263->lock);
+
+	if (aw_dev->volume_desc.ctl_volume == value)
+		return 0;
+
+	aw_dev->volume_desc.ctl_volume = value;
+
+	if (aw_dev->status == AW88263_DEV_PW_ON)
+		aw88263_dev_set_volume(aw_dev, aw88263_ctl_to_vol(aw_dev));
+
+	return 1;
+}
+
+/*
+ * The chip steps by 1/8 dB, finer than a TLV can say, so the control steps
+ * by 1/4 dB. Its top is the level the profile in the firmware file asks for.
+ */
+static const DECLARE_TLV_DB_SCALE(aw88263_volume_tlv, -9000, 25, 1);
+
+static const struct snd_kcontrol_new aw88263_controls[] = {
+	SOC_SINGLE_EXT_TLV("PCM Playback Volume", SND_SOC_NOPM, 0,
+			   AW88263_CTL_MAX_VOL, 0, aw88263_volume_get,
+			   aw88263_volume_set, aw88263_volume_tlv),
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "Profile Set",
+		.info = aw88263_profile_info,
+		.get = aw88263_profile_get,
+		.put = aw88263_profile_set,
+	},
+};
+
+static int aw88263_playback_event(struct snd_soc_dapm_widget *w,
+				  struct snd_kcontrol *k, int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct aw88263 *aw88263 = snd_soc_component_get_drvdata(component);
+
+	guard(mutex)(&aw88263->lock);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		aw88263_start(aw88263);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		aw88263_dev_stop(aw88263->aw_pa);
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
+static const struct snd_soc_dapm_widget aw88263_dapm_widgets[] = {
+	SND_SOC_DAPM_AIF_IN_E("AIF_RX", "Speaker_Playback", 0, SND_SOC_NOPM, 0, 0,
+			      aw88263_playback_event,
+			      SND_SOC_DAPM_PRE_PMU | SND_SOC_DAPM_POST_PMD),
+	SND_SOC_DAPM_OUTPUT("DAC Output"),
+
+	SND_SOC_DAPM_AIF_OUT("AIF_TX", "Speaker_Capture", 0, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_INPUT("ADC Input"),
+};
+
+static const struct snd_soc_dapm_route aw88263_audio_map[] = {
+	{"DAC Output", NULL, "AIF_RX"},
+	{"AIF_TX", NULL, "ADC Input"},
+};
+
+static int aw88263_dev_init(struct aw88263 *aw88263, struct aw_container *aw_cfg)
+{
+	struct aw_device *aw_dev = aw88263->aw_pa;
+	int ret;
+
+	ret = aw88395_dev_cfg_load(aw_dev, aw_cfg);
+	if (ret) {
+		dev_err(aw_dev->dev, "aw_dev acf parse failed\n");
+		return -EINVAL;
+	}
+
+	ret = regmap_write(aw_dev->regmap, AW88263_ID_REG, AW88263_SOFT_RESET_VALUE);
+	if (ret)
+		return ret;
+
+	aw_dev->prof_cur = AW88263_INIT_PROFILE;
+	aw_dev->prof_index = AW88263_INIT_PROFILE;
+
+	ret = aw88263_dev_fw_update(aw88263);
+	if (ret)
+		return ret;
+
+	aw88263_dev_clear_int_status(aw_dev);
+	aw88263_dev_mute(aw_dev, true);
+	aw88263_dev_i2s_tx_enable(aw_dev, false);
+	usleep_range(1000, 1100);
+	aw88263_dev_amppd(aw_dev, true);
+	aw88263_dev_pwd(aw_dev, true);
+
+	return 0;
+}
+
+static int aw88263_request_firmware_file(struct aw88263 *aw88263)
+{
+	const struct firmware *cont __free(firmware) = NULL;
+	struct device *dev = aw88263->aw_pa->dev;
+	struct aw_container *aw_cfg;
+	int ret;
+
+	aw88263->aw_pa->fw_status = AW88263_DEV_FW_FAILED;
+
+	ret = request_firmware(&cont, AW88263_ACF_FILE, dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to load %s\n", AW88263_ACF_FILE);
+
+	aw_cfg = devm_kzalloc(dev, struct_size(aw_cfg, data, cont->size), GFP_KERNEL);
+	if (!aw_cfg)
+		return -ENOMEM;
+
+	aw_cfg->len = cont->size;
+	memcpy(aw_cfg->data, cont->data, cont->size);
+	aw88263->aw_cfg = aw_cfg;
+
+	ret = aw88395_dev_load_acf_check(aw88263->aw_pa, aw_cfg);
+	if (ret)
+		return dev_err_probe(dev, ret, "invalid %s\n", AW88263_ACF_FILE);
+
+	guard(mutex)(&aw88263->lock);
+
+	return aw88263_dev_init(aw88263, aw_cfg);
+}
+
+static int aw88263_codec_probe(struct snd_soc_component *component)
+{
+	struct snd_soc_dapm_context *dapm = snd_soc_component_get_dapm(component);
+	struct aw88263 *aw88263 = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	ret = aw88263_request_firmware_file(aw88263);
+	if (ret)
+		return ret;
+
+	ret = snd_soc_dapm_new_controls(dapm, aw88263_dapm_widgets,
+					ARRAY_SIZE(aw88263_dapm_widgets));
+	if (ret)
+		return ret;
+
+	ret = snd_soc_dapm_add_routes(dapm, aw88263_audio_map,
+				      ARRAY_SIZE(aw88263_audio_map));
+	if (ret)
+		return ret;
+
+	return snd_soc_add_component_controls(component, aw88263_controls,
+					      ARRAY_SIZE(aw88263_controls));
+}
+
+static const struct snd_soc_component_driver soc_codec_dev_aw88263 = {
+	.probe = aw88263_codec_probe,
+};
+
+static int aw88263_init(struct aw88263 *aw88263, struct i2c_client *i2c)
+{
+	struct aw_device *aw_dev;
+	unsigned int chip_id;
+	u32 channel = 0;
+	int ret;
+
+	ret = regmap_read(aw88263->regmap, AW88263_ID_REG, &chip_id);
+	if (ret)
+		return dev_err_probe(&i2c->dev, ret, "failed to read chip ID\n");
+
+	if (chip_id != AW88263_CHIP_ID)
+		return dev_err_probe(&i2c->dev, -ENODEV,
+				     "unsupported chip ID 0x%04x\n", chip_id);
+
+	aw_dev = devm_kzalloc(&i2c->dev, sizeof(*aw_dev), GFP_KERNEL);
+	if (!aw_dev)
+		return -ENOMEM;
+
+	device_property_read_u32(&i2c->dev, "awinic,audio-channel", &channel);
+
+	aw_dev->i2c = i2c;
+	aw_dev->regmap = aw88263->regmap;
+	aw_dev->dev = &i2c->dev;
+	aw_dev->chip_id = AW88263_CHIP_ID;
+	aw_dev->channel = channel;
+	aw_dev->prof_info.prof_type = AW88395_DEV_NONE_TYPE_ID;
+	aw_dev->fw_status = AW88263_DEV_FW_FAILED;
+	aw_dev->volume_desc.ctl_volume = AW88263_CTL_DEFAULT_VOL;
+	aw_dev->volume_desc.mute_volume = AW88263_MUTE_VOL;
+
+	aw88263->aw_pa = aw_dev;
+
+	return 0;
+}
+
+static int aw88263_i2c_probe(struct i2c_client *i2c)
+{
+	struct aw88263 *aw88263;
+	int ret;
+
+	if (!i2c_check_functionality(i2c->adapter, I2C_FUNC_I2C))
+		return dev_err_probe(&i2c->dev, -ENXIO, "I2C not supported\n");
+
+	aw88263 = devm_kzalloc(&i2c->dev, sizeof(*aw88263), GFP_KERNEL);
+	if (!aw88263)
+		return -ENOMEM;
+
+	/* until hw_params says otherwise, the format Awinic's profiles use */
+	aw88263->i2sctrl = FIELD_PREP(AW88263_I2SSR, AW88263_I2SSR_48_KHZ) |
+			   FIELD_PREP(AW88263_I2SFS, AW88263_I2SFS_32_BITS) |
+			   FIELD_PREP(AW88263_I2SBCK, AW88263_I2SBCK_64FS) |
+			   FIELD_PREP(AW88263_I2SMD, AW88263_I2SMD_PHILIPS);
+
+	ret = devm_mutex_init(&i2c->dev, &aw88263->lock);
+	if (ret)
+		return ret;
+
+	i2c_set_clientdata(i2c, aw88263);
+
+	aw88263->regmap = devm_regmap_init_i2c(i2c, &aw88263_regmap_config);
+	if (IS_ERR(aw88263->regmap))
+		return dev_err_probe(&i2c->dev, PTR_ERR(aw88263->regmap),
+				     "failed to init regmap\n");
+
+	aw88263->reset_gpio = devm_gpiod_get_optional(&i2c->dev, "reset",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(aw88263->reset_gpio))
+		return dev_err_probe(&i2c->dev, PTR_ERR(aw88263->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	if (aw88263->reset_gpio) {
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(aw88263->reset_gpio, 0);
+		usleep_range(2000, 3000);
+	}
+
+	ret = aw88263_init(aw88263, i2c);
+	if (ret)
+		return ret;
+
+	return devm_snd_soc_register_component(&i2c->dev, &soc_codec_dev_aw88263,
+					       aw88263_dai, ARRAY_SIZE(aw88263_dai));
+}
+
+static const struct i2c_device_id aw88263_i2c_id[] = {
+	{ "aw88263" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, aw88263_i2c_id);
+
+static const struct of_device_id aw88263_of_match[] = {
+	{ .compatible = "awinic,aw88263" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw88263_of_match);
+
+static struct i2c_driver aw88263_i2c_driver = {
+	.driver = {
+		.name = "aw88263",
+		.of_match_table = aw88263_of_match,
+	},
+	.probe = aw88263_i2c_probe,
+	.id_table = aw88263_i2c_id,
+};
+module_i2c_driver(aw88263_i2c_driver);
+
+MODULE_DESCRIPTION("ASoC AW88263 Smart PA Driver");
+MODULE_LICENSE("GPL");
diff --git a/sound/soc/codecs/aw88263.h b/sound/soc/codecs/aw88263.h
new file mode 100644
index 000000000..e7aed94a5
--- /dev/null
+++ b/sound/soc/codecs/aw88263.h
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * aw88263.h  --  AW88263 ALSA SoC Audio driver
+ *
+ * The register layout is the one Awinic's aw882xx driver calls PID 0x2032.
+ */
+
+#ifndef __AW88263_H__
+#define __AW88263_H__
+
+#include <linux/bits.h>
+
+#define AW88263_ID_REG			0x00
+#define AW88263_SYSST_REG		0x01
+#define AW88263_SYSINT_REG		0x02
+#define AW88263_SYSINTM_REG		0x03
+#define AW88263_SYSCTRL_REG		0x04
+#define AW88263_SYSCTRL2_REG		0x05
+#define AW88263_I2SCTRL_REG		0x06
+#define AW88263_I2SCFG1_REG		0x07
+#define AW88263_VTMCTRL3_REG		0x56
+#define AW88263_PLLCTRL1_REG		0x66
+#define AW88263_EFRH_REG		0x78
+#define AW88263_EFRM1_REG		0x7a
+#define AW88263_REG_MAX			0x7d
+
+#define AW88263_CHIP_ID			0x2032
+#define AW88263_SOFT_RESET_VALUE	0x55aa
+
+/* SYSST */
+#define AW88263_PLLS			BIT(0)
+#define AW88263_CLKS			BIT(4)
+#define AW88263_NOCLKS			BIT(5)
+#define AW88263_SWS			BIT(8)
+#define AW88263_BSTS			BIT(9)
+#define AW88263_IIS_CHECK		(AW88263_CLKS | AW88263_PLLS)
+#define AW88263_SYSST_CHECK		(AW88263_BSTS | AW88263_SWS | \
+					 AW88263_CLKS | AW88263_PLLS)
+
+/* SYSCTRL */
+#define AW88263_PWDN			BIT(0)
+#define AW88263_AMPPD			BIT(1)
+#define AW88263_BCKINV			BIT(4)
+#define AW88263_WSINV			BIT(5)
+#define AW88263_I2SEN			BIT(6)
+#define AW88263_RCV_MODE		BIT(7)
+
+/* SYSCTRL2 */
+#define AW88263_HMUTE			BIT(4)
+#define AW88263_VOL			GENMASK(15, 6)
+
+/* I2SCTRL */
+#define AW88263_I2SSR			GENMASK(3, 0)
+#define AW88263_I2SSR_8_KHZ		0
+#define AW88263_I2SSR_11_KHZ		1
+#define AW88263_I2SSR_12_KHZ		2
+#define AW88263_I2SSR_16_KHZ		3
+#define AW88263_I2SSR_22_KHZ		4
+#define AW88263_I2SSR_24_KHZ		5
+#define AW88263_I2SSR_32_KHZ		6
+#define AW88263_I2SSR_44_KHZ		7
+#define AW88263_I2SSR_48_KHZ		8
+#define AW88263_I2SSR_96_KHZ		9
+#define AW88263_I2SBCK			GENMASK(5, 4)
+#define AW88263_I2SBCK_32FS		0
+#define AW88263_I2SBCK_48FS		1
+#define AW88263_I2SBCK_64FS		2
+#define AW88263_I2SFS			GENMASK(7, 6)
+#define AW88263_I2SFS_16_BITS		0
+#define AW88263_I2SFS_20_BITS		1
+#define AW88263_I2SFS_24_BITS		2
+#define AW88263_I2SFS_32_BITS		3
+#define AW88263_I2SMD			GENMASK(9, 8)
+#define AW88263_I2SMD_PHILIPS		0
+#define AW88263_I2SMD_MSB_JUSTIFIED	1
+#define AW88263_I2SMD_LSB_JUSTIFIED	2
+
+/* I2SCFG1 */
+#define AW88263_I2STXEN			BIT(0)
+
+/* PLLCTRL1 */
+#define AW88263_CCO_MUX			BIT(14)
+
+/* EFRH and EFRM1 */
+#define AW88263_EF_GESLP		GENMASK(9, 0)
+#define AW88263_EF_GESLP_SIGN		BIT(9)
+
+#define AW88263_CABL_BASE_VALUE		1000
+#define AW88263_VCAL_FACTOR		BIT(13)
+
+/*
+ * The volume is an attenuation in 1/8 dB, held as 6 dB steps in the top
+ * four bits of the field and the rest, below 6 dB, in the bottom six.
+ */
+#define AW88263_VOL_6DB_STEP		(6 * 8)
+#define AW88263_MUTE_VOL		(90 * 8)
+
+/* The mixer control counts 1/4 dB up from -90 dB to the profile's level */
+#define AW88263_CTL_MAX_VOL		(AW88263_MUTE_VOL / 2)
+#define AW88263_CTL_DEFAULT_VOL		(AW88263_CTL_MAX_VOL - 20 * 4)
+
+#define AW88263_DEV_SYSST_CHECK_MAX	10
+#define AW88263_START_RETRIES		5
+#define AW88263_INIT_PROFILE		0
+#define AW88263_ACF_FILE		"aw88263_acf.bin"
+
+#define AW88263_RATES	(SNDRV_PCM_RATE_8000_48000 | SNDRV_PCM_RATE_12000 | \
+			 SNDRV_PCM_RATE_24000 | SNDRV_PCM_RATE_96000)
+#define AW88263_FORMATS	(SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE | \
+			 SNDRV_PCM_FMTBIT_S32_LE)
+
+enum {
+	AW88263_DEV_PW_OFF = 0,
+	AW88263_DEV_PW_ON,
+};
+
+enum {
+	AW88263_DEV_FW_FAILED = 0,
+	AW88263_DEV_FW_OK,
+};
+
+struct aw88263 {
+	struct aw_device *aw_pa;
+	/* serialises power sequencing against the controls */
+	struct mutex lock;
+	struct gpio_desc *reset_gpio;
+	struct regmap *regmap;
+	struct aw_container *aw_cfg;
+
+	bool amppd_st;
+
+	unsigned int i2sctrl;
+	unsigned int sysctrl_inv;
+};
+
+#endif
