From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 13:14:07 -0300
Subject: [PATCH] dt-bindings: clock: qcom: Add SM6450 camera clock controller
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The camera clock controller on SM6450 takes the same two clocks as the
one on SM4450, the board XO and the camera AHB clock from GCC, and adds
a fourth CSIPHY, a fifth MCLK and a third TFE. Document its compatible
alongside SM4450's and add its clock and reset indices.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../bindings/clock/qcom,sm4450-camcc.yaml     |  12 +-
 include/dt-bindings/clock/qcom,sm6450-camcc.h | 120 ++++++++++++++++++
 2 files changed, 128 insertions(+), 4 deletions(-)
 create mode 100644 include/dt-bindings/clock/qcom,sm6450-camcc.h

diff --git a/Documentation/devicetree/bindings/clock/qcom,sm4450-camcc.yaml b/Documentation/devicetree/bindings/clock/qcom,sm4450-camcc.yaml
index 70f025b26..a14a4427a 100644
--- a/Documentation/devicetree/bindings/clock/qcom,sm4450-camcc.yaml
+++ b/Documentation/devicetree/bindings/clock/qcom,sm4450-camcc.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/clock/qcom,sm4450-camcc.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Qualcomm Camera Clock & Reset Controller on SM4450
+title: Qualcomm Camera Clock & Reset Controller on SM4450 and SM6450
 
 maintainers:
   - Ajit Pandey <quic_ajipan@quicinc.com>
@@ -12,13 +12,17 @@ maintainers:
 
 description: |
   Qualcomm camera clock control module provides the clocks, resets and power
-  domains on SM4450
+  domains on SM4450 and SM6450
 
-  See also: include/dt-bindings/clock/qcom,sm4450-camcc.h
+  See also:
+    include/dt-bindings/clock/qcom,sm4450-camcc.h
+    include/dt-bindings/clock/qcom,sm6450-camcc.h
 
 properties:
   compatible:
-    const: qcom,sm4450-camcc
+    enum:
+      - qcom,sm4450-camcc
+      - qcom,sm6450-camcc
 
   clocks:
     items:
diff --git a/include/dt-bindings/clock/qcom,sm6450-camcc.h b/include/dt-bindings/clock/qcom,sm6450-camcc.h
new file mode 100644
index 000000000..9d35eea73
--- /dev/null
