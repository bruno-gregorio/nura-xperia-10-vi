From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 13:17:11 -0300
Subject: [PATCH] dt-bindings: i2c: qcom-cci: Document the SM6450 compatible
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The CCI on SM6450 is a CCI v2 that takes the same three clocks as the
one on SM8550: the camera NoC AXI clock, the CPAS AHB clock and its own
clock.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 Documentation/devicetree/bindings/i2c/qcom,i2c-cci.yaml | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Documentation/devicetree/bindings/i2c/qcom,i2c-cci.yaml b/Documentation/devicetree/bindings/i2c/qcom,i2c-cci.yaml
index 9bc99d736..c95d5405c 100644
--- a/Documentation/devicetree/bindings/i2c/qcom,i2c-cci.yaml
+++ b/Documentation/devicetree/bindings/i2c/qcom,i2c-cci.yaml
@@ -32,6 +32,7 @@ properties:
               - qcom,sdm670-cci
               - qcom,sdm845-cci
               - qcom,sm6350-cci
+              - qcom,sm6450-cci
               - qcom,sm8250-cci
               - qcom,sm8450-cci
               - qcom,sm8550-cci
@@ -185,6 +186,7 @@ allOf:
             enum:
               - qcom,sdm845-cci
               - qcom,sm6350-cci
+              - qcom,sm6450-cci
     then:
       properties:
         clocks:
