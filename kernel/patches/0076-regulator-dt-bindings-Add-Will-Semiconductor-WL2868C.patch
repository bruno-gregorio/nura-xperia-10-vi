From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 13:20:14 -0300
Subject: [PATCH] regulator: dt-bindings: Add Will Semiconductor WL2868C
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The WL2868C is a camera power management IC with seven LDOs set over
I2C, two for digital cores and five for analog and I/O rails.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../bindings/regulator/willsemi,wl2868c.yaml  | 96 +++++++++++++++++++
 1 file changed, 96 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/willsemi,wl2868c.yaml

diff --git a/Documentation/devicetree/bindings/regulator/willsemi,wl2868c.yaml b/Documentation/devicetree/bindings/regulator/willsemi,wl2868c.yaml
new file mode 100644
index 000000000..8fcdd2196
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/willsemi,wl2868c.yaml
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/willsemi,wl2868c.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Will Semiconductor WL2868C camera PMIC
+
+maintainers:
+  - Bruno Gregório <accounts@bruno.pw>
+
+description:
+  The WL2868C is an I2C programmable power management IC for camera
+  modules with seven low dropout regulators. LDO1 and LDO2 run from VIN12
+  and give 0.496 V to 1.512 V, LDO3 to LDO7 run from VIN34, VIN5, VIN6 and
+  VIN7 and give 1.504 V to 3.544 V, all in 8 mV steps.
+
+properties:
+  compatible:
+    const: willsemi,wl2868c
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+    description: The IRQ pin, which flags over-current and under-voltage.
+
+  reset-gpios:
+    maxItems: 1
+    description: The RST_N pin, which holds the chip in reset when low.
+
+  vsys-supply:
+    description: Supply for the chip's bias.
+
+  vin12-supply:
+    description: Input supply for LDO1 and LDO2.
+
+  vin34-supply:
+    description: Input supply for LDO3 and LDO4.
+
+  vin5-supply:
+    description: Input supply for LDO5.
+
+  vin6-supply:
+    description: Input supply for LDO6.
+
+  vin7-supply:
+    description: Input supply for LDO7.
+
+  regulators:
+    type: object
+    additionalProperties: false
+
+    patternProperties:
+      "^ldo[1-7]$":
+        type: object
+        $ref: regulator.yaml#
+        unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - regulators
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        pmic@2f {
+            compatible = "willsemi,wl2868c";
+            reg = <0x2f>;
+            reset-gpios = <&pm6450_gpios 3 GPIO_ACTIVE_LOW>;
+
+            regulators {
+                ldo1 {
+                    regulator-name = "cam_vdig";
+                    regulator-min-microvolt = <1200000>;
+                    regulator-max-microvolt = <1200000>;
+                };
+
+                ldo7 {
+                    regulator-name = "cam_vio";
+                    regulator-min-microvolt = <1800000>;
+                    regulator-max-microvolt = <1800000>;
+                };
+            };
+        };
+    };
+...
