From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 13:38:46 -0300
Subject: [PATCH] media: i2c: Add Sony IMX582 sensor driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add a driver for the Sony IMX582 in its binned modes, which read each
group of same-colour pixels of its quad Bayer array as one and give an
ordinary RGGB image: 4000x3000 at 30 fps, 4000x2256 at up to 60 fps and
2000x1132 at up to 120 fps, in RAW10 over four lanes, from a 24 MHz
clock. The register settings are those the Sony Xperia 10 VI programs.

Every mode starts at 30 fps, as a frame of a 120th of a second leaves
little room for the exposure; the vertical blanking can be shortened to
reach the faster rates.

The controls cover exposure, analogue and digital gain, vertical
blanking, flips and the sensor's test patterns.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 drivers/media/i2c/Kconfig  |   10 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/imx582.c | 1176 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1187 insertions(+)
 create mode 100644 drivers/media/i2c/imx582.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index cdd7ba5da..6598682af 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -277,6 +277,16 @@ config VIDEO_IMX415
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx415.
 
+config VIDEO_IMX582
+	tristate "Sony IMX582 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX582 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx582.
+
 config VIDEO_MAX9271_LIB
 	tristate
 
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 57cdd8dc9..b2323577f 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -60,6 +60,7 @@ obj-$(CONFIG_VIDEO_IMX335) += imx335.o
 obj-$(CONFIG_VIDEO_IMX355) += imx355.o
 obj-$(CONFIG_VIDEO_IMX412) += imx412.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
+obj-$(CONFIG_VIDEO_IMX582) += imx582.o
