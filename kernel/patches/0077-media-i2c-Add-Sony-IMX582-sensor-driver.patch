+/*
+ * Sony IMX582 sensor driver
+ *
+ * The IMX582 is a 1/2-inch 48 megapixel quad Bayer sensor, 8000x6000 with
+ * 0.8 um pixels, that sends RAW10 over four MIPI CSI-2 D-PHY lanes. This
+ * driver runs it in its binned modes, where each group of same-colour
+ * pixels reads out as one, so that the output is an ordinary RGGB Bayer
+ * image.
+ *
+ * The register settings are those of the Sony Xperia 10 VI, for a 24 MHz
+ * external clock.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define IMX582_REG_CHIP_ID		CCI_REG16(0x0016)
+#define IMX582_CHIP_ID			0x0582
+
+#define IMX582_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX582_MODE_STANDBY		0x00
+#define IMX582_MODE_STREAMING		0x01
+
+/* Bit 0 mirrors the image, bit 1 flips it */
+#define IMX582_REG_ORIENTATION		CCI_REG8(0x0101)
+
+/* Frame length, in lines */
+#define IMX582_REG_FRAME_LENGTH		CCI_REG16(0x0340)
+#define IMX582_FRAME_LENGTH_MAX		0xffff
+
+/* Coarse integration time, in lines */
+#define IMX582_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX582_EXPOSURE_MIN		5
+#define IMX582_EXPOSURE_MARGIN		48
+#define IMX582_EXPOSURE_STEP		1
+
+/* The analogue gain is 1024 / (1024 - code), from 1x to 64x */
+#define IMX582_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define IMX582_ANA_GAIN_MIN		0
+#define IMX582_ANA_GAIN_MAX		1008
+#define IMX582_ANA_GAIN_STEP		1
+#define IMX582_ANA_GAIN_DEFAULT		0
+
+/* The digital gain of each colour, in 8.8 fixed point, up to 4x */
+#define IMX582_REG_DIG_GAIN_GR		CCI_REG16(0x020e)
+#define IMX582_REG_DIG_GAIN_R		CCI_REG16(0x0210)
+#define IMX582_REG_DIG_GAIN_B		CCI_REG16(0x0212)
+#define IMX582_REG_DIG_GAIN_GB		CCI_REG16(0x0214)
+#define IMX582_DGTL_GAIN_MIN		0x0100
+#define IMX582_DGTL_GAIN_MAX		0x0400
+#define IMX582_DGTL_GAIN_STEP		1
+#define IMX582_DGTL_GAIN_DEFAULT	0x0100
+
+#define IMX582_REG_TEST_PATTERN		CCI_REG16(0x0600)
+#define IMX582_REG_TESTP_RED		CCI_REG16(0x0602)
+#define IMX582_REG_TESTP_GREENR		CCI_REG16(0x0604)
+#define IMX582_REG_TESTP_BLUE		CCI_REG16(0x0606)
+#define IMX582_REG_TESTP_GREENB		CCI_REG16(0x0608)
+#define IMX582_TESTP_COLOUR_MIN		0
+#define IMX582_TESTP_COLOUR_MAX		0x03ff
+#define IMX582_TESTP_COLOUR_STEP	1
+
+#define IMX582_XCLK_FREQ		(24 * HZ_PER_MHZ)
+
+#define IMX582_NATIVE_WIDTH		8000
+#define IMX582_NATIVE_HEIGHT		6000
+
+/* From the end of reset to the first I2C access */
+#define IMX582_RESET_DELAY_US		10000
+
+static const char * const imx582_supply_names[] = {
+	"avdd",		/* Analogue, 2.9 V */
+	"dvdd",		/* Digital core, 1.1 V */
+	"dovdd",	/* Interface, 1.8 V */
+};
+
+/* The Bayer order unflipped, mirrored, flipped, and both */
+static const u32 imx582_mbus_codes[] = {
