+
+struct imx582_mode {
+	u32 width;
+	u32 height;
+	/* The part of the pixel array that is read out */
+	struct v4l2_rect crop;
+	/* Line length, in pixel clocks */
+	u32 llp;
+	/*
+	 * Default frame length, in lines. Every mode starts at 30 fps, which
+	 * leaves room for a usable exposure; a shorter vertical blanking gives
+	 * the faster modes their full frame rate.
+	 */
+	u32 fll_def;
+	u32 vblank_min;
+	u64 pixel_rate;
+	unsigned int link_freq_index;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
