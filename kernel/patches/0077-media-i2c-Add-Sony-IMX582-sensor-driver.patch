+
+struct imx582 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx582_supply_names)];
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+};
+
+static inline struct imx582 *to_imx582(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx582, sd);
+}
+
+static u32 imx582_get_format_code(struct imx582 *imx582)
+{
+	return imx582_mbus_codes[(imx582->vflip->val ? 2 : 0) |
+				 (imx582->hflip->val ? 1 : 0)];
+}
+
+static const struct imx582_mode *
+imx582_find_mode(const struct v4l2_mbus_framefmt *format)
+{
+	return v4l2_find_nearest_size(imx582_modes, ARRAY_SIZE(imx582_modes),
+				      width, height,
+				      format->width, format->height);
+}
+
+/* -----------------------------------------------------------------------------
+ * Controls
+ */
+
+static int imx582_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx582 *imx582 = container_of(ctrl->handler, struct imx582,
+					     ctrl_handler);
+	struct device *dev = imx582->sd.dev;
+	const struct v4l2_mbus_framefmt *format;
+	struct v4l2_subdev_state *state;
+	int ret = 0;
+
+	state = v4l2_subdev_get_locked_active_state(&imx582->sd);
+	format = v4l2_subdev_state_get_format(state, 0);
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		int exposure_max = format->height + ctrl->val -
+				   IMX582_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(imx582->exposure,
+					 imx582->exposure->minimum,
+					 exposure_max, imx582->exposure->step,
+					 exposure_max);
+	}
+
+	/* The registers are written when streaming starts */
+	if (pm_runtime_get_if_in_use(dev) <= 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(imx582->regmap, IMX582_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(imx582->regmap, IMX582_REG_ANALOG_GAIN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		cci_write(imx582->regmap, IMX582_REG_DIG_GAIN_GR, ctrl->val,
+			  &ret);
+		cci_write(imx582->regmap, IMX582_REG_DIG_GAIN_R, ctrl->val,
+			  &ret);
+		cci_write(imx582->regmap, IMX582_REG_DIG_GAIN_B, ctrl->val,
+			  &ret);
+		cci_write(imx582->regmap, IMX582_REG_DIG_GAIN_GB, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(imx582->regmap, IMX582_REG_FRAME_LENGTH,
+			  format->height + ctrl->val, &ret);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		cci_write(imx582->regmap, IMX582_REG_ORIENTATION,
+			  imx582->hflip->val | imx582->vflip->val << 1, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(imx582->regmap, IMX582_REG_TEST_PATTERN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_RED:
+		cci_write(imx582->regmap, IMX582_REG_TESTP_RED, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_GREENR:
+		cci_write(imx582->regmap, IMX582_REG_TESTP_GREENR, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_BLUE:
+		cci_write(imx582->regmap, IMX582_REG_TESTP_BLUE, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_GREENB:
+		cci_write(imx582->regmap, IMX582_REG_TESTP_GREENB, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_PIXEL_RATE:
+	case V4L2_CID_LINK_FREQ:
+	case V4L2_CID_HBLANK:
+		/* Set by the mode */
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx582_ctrl_ops = {
+	.s_ctrl = imx582_set_ctrl,
+};
+
+static int imx582_init_controls(struct imx582 *imx582)
+{
+	const struct imx582_mode *mode = &imx582_modes[0];
+	struct v4l2_ctrl_handler *hdl = &imx582->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	int exposure_max, hblank;
+	unsigned int i;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(imx582->sd.dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 16);
+
+	imx582->pixel_rate = v4l2_ctrl_new_std(hdl, &imx582_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       mode->pixel_rate,
+					       mode->pixel_rate, 1,
+					       mode->pixel_rate);
+
+	imx582->link_freq =
+		v4l2_ctrl_new_int_menu(hdl, &imx582_ctrl_ops,
+				       V4L2_CID_LINK_FREQ,
+				       ARRAY_SIZE(imx582_link_freq_menu) - 1,
+				       mode->link_freq_index,
+				       imx582_link_freq_menu);
+	if (imx582->link_freq)
+		imx582->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx582->vblank = v4l2_ctrl_new_std(hdl, &imx582_ctrl_ops,
+					   V4L2_CID_VBLANK, mode->vblank_min,
+					   IMX582_FRAME_LENGTH_MAX - mode->height,
+					   1, mode->fll_def - mode->height);
+
+	hblank = mode->llp - mode->width;
+	imx582->hblank = v4l2_ctrl_new_std(hdl, &imx582_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank, 1,
+					   hblank);
+	if (imx582->hblank)
+		imx582->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	exposure_max = mode->fll_def - IMX582_EXPOSURE_MARGIN;
+	imx582->exposure = v4l2_ctrl_new_std(hdl, &imx582_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX582_EXPOSURE_MIN, exposure_max,
+					     IMX582_EXPOSURE_STEP,
+					     exposure_max);
+
+	v4l2_ctrl_new_std(hdl, &imx582_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX582_ANA_GAIN_MIN, IMX582_ANA_GAIN_MAX,
+			  IMX582_ANA_GAIN_STEP, IMX582_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx582_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  IMX582_DGTL_GAIN_MIN, IMX582_DGTL_GAIN_MAX,
+			  IMX582_DGTL_GAIN_STEP, IMX582_DGTL_GAIN_DEFAULT);
+
+	imx582->hflip = v4l2_ctrl_new_std(hdl, &imx582_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (imx582->hflip)
+		imx582->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	imx582->vflip = v4l2_ctrl_new_std(hdl, &imx582_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (imx582->vflip)
+		imx582->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	v4l2_ctrl_new_std_menu_items(hdl, &imx582_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx582_test_pattern_menu) - 1,
+				     0, 0, imx582_test_pattern_menu);
+
+	/* The solid colour pattern is white by default */
+	for (i = 0; i < 4; i++)
+		v4l2_ctrl_new_std(hdl, &imx582_ctrl_ops,
+				  V4L2_CID_TEST_PATTERN_RED + i,
+				  IMX582_TESTP_COLOUR_MIN,
+				  IMX582_TESTP_COLOUR_MAX,
+				  IMX582_TESTP_COLOUR_STEP,
+				  IMX582_TESTP_COLOUR_MAX);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &imx582_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return dev_err_probe(imx582->sd.dev, ret,
+				     "failed to init controls\n");
+	}
+
+	imx582->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * Subdev operations
+ */
+
+static int imx582_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx582 *imx582 = to_imx582(sd);
+	const struct imx582_mode *mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret < 0)
+		return ret;
+
+	mode = imx582_find_mode(v4l2_subdev_state_get_format(state, 0));
+
+	ret = cci_multi_reg_write(imx582->regmap, imx582_common_regs,
+				  ARRAY_SIZE(imx582_common_regs), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(imx582->regmap, mode->regs,
+					  mode->num_regs, NULL);
+	if (ret) {
+		dev_err(sd->dev, "failed to write the mode: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(imx582->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(imx582->regmap, IMX582_REG_MODE_SELECT,
+			IMX582_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	/* The Bayer order can't change while streaming */
+	__v4l2_ctrl_grab(imx582->vflip, true);
+	__v4l2_ctrl_grab(imx582->hflip, true);
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int imx582_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx582 *imx582 = to_imx582(sd);
+	int ret;
+
+	ret = cci_write(imx582->regmap, IMX582_REG_MODE_SELECT,
+			IMX582_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	__v4l2_ctrl_grab(imx582->vflip, false);
+	__v4l2_ctrl_grab(imx582->hflip, false);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static void imx582_update_pad_format(struct imx582 *imx582,
+				     const struct imx582_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = imx582_get_format_code(imx582);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx582_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct imx582 *imx582 = to_imx582(sd);
+
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = imx582_get_format_code(imx582);
+
+	return 0;
+}
+
+static int imx582_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct imx582 *imx582 = to_imx582(sd);
+
+	if (fse->index >= ARRAY_SIZE(imx582_modes))
+		return -EINVAL;
+
+	if (fse->code != imx582_get_format_code(imx582))
+		return -EINVAL;
+
+	fse->min_width = imx582_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = imx582_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int imx582_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx582 *imx582 = to_imx582(sd);
+	const struct imx582_mode *mode;
+	int exposure_max, hblank;
+	int ret;
+
+	mode = imx582_find_mode(&fmt->format);
+
+	imx582_update_pad_format(imx582, mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	*v4l2_subdev_state_get_crop(state, 0) = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	ret = __v4l2_ctrl_modify_range(imx582->pixel_rate, mode->pixel_rate,
+				       mode->pixel_rate, 1, mode->pixel_rate);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx582->link_freq, mode->link_freq_index);
+	if (ret)
+		return ret;
+
+	hblank = mode->llp - mode->width;
+	ret = __v4l2_ctrl_modify_range(imx582->hblank, hblank, hblank, 1,
+				       hblank);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_modify_range(imx582->vblank, mode->vblank_min,
+				       IMX582_FRAME_LENGTH_MAX - mode->height,
+				       1, mode->fll_def - mode->height);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx582->vblank, mode->fll_def - mode->height);
+	if (ret)
+		return ret;
+
+	exposure_max = mode->fll_def - IMX582_EXPOSURE_MARGIN;
+
+	return __v4l2_ctrl_modify_range(imx582->exposure, IMX582_EXPOSURE_MIN,
+					exposure_max, IMX582_EXPOSURE_STEP,
+					exposure_max);
+}
+
+static int imx582_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = IMX582_NATIVE_WIDTH;
+		sel->r.height = IMX582_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int imx582_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = imx582_modes[0].width,
+			.height = imx582_modes[0].height,
+		},
+	};
+
+	return imx582_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops imx582_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops imx582_pad_ops = {
+	.enum_mbus_code = imx582_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = imx582_set_pad_format,
+	.get_selection = imx582_get_selection,
+	.enum_frame_size = imx582_enum_frame_size,
+	.enable_streams = imx582_enable_streams,
+	.disable_streams = imx582_disable_streams,
+};
+
+static const struct v4l2_subdev_ops imx582_subdev_ops = {
+	.video = &imx582_video_ops,
+	.pad = &imx582_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx582_internal_ops = {
+	.init_state = imx582_init_state,
+};
+
+/* -----------------------------------------------------------------------------
+ * Power management
+ */
+
+static int imx582_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx582 *imx582 = to_imx582(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx582->supplies),
+				    imx582->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(imx582->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		goto err_regulators;
+	}
+
+	gpiod_set_value_cansleep(imx582->reset_gpio, 0);
+	fsleep(IMX582_RESET_DELAY_US);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(imx582->supplies), imx582->supplies);
+
+	return ret;
+}
+
+static int imx582_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx582 *imx582 = to_imx582(sd);
+
+	clk_disable_unprepare(imx582->xclk);
+	gpiod_set_value_cansleep(imx582->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(imx582->supplies), imx582->supplies);
+
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * Probe & remove
+ */
+
+static int imx582_identify_module(struct imx582 *imx582)
+{
+	struct device *dev = imx582->sd.dev;
+	u64 val;
+	int ret;
+
+	ret = cci_read(imx582->regmap, IMX582_REG_CHIP_ID, &val, NULL);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read chip id\n");
+
+	if (val != IMX582_CHIP_ID)
+		return dev_err_probe(dev, -ENODEV,
+				     "chip id mismatch: %x!=%llx\n",
+				     IMX582_CHIP_ID, val);
+
+	return 0;
+}
+
+static int imx582_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint)
+		return dev_err_probe(dev, -EINVAL, "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep_cfg);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not parse endpoint\n");
+
+	if (ep_cfg.bus.mipi_csi2.num_data_lanes != 4) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "only 4 data lanes are supported\n");
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, ep_cfg.link_frequencies,
+				       ep_cfg.nr_of_link_frequencies,
+				       imx582_link_freq_menu,
+				       ARRAY_SIZE(imx582_link_freq_menu),
+				       &link_freq_bitmap);
+	if (ret)
+		goto out;
+
+	if (link_freq_bitmap != GENMASK(ARRAY_SIZE(imx582_link_freq_menu) - 1, 0))
+		ret = dev_err_probe(dev, -EINVAL,
+				    "every mode's link frequency is needed\n");
+
+out:
+	v4l2_fwnode_endpoint_free(&ep_cfg);
+
+	return ret;
+}
+
+static int imx582_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx582 *imx582;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	imx582 = devm_kzalloc(dev, sizeof(*imx582), GFP_KERNEL);
+	if (!imx582)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&imx582->sd, client, &imx582_subdev_ops);
+	imx582->sd.internal_ops = &imx582_internal_ops;
+
+	ret = imx582_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	imx582->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx582->regmap))
+		return dev_err_probe(dev, PTR_ERR(imx582->regmap),
+				     "failed to initialize CCI\n");
+
+	imx582->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(imx582->xclk))
+		return dev_err_probe(dev, PTR_ERR(imx582->xclk),
+				     "failed to get xclk\n");
+
+	rate = clk_get_rate(imx582->xclk);
+	if (rate != IMX582_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency not supported: %lu Hz\n",
+				     rate);
+
+	for (i = 0; i < ARRAY_SIZE(imx582_supply_names); i++)
+		imx582->supplies[i].supply = imx582_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(imx582->supplies),
+				      imx582->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	imx582->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(imx582->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx582->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	ret = imx582_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = imx582_identify_module(imx582);
+	if (ret)
+		goto error_power_off;
+
+	ret = imx582_init_controls(imx582);
+	if (ret)
+		goto error_power_off;
+
+	imx582->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx582->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx582->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx582->sd.entity, 1, &imx582->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto error_handler_free;
+	}
+
+	imx582->sd.state_lock = imx582->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&imx582->sd);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "subdev init error\n");
+		goto error_media_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&imx582->sd);
+	if (ret < 0) {
+		dev_err_probe(dev, ret,
+			      "failed to register sensor sub-device\n");
+		goto error_subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	return 0;
+
+error_subdev_cleanup:
+	v4l2_subdev_cleanup(&imx582->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+
+error_media_entity:
+	media_entity_cleanup(&imx582->sd.entity);
+
+error_handler_free:
+	v4l2_ctrl_handler_free(imx582->sd.ctrl_handler);
+
+error_power_off:
+	imx582_power_off(dev);
+
+	return ret;
+}
+
+static void imx582_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev)) {
+		imx582_power_off(&client->dev);
+		pm_runtime_set_suspended(&client->dev);
+	}
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx582_pm_ops, imx582_power_off,
+				 imx582_power_on, NULL);
+
+static const struct of_device_id imx582_of_match[] = {
+	{ .compatible = "sony,imx582" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx582_of_match);
+
+static struct i2c_driver imx582_i2c_driver = {
+	.driver = {
+		.name = "imx582",
+		.of_match_table = imx582_of_match,
+		.pm = pm_ptr(&imx582_pm_ops),
+	},
+	.probe = imx582_probe,
+	.remove = imx582_remove,
+};
+module_i2c_driver(imx582_i2c_driver);
+
