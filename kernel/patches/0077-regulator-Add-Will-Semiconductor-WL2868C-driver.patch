From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 13:20:14 -0300
Subject: [PATCH] regulator: Add Will Semiconductor WL2868C driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The WL2868C's LDOs each have a voltage register with 8 mV steps and an
enable bit in one shared register, which is all regmap's helpers need.
The chip loses its settings in reset, so the driver releases the RST_N
line, if there is one, before it looks for the device ID.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 drivers/regulator/Kconfig             |   8 ++
 drivers/regulator/Makefile            |   1 +
 drivers/regulator/wl2868c-regulator.c | 175 ++++++++++++++++++++++++++
 3 files changed, 184 insertions(+)
 create mode 100644 drivers/regulator/wl2868c-regulator.c

diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index d84f3d054..2dba59389 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -1780,6 +1780,14 @@ config REGULATOR_VQMMC_IPQ4019
 	  This driver provides support for the VQMMC LDO I/0
 	  voltage regulator of the IPQ4019 SD/EMMC controller.
 
+config REGULATOR_WL2868C
+	tristate "Will Semiconductor WL2868C camera PMIC"
+	depends on I2C && OF
+	select REGMAP_I2C
+	help
+	  This driver supports the seven LDOs of the Will Semiconductor
+	  WL2868C, a power management IC for camera modules.
+
 config REGULATOR_WM831X
 	tristate "Wolfson Microelectronics WM831x PMIC regulators"
 	depends on MFD_WM831X
diff --git a/drivers/regulator/Makefile b/drivers/regulator/Makefile
index b31013760..5aead1002 100644
--- a/drivers/regulator/Makefile
+++ b/drivers/regulator/Makefile
@@ -204,6 +204,7 @@ obj-$(CONFIG_REGULATOR_RZG2L_VBCTRL) += renesas-usb-vbus-regulator.o
 obj-$(CONFIG_REGULATOR_VCTRL) += vctrl-regulator.o
 obj-$(CONFIG_REGULATOR_VEXPRESS) += vexpress-regulator.o
 obj-$(CONFIG_REGULATOR_VQMMC_IPQ4019) += vqmmc-ipq4019-regulator.o
+obj-$(CONFIG_REGULATOR_WL2868C) += wl2868c-regulator.o
 obj-$(CONFIG_REGULATOR_WM831X) += wm831x-dcdc.o
 obj-$(CONFIG_REGULATOR_WM831X) += wm831x-isink.o
 obj-$(CONFIG_REGULATOR_WM831X) += wm831x-ldo.o
diff --git a/drivers/regulator/wl2868c-regulator.c b/drivers/regulator/wl2868c-regulator.c
new file mode 100644
index 000000000..fdc202c8e
--- /dev/null
+++ b/drivers/regulator/wl2868c-regulator.c
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Will Semiconductor WL2868C camera power management IC
+ *
+ * Seven LDOs set through I2C: LDO1 and LDO2 for the digital cores, from
+ * VIN12, and LDO3 to LDO7 for the analog and I/O rails, from their own
+ * inputs. Every output steps by 8 mV, and register 0x0e holds the system
+ * enable in bit 7 and one enable bit per LDO below it.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mod_devicetable.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+
+#define WL2868C_DEVICE_ID		0x00
+#define WL2868C_LDO_VOUT(n)		(0x03 + (n))
+#define WL2868C_LDO_EN			0x0e
+#define WL2868C_SYS_EN			BIT(7)
+#define WL2868C_MAX_REGISTER		0x25
+
+#define WL2868C_ID			0x82
+
+enum wl2868c_regulator_ids {
+	WL2868C_LDO1,
+	WL2868C_LDO2,
+	WL2868C_LDO3,
+	WL2868C_LDO4,
+	WL2868C_LDO5,
+	WL2868C_LDO6,
+	WL2868C_LDO7,
+	WL2868C_NUM_REGULATORS,
+};
+
+static const struct regulator_ops wl2868c_ops = {
+	.list_voltage = regulator_list_voltage_linear,
+	.map_voltage = regulator_map_voltage_linear,
+	.set_voltage_sel = regulator_set_voltage_sel_regmap,
+	.get_voltage_sel = regulator_get_voltage_sel_regmap,
+	.enable = regulator_enable_regmap,
+	.disable = regulator_disable_regmap,
+	.is_enabled = regulator_is_enabled_regmap,
+};
+
+/*
+ * The enable time is the datasheet's turn-on delay plus its soft start,
+ * 25 us and 60 us for LDO1 and LDO2, 25 us and 80 us for the others.
+ */
+#define WL2868C_LDO(_id, _supply, _min, _n, _mask, _time)		\
+	[WL2868C_LDO ## _id] = {					\
+		.name = "ldo" #_id,					\
+		.of_match = "ldo" #_id,					\
+		.regulators_node = "regulators",			\
+		.supply_name = _supply,					\
+		.id = WL2868C_LDO ## _id,				\
+		.type = REGULATOR_VOLTAGE,				\
+		.owner = THIS_MODULE,					\
+		.ops = &wl2868c_ops,					\
+		.min_uV = _min,						\
+		.uV_step = 8000,					\
+		.n_voltages = _n,					\
+		.vsel_reg = WL2868C_LDO_VOUT(WL2868C_LDO ## _id),	\
+		.vsel_mask = _mask,					\
+		.enable_reg = WL2868C_LDO_EN,				\
+		.enable_mask = BIT(WL2868C_LDO ## _id),			\
+		.enable_time = _time,					\
+	}
+
+static const struct regulator_desc wl2868c_regulators[] = {
+	WL2868C_LDO(1, "vin12", 496000, 128, 0x7f, 85),
+	WL2868C_LDO(2, "vin12", 496000, 128, 0x7f, 85),
+	WL2868C_LDO(3, "vin34", 1504000, 256, 0xff, 105),
+	WL2868C_LDO(4, "vin34", 1504000, 256, 0xff, 105),
+	WL2868C_LDO(5, "vin5", 1504000, 256, 0xff, 105),
+	WL2868C_LDO(6, "vin6", 1504000, 256, 0xff, 105),
+	WL2868C_LDO(7, "vin7", 1504000, 256, 0xff, 105),
+};
+
+static const struct regmap_config wl2868c_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = WL2868C_MAX_REGISTER,
+};
+
+static int wl2868c_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct regulator_config config = { };
+	struct regulator_dev *rdev;
+	struct gpio_desc *reset;
+	struct regmap *regmap;
+	unsigned int id;
+	int i, ret;
+
+	ret = devm_regulator_get_enable_optional(dev, "vsys");
+	if (ret && ret != -ENODEV)
+		return dev_err_probe(dev, ret, "failed to enable vsys\n");
+
+	/*
+	 * A pulse on the reset line clears whatever the boot loader or a warm
+	 * reboot left on; out of reset the chip answers on I2C with every LDO
+	 * off.
+	 */
+	reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(reset))
+		return dev_err_probe(dev, PTR_ERR(reset),
+				     "failed to get reset gpio\n");
+	if (reset) {
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(reset, 0);
+		usleep_range(1000, 2000);
+	}
+
+	regmap = devm_regmap_init_i2c(client, &wl2868c_regmap_config);
+	if (IS_ERR(regmap))
+		return dev_err_probe(dev, PTR_ERR(regmap),
+				     "failed to init regmap\n");
+
+	ret = regmap_read(regmap, WL2868C_DEVICE_ID, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read device ID\n");
+	if (id != WL2868C_ID)
+		return dev_err_probe(dev, -ENODEV,
+				     "unknown device ID 0x%02x\n", id);
+
+	/* The LDO enables only act while the system enable is set. */
+	ret = regmap_set_bits(regmap, WL2868C_LDO_EN, WL2868C_SYS_EN);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set system enable\n");
+
+	config.dev = dev;
+	config.regmap = regmap;
+
+	for (i = 0; i < ARRAY_SIZE(wl2868c_regulators); i++) {
+		rdev = devm_regulator_register(dev, &wl2868c_regulators[i],
+					       &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(dev, PTR_ERR(rdev),
+					     "failed to register %s\n",
+					     wl2868c_regulators[i].name);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id wl2868c_of_match[] = {
+	{ .compatible = "willsemi,wl2868c" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, wl2868c_of_match);
+
+static const struct i2c_device_id wl2868c_i2c_id[] = {
+	{ "wl2868c" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, wl2868c_i2c_id);
+
+static struct i2c_driver wl2868c_driver = {
+	.driver = {
+		.name = "wl2868c",
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
+		.of_match_table = wl2868c_of_match,
+	},
+	.probe = wl2868c_probe,
+	.id_table = wl2868c_i2c_id,
+};
+module_i2c_driver(wl2868c_driver);
+
+MODULE_DESCRIPTION("Will Semiconductor WL2868C regulator driver");
+MODULE_LICENSE("GPL");
