From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 13:40:41 -0300
Subject: [PATCH] arm64: dts: qcom: sm6450-sony-xperia-columbia-pdx246: Add the
 main camera
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The main camera is a Sony IMX582 on the first CCI's first bus, clocked
from MCLK0 and reset through GPIO 44, with its supplies on the camera
PMIC.

The focus actuator and the image stabiliser share that bus. Stock powers
both whenever it uses the bus, the stabiliser through a switch on GPIO 43;
until they have drivers, keep both supplies on.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../sm6450-sony-xperia-columbia-pdx246.dts    | 76 +++++++++++++++++++
 1 file changed, 76 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
index 6bc423d60..607c8f2c8 100644
--- a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
+++ b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
@@ -105,6 +105,23 @@ pmic_glink_hs_in: endpoint {
 		};
 	};
 
+	/*
+	 * The main camera's image stabiliser supply. Stock raises it before
+	 * any of the sensor's own, and the stabiliser shares the sensor's bus;
+	 * until it has a driver, it stays on.
+	 */
+	cam_ois_vdd: regulator-cam-ois-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_ois_vdd";
+		gpio = <&tlmm 43 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&cam_ois_vdd_default>;
+		pinctrl-names = "default";
+
+		regulator-always-on;
+	};
+
 	/*
 	 * The panel's 1.8V logic supply is switched on by driving PM6150L
 	 * GPIO 9 low. With it the other way round the panel still takes
@@ -446,6 +463,38 @@ &cci0 {
 	status = "okay";
 };
 
+&cci0_i2c0 {
+	/* The main camera. */
+	camera@1a {
+		compatible = "sony,imx582";
+		reg = <0x1a>;
+
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
+
+		avdd-supply = <&cam_main_vana_2p9>;
+		dvdd-supply = <&cam_main_vdig_1p1>;
+		dovdd-supply = <&cam_vio_1p8>;
+
+		pinctrl-0 = <&cam_mclk0_default &cam_main_reset>;
+		pinctrl-names = "default";
+
+		orientation = <1>;
+		rotation = <270>;
+
+		port {
+			cam_main_out: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <412000000 632000000
+							      782400000>;
+			};
+		};
+	};
+};
+
 &cci0_i2c1 {
 	clock-frequency = <400000>;
 
@@ -607,10 +656,16 @@ cam_wide_vana_2p8: ldo4 {
 				regulator-max-microvolt = <2800000>;
 			};
 
+			/*
+			 * The main camera's focus actuator and stabiliser share
+			 * the sensor's bus, and stock never uses the bus without
+			 * them powered; until they have drivers, it stays on.
+			 */
 			cam_main_vaf_2p8: ldo5 {
 				regulator-name = "cam_main_vaf_2p8";
 				regulator-min-microvolt = <2800000>;
 				regulator-max-microvolt = <2800000>;
+				regulator-always-on;
 			};
 
 			cam_front_vana_2p8: ldo6 {
@@ -874,6 +929,13 @@ wcd937x_tx: codec@0,3 {
 };
 
 &tlmm {
+	cam_mclk0_default: cam-mclk0-default-state {
+		pins = "gpio39";
+		function = "cam_mclk";
+		drive-strength = <6>;
+		bias-disable;
+	};
+
 	cam_mclk1_default: cam-mclk1-default-state {
 		pins = "gpio40";
 		function = "cam_mclk";
@@ -888,6 +950,20 @@ cam_mclk3_default: cam-mclk3-default-state {
 		bias-disable;
 	};
 
+	cam_ois_vdd_default: cam-ois-vdd-default-state {
+		pins = "gpio43";
+		function = "gpio";
+		drive-strength = <6>;
+		bias-disable;
+	};
+
+	cam_main_reset: cam-main-reset-state {
+		pins = "gpio44";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	cam_wide_reset: cam-wide-reset-state {
 		pins = "gpio45";
 		function = "gpio";
