From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 13:23:09 -0300
Subject: [PATCH] arm64: dts: qcom: sm6450-sony-xperia-columbia-pdx246: Add the
 Hi-846 cameras
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The ultra-wide and front cameras are both Hynix Hi-846 sensors, on the
second master of each CCI, fed by a WL2868C camera PMIC on I2C2 and a
24 MHz MCLK each. The PMIC's inputs are not in the vendor tree; take the
ones it gives the PM8010 that it lists as the PMIC's alternative.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../sm6450-sony-xperia-columbia-pdx246.dts    | 181 ++++++++++++++++++
 1 file changed, 181 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
index 711b06021..a8b55eae4 100644
--- a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
+++ b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
@@ -430,6 +430,88 @@ pm6150l_bob: bob {
 	};
 };
 
+&cci0 {
+	status = "okay";
+};
+
+&cci0_i2c1 {
+	clock-frequency = <400000>;
+
+	/* The ultra-wide camera. */
+	camera@21 {
+		compatible = "hynix,hi846";
+		reg = <0x21>;
+
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 45 GPIO_ACTIVE_LOW>;
+
+		vddio-supply = <&cam_vio_1p8>;
+		vdda-supply = <&cam_wide_vana_2p8>;
+		vddd-supply = <&cam_hi846_vdig_1p2>;
+
+		pinctrl-0 = <&cam_mclk1_default &cam_wide_reset>;
+		pinctrl-names = "default";
+
+		orientation = <1>;
+		rotation = <270>;
+
+		port {
+			cam_wide_out: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <90000000 180000000
+							      360000000>;
+			};
+		};
+	};
+};
+
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c1 {
+	clock-frequency = <400000>;
+
+	/* The front camera. */
+	camera@20 {
+		compatible = "hynix,hi846";
+		reg = <0x20>;
+
+		clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
+
+		vddio-supply = <&cam_vio_1p8>;
+		vdda-supply = <&cam_front_vana_2p8>;
+		vddd-supply = <&cam_hi846_vdig_1p2>;
+
+		pinctrl-0 = <&cam_mclk3_default &cam_front_reset>;
+		pinctrl-names = "default";
+
+		/*
+		 * Stock reads this sensor out turned 180 degrees from the
+		 * ultra-wide, GRBG where that one is GBRG, and so reports the
+		 * opposite angle for it. The driver here reads both out the
+		 * same way, so both take the same correction.
+		 */
+		orientation = <0>;
+		rotation = <270>;
+
+		port {
+			cam_front_out: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <90000000 180000000
+							      360000000>;
+			};
+		};
+	};
+};
+
 &gpi_dma0 {
 	status = "okay";
 };
@@ -469,6 +551,70 @@ amp_top: audio-codec@34 {
 &i2c2 {
 	status = "okay";
 
+	/*
+	 * The cameras' supplies. Their inputs are not in the stock tree; these
+	 * are the ones it gives the PM8010 this chip replaced.
+	 */
+	pmic@2f {
+		compatible = "willsemi,wl2868c";
+		reg = <0x2f>;
+
+		reset-gpios = <&pm6450_gpios 3 GPIO_ACTIVE_LOW>;
+
+		vin12-supply = <&pm6450_s8>;
+		vin34-supply = <&pm6150l_bob>;
+		vin5-supply = <&pm6150l_bob>;
+		vin6-supply = <&pm6150l_bob>;
+		vin7-supply = <&pm6150l_bob>;
+
+		pinctrl-0 = <&cam_pmic_reset>;
+		pinctrl-names = "default";
+
+		regulators {
+			cam_hi846_vdig_1p2: ldo1 {
+				regulator-name = "cam_hi846_vdig_1p2";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1200000>;
+			};
+
+			cam_main_vdig_1p1: ldo2 {
+				regulator-name = "cam_main_vdig_1p1";
+				regulator-min-microvolt = <1100000>;
+				regulator-max-microvolt = <1100000>;
+			};
+
+			cam_main_vana_2p9: ldo3 {
+				regulator-name = "cam_main_vana_2p9";
+				regulator-min-microvolt = <2900000>;
+				regulator-max-microvolt = <2900000>;
+			};
+
+			cam_wide_vana_2p8: ldo4 {
+				regulator-name = "cam_wide_vana_2p8";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			cam_main_vaf_2p8: ldo5 {
+				regulator-name = "cam_main_vaf_2p8";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			cam_front_vana_2p8: ldo6 {
+				regulator-name = "cam_front_vana_2p8";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			cam_vio_1p8: ldo7 {
+				regulator-name = "cam_vio_1p8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+		};
+	};
+
 	/* Its twin on the bottom speaker, taking the stream's other channel. */
 	amp_bottom: audio-codec@34 {
 		compatible = "awinic,aw88263";
@@ -569,6 +715,13 @@ panel_vddio_en: panel-vddio-en-state {
 };
 
 &pm6450_gpios {
+	cam_pmic_reset: cam-pmic-reset-state {
+		pins = "gpio3";
+		function = "normal";
+		power-source = <0>;
+		bias-disable;
+	};
+
 	vol_down_n: vol-down-n-state {
 		pins = "gpio1";
 		function = "normal";
@@ -727,6 +880,34 @@ wcd937x_tx: codec@0,3 {
 };
 
 &tlmm {
+	cam_mclk1_default: cam-mclk1-default-state {
+		pins = "gpio40";
+		function = "cam_mclk";
+		drive-strength = <6>;
+		bias-disable;
+	};
+
+	cam_mclk3_default: cam-mclk3-default-state {
+		pins = "gpio42";
+		function = "cam_mclk";
+		drive-strength = <6>;
+		bias-disable;
+	};
+
+	cam_wide_reset: cam-wide-reset-state {
+		pins = "gpio45";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_front_reset: cam-front-reset-state {
+		pins = "gpio47";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	amp_top_reset: amp-top-reset-state {
 		pins = "gpio26";
 		function = "gpio";
