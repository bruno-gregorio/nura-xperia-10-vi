From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 13:38:46 -0300
Subject: [PATCH] media: dt-bindings: Add Sony IMX582
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Sony IMX582 is a 48 megapixel quad Bayer image sensor, controlled
through I2C at 0x1a and sending its images through four MIPI CSI-2 D-PHY
lanes. Describe its clock, its three supplies, its reset line and its
output port.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../bindings/media/i2c/sony,imx582.yaml       | 119 ++++++++++++++++++
 1 file changed, 119 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/sony,imx582.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/sony,imx582.yaml b/Documentation/devicetree/bindings/media/i2c/sony,imx582.yaml
new file mode 100644
index 000000000..9371f50ad
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/sony,imx582.yaml
@@ -0,0 +1,119 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx582.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX582 Sensor
+
+maintainers:
+  - Bruno Gregório <accounts@bruno.pw>
+
+description:
+  The Sony IMX582 is a 1/2-inch CMOS quad Bayer image sensor with an active
+  array of 8000H x 6000V pixels. It is programmable through I2C at the fixed
+  address 0x1a, and sends its image data through four MIPI CSI-2 D-PHY
+  lanes.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx582
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: The external clock, at 24 MHz.
+    maxItems: 1
+
+  avdd-supply:
+    description: Analog power supply, 2.9 V.
+
+  dvdd-supply:
+    description: Digital core power supply, 1.1 V.
+
+  dovdd-supply:
+    description: Interface power supply, 1.8 V.
+
+  reset-gpios:
+    description: The GPIO connected to the XCLR pin, if any.
+    maxItems: 1
+
+  lens-focus: true
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@1a {
+            compatible = "sony,imx582";
+            reg = <0x1a>;
+
+            clocks = <&camera_mclk>;
+            assigned-clocks = <&camera_mclk>;
+            assigned-clock-rates = <24000000>;
+
+            reset-gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
+
+            avdd-supply = <&cam_vana>;
+            dvdd-supply = <&cam_vdig>;
+            dovdd-supply = <&cam_vio>;
+
+            orientation = <1>;
+            rotation = <90>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <412000000 632000000
+                                                  782400000>;
+                    remote-endpoint = <&csiphy0_ep>;
+                };
+            };
+        };
+    };
+...
