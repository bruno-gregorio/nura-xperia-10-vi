From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 14:20:03 -0300
Subject: [PATCH] media: dt-bindings: Add qcom,sm6450-camss
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add the binding for the camera subsystem of the SM6450, which has four
CSI PHYs, three thin front ends (TFE 640) each with a CSID of its own,
and two CSI test pattern generators.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../bindings/media/qcom,sm6450-camss.yaml     | 315 ++++++++++++++++++
 1 file changed, 315 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/qcom,sm6450-camss.yaml

diff --git a/Documentation/devicetree/bindings/media/qcom,sm6450-camss.yaml b/Documentation/devicetree/bindings/media/qcom,sm6450-camss.yaml
new file mode 100644
index 000000000..a7adb9b78
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/qcom,sm6450-camss.yaml
@@ -0,0 +1,315 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/qcom,sm6450-camss.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SM6450 Camera Subsystem (CAMSS)
+
+maintainers:
+  - Bruno Gregório <accounts@bruno.pw>
+
+description:
+  The CAMSS IP is a CSI decoder and ISP present on Qualcomm platforms. The
+  SM6450 one has four CSI PHYs, three thin front ends (TFE 640) each with
+  its own CSID, and two CSI test pattern generators.
+
+properties:
+  compatible:
+    const: qcom,sm6450-camss
+
+  reg:
+    maxItems: 13
+
+  reg-names:
+    items:
+      - const: top
+      - const: csid0
+      - const: csid1
+      - const: csid2
+      - const: csiphy0
+      - const: csiphy1
+      - const: csiphy2
+      - const: csiphy3
+      - const: csitpg0
+      - const: csitpg1
+      - const: vfe0
+      - const: vfe1
+      - const: vfe2
+
+  clocks:
+    maxItems: 28
+
+  clock-names:
+    items:
+      - const: camnoc_axi
+      - const: camnoc_axi_hf
+      - const: camnoc_axi_sf
+      - const: core_ahb
+      - const: cpas_ahb
+      - const: csi0
+      - const: csi1
+      - const: csi2
+      - const: csiphy0
+      - const: csiphy0_timer
+      - const: csiphy1
+      - const: csiphy1_timer
+      - const: csiphy2
+      - const: csiphy2_timer
+      - const: csiphy3
+      - const: csiphy3_timer
+      - const: gcc_axi_hf
+      - const: gcc_axi_sf
+      - const: soc_ahb
+      - const: vfe0
+      - const: vfe0_ahb
+      - const: vfe0_cphy_rx
+      - const: vfe1
+      - const: vfe1_ahb
+      - const: vfe1_cphy_rx
+      - const: vfe2
+      - const: vfe2_ahb
+      - const: vfe2_cphy_rx
+
+  interrupts:
+    maxItems: 12
+
+  interrupt-names:
+    items:
+      - const: csid0
+      - const: csid1
+      - const: csid2
+      - const: csiphy0
+      - const: csiphy1
+      - const: csiphy2
+      - const: csiphy3
+      - const: csitpg0
+      - const: csitpg1
+      - const: vfe0
+      - const: vfe1
+      - const: vfe2
+
+  interconnects:
+    maxItems: 3
+
+  interconnect-names:
+    items:
+      - const: ahb
+      - const: hf_mnoc
+      - const: sf_mnoc
+
+  iommus:
+    maxItems: 1
+
+  power-domains:
+    items:
+      - description: Titan Top GDSC.
+
+  vdd-csiphy-0p9-supply:
+    description:
+      Phandle to a 0.9V regulator supply to CSI PHYs.
+
+  vdd-csiphy-1p2-supply:
+    description:
+      Phandle to a 1.2V regulator supply to CSI PHYs.
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    description:
+      CSI input ports, one for each CSI PHY.
+
+    patternProperties:
+      "^port@[0-3]$":
+        $ref: /schemas/graph.yaml#/$defs/port-base
+        unevaluatedProperties: false
+
+        description:
+          Input port for receiving CSI data from a CSIPHY.
+
+        properties:
+          endpoint:
+            $ref: video-interfaces.yaml#
+            unevaluatedProperties: false
+
+            properties:
+              data-lanes:
+                minItems: 1
+                maxItems: 4
+
+            required:
+              - data-lanes
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - interrupts
+  - interrupt-names
+  - interconnects
+  - interconnect-names
+  - iommus
+  - power-domains
+  - vdd-csiphy-0p9-supply
+  - vdd-csiphy-1p2-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,sm6450-camcc.h>
+    #include <dt-bindings/clock/qcom,sm6450-gcc.h>
+    #include <dt-bindings/interconnect/qcom,icc.h>
+    #include <dt-bindings/interconnect/qcom,sm6450-rpmh.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        isp@ac13000 {
+            compatible = "qcom,sm6450-camss";
+
+            reg = <0x0 0x0ac13000 0x0 0x1000>,
+                  <0x0 0x0ac62000 0x0 0x1000>,
+                  <0x0 0x0ac71000 0x0 0x1000>,
+                  <0x0 0x0ac80000 0x0 0x1000>,
+                  <0x0 0x0ace4000 0x0 0x2000>,
+                  <0x0 0x0ace6000 0x0 0x2000>,
+                  <0x0 0x0ace8000 0x0 0x2000>,
+                  <0x0 0x0acea000 0x0 0x2000>,
+                  <0x0 0x0acf6000 0x0 0x400>,
+                  <0x0 0x0acf7000 0x0 0x400>,
+                  <0x0 0x0ac63800 0x0 0xb800>,
+                  <0x0 0x0ac72800 0x0 0xb800>,
+                  <0x0 0x0ac81800 0x0 0xb800>;
+            reg-names = "top",
+                        "csid0",
+                        "csid1",
+                        "csid2",
+                        "csiphy0",
+                        "csiphy1",
+                        "csiphy2",
+                        "csiphy3",
+                        "csitpg0",
+                        "csitpg1",
+                        "vfe0",
+                        "vfe1",
+                        "vfe2";
+
+            clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+                     <&camcc CAM_CC_CAMNOC_AXI_HF_CLK>,
+                     <&camcc CAM_CC_CAMNOC_AXI_SF_CLK>,
+                     <&camcc CAM_CC_CORE_AHB_CLK>,
+                     <&camcc CAM_CC_CPAS_AHB_CLK>,
+                     <&camcc CAM_CC_TFE_0_CSID_CLK>,
+                     <&camcc CAM_CC_TFE_1_CSID_CLK>,
+                     <&camcc CAM_CC_TFE_2_CSID_CLK>,
+                     <&camcc CAM_CC_CSIPHY0_CLK>,
+                     <&camcc CAM_CC_CSI0PHYTIMER_CLK>,
+                     <&camcc CAM_CC_CSIPHY1_CLK>,
+                     <&camcc CAM_CC_CSI1PHYTIMER_CLK>,
+                     <&camcc CAM_CC_CSIPHY2_CLK>,
+                     <&camcc CAM_CC_CSI2PHYTIMER_CLK>,
+                     <&camcc CAM_CC_CSIPHY3_CLK>,
+                     <&camcc CAM_CC_CSI3PHYTIMER_CLK>,
+                     <&gcc GCC_CAMERA_HF_AXI_CLK>,
+                     <&gcc GCC_CAMERA_SF_AXI_CLK>,
+                     <&camcc CAM_CC_SOC_AHB_CLK>,
+                     <&camcc CAM_CC_TFE_0_CLK>,
+                     <&camcc CAM_CC_TFE_0_AHB_CLK>,
+                     <&camcc CAM_CC_TFE_0_CPHY_RX_CLK>,
+                     <&camcc CAM_CC_TFE_1_CLK>,
+                     <&camcc CAM_CC_TFE_1_AHB_CLK>,
+                     <&camcc CAM_CC_TFE_1_CPHY_RX_CLK>,
+                     <&camcc CAM_CC_TFE_2_CLK>,
+                     <&camcc CAM_CC_TFE_2_AHB_CLK>,
+                     <&camcc CAM_CC_TFE_2_CPHY_RX_CLK>;
+            clock-names = "camnoc_axi",
+                          "camnoc_axi_hf",
+                          "camnoc_axi_sf",
+                          "core_ahb",
+                          "cpas_ahb",
+                          "csi0",
+                          "csi1",
+                          "csi2",
+                          "csiphy0",
+                          "csiphy0_timer",
+                          "csiphy1",
+                          "csiphy1_timer",
+                          "csiphy2",
+                          "csiphy2_timer",
+                          "csiphy3",
+                          "csiphy3_timer",
+                          "gcc_axi_hf",
+                          "gcc_axi_sf",
+                          "soc_ahb",
+                          "vfe0",
+                          "vfe0_ahb",
+                          "vfe0_cphy_rx",
+                          "vfe1",
+                          "vfe1_ahb",
+                          "vfe1_cphy_rx",
+                          "vfe2",
+                          "vfe2_ahb",
+                          "vfe2_cphy_rx";
+
+            interrupts = <GIC_SPI 464 IRQ_TYPE_EDGE_RISING>,
+                         <GIC_SPI 466 IRQ_TYPE_EDGE_RISING>,
+                         <GIC_SPI 640 IRQ_TYPE_EDGE_RISING>,
+                         <GIC_SPI 203 IRQ_TYPE_EDGE_RISING>,
+                         <GIC_SPI 234 IRQ_TYPE_EDGE_RISING>,
+                         <GIC_SPI 227 IRQ_TYPE_EDGE_RISING>,
+                         <GIC_SPI 228 IRQ_TYPE_EDGE_RISING>,
+                         <GIC_SPI 50 IRQ_TYPE_EDGE_RISING>,
+                         <GIC_SPI 51 IRQ_TYPE_EDGE_RISING>,
+                         <GIC_SPI 465 IRQ_TYPE_EDGE_RISING>,
+                         <GIC_SPI 467 IRQ_TYPE_EDGE_RISING>,
+                         <GIC_SPI 641 IRQ_TYPE_EDGE_RISING>;
+            interrupt-names = "csid0",
+                              "csid1",
+                              "csid2",
+                              "csiphy0",
+                              "csiphy1",
+                              "csiphy2",
+                              "csiphy3",
+                              "csitpg0",
+                              "csitpg1",
+                              "vfe0",
+                              "vfe1",
+                              "vfe2";
+
+            interconnects = <&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+                             &cnoc2 SLAVE_CAMERA_CFG QCOM_ICC_TAG_ACTIVE_ONLY>,
+                            <&mmss_noc MASTER_CAMNOC_HF QCOM_ICC_TAG_ALWAYS
+                             &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
+                            <&mmss_noc MASTER_CAMNOC_SF QCOM_ICC_TAG_ALWAYS
+                             &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+            interconnect-names = "ahb",
+                                 "hf_mnoc",
+                                 "sf_mnoc";
+
+            iommus = <&apps_smmu 0x880 0x420>;
+
+            power-domains = <&camcc CAM_CC_CAMSS_TOP_GDSC>;
+
+            vdd-csiphy-0p9-supply = <&vreg_l5b>;
+            vdd-csiphy-1p2-supply = <&vreg_l16b>;
+
+            ports {
+                #address-cells = <1>;
+                #size-cells = <0>;
+
+                port@0 {
+                    reg = <0>;
+
+                    csiphy0_ep: endpoint {
+                        data-lanes = <0 1 2 3>;
+                        remote-endpoint = <&sensor_ep>;
+                    };
+                };
+            };
+        };
+    };
