From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Mon, 12 Oct 2026 14:20:03 -0300
Subject: [PATCH] arm64: dts: qcom: sm6450-sony-xperia-columbia-pdx246: Enable
 the camera subsystem
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Connect the main camera to CSIPHY0, the ultra-wide to CSIPHY1 and the
front camera to CSIPHY3, four lanes each.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../sm6450-sony-xperia-columbia-pdx246.dts    | 33 +++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
index b776c0c20..7f2044bb7 100644
--- a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
+++ b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
@@ -447,6 +447,36 @@ pm6150l_bob: bob {
 	};
 };
 
+&camss {
+	vdd-csiphy-0p9-supply = <&pm6450_l5>;
+	vdd-csiphy-1p2-supply = <&pm6450_l16>;
+
+	status = "okay";
+
+	ports {
+		port@0 {
+			camss_main_in: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&cam_main_out>;
+			};
+		};
+
+		port@1 {
+			camss_wide_in: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&cam_wide_out>;
+			};
+		};
+
+		port@3 {
+			camss_front_in: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&cam_front_out>;
+			};
+		};
+	};
+};
+
 &cci0 {
 	status = "okay";
 };
@@ -478,6 +508,7 @@ cam_main_out: endpoint {
 				data-lanes = <1 2 3 4>;
 				link-frequencies = /bits/ 64 <412000000 632000000
 							      782400000>;
+				remote-endpoint = <&camss_main_in>;
 			};
 		};
 	};
@@ -512,6 +543,7 @@ cam_wide_out: endpoint {
 				data-lanes = <1 2 3 4>;
 				link-frequencies = /bits/ 64 <90000000 180000000
 							      360000000>;
+				remote-endpoint = <&camss_wide_in>;
 			};
 		};
 	};
@@ -555,6 +587,7 @@ cam_front_out: endpoint {
 				data-lanes = <1 2 3 4>;
 				link-frequencies = /bits/ 64 <90000000 180000000
 							      360000000>;
+				remote-endpoint = <&camss_front_in>;
 			};
 		};
 	};
