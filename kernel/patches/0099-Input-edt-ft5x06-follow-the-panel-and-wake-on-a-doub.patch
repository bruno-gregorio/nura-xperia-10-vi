+static int edt_ft5x06_follow_resume(struct edt_ft5x06_ts_data *tsdata)
+{
+	mutex_lock(&tsdata->mutex);
+	if (tsdata->wake_enabled) {
+		disable_irq_wake(tsdata->client->irq);
+		tsdata->wake_enabled = false;
+	}
+	mutex_unlock(&tsdata->mutex);
+
+	complete_all(&tsdata->resumed);
+	edt_ft5x06_follow_later(tsdata);
+
+	return 0;
+}
