From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 15 Oct 2026 14:38:06 -0300
Subject: [PATCH] Input: edt-ft5x06 - follow the panel and wake on a double tap
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A touchscreen glued to a panel has nothing to report while the panel is
dark, and on phones it is the obvious place to wake the screen from.
When the device tree gives the touchscreen a panel to follow, follow it.

With the panel off, touches are not reported. The controller keeps
scanning and the driver looks for a double tap: two contacts, each lifted
within 250 ms without straying more than an eighth of the shorter axis,
the second going down 40 to 300 ms after the first lifted and near it.
A double tap is reported as KEY_POWER on a second input device, "<name>
wake gesture", which is how userspace already asks to turn the screen
on. The key is not sent if the panel has come back on meanwhile, where
it would turn it off again.

The second device also says whether anyone wants the gesture. While it
has no users, or userspace inhibits it through the input core's
"inhibited" attribute, as it may while a proximity sensor is covered,
the controller is powered down with the panel instead.

If the device may wake the system, the controller is left scanning
through system suspend with its interrupt as a wakeup source, armed by
the driver rather than by the I2C core, so only the gesture wakes it.
A touch that wakes the system cannot be read as a tap: by the time the
bus is back it has lifted, and a quick second tap often with it. It
counts as the first tap, and the second may follow within two seconds.

The power-down and power-up sequences move out of suspend and resume,
unchanged, so that following the panel can use them too.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/touchscreen/Kconfig      |   2 +
 drivers/input/touchscreen/edt-ft5x06.c | 661 ++++++++++++++++++++++---
 2 files changed, 594 insertions(+), 69 deletions(-)

diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 7d5b72ee0..e1df6fd0e 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -794,6 +794,8 @@ config TOUCHSCREEN_PENMOUNT
 config TOUCHSCREEN_EDT_FT5X06
 	tristate "EDT FocalTech FT5x06 I2C Touchscreen support"
 	depends on I2C
+	# We need to call into panel code so if DRM=m, this can't be 'y'
+	depends on DRM || !DRM
 	select REGMAP_I2C
 	help
 	  Say Y here if you have an EDT "Polytouch" touchscreen based
diff --git a/drivers/input/touchscreen/edt-ft5x06.c b/drivers/input/touchscreen/edt-ft5x06.c
index 9ccdce762..6af7cf0bc 100644
--- a/drivers/input/touchscreen/edt-ft5x06.c
+++ b/drivers/input/touchscreen/edt-ft5x06.c
@@ -14,6 +14,7 @@
  *    http://www.glyn.com/Products/Displays
  */
 
+#include <linux/completion.h>
 #include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
@@ -24,16 +25,22 @@
 #include <linux/input/touchscreen.h>
 #include <linux/irq.h>
 #include <linux/kernel.h>
+#include <linux/ktime.h>
 #include <linux/module.h>
+#include <linux/pm_wakeirq.h>
+#include <linux/pm_wakeup.h>
 #include <linux/property.h>
 #include <linux/ratelimit.h>
 #include <linux/regmap.h>
 #include <linux/regulator/consumer.h>
 #include <linux/slab.h>
 #include <linux/uaccess.h>
+#include <linux/workqueue.h>
 
 #include <linux/unaligned.h>
 
+#include <drm/drm_panel.h>
+
 #define WORK_REGISTER_THRESHOLD		0x00
 #define WORK_REGISTER_REPORT_RATE	0x08
 #define WORK_REGISTER_GAIN		0x30
@@ -80,6 +87,27 @@
 #define M06_REG_CMD(factory) ((factory) ? 0xf3 : 0xfc)
 #define M06_REG_ADDR(factory, addr) ((factory) ? (addr) & 0x7f : (addr) & 0x3f)
 
+/*
+ * Double tap to wake, while the panel is off. A tap is one contact that lifts
+ * within EDT_TAP_MAX_MS without straying further than the slop, an eighth of
+ * the shorter axis. The second tap must go down between EDT_TAP_MIN_GAP_MS
+ * and EDT_TAP_GAP_MS after the first lifted, within the slop of it.
+ */
+#define EDT_TAP_MAX_MS			250
+#define EDT_TAP_MIN_GAP_MS		40
+#define EDT_TAP_GAP_MS			300
+/*
+ * A touch that wakes the system from suspend cannot be read: by the time the
+ * bus is back it has lifted, and a quick second tap often with it. It counts
+ * as the first tap, wherever it was, if its interrupt arrives within
+ * EDT_WAKE_IRQ_MS of the resume, and the second may come EDT_WAKE_GAP_MS
+ * after that.
+ */
+#define EDT_WAKE_IRQ_MS			1000
+#define EDT_WAKE_GAP_MS			2000
+/* After the key, taps are ignored while the panel comes back on. */
+#define EDT_TAP_HOLDOFF_MS		1000
+
 enum edt_pmode {
 	EDT_PMODE_NOT_SUPPORTED,
 	EDT_PMODE_HIBERNATE,
@@ -105,6 +133,18 @@ struct edt_reg_addr {
 	int reg_num_y;
 };
 
+struct edt_tap {
+	ktime_t down_time;	/* when the contact now down went down */
+	ktime_t up_time;	/* when the pending first tap lifted */
+	ktime_t holdoff;	/* no taps count before this */
+	int x, y;		/* where the contact now down went down */
+	int tap_x, tap_y;	/* where the pending first tap was */
+	bool down;		/* a contact is down */
+	bool spoiled;		/* ... and it is not a tap */
+	bool pending;		/* a first tap lifted at up_time */
+	bool woke;		/* ... and it was the touch that woke us */
+};
+
 struct edt_ft5x06_ts_data {
 	struct i2c_client *client;
 	struct input_dev *input;
@@ -146,6 +186,24 @@ struct edt_ft5x06_ts_data {
 	enum edt_ver version;
 	unsigned int crc_errors;
 	unsigned int header_errors;
+
+	/* Following a panel; see edt_ft5x06_follow(). */
+	struct drm_panel_follower panel_follower;
+	struct work_struct follow_work;
+	struct input_dev *gesture;
+	struct completion resumed;
+	ktime_t resume_time;
+	struct edt_tap tap;
+	int tap_slop;
+	bool follows_panel;
+	bool follow_ready;	/* under mutex */
+	bool panel_off;
+	bool listening;		/* the gesture device is open, not inhibited */
+	bool powered;
+	bool gesture_mode;
+	bool wake_enabled;
+	bool wake_armed;
+	bool slept;
 };
 
 struct edt_i2c_chip_data {
@@ -295,14 +353,128 @@ static const struct regmap_config edt_M06_i2c_regmap_config = {
 	.write = edt_M06_i2c_write,
 };
 
+static void edt_ft5x06_tap_report(struct edt_ft5x06_ts_data *tsdata)
+{
+	/* With the panel back on, the same key would turn it off again. */
+	if (!READ_ONCE(tsdata->panel_off) || !READ_ONCE(tsdata->listening))
+		return;
+
+	pm_wakeup_dev_event(&tsdata->client->dev, EDT_TAP_HOLDOFF_MS, false);
+	input_report_key(tsdata->gesture, KEY_POWER, 1);
+	input_sync(tsdata->gesture);
+	input_report_key(tsdata->gesture, KEY_POWER, 0);
+	input_sync(tsdata->gesture);
+}
+
+/* Whether a contact going down at @now, at @x, @y, is a second tap. */
+static bool edt_ft5x06_tap_follows(struct edt_ft5x06_ts_data *tsdata,
+				   ktime_t now, int x, int y)
+{
+	struct edt_tap *tap = &tsdata->tap;
+	s64 gap = ktime_ms_delta(now, tap->up_time);
+
+	if (tap->woke)
+		return gap <= EDT_WAKE_GAP_MS;
+
+	return gap >= EDT_TAP_MIN_GAP_MS && gap <= EDT_TAP_GAP_MS &&
+	       abs(x - tap->tap_x) <= tsdata->tap_slop &&
+	       abs(y - tap->tap_y) <= tsdata->tap_slop;
+}
+
+/* One frame with the panel off: @contacts down, the first at @x, @y. */
+static void edt_ft5x06_tap_frame(struct edt_ft5x06_ts_data *tsdata,
+				 int contacts, int x, int y)
+{
+	struct edt_tap *tap = &tsdata->tap;
+	ktime_t now = ktime_get();
+
+	if (contacts) {
+		/* Whatever this turns out to be, stay up to see it end. */
+		pm_wakeup_dev_event(&tsdata->client->dev,
+				    EDT_TAP_MAX_MS + EDT_TAP_GAP_MS, false);
+
+		if (!tap->down) {
+			tap->down = true;
+			tap->down_time = now;
+			tap->x = x;
+			tap->y = y;
+			tap->spoiled = ktime_before(now, tap->holdoff);
+			if (tap->pending &&
+			    !edt_ft5x06_tap_follows(tsdata, now, x, y))
+				tap->pending = false;
+		}
+
+		if (contacts > 1 ||
+		    abs(x - tap->x) > tsdata->tap_slop ||
+		    abs(y - tap->y) > tsdata->tap_slop)
+			tap->spoiled = true;
+		return;
+	}
+
+	if (!tap->down)
+		return;
+	tap->down = false;
+
+	if (tap->spoiled ||
+	    ktime_ms_delta(now, tap->down_time) > EDT_TAP_MAX_MS) {
+		tap->pending = false;
+		return;
+	}
+
+	if (tap->pending) {
+		tap->pending = false;
+		tap->holdoff = ktime_add_ms(now, EDT_TAP_HOLDOFF_MS);
+		edt_ft5x06_tap_report(tsdata);
+		return;
+	}
+
+	tap->pending = true;
+	tap->woke = false;
+	tap->up_time = now;
+	tap->tap_x = tap->x;
+	tap->tap_y = tap->y;
+}
+
+/*
+ * The first interrupt after a suspend that left the controller scanning. If
+ * it came straight out of the resume, a touch woke the system, and that
+ * touch is the first tap.
+ */
+static void edt_ft5x06_tap_woke(struct edt_ft5x06_ts_data *tsdata)
+{
+	struct device *dev = &tsdata->client->dev;
+	struct edt_tap *tap = &tsdata->tap;
+
+	tsdata->wake_armed = false;
+	if (!tsdata->slept ||
+	    ktime_ms_delta(ktime_get(), tsdata->resume_time) > EDT_WAKE_IRQ_MS)
+		return;
+	tsdata->slept = false;
+
+	/* The bus resumes before its clients do. */
+	wait_for_completion_timeout(&tsdata->resumed, msecs_to_jiffies(1000));
+	dev_dbg(dev, "a touch woke the system, bus back after %lld ms\n",
+		ktime_ms_delta(ktime_get(), tsdata->resume_time));
+
+	tap->down = false;
+	tap->pending = true;
+	tap->woke = true;
+	tap->up_time = ktime_get();
+	pm_wakeup_dev_event(dev, EDT_WAKE_GAP_MS + EDT_TAP_MAX_MS, false);
+}
+
 static irqreturn_t edt_ft5x06_ts_isr(int irq, void *dev_id)
 {
 	struct edt_ft5x06_ts_data *tsdata = dev_id;
 	struct device *dev = &tsdata->client->dev;
 	u8 rdbuf[63];
 	int i, type, x, y, id;
+	int contacts = 0, cx = 0, cy = 0;
 	int error;
 
+	if (tsdata->gesture_mode && tsdata->wake_armed)
+		edt_ft5x06_tap_woke(tsdata);
+
 	memset(rdbuf, 0, sizeof(rdbuf));
 	error = regmap_bulk_read(tsdata->regmap, tsdata->tdata_cmd, rdbuf,
 				 tsdata->tdata_len);
@@ -332,6 +504,15 @@ static irqreturn_t edt_ft5x06_ts_isr(int irq, void *dev_id)
 
 		id = (buf[2] >> 4) & 0x0f;
 
+		/* With the panel off, nothing is reported but the gesture. */
+		if (tsdata->gesture_mode) {
+			if (type != TOUCH_EVENT_UP && !contacts++) {
+				cx = x;
+				cy = y;
+			}
+			continue;
+		}
+
 		input_mt_slot(tsdata->input, id);
 		if (input_mt_report_slot_state(tsdata->input, MT_TOOL_FINGER,
 					       type != TOUCH_EVENT_UP))
@@ -339,6 +520,11 @@ static irqreturn_t edt_ft5x06_ts_isr(int irq, void *dev_id)
 					       x, y, true);
 	}
 
+	if (tsdata->gesture_mode) {
+		edt_ft5x06_tap_frame(tsdata, contacts, cx, cy);
+		goto out;
+	}
+
 	/*
 	 * The controller reports every contact in every frame, and a lift
 	 * only once. A contact that is gone without one, as happens when the
@@ -1141,6 +1327,303 @@ static void edt_ft5x06_disable_regulators(void *arg)
 	regulator_disable(data->iovcc);
 }
 
+/* Not for EDT_PMODE_NOT_SUPPORTED, and the interrupt is the caller's. */
+static void edt_ft5x06_power_off(struct edt_ft5x06_ts_data *tsdata)
+{
+	struct device *dev = &tsdata->client->dev;
+	int ret;
+
+	/* Enter hibernate mode. */
+	ret = regmap_write(tsdata->regmap, PMOD_REGISTER_OPMODE,
+			   PMOD_REGISTER_HIBERNATE);
+	if (ret)
+		dev_warn(dev, "Failed to set hibernate mode\n");
+
+	if (tsdata->suspend_mode == EDT_PMODE_HIBERNATE)
+		return;
+
+	gpiod_set_value_cansleep(tsdata->reset_gpio, 1);
+	usleep_range(1000, 2000);
+
+	ret = regulator_disable(tsdata->vcc);
+	if (ret)
+		dev_warn(dev, "Failed to disable vcc\n");
+	ret = regulator_disable(tsdata->iovcc);
+	if (ret)
+		dev_warn(dev, "Failed to disable iovcc\n");
+}
+
+/* Not for EDT_PMODE_NOT_SUPPORTED, and the interrupt is the caller's. */
+static int edt_ft5x06_power_on(struct edt_ft5x06_ts_data *tsdata)
+{
+	struct device *dev = &tsdata->client->dev;
+	struct gpio_desc *reset_gpio = tsdata->reset_gpio;
+	int ret;
+
+	if (tsdata->suspend_mode == EDT_PMODE_HIBERNATE) {
+		struct gpio_desc *wake_gpio = tsdata->wake_gpio;
+
+		gpiod_set_value_cansleep(wake_gpio, 0);
+		usleep_range(5000, 6000);
+		gpiod_set_value_cansleep(wake_gpio, 1);
+		return 0;
+	}
+
+	/*
+	 * We can't check if the regulator is a dummy or a real regulator. So
+	 * we need to specify the 5ms reset time (T_rst) here instead of the
+	 * 100us T_rtp time. We also need to wait 300ms in case it was a real
+	 * supply and the power was cutted of. Toggle the reset pin is also a
+	 * way to exit the hibernate mode.
+	 */
+	gpiod_set_value_cansleep(reset_gpio, 1);
+	usleep_range(5000, 6000);
+
+	ret = regulator_enable(tsdata->iovcc);
+	if (ret) {
+		dev_err(dev, "Failed to enable iovcc\n");
+		return ret;
+	}
+
+	/* Delay enabling VCC for > 10us (T_ivd) after IOVCC */
+	usleep_range(10, 100);
+
+	ret = regulator_enable(tsdata->vcc);
+	if (ret) {
+		dev_err(dev, "Failed to enable vcc\n");
+		regulator_disable(tsdata->iovcc);
+		return ret;
+	}
+
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(reset_gpio, 0);
+	msleep(300);
+
+	edt_ft5x06_restore_reg_parameters(tsdata);
+
+	return 0;
+}
+
+/*
+ * Bring the controller in line with the panel it follows, under the mutex.
+ *
+ * With the panel on, touches are reported as usual. With it off, they are
+ * not reported at all. The controller then watches for a double tap, which
+ * it reports as KEY_POWER through a separate input device, as long as
+ * anyone listens on that device; otherwise it is powered down. Userspace
+ * that wants the gesture off for a while, say because the proximity sensor
+ * is covered, inhibits that device.
+ */
+static void edt_ft5x06_follow(struct edt_ft5x06_ts_data *tsdata)
+{
+	int irq = tsdata->client->irq;
+	bool off = READ_ONCE(tsdata->panel_off);
+	bool gesture = off && READ_ONCE(tsdata->listening);
+	bool power = !off || gesture;
+
+	/* The raw data mode has the interrupt. */
+	if (tsdata->factory_mode)
+		return;
+
+	/* With no way to wake it up again, the controller stays on. */
+	if (tsdata->suspend_mode == EDT_PMODE_NOT_SUPPORTED) {
+		gesture = off;
+		power = true;
+	}
+
+	if (power == tsdata->powered && gesture == tsdata->gesture_mode)
+		return;
+
+	if (tsdata->powered)
+		disable_irq(irq);
+
+	/* Contacts down now would never be reported lifting. */
+	if (tsdata->powered && !tsdata->gesture_mode) {
+		input_mt_sync_frame(tsdata->input);
+		input_sync(tsdata->input);
+	}
+
+	memset(&tsdata->tap, 0, sizeof(tsdata->tap));
+	tsdata->wake_armed = false;
+	tsdata->gesture_mode = gesture;
+
+	if (power && !tsdata->powered) {
+		if (edt_ft5x06_power_on(tsdata))
+			return;
+		tsdata->powered = true;
+	} else if (!power && tsdata->powered) {
+		edt_ft5x06_power_off(tsdata);
+		tsdata->powered = false;
+	}
+
+	if (tsdata->powered)
+		enable_irq(irq);
+}
+
+static void edt_ft5x06_follow_work(struct work_struct *work)
+{
+	struct edt_ft5x06_ts_data *tsdata =
+		container_of(work, struct edt_ft5x06_ts_data, follow_work);
+
+	mutex_lock(&tsdata->mutex);
+	if (tsdata->follow_ready)
+		edt_ft5x06_follow(tsdata);
+	mutex_unlock(&tsdata->mutex);
+}
+
+/*
+ * The panel and input callbacks only note what changed. The work is
+ * freezable, so a change during system sleep waits for the resume.
+ */
+static void edt_ft5x06_follow_later(struct edt_ft5x06_ts_data *tsdata)
+{
+	queue_work(system_freezable_wq, &tsdata->follow_work);
+}
+
+static int edt_ft5x06_panel_enabled(struct drm_panel_follower *follower)
+{
+	struct edt_ft5x06_ts_data *tsdata =
+		container_of(follower, struct edt_ft5x06_ts_data, panel_follower);
+
+	WRITE_ONCE(tsdata->panel_off, false);
+	edt_ft5x06_follow_later(tsdata);
+
+	return 0;
+}
+
+static int edt_ft5x06_panel_disabling(struct drm_panel_follower *follower)
+{
+	struct edt_ft5x06_ts_data *tsdata =
+		container_of(follower, struct edt_ft5x06_ts_data, panel_follower);
+
+	WRITE_ONCE(tsdata->panel_off, true);
+	edt_ft5x06_follow_later(tsdata);
+
+	return 0;
+}
+
+static const struct drm_panel_follower_funcs edt_ft5x06_panel_follower_funcs = {
+	.panel_enabled = edt_ft5x06_panel_enabled,
+	.panel_disabling = edt_ft5x06_panel_disabling,
+};
+
+/* Called on the first open and on uninhibit, and close the other way. */
+static int edt_ft5x06_gesture_open(struct input_dev *dev)
+{
+	struct edt_ft5x06_ts_data *tsdata = input_get_drvdata(dev);
+
+	WRITE_ONCE(tsdata->listening, true);
+	edt_ft5x06_follow_later(tsdata);
+
+	return 0;
+}
+
+static void edt_ft5x06_gesture_close(struct input_dev *dev)
+{
+	struct edt_ft5x06_ts_data *tsdata = input_get_drvdata(dev);
+
+	WRITE_ONCE(tsdata->listening, false);
+	edt_ft5x06_follow_later(tsdata);
+}
+
+static void edt_ft5x06_cancel_follow(void *arg)
+{
+	struct edt_ft5x06_ts_data *tsdata = arg;
+
+	cancel_work_sync(&tsdata->follow_work);
+}
+
+/* Undoes edt_ft5x06_start_follow(), before anything it relies on goes. */
+static void edt_ft5x06_stop_follow(void *arg)
+{
+	struct edt_ft5x06_ts_data *tsdata = arg;
+
+	mutex_lock(&tsdata->mutex);
+	tsdata->follow_ready = false;
+	mutex_unlock(&tsdata->mutex);
+	cancel_work_sync(&tsdata->follow_work);
+
+	/* The regulators' devm action expects them on. */
+	if (!tsdata->powered && !edt_ft5x06_power_on(tsdata)) {
+		tsdata->powered = true;
+		enable_irq(tsdata->client->irq);
+	}
+}
+
+/* Early in probe, so that a panel not there yet defers it cheaply. */
+static int edt_ft5x06_init_follow(struct edt_ft5x06_ts_data *tsdata)
+{
+	struct device *dev = &tsdata->client->dev;
+	int error;
+
+	INIT_WORK(&tsdata->follow_work, edt_ft5x06_follow_work);
+	init_completion(&tsdata->resumed);
+	complete_all(&tsdata->resumed);
+	tsdata->powered = true;
+
+	if (!drm_is_panel_follower(dev))
+		return 0;
+
+	error = devm_add_action_or_reset(dev, edt_ft5x06_cancel_follow, tsdata);
+	if (error)
+		return error;
+
+	/* Until the panel says it is on, it is off. */
+	tsdata->panel_off = true;
+	tsdata->panel_follower.funcs = &edt_ft5x06_panel_follower_funcs;
+	error = devm_drm_panel_add_follower(dev, &tsdata->panel_follower);
+	if (error)
+		return dev_err_probe(dev, error, "Failed to follow the panel\n");
+
+	tsdata->follows_panel = true;
+
+	return 0;
+}
+
+/* Last in probe, once everything the follower work touches is there. */
+static int edt_ft5x06_start_follow(struct edt_ft5x06_ts_data *tsdata)
+{
+	struct device *dev = &tsdata->client->dev;
+	struct input_dev *gesture = tsdata->gesture;
+	int error;
+
+	gesture->name = devm_kasprintf(dev, GFP_KERNEL, "%s wake gesture",
+				       tsdata->name);
+	if (!gesture->name)
+		return -ENOMEM;
+
+	gesture->id.bustype = BUS_I2C;
+	gesture->open = edt_ft5x06_gesture_open;
+	gesture->close = edt_ft5x06_gesture_close;
+	input_set_capability(gesture, EV_KEY, KEY_POWER);
+	input_set_drvdata(gesture, tsdata);
+
+	tsdata->tap_slop =
+		min(input_abs_get_max(tsdata->input, ABS_MT_POSITION_X),
+		    input_abs_get_max(tsdata->input, ABS_MT_POSITION_Y)) / 8;
+
+	error = input_register_device(gesture);
+	if (error)
+		return error;
+
