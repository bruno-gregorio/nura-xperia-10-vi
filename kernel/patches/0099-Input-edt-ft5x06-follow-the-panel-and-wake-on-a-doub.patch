+	if (tsdata->gesture_mode && tsdata->powered &&
+	    device_may_wakeup(dev)) {
+		error = enable_irq_wake(irq);
+		if (!error) {
+			tsdata->wake_enabled = true;
+			tsdata->wake_armed = true;
+			goto out;
+		}
+		dev_warn(dev, "Failed to enable wake irq: %d\n", error);
+	}
+
+	if (tsdata->powered &&
+	    tsdata->suspend_mode != EDT_PMODE_NOT_SUPPORTED) {
+		disable_irq(irq);
+		edt_ft5x06_power_off(tsdata);
+		tsdata->powered = false;
+	}
+
+out:
+	mutex_unlock(&tsdata->mutex);
+
+	return 0;
+}
