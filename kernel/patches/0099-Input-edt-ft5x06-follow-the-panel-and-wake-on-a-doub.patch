+/*
+ * With the panel off and the gesture wanted, the controller is left scanning
+ * and its interrupt wakes the system. Otherwise it is powered down.
+ */
+static int edt_ft5x06_follow_suspend(struct edt_ft5x06_ts_data *tsdata)
+{
+	struct device *dev = &tsdata->client->dev;
+	int irq = tsdata->client->irq;
+	int error;
