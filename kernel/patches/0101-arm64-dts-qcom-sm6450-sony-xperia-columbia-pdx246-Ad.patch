From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 15 Oct 2026 16:43:13 -0300
Subject: [PATCH] arm64: dts: qcom: sm6450-sony-xperia-columbia-pdx246: Add the
 modem's rmtfs buffer
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The modem keeps its non-volatile data on the application processor's
storage and reaches it through rmtfs, which needs a buffer shared with
the modem. Stock allocates 0x280000 bytes for client 1 dynamically,
below 4 GiB; do the same, with a guard page on either side.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../qcom/sm6450-sony-xperia-columbia-pdx246.dts | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
index 5060237f9..5a162904c 100644
--- a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
+++ b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
@@ -5,6 +5,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/firmware/qcom,scm.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/leds/common.h>
@@ -160,6 +161,22 @@ rdtag@ffdc0000 {
 			reg = <0x0 0xffdc0000 0x0 0x40000>;
 			no-map;
 		};
+
+		/*
+		 * The modem's remote file system buffer. Stock allocates it
+		 * dynamically below 4 GiB, with no fixed address to copy.
+		 */
+		rmtfs_mem: rmtfs {
+			compatible = "qcom,rmtfs-mem";
+			size = <0x0 0x282000>;
+			alignment = <0x0 0x1000>;
+			alloc-ranges = <0x0 0x80000000 0x0 0x80000000>;
+			no-map;
+
+			qcom,client-id = <1>;
+			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
+			qcom,use-guard-pages;
+		};
 	};
 
 	/*
