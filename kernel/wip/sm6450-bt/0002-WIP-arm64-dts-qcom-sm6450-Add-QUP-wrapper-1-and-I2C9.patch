From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 15:31:42 -0300
Subject: [PATCH] WIP: arm64: dts: qcom: sm6450: Add QUP wrapper 1 and I2C9
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add the second QUP wrapper, with the SMMU stream and clocks of the
downstream tree, and its serial engine 3 at 0xa8c000 as an I2C controller,
SDA and SCL on GPIOs 10 and 11. The Xperia 10 VI has its touchscreen on
it. The wrapper and the controller vote their paths the way wrapper 0 and
UART3 do, and the controller adds its path to memory over aggre2_noc.

Round 36 probed the controller and the touchscreen behind it without the
interconnect votes.

To be folded into the SM6450 DT once it has run.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 arch/arm64/boot/dts/qcom/sm6450.dtsi | 44 ++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6450.dtsi b/arch/arm64/boot/dts/qcom/sm6450.dtsi
index 75cca6cd4..c52cf8b27 100644
--- a/arch/arm64/boot/dts/qcom/sm6450.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6450.dtsi
@@ -762,6 +762,42 @@ &clk_virt SLAVE_QUP_CORE_0 QCOM_ICC_TAG_ALWAYS>,
 			};
 		};
 
+		qupv3_id_1: geniqup@ac0000 {
+			compatible = "qcom,geni-se-qup";
+			reg = <0x0 0x00ac0000 0x0 0x2000>;
+			ranges;
+			clocks = <&gcc GCC_QUPV3_WRAP_1_M_AHB_CLK>,
+				 <&gcc GCC_QUPV3_WRAP_1_S_AHB_CLK>;
+			clock-names = "m-ahb", "s-ahb";
+			iommus = <&apps_smmu 0x403 0x0>;
+			interconnects = <&clk_virt MASTER_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS
+					 &clk_virt SLAVE_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS>;
+			interconnect-names = "qup-core";
+			#address-cells = <2>;
+			#size-cells = <2>;
+			status = "disabled";
+
+			i2c9: i2c@a8c000 {
+				compatible = "qcom,geni-i2c";
+				reg = <0x0 0x00a8c000 0x0 0x4000>;
+				clocks = <&gcc GCC_QUPV3_WRAP1_S3_CLK>;
+				clock-names = "se";
+				interrupts = <GIC_SPI 356 IRQ_TYPE_LEVEL_HIGH>;
+				interconnects = <&clk_virt MASTER_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS
+						 &clk_virt SLAVE_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS>,
+						<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+						 &cnoc2 SLAVE_QUP_1 QCOM_ICC_TAG_ACTIVE_ONLY>,
+						<&aggre2_noc MASTER_QUP_1 QCOM_ICC_TAG_ALWAYS
+						 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+				interconnect-names = "qup-core", "qup-config", "qup-memory";
+				pinctrl-0 = <&qup_i2c9_data_clk>;
+				pinctrl-names = "default";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				status = "disabled";
+			};
+		};
+
 		cnoc2: interconnect@1500000 {
 			compatible = "qcom,sm6450-cnoc2";
 			reg = <0x0 0x01500000 0x0 0x1000>;
@@ -1308,6 +1344,14 @@ tlmm: pinctrl@f100000 {
 			gpio-reserved-ranges = <38 1>;
 			wakeup-parent = <&pdc>;
 
+			qup_i2c9_data_clk: qup-i2c9-data-clk-state {
+				/* SDA, SCL */
+				pins = "gpio10", "gpio11";
+				function = "qup1_se3";
+				drive-strength = <2>;
+				bias-pull-up;
+			};
+
 			qup_uart3_rx: qup-uart3-rx-state {
 				pins = "gpio23";
 				function = "qup0_se3";
