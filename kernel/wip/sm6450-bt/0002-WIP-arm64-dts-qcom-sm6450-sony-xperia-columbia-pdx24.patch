From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 12:27:25 -0300
Subject: [PATCH] WIP: arm64: dts: qcom: sm6450-sony-xperia-columbia-pdx246:
 Enable Bluetooth
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The downstream bt_wcn3990 node names the WCN3990 family. Its core, PA, IO
and XO rails map to vddrf, vddch0, vddio and vddxo, and its switch-control
GPIO is TLMM 61. The exact part, WCN3990, WCN3991 or WCN3988, shows in the
version hci_qca reads back, and the compatible may still have to change.

To be folded into the board DT once it has probed on the device.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../sm6450-sony-xperia-columbia-pdx246.dts    | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
index 1d1c9c5d7..178c169ee 100644
--- a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
+++ b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
@@ -23,6 +23,7 @@ / {
 
 	aliases {
 		serial0 = &uart3;
+		serial1 = &uart11;
 	};
 
 	chosen {
@@ -297,6 +298,10 @@ &qupv3_id_0 {
 	status = "okay";
 };
 
+&qupv3_id_1 {
+	status = "okay";
+};
+
 &sdc2_off_state {
 	sd-cd-pins {
 		pins = "gpio107";
@@ -327,6 +332,23 @@ &sdhc_2 {
 	status = "okay";
 };
 
+&uart11 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,wcn3990-bt";
+
+		vddio-supply = <&pm6450_l22>;
+		vddxo-supply = <&pm6150l_l1>;
+		vddrf-supply = <&pm6450_l14>;
+		vddch0-supply = <&pm6150l_l10>;
+
+		swctrl-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
+
+		max-speed = <3200000>;
+	};
+};
+
 &uart3 {
 	status = "okay";
 };
