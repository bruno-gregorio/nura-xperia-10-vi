From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 15:32:01 -0300
Subject: [PATCH] WIP: arm64: dts: qcom: sm6450-sony-xperia-columbia-pdx246:
 Enable the touchscreen
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A FocalTech FT3519T at 0x38 on I2C9, with its interrupt on GPIO 13 and
its reset on GPIO 12. Its analog supply is switched by GPIO 103; the
stock driver only ever drives that line and never enables the LDO its
device tree also names, so the LDO is left out here.

Round 36 probed it, and the controller answered.

To be folded into the board DT once it has run with the interconnect
votes.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../sm6450-sony-xperia-columbia-pdx246.dts    | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
index 0fb71cc73..98aa44c61 100644
--- a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
+++ b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
@@ -43,6 +43,13 @@ key-volume-down {
 			wakeup-source;
 		};
 	};
+
+	ts_avdd: regulator-ts-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "ts_avdd";
+		gpio = <&tlmm 103 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
 };
 
 &apps_rsc {
@@ -273,6 +280,26 @@ pm6150l_bob: bob {
 	};
 };
 
+&i2c9 {
+	status = "okay";
+
+	touchscreen@38 {
+		compatible = "focaltech,ft3519", "focaltech,ft3518";
+		reg = <0x38>;
+
+		interrupts-extended = <&tlmm 13 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;
+
+		vcc-supply = <&ts_avdd>;
+
+		pinctrl-0 = <&ts_int_default>, <&ts_reset_default>;
+		pinctrl-names = "default";
+
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <2520>;
+	};
+};
+
 &pm6450_gpios {
 	vol_down_n: vol-down-n-state {
 		pins = "gpio1";
@@ -297,6 +324,10 @@ &qupv3_id_0 {
 	status = "okay";
 };
 
+&qupv3_id_1 {
+	status = "okay";
+};
+
 &remoteproc_adsp {
 	firmware-name = "qcom/sm6450/Sony/columbia/adsp.mbn";
 
@@ -351,6 +382,22 @@ &sdhc_2 {
 	status = "okay";
 };
 
+&tlmm {
+	ts_int_default: ts-int-default-state {
+		pins = "gpio13";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	ts_reset_default: ts-reset-default-state {
+		pins = "gpio12";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+};
+
 &uart3 {
 	status = "okay";
 };
