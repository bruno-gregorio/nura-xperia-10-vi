From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 15:45:32 -0300
Subject: [PATCH] WIP: arm64: dts: qcom: sm6450: Add UART11
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add the serial engine of QUP wrapper 1 that downstream uses as a UART:
SE5, UART11 in the SoC's numbering, the Bluetooth UART on GPIOs 14 to
17. The clocks, interrupt and pin biases are the downstream tree's, and
it votes its paths the way UART3 does.

Rounds 35 and 44 ran it without the interconnect votes, as ttyHS1, and
hci_qca set the radio up over it at 3.2 Mbaud.

To be folded into the SM6450 DT once it has run with the votes.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 arch/arm64/boot/dts/qcom/sm6450.dtsi | 45 ++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6450.dtsi b/arch/arm64/boot/dts/qcom/sm6450.dtsi
index c52cf8b27..947e995ce 100644
--- a/arch/arm64/boot/dts/qcom/sm6450.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6450.dtsi
@@ -796,6 +796,23 @@ &cnoc2 SLAVE_QUP_1 QCOM_ICC_TAG_ACTIVE_ONLY>,
 				#size-cells = <0>;
 				status = "disabled";
 			};
+
+			uart11: serial@a94000 {
+				compatible = "qcom,geni-uart";
+				reg = <0x0 0x00a94000 0x0 0x4000>;
+				clocks = <&gcc GCC_QUPV3_WRAP1_S5_CLK>;
+				clock-names = "se";
+				interrupts = <GIC_SPI 358 IRQ_TYPE_LEVEL_HIGH>;
+				interconnects = <&clk_virt MASTER_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS
+						 &clk_virt SLAVE_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS>,
+						<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+						 &cnoc2 SLAVE_QUP_1 QCOM_ICC_TAG_ACTIVE_ONLY>;
+				interconnect-names = "qup-core", "qup-config";
+				pinctrl-0 = <&qup_uart11_cts>, <&qup_uart11_rts>,
+					    <&qup_uart11_tx>, <&qup_uart11_rx>;
+				pinctrl-names = "default";
+				status = "disabled";
+			};
 		};
 
 		cnoc2: interconnect@1500000 {
@@ -1352,6 +1369,34 @@ qup_i2c9_data_clk: qup-i2c9-data-clk-state {
 				bias-pull-up;
 			};
 
+			qup_uart11_cts: qup-uart11-cts-state {
+				pins = "gpio14";
+				function = "qup1_se5";
+				drive-strength = <2>;
+				bias-disable;
+			};
+
+			qup_uart11_rts: qup-uart11-rts-state {
+				pins = "gpio15";
+				function = "qup1_se5";
+				drive-strength = <2>;
+				bias-pull-down;
+			};
+
+			qup_uart11_rx: qup-uart11-rx-state {
+				pins = "gpio17";
+				function = "qup1_se5";
+				drive-strength = <2>;
+				bias-disable;
+			};
+
+			qup_uart11_tx: qup-uart11-tx-state {
+				pins = "gpio16";
+				function = "qup1_se5";
+				drive-strength = <2>;
+				bias-pull-up;
+			};
+
 			qup_uart3_rx: qup-uart3-rx-state {
 				pins = "gpio23";
 				function = "qup0_se3";
