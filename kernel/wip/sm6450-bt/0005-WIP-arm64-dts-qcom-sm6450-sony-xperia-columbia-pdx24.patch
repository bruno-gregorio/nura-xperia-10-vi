From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 15:45:43 -0300
Subject: [PATCH] WIP: arm64: dts: qcom: sm6450-sony-xperia-columbia-pdx246:
 Enable Bluetooth
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The radio is a WCN3991 on UART11. Stock's qcom,wcn3990 is the compatible
Qualcomm's btpower gives every WCN39xx, so it does not name the chip; the
version hci_qca reads back does. Round 35, under qcom,wcn3990-bt, got a
15-byte reply where a WCN3990's is 14, and btqca expects 15 only from a
WCN3991. Round 44, under qcom,wcn3991-bt, read SoC 0x40014320, ROM
0x0302 and patch 0x0de9, loaded crbtfw32.tlv and crnv32u.bin, and
completed setup.

The downstream node's core, PA, IO and XO rails map to vddrf, vddch0,
vddio and vddxo, and its switch-control GPIO is TLMM 61. hci_qca sets
loads on the rails but no voltage, so vddrf and vddxo ran at the bottom
of their windows, 1.15 V and 1.62 V. The stock Bluetooth and WLAN
drivers ask for 1.304 V and 1.7 to 1.9 V, and both rails feed only this
chip, so their floors are raised to 1.304 V and 1.8 V.

To be folded into the board DT once it has run with UART11's votes.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../sm6450-sony-xperia-columbia-pdx246.dts    | 22 +++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
index 98aa44c61..dba50920e 100644
--- a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
+++ b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
@@ -23,6 +23,7 @@ / {
 
 	aliases {
 		serial0 = &uart3;
+		serial1 = &uart11;
 	};
 
 	chosen {
@@ -137,7 +138,7 @@ pm6450_l13: ldo13 {
 		};
 
 		pm6450_l14: ldo14 {
-			regulator-min-microvolt = <1150000>;
+			regulator-min-microvolt = <1304000>;
 			regulator-max-microvolt = <1304000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
@@ -223,7 +224,7 @@ pm6150l_s8: smps8 {
 		};
 
 		pm6150l_l1: ldo1 {
-			regulator-min-microvolt = <1620000>;
+			regulator-min-microvolt = <1800000>;
 			regulator-max-microvolt = <1980000>;
 		};
 
@@ -398,6 +399,23 @@ ts_reset_default: ts-reset-default-state {
 	};
 };
 
+&uart11 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,wcn3991-bt";
+
+		vddio-supply = <&pm6450_l22>;
+		vddxo-supply = <&pm6150l_l1>;
+		vddrf-supply = <&pm6450_l14>;
+		vddch0-supply = <&pm6150l_l10>;
+
+		swctrl-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
+
+		max-speed = <3200000>;
+	};
+};
+
 &uart3 {
 	status = "okay";
 };
