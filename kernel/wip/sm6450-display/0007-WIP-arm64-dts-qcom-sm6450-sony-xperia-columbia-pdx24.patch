From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 11:41:28 -0300
Subject: [PATCH] WIP: arm64: dts: qcom: sm6450-sony-xperia-columbia-pdx246:
 Enable the display
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Describe the Samsung SOFEF01-M with the AMS605DK01 panel on DSI0, its
reset and TE pins, and the 1.8V I/O rail switched by PM6150L GPIO 9.

That switch is enabled with the GPIO low: the stock tree flags it
active-low, and its regulator driver, unlike regulator-fixed, does not
let enable-active-high override the flag. Driven high, the rail is off,
and the panel takes writes but answers no read and sends no TE.

The panel's vci, PM6150L L4, gets the 3.0V floor the stock panel node
asks for; the panel driver sets no voltage on it.

To be folded into the board device tree once the panel lights up.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../sm6450-sony-xperia-columbia-pdx246.dts    | 99 ++++++++++++++++++-
 1 file changed, 98 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
index 3d761b4c3..9762bd26b 100644
--- a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
+++ b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
@@ -7,6 +7,7 @@
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
 
 #define PMK8350_SID 0
@@ -43,6 +44,26 @@ key-volume-down {
 			wakeup-source;
 		};
 	};
+
+	/*
+	 * The panel's 1.8V logic supply is switched on by driving PM6150L
+	 * GPIO 9 low. With it the other way round the panel still takes
+	 * writes, but sends neither TE nor a read reply.
+	 */
+	panel_vddio_1p8: regulator-panel-vddio {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vddio_1p8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+
+		gpio = <&pm6150l_gpios 9 GPIO_ACTIVE_LOW>;
+		startup-delay-us = <233>;
+
+		pinctrl-0 = <&panel_vddio_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
 };
 
 &apps_rsc {
@@ -221,7 +242,7 @@ pm6150l_l1: ldo1 {
 		};
 
 		pm6150l_l4: ldo4 {
-			regulator-min-microvolt = <2700000>;
+			regulator-min-microvolt = <3000000>;
 			regulator-max-microvolt = <3300000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
@@ -273,6 +294,59 @@ pm6150l_bob: bob {
 	};
 };
 
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&pm6450_l16>;
+
+	status = "okay";
+
+	panel@0 {
+		compatible = "samsung,sofef01-m-ams605dk01";
+		reg = <0>;
+
+		reset-gpios = <&tlmm 127 GPIO_ACTIVE_LOW>;
+
+		vci-supply = <&pm6150l_l4>;
+		vddio-supply = <&panel_vddio_1p8>;
+
+		pinctrl-0 = <&panel_reset_active>, <&panel_te>;
+		pinctrl-1 = <&panel_reset_suspend>, <&panel_te>;
+		pinctrl-names = "default", "sleep";
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&pm6450_l5>;
+
+	status = "okay";
+};
+
+&pm6150l_gpios {
+	panel_vddio_en: panel-vddio-en-state {
+		pins = "gpio9";
+		function = "normal";
+		power-source = <0>;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
+		bias-disable;
+		input-disable;
+		output-enable;
+	};
+};
+
 &pm6450_gpios {
 	vol_down_n: vol-down-n-state {
 		pins = "gpio1";
@@ -351,6 +425,29 @@ &sdhc_2 {
 	status = "okay";
 };
 
+&tlmm {
+	panel_reset_active: panel-reset-active-state {
+		pins = "gpio127";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	panel_reset_suspend: panel-reset-suspend-state {
+		pins = "gpio127";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	panel_te: panel-te-state {
+		pins = "gpio99";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
 &uart3 {
 	status = "okay";
 };
