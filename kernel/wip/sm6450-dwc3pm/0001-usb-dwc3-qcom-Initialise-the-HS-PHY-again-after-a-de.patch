From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 18:21:00 -0300
Subject: [PATCH] usb: dwc3: qcom: Initialise the HS PHY again after a device
 role report
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Bring-up only, NOT FOR UPSTREAM.

On SM6450 the charger firmware on the ADSP runs BC1.2 detection on
attach and leaves the HS PHY in UTMI non-driving mode, with the
DATAPATH override in CFG0 set, OPMODE non-driving and SUSPEND_N_SEL
set. The host loses the link a fraction of a second after the ADSP
comes up. The vendor kernel recovers because it initialises the PHY
each time it starts the peripheral.

Some time after each device role report, take the gadget off the bus,
run the PHY's exit and init, and put it back on.

To be dropped once the PHY driver can tell when the firmware has taken
the PHY, or a firmware handshake is found that makes it give it back.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 drivers/usb/dwc3/dwc3-qcom.c | 71 ++++++++++++++++++++++++++++++++++++
 1 file changed, 71 insertions(+)

diff --git a/drivers/usb/dwc3/dwc3-qcom.c b/drivers/usb/dwc3/dwc3-qcom.c
index ded2ca866..78d09006a 100644
--- a/drivers/usb/dwc3/dwc3-qcom.c
+++ b/drivers/usb/dwc3/dwc3-qcom.c
@@ -85,6 +85,8 @@ struct dwc3_qcom {
 	struct icc_path		*icc_path_apps;
 
 	enum usb_role		current_role;
+
+	struct delayed_work	phy_reinit_work;
 };
 
 #define to_dwc3_qcom(d) container_of((d), struct dwc3_qcom, dwc)
@@ -558,10 +560,76 @@ static int dwc3_qcom_setup_irq(struct dwc3_qcom *qcom, struct platform_device *p
 	return 0;
 }
 
+/*
+ * Bring-up only, NOT FOR UPSTREAM.
+ *
+ * On SM6450 the charger firmware on the ADSP runs BC1.2 detection when a
+ * cable is attached, and for that it puts the HS PHY in UTMI non-driving
+ * mode: it sets the DATAPATH override in CFG0, OPMODE to non-driving in
+ * UTMI_CTRL0 and SUSPEND_N_SEL in HS_PHY_CTRL2, and it switches the PHY's
+ * reference clock gate off. It never takes the PHY back out of it, so the
+ * host loses the link a fraction of a second after the ADSP comes up, and
+ * never sees it again.
+ * The vendor kernel gets away with it because it initialises the PHY again
+ * each time it starts the peripheral, which it does after the charger
+ * firmware reports the attach. Do the same here, late enough to come after
+ * the firmware's detection: some time after each device role report, take
+ * the gadget off the bus, run the PHY's exit and init, which resets it, and
+ * put the gadget back on. The pullup does a core soft reset as well.
+ */
+#define DWC3_QCOM_PHY_REINIT_DELAY_MS	1500
+
+static void dwc3_qcom_phy_reinit_work(struct work_struct *work)
+{
+	struct dwc3_qcom *qcom = container_of(to_delayed_work(work),
+					      struct dwc3_qcom, phy_reinit_work);
+	struct dwc3 *dwc = &qcom->dwc;
+	bool connected;
+	int i, ret;
+
+	if (pm_runtime_resume_and_get(qcom->dev))
+		return;
+
+	mutex_lock(&dwc->mutex);
+
+	if (qcom->current_role != USB_ROLE_DEVICE ||
+	    dwc->current_dr_role != DWC3_GCTL_PRTCAP_DEVICE || !dwc->gadget)
+		goto out;
+
+	connected = dwc->softconnect;
+	if (connected)
+		usb_gadget_disconnect(dwc->gadget);
+
+	for (i = 0; i < dwc->num_usb2_ports; i++) {
+		phy_exit(dwc->usb2_generic_phy[i]);
+		ret = phy_init(dwc->usb2_generic_phy[i]);
+		if (ret)
+			dev_err(qcom->dev, "port-%d HS-PHY init failed: %d\n",
+				i + 1, ret);
+	}
+
+	if (connected)
+		usb_gadget_connect(dwc->gadget);
+
+	dev_info(qcom->dev, "HS-PHY initialised again after a device role report%s\n",
+		 connected ? ", gadget reconnected" : "");
+out:
+	mutex_unlock(&dwc->mutex);
+	pm_runtime_mark_last_busy(qcom->dev);
+	pm_runtime_put_autosuspend(qcom->dev);
+}
+
 static void dwc3_qcom_set_role_notifier(struct dwc3 *dwc, enum usb_role next_role)
 {
 	struct dwc3_qcom *qcom = to_dwc3_qcom(dwc);
 
+	/* Bring-up only, see dwc3_qcom_phy_reinit_work() */
+	dev_info(qcom->dev, "role report: %s -> %s\n",
+		 usb_role_string(qcom->current_role), usb_role_string(next_role));
+	if (next_role == USB_ROLE_DEVICE)
+		mod_delayed_work(system_freezable_wq, &qcom->phy_reinit_work,
+				 msecs_to_jiffies(DWC3_QCOM_PHY_REINIT_DELAY_MS));
+
 	if (qcom->current_role == next_role)
 		return;
 
@@ -623,6 +691,7 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	qcom->dev = &pdev->dev;
+	INIT_DELAYED_WORK(&qcom->phy_reinit_work, dwc3_qcom_phy_reinit_work);
 
 	qcom->resets = devm_reset_control_array_get_optional_exclusive(dev);
 	if (IS_ERR(qcom->resets)) {
@@ -724,6 +793,7 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 remove_core:
 	dwc3_core_remove(&qcom->dwc);
 clk_disable:
+	cancel_delayed_work_sync(&qcom->phy_reinit_work);
 	clk_bulk_disable_unprepare(qcom->num_clocks, qcom->clks);
 
 	return ret;
@@ -737,6 +807,7 @@ static void dwc3_qcom_remove(struct platform_device *pdev)
 	if (pm_runtime_resume_and_get(qcom->dev) < 0)
 		return;
 
+	cancel_delayed_work_sync(&qcom->phy_reinit_work);
 	dwc3_core_remove(&qcom->dwc);
 	clk_bulk_disable_unprepare(qcom->num_clocks, qcom->clks);
 	dwc3_qcom_interconnect_exit(qcom);
