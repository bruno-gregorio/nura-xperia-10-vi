From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 12:04:05 -0300
Subject: [PATCH] dt-bindings: remoteproc: qcom,sm6350-pas: Add SM6450 CDSP
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The compute DSP on SM6450 runs from CX and MX, as SM6350's does, and the
downstream driver describes it with the same crash reason, PAS id and
SSCTL instance. Document it with the SM6350 CDSP as fallback.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../bindings/remoteproc/qcom,sm6350-pas.yaml  | 23 +++++++++++--------
 1 file changed, 14 insertions(+), 9 deletions(-)

diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,sm6350-pas.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,sm6350-pas.yaml
index c1a3cc308..2916a88ee 100644
--- a/Documentation/devicetree/bindings/remoteproc/qcom,sm6350-pas.yaml
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,sm6350-pas.yaml
@@ -15,10 +15,14 @@ description:
 
 properties:
   compatible:
-    enum:
-      - qcom,sm6350-adsp-pas
-      - qcom,sm6350-cdsp-pas
-      - qcom,sm6350-mpss-pas
+    oneOf:
+      - enum:
+          - qcom,sm6350-adsp-pas
+          - qcom,sm6350-cdsp-pas
+          - qcom,sm6350-mpss-pas
+      - items:
+          - const: qcom,sm6450-cdsp-pas
+          - const: qcom,sm6350-cdsp-pas
 
   reg:
     maxItems: 1
@@ -55,9 +59,10 @@ allOf:
   - if:
       properties:
         compatible:
-          enum:
-            - qcom,sm6350-adsp-pas
-            - qcom,sm6350-cdsp-pas
+          contains:
+            enum:
+              - qcom,sm6350-adsp-pas
+              - qcom,sm6350-cdsp-pas
     then:
       properties:
         interrupts:
@@ -90,8 +95,8 @@ allOf:
   - if:
       properties:
         compatible:
-          enum:
-            - qcom,sm6350-cdsp-pas
+          contains:
+            const: qcom,sm6350-cdsp-pas
     then:
       properties:
         power-domains:
