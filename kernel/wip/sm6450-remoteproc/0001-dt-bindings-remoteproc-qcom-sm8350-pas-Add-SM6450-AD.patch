From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 12:04:05 -0300
Subject: [PATCH] dt-bindings: remoteproc: qcom,sm8350-pas: Add SM6450 ADSP and
 MPSS
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The audio DSP and the modem on SM6450 take the same power domains,
interrupts and firmware interface as those on SM8350 and SM8450: the
downstream driver describes them with the same values for both SoCs.
Document them with the SM8350 ADSP and SM8450 MPSS as fallbacks.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../bindings/remoteproc/qcom,sm8350-pas.yaml        | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,sm8350-pas.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,sm8350-pas.yaml
index 6d0982315..76bf828d4 100644
--- a/Documentation/devicetree/bindings/remoteproc/qcom,sm8350-pas.yaml
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,sm8350-pas.yaml
@@ -29,6 +29,12 @@ properties:
       - items:
           - const: qcom,sc8280xp-slpi-pas
           - const: qcom,sm8350-slpi-pas
+      - items:
+          - const: qcom,sm6450-adsp-pas
+          - const: qcom,sm8350-adsp-pas
+      - items:
+          - const: qcom,sm6450-mpss-pas
+          - const: qcom,sm8450-mpss-pas
 
   reg:
     maxItems: 1
@@ -90,9 +96,10 @@ allOf:
   - if:
       properties:
         compatible:
-          enum:
-            - qcom,sm8350-mpss-pas
-            - qcom,sm8450-mpss-pas
+          contains:
+            enum:
+              - qcom,sm8350-mpss-pas
+              - qcom,sm8450-mpss-pas
     then:
       properties:
         power-domains:
