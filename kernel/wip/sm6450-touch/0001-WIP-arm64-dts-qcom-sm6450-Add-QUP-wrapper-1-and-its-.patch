From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 12:27:24 -0300
Subject: [PATCH] WIP: arm64: dts: qcom: sm6450: Add QUP wrapper 1 and its
 UART11
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add the second QUP wrapper with the one serial engine downstream uses as a
UART: SE5, UART11 in the SoC's numbering, the Bluetooth UART on GPIOs 14
to 17. The SMMU stream, clocks, interrupt and pin biases are the
downstream tree's.

To be folded into the SM6450 DT once it has probed on the device.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 arch/arm64/boot/dts/qcom/sm6450.dtsi | 53 ++++++++++++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6450.dtsi b/arch/arm64/boot/dts/qcom/sm6450.dtsi
index c770a0099..89b7431c3 100644
--- a/arch/arm64/boot/dts/qcom/sm6450.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6450.dtsi
@@ -739,6 +739,31 @@ uart3: serial@98c000 {
 			};
 		};
 
+		qupv3_id_1: geniqup@ac0000 {
+			compatible = "qcom,geni-se-qup";
+			reg = <0x0 0x00ac0000 0x0 0x2000>;
+			ranges;
+			clocks = <&gcc GCC_QUPV3_WRAP_1_M_AHB_CLK>,
+				 <&gcc GCC_QUPV3_WRAP_1_S_AHB_CLK>;
+			clock-names = "m-ahb", "s-ahb";
+			iommus = <&apps_smmu 0x403 0x0>;
+			#address-cells = <2>;
+			#size-cells = <2>;
+			status = "disabled";
+
+			uart11: serial@a94000 {
+				compatible = "qcom,geni-uart";
+				reg = <0x0 0x00a94000 0x0 0x4000>;
+				clocks = <&gcc GCC_QUPV3_WRAP1_S5_CLK>;
+				clock-names = "se";
+				interrupts = <GIC_SPI 358 IRQ_TYPE_LEVEL_HIGH>;
+				pinctrl-0 = <&qup_uart11_cts>, <&qup_uart11_rts>,
+					    <&qup_uart11_tx>, <&qup_uart11_rx>;
+				pinctrl-names = "default";
+				status = "disabled";
+			};
+		};
+
 		tcsr_mutex: hwlock@1f40000 {
 			compatible = "qcom,tcsr-mutex";
 			reg = <0x0 0x01f40000 0x0 0x20000>;
@@ -979,6 +1004,34 @@ tlmm: pinctrl@f100000 {
 			gpio-reserved-ranges = <38 1>;
 			wakeup-parent = <&pdc>;
 
+			qup_uart11_cts: qup-uart11-cts-state {
+				pins = "gpio14";
+				function = "qup1_se5";
+				drive-strength = <2>;
+				bias-disable;
+			};
+
+			qup_uart11_rts: qup-uart11-rts-state {
+				pins = "gpio15";
+				function = "qup1_se5";
+				drive-strength = <2>;
+				bias-pull-down;
+			};
+
+			qup_uart11_rx: qup-uart11-rx-state {
+				pins = "gpio17";
+				function = "qup1_se5";
+				drive-strength = <2>;
+				bias-disable;
+			};
+
+			qup_uart11_tx: qup-uart11-tx-state {
+				pins = "gpio16";
+				function = "qup1_se5";
+				drive-strength = <2>;
+				bias-pull-up;
+			};
+
 			qup_uart3_rx: qup-uart3-rx-state {
 				pins = "gpio23";
 				function = "qup0_se3";
