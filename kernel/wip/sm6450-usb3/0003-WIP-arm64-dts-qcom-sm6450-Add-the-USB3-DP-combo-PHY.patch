From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 18:53:16 -0300
Subject: [PATCH] WIP: arm64: dts: qcom: sm6450: Add the USB3/DP combo PHY
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Describe the USB3 and DisplayPort combo PHY at 0x88e8000, feed its pipe
clock back to GCC, and give the DWC3 controller its SuperSpeed PHY and
port. The resets are the downstream node's, and its clocks decode
through the vendor GCC header to these four: the PHY's aux, com_aux and
pipe clocks, and as its reference the USB3 CLKREF gate, which the
downstream node also takes, on top of the CXO it feeds from.

The DisplayPort input port is left out until the SoC describes its DP
controller.

The Xperia 10 VI's port is USB 2.0, so the board keeps the controller at
high speed, off the UTMI clock, and leaves the combo PHY disabled.

To be folded into the SM6450 DT / board DT once it has probed on the device.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../sm6450-sony-xperia-columbia-pdx246.dts    | 10 +++
 arch/arm64/boot/dts/qcom/sm6450.dtsi          | 72 +++++++++++++++----
 2 files changed, 70 insertions(+), 12 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
index 45d513710..a1d7dc7bb 100644
--- a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
+++ b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
@@ -580,7 +580,17 @@ &ufs_mem_phy {
 	status = "okay";
 };
 
+/*
+ * The phone's port is USB 2.0: stock links at high speed on it too, on
+ * the same cable. So the combo PHY stays off, and the controller runs at
+ * high speed off the UTMI clock alone.
+ */
 &usb_1 {
+	maximum-speed = "high-speed";
+	phys = <&usb_1_hsphy>;
+	phy-names = "usb2-phy";
+	qcom,select-utmi-as-pipe-clk;
+
 	status = "okay";
 };
 
diff --git a/arch/arm64/boot/dts/qcom/sm6450.dtsi b/arch/arm64/boot/dts/qcom/sm6450.dtsi
index b38f70be9..247218468 100644
--- a/arch/arm64/boot/dts/qcom/sm6450.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6450.dtsi
@@ -11,6 +11,7 @@
 #include <dt-bindings/interconnect/qcom,sm6450-rpmh.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/mailbox/qcom-ipcc.h>
+#include <dt-bindings/phy/phy-qcom-qmp.h>
 #include <dt-bindings/power/qcom-rpmpd.h>
 #include <dt-bindings/soc/qcom,rpmh-rsc.h>
 #include <dt-bindings/thermal/thermal.h>
@@ -730,7 +731,7 @@ gcc: clock-controller@100000 {
 				 <&ufs_mem_phy 0>,
 				 <&ufs_mem_phy 1>,
 				 <&ufs_mem_phy 2>,
-				 <0>;
+				 <&usb_1_qmpphy QMP_USB43DP_USB3_PIPE_CLK>;
 		};
 
 		qupv3_id_0: geniqup@9c0000 {
@@ -1328,6 +1329,52 @@ usb_1_hsphy: phy@88e3000 {
 			status = "disabled";
 		};
 
+		usb_1_qmpphy: phy@88e8000 {
+			compatible = "qcom,sm6450-qmp-usb3-dp-phy";
+			reg = <0x0 0x088e8000 0x0 0x3000>;
+
+			clocks = <&gcc GCC_USB3_PRIM_PHY_AUX_CLK>,
+				 <&gcc GCC_USB3_0_CLKREF_EN>,
+				 <&gcc GCC_USB3_PRIM_PHY_COM_AUX_CLK>,
+				 <&gcc GCC_USB3_PRIM_PHY_PIPE_CLK>;
+			clock-names = "aux",
+				      "ref",
+				      "com_aux",
+				      "usb3_pipe";
+
+			resets = <&gcc GCC_USB3_DP_PHY_PRIM_BCR>,
+				 <&gcc GCC_USB3_PHY_PRIM_BCR>;
+			reset-names = "phy",
+				      "common";
+
+			#clock-cells = <1>;
+			#phy-cells = <1>;
+
+			orientation-switch;
+
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					usb_1_qmpphy_out: endpoint {
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					usb_1_qmpphy_usb_ss_in: endpoint {
+						remote-endpoint = <&usb_1_dwc3_ss>;
+					};
+				};
+			};
+		};
+
 		remoteproc_wpss: remoteproc@8a00000 {
 			compatible = "qcom,sm6450-wpss-pas", "qcom,sc7280-wpss-pas";
 			reg = <0x0 0x08a00000 0x0 0x10000>;
@@ -1422,17 +1469,10 @@ &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
 			iommus = <&apps_smmu 0x80 0x0>;
 			dma-coherent;
 
-			phys = <&usb_1_hsphy>;
-			phy-names = "usb2-phy";
-			maximum-speed = "high-speed";
-
-			/*
-			 * There is a USB3 + DP combo PHY at 0x88e8000, but
-			 * which upstream QMP generation it is has not been
-			 * established yet. Until it has, the controller runs
-			 * at high speed off the UTMI clock alone.
-			 */
-			qcom,select-utmi-as-pipe-clk;
+			phys = <&usb_1_hsphy>,
+			       <&usb_1_qmpphy QMP_USB43DP_USB3_PHY>;
+			phy-names = "usb2-phy",
+				    "usb3-phy";
 
 			snps,dis-u1-entry-quirk;
 			snps,dis-u2-entry-quirk;
@@ -1459,6 +1499,14 @@ port@0 {
 					usb_1_dwc3_hs: endpoint {
 					};
 				};
+
+				port@1 {
+					reg = <1>;
+
+					usb_1_dwc3_ss: endpoint {
+						remote-endpoint = <&usb_1_qmpphy_usb_ss_in>;
+					};
+				};
 			};
 		};
 
