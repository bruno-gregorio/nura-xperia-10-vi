From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Greg=C3=B3rio?= <accounts@bruno.pw>
Date: Thu, 8 Oct 2026 09:19:55 -0300
Subject: [PATCH] WIP: arm64: dts: qcom: sm6450: flattened dwc3 binding
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

To be folded into the binding, SoC and board commits once round 25
has run it.

Signed-off-by: Bruno Gregório <accounts@bruno.pw>
---
 .../devicetree/bindings/usb/qcom,dwc3.yaml    |  3 -
 .../bindings/usb/qcom,snps-dwc3.yaml          |  3 +
 .../sm6450-sony-xperia-columbia-pdx246.dts    |  7 +--
 arch/arm64/boot/dts/qcom/sm6450.dtsi          | 63 +++++++++----------
 4 files changed, 34 insertions(+), 42 deletions(-)

diff --git a/Documentation/devicetree/bindings/usb/qcom,dwc3.yaml b/Documentation/devicetree/bindings/usb/qcom,dwc3.yaml
index c583651a4..a792434c5 100644
--- a/Documentation/devicetree/bindings/usb/qcom,dwc3.yaml
+++ b/Documentation/devicetree/bindings/usb/qcom,dwc3.yaml
@@ -60,7 +60,6 @@ properties:
           - qcom,sm6125-dwc3
           - qcom,sm6350-dwc3
           - qcom,sm6375-dwc3
-          - qcom,sm6450-dwc3
           - qcom,sm8150-dwc3
           - qcom,sm8250-dwc3
           - qcom,sm8350-dwc3
@@ -228,7 +227,6 @@ allOf:
               - qcom,sdx65-dwc3
               - qcom,sdx75-dwc3
               - qcom,sm6350-dwc3
-              - qcom,sm6450-dwc3
     then:
       properties:
         clocks:
@@ -506,7 +504,6 @@ allOf:
               - qcom,sdx75-dwc3
               - qcom,sm4250-dwc3
               - qcom,sm6350-dwc3
-              - qcom,sm6450-dwc3
               - qcom,sm8150-dwc3
               - qcom,sm8250-dwc3
               - qcom,sm8350-dwc3
diff --git a/Documentation/devicetree/bindings/usb/qcom,snps-dwc3.yaml b/Documentation/devicetree/bindings/usb/qcom,snps-dwc3.yaml
index d49a58d54..3a8418426 100644
--- a/Documentation/devicetree/bindings/usb/qcom,snps-dwc3.yaml
+++ b/Documentation/devicetree/bindings/usb/qcom,snps-dwc3.yaml
@@ -61,6 +61,7 @@ properties:
           - qcom,sm6125-dwc3
           - qcom,sm6350-dwc3
           - qcom,sm6375-dwc3
+          - qcom,sm6450-dwc3
           - qcom,sm8150-dwc3
           - qcom,sm8250-dwc3
           - qcom,sm8350-dwc3
@@ -213,6 +214,7 @@ allOf:
               - qcom,sdx65-dwc3
               - qcom,sdx75-dwc3
               - qcom,sm6350-dwc3
+              - qcom,sm6450-dwc3
     then:
       properties:
         clocks:
@@ -495,6 +497,7 @@ allOf:
               - qcom,sdx75-dwc3
               - qcom,sm4250-dwc3
               - qcom,sm6350-dwc3
+              - qcom,sm6450-dwc3
               - qcom,sm8150-dwc3
               - qcom,sm8250-dwc3
               - qcom,sm8350-dwc3
diff --git a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
index 1d1c9c5d7..303419c10 100644
--- a/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
+++ b/arch/arm64/boot/dts/qcom/sm6450-sony-xperia-columbia-pdx246.dts
@@ -332,12 +332,9 @@ &uart3 {
 };
 
 &usb_1 {
-	status = "okay";
-};
+	dr_mode = "peripheral";
 
-&usb_1_dwc3 {
-	dr_mode = "otg";
-	usb-role-switch;
+	status = "okay";
 };
 
 /*
diff --git a/arch/arm64/boot/dts/qcom/sm6450.dtsi b/arch/arm64/boot/dts/qcom/sm6450.dtsi
index c770a0099..34f0c93a3 100644
--- a/arch/arm64/boot/dts/qcom/sm6450.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6450.dtsi
@@ -810,9 +810,9 @@ usb_1_hsphy: phy@88e3000 {
 			status = "disabled";
 		};
 
-		usb_1: usb@a6f8800 {
-			compatible = "qcom,sm6450-dwc3", "qcom,dwc3";
-			reg = <0x0 0x0a6f8800 0x0 0x400>;
+		usb_1: usb@a600000 {
+			compatible = "qcom,sm6450-dwc3", "qcom,snps-dwc3";
+			reg = <0x0 0x0a600000 0x0 0xfc100>;
 
 			clocks = <&gcc GCC_CFG_NOC_USB3_PRIM_AXI_CLK>,
 				 <&gcc GCC_USB30_PRIM_MASTER_CLK>,
@@ -830,18 +830,21 @@ usb_1: usb@a6f8800 {
 			assigned-clock-rates = <19200000>, <133333333>;
 
 			/*
-			 * The stock tree names four of these five: it has no
-			 * hs_phy_irq. SPI 130 for pwr_event and SPI 133 for
-			 * the core are what SM6350 uses, which puts hs_phy_irq
-			 * at 131, and 131 is claimed by nothing else in the
-			 * stock tree. That is the one inferred line here.
+			 * The stock tree names four of the five glue
+			 * interrupts: it has no hs_phy_irq. SM6350 and SM8450
+			 * use SPI 130 for pwr_event and SPI 133 for the core,
+			 * as this SoC does, and both put hs_phy_irq at 131,
+			 * which nothing else in the stock tree claims. That is
+			 * the one inferred line here.
 			 */
-			interrupts-extended = <&intc GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>,
+			interrupts-extended = <&intc GIC_SPI 133 IRQ_TYPE_LEVEL_HIGH>,
+					      <&intc GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>,
 					      <&intc GIC_SPI 131 IRQ_TYPE_LEVEL_HIGH>,
 					      <&pdc 14 IRQ_TYPE_EDGE_BOTH>,
 					      <&pdc 15 IRQ_TYPE_EDGE_BOTH>,
 					      <&pdc 17 IRQ_TYPE_LEVEL_HIGH>;
-			interrupt-names = "pwr_event",
+			interrupt-names = "dwc_usb3",
+					  "pwr_event",
 					  "hs_phy_irq",
 					  "dp_hs_phy_irq",
 					  "dm_hs_phy_irq",
@@ -851,6 +854,12 @@ usb_1: usb@a6f8800 {
 
 			resets = <&gcc GCC_USB30_PRIM_BCR>;
 
+			iommus = <&apps_smmu 0x80 0x0>;
+
+			phys = <&usb_1_hsphy>;
+			phy-names = "usb2-phy";
+			maximum-speed = "high-speed";
+
 			/*
 			 * There is a USB3 + DP combo PHY at 0x88e8000, but
 			 * which upstream QMP generation it is has not been
@@ -859,32 +868,18 @@ usb_1: usb@a6f8800 {
 			 */
 			qcom,select-utmi-as-pipe-clk;
 
-			#address-cells = <2>;
-			#size-cells = <2>;
-			ranges;
+			snps,dis-u1-entry-quirk;
+			snps,dis-u2-entry-quirk;
+			snps,dis_u2_susphy_quirk;
+			snps,dis_u3_susphy_quirk;
+			snps,has-lpm-erratum;
+			snps,hird-threshold = /bits/ 8 <0x0>;
+			snps,is-utmi-l1-suspend;
+			snps,usb2-gadget-lpm-disable;
+			snps,usb2-lpm-disable;
+			tx-fifo-resize;
 
 			status = "disabled";
-
-			usb_1_dwc3: usb@a600000 {
-				compatible = "snps,dwc3";
-				reg = <0x0 0x0a600000 0x0 0xcd00>;
-				interrupts = <GIC_SPI 133 IRQ_TYPE_LEVEL_HIGH>;
-				iommus = <&apps_smmu 0x80 0x0>;
-				phys = <&usb_1_hsphy>;
-				phy-names = "usb2-phy";
-				maximum-speed = "high-speed";
-
-				snps,dis-u1-entry-quirk;
-				snps,dis-u2-entry-quirk;
-				snps,dis_u2_susphy_quirk;
-				snps,dis_u3_susphy_quirk;
-				snps,has-lpm-erratum;
-				snps,hird-threshold = /bits/ 8 <0x0>;
-				snps,is-utmi-l1-suspend;
-				snps,usb2-gadget-lpm-disable;
-				snps,usb2-lpm-disable;
-				tx-fifo-resize;
-			};
 		};
 
 		pdc: interrupt-controller@b220000 {
