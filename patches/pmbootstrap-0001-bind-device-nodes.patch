+    # Actually mount the folder.
+    # A plain --bind fails with EINVAL on a source that has submounts the
+    # caller may not traverse, which inside a rootless container includes
+    # /proc (podman masks parts of it with its own mounts). --rbind carries
+    # those submounts along and succeeds; for a source without submounts it is
+    # equivalent to --bind, so it is only used as a fallback to keep the
+    # normal case unchanged.
+    if pmb.helpers.run.root(["mount", "--bind", source, destination], check=False) != 0:
+        pmb.helpers.run.root(["mount", "--rbind", source, destination])
 
