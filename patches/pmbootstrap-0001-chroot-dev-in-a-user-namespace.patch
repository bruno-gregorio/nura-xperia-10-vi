+def in_user_namespace() -> bool:
+    """
+    Whether pmbootstrap runs inside a non-initial user namespace, i.e. in a
+    rootless container. Two kernel restrictions that apply only there change
+    how the chroot's /dev has to be set up; see the two callers.
+    """
+    try:
+        with open("/proc/self/uid_map") as handle:
+            return handle.read().split() != ["0", "0", "4294967295"]
+    except OSError:
+        return False
