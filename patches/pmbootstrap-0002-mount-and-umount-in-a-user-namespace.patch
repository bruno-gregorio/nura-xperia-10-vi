@@ -102,8 +109,19 @@
 
 def umount_all(folder: Path) -> None:
     """Umount all folders that are mounted inside a given folder."""
-    for mountpoint in umount_all_list(folder):
-        pmb.helpers.run.root(["umount", mountpoint])
+    mountpoints = umount_all_list(folder)
+    for mountpoint in mountpoints:
+        # Inside a rootless container the submounts under /proc and /sys are
+        # locked to the container's user namespace: the kernel refuses to
+        # unmount them on their own with EINVAL, which umount(8) reports as
+        # the rather misleading "not mounted". They can only go away together
+        # with the mount they hang off, and detaching that one lazily takes
+        # the whole subtree with it. So let an individual umount fail here and
+        # only insist once the whole list has been walked - by then the
+        # parent, which sorts after its children, has taken them along.
+        if pmb.helpers.run.root(["umount", mountpoint], check=False) != 0:
+            pmb.helpers.run.root(["umount", "-l", mountpoint], check=False)
+    for mountpoint in mountpoints:
         if ismount(mountpoint):
             raise RuntimeError(f"Failed to umount: {mountpoint}")
 
